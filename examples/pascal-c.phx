(* pascal-c.phx -- Pascal, compiled to C.
 *
 *   phx examples/pascal-c.phx prog.pas > prog.c && cc prog.c -o prog
 *
 * The grammar, the tree, the symbol table and the typechecker are in
 * `pascal.phx` and are imported: none of them has an opinion about C. This
 * file is the emit pass and the driver that orders it, and that is all a
 * target is.
 *
 * ---------------------------------------------------------------------------
 * The subset, said plainly rather than discovered
 *
 * **In:** integer, real, boolean, char; subranges; enumerations; sets of a
 * small ordinal type; one-dimensional arrays, bounds written out or named;
 * records without variants; constants, type definitions and variables;
 * procedures and functions, by value and by `var`, not nested; `if`, `while`,
 * `repeat`, `for` both ways, `case`, `with`, compound statements, assignment
 * and calls; the operators including `in`; `write` and `writeln` with field
 * widths.
 *
 * **Also in:** `goto` and labels, which C has and which a translator into
 * Solveig *source* could not have had -- there being no control-flow syntax
 * there to translate them into.
 *
 * **Out:** files, pointers, nested routines, variant records, and a set of
 * more than 63 values. Each is **refused with a message naming it**, at a
 * position in the Pascal, and `tests/refused/` checks that they are: a
 * compiler for a subset has to be right about what it covers *and* loud about
 * what it does not, and the second is the half that is easy to get wrong,
 * because a silent wrong answer looks like success.
 *
 * `tests/pascal/gcd.pas` is inside it, and that file was written for another
 * tool years before Phoenix existed.
 *
 * ---------------------------------------------------------------------------
 * Two things C makes awkward, and how they are done
 *
 * **A C type is written around its name**, not before it: `long v[30]`, not
 * `long[30] v`. So a type answers two pieces -- what goes before the name and
 * what goes after -- and every declaration is `{pre} {name}{post}`. That is
 * the declarator rule C actually has, and writing it out once here is cheaper
 * than special-casing arrays in four places.
 *
 * **Pascal indexes from wherever it likes**, and C from nought. Every index is
 * emitted with one subtracted, and **the subset requires arrays to start at
 * one** -- which is what almost every Pascal array does.
 *
 * Doing it properly is following the variable to its type and that type to its
 * index subrange, which is the same chain of backward hops `pascal.phx` uses
 * to find a record's fields through a `with`. It is known to work and it is
 * four lookups long; the restriction is here to keep this file readable, not
 * because the notation could not say it.
 *)

%import "pascal.phx" .

(* ------------------------------------------------------------------ *)
(* What a `var` parameter is called inside the routine.                *)
(*                                                                     *)
(* This is its own pass for a reason worth stating. `emit-c` hands the  *)
(* by-reference names *down* to a routine's body, and an inherited      *)
(* clause runs on the way **in**, before that routine's parameters have *)
(* been looked at. Gathering them is bottom-up; handing them down is    *)
(* top-down; one walk cannot do both.                                   *)
(*                                                                     *)
(* It is the same shape as `symbols` before `typecheck` in `pascal.phx`, *)
(* and it turned up the same way -- by being written as one pass first   *)
(* and not working.                                                     *)

%pass prepare

  (* **An array parameter is by reference in C whether or not it says so**,
   * because an array decays to a pointer when it is passed. So a Pascal
   * `var f : Flags` is a plain `Flags f` in C and needs no dereference, while
   * a `var n : integer` is `long *n` and every use of it is `(*n)`.
   *
   * `shapeof` is what the typechecker worked out this parameter's type really
   * is, and the choice between the two spellings is a `lookup` against it --
   * a table standing in for the conditional the notation has not got. *)
  (* What a *caller* has to put in front of an argument for this parameter:
   * `&` for a by-reference one that is not an array, and nothing otherwise.
   * One entry per name, so the list lines up with the argument positions. *)
  Param(byref: true)  : addr = each($names, lookup([["array", ""]], $shapeof, "&"))
                      : star = lookup([["array", ""]], $shapeof, "*")
                      : refs = bind([], $names,
                                 each($names, lookup([["array", "{}"]], $shapeof,
                                                     "(*{})"))) .
  Param(byref: false) : addr = each($names, "")
                      : star = ""
                      : refs = [] .

  Procedure : byrefs = flatten([...$params.refs]) .
  Function  : byrefs = flatten([...$params.refs]) .

%pass emit-c


  (* Where a variable lives, and how it is spelled, are both handed *down* --
   * a program's variables are C globals and a routine's are C locals, and a
   * `var` parameter is a pointer that every use of has to dereference.
   *
   * There is no `if` in the notation, so both are done with `lookup` against a
   * default: a name that is not by reference looks up to itself. That is the
   * conditional, written as a table. *)





  (* A parameter's type is written as a bare *name* in Pascal, so there is no
   * type node to ask -- the table is the same one `NamedType` uses, and a name
   * that is not a base type is a typedef and stands for itself. *)
  Param : out = join(each($names, "{} {}{}"
                        of lookup($ctypes, $type, $type), $star, "{}"), ", ") .

  (* ---- types, as C declarators ----
   *
   * A C type is written *around* its name -- `long v[30]`, not `long[30] v` --
   * so a type answers two pieces and every declaration is `{pre} {name}{post}`.
   * Writing C's declarator rule out once here is cheaper than special-casing
   * arrays in the four places a type is declared. *)

  NamedType(name: "integer") : pre = "long"   : post = "" .
  NamedType(name: "real")    : pre = "double" : post = "" .
  NamedType(name: "boolean") : pre = "int"    : post = "" .
  NamedType(name: "char")    : pre = "char"   : post = "" .
  NamedType                  : pre = $name    : post = "" .

  NoType    : pre = "void" : post = "" .

  (* Outside the subset, and said so *here* rather than left to fail as a
   * missing attribute. A check blocks its node's attributes, so the message
   * is the one a person reads and the consequences stay quiet -- and it
   * carries a position in the Pascal rather than in this file. *)
  Pointer  : pre = "void *" : post = ""
           ! true : "a pointer type is not compiled: ^, new and dispose are not in this subset" .
  FileType : pre = "long" : post = ""
           ! true : "a file type is not compiled: input and output are the only files in this subset" .
  Subrange  : pre = "long" : post = "" .
  Packed    : pre = $type.pre : post = $type.post .

  (* An enumeration becomes a C `enum`, which numbers its members from nought
   * exactly as Pascal does -- so nothing here has to count, and `Red` is a C
   * constant wherever a Pascal program writes it. *)
  EnumType  : pre = "enum {{ {} }}" of join($names, ", ") : post = "" .

  (* A set of a small ordinal type is a bit per member in a `long`, which is
   * how Pascal's sets are built and the only cheap way for C to have one.
   *
   * **Which means it holds 63 members and not one more.** `set of 0 .. 200`
   * compiled quietly and answered wrongly before this check existed, which is
   * the worst thing this compiler could do. A span of nought means the
   * typechecker could not work the size out -- a named constant in the bounds
   * -- and an unknown is not refused. *)
  SetType   : pre = "long" : post = ""
            ! lookup($spans, $of.iname, $of.span) > 63
              : "a set of {} values does not fit -- {} is the most a set can hold here"
                  of lookup($spans, $of.iname, $of.span), 63 .

  (* `bound` is the index range the typechecker resolved -- written out or
   * named, it is a subrange by the time it reaches here. *)
  ArrayType : pre  = $of.pre
            : post = "[({}) - ({}) + 1]{}"
                       of $bound.high.out, $bound.low.out, $of.post .

  RecordType : pre  = "struct {{ {} }}" of join($fields.out, " ")
             : post = "" .
  FieldDecl  : out  = join(each($names, "{} {}{};" of $type.pre, "{}", $type.post), " ") .

  (* ---- constants ---- *)

  Integer       : out = "{}" of $text .
  Real          : out = "{}" of $text .
  (* `plain` is what the literal says, worked out by `symbols`. A literal of
   * one character is a `char` in Pascal, and C spells a character and a string
   * differently -- so which of the two templates is used is another lookup.
   *
   * Both escape a backslash first and their own quote second, in that order,
   * because doing it the other way round would escape the escapes. *)
  Text : c-escaped = join(split(join(split($plain, "\\"), "\\\\"), "\""), "\\\"")
       : q-escaped = join(split(join(split($plain, "\\"), "\\\\"), "'"), "\\'")
       : out = lookup([[1, "'{}'"]], size($plain), "\"{}\"")
                 of lookup([[1, $q-escaped]], size($plain), $c-escaped) .
  (* Pascal's two boolean literals are ordinary named constants in the
   * grammar, and C spells them differently. Another table standing in for a
   * conditional. *)
  NamedConstant : out = lookup($spelled, $name, $name) .
  Signed         : out = "({}{})" of $sign, $value.out .
  SignedConstant : out = "({}{})" of $sign, $value.out .
  Nil           : out = "0" .

  (* ---- declarations ---- *)

  ConstDef : out = "#define {} {}\n" of $name, $value.out .
  TypeDef  : out = "typedef {} {}{};\n" of $type.pre, $name, $type.post .
  VarDecl  : out = "{}\n" of join(each($names, "{}{} {}{};"
                                              of $storage, $type.pre, "{}",
                                                 $type.post), "\n") .

  (* ---- routines ----
   *
   * A Pascal function returns by assigning to its own name, so C gets a local
   * of that name and a `return` at the end. *)

  Forward   : out = "" : inner = "" .

  Procedure : down inroutine = true
            : down storage = ""
            : down spelled = [...$byrefs, ...$spelled]
            : out = "static void {}({})\n{{\n{}{}\n}}\n"
                of $name, join($params.out, ", "), $body.decls, $body.code .

  (* **A Pascal function returns by assigning to its own name**, and C cannot
   * have a local with the same name as the function -- `Fact := n * Fact(n-1)`
   * became `Fact = n * Fact(n-1)` with `Fact` a `long`, and recursion stopped
   * compiling. The result gets a name of its own, and *reading* the function's
   * name inside it is spelled that way while *calling* it is not, because a
   * call is a different node and does not go through this table. *)
  Function  : down inroutine = true
            : down storage = ""
            : down spelled = [...bind([], $name, "phx_result"),
                              ...$byrefs, ...$spelled]
            : out = "static {} {}({})\n{{\n  {} phx_result;\n{}{}\n  return phx_result;\n}}\n"
                of $returns.pre, $name, join($params.out, ", "),
                   $returns.pre, $body.decls, $body.code .

  (* ---- blocks ---- *)

  (* The same scope the typechecker built. An inherited attribute lives only
   * for the walk that made it, so a later pass needing one says so again --
   * one line, and explicit about needing it. *)
  (* Both tables the typechecker built are rebuilt here: an inherited
   * attribute lives only for the walk that made it, so a later pass needing
   * one says so again. *)
  (* **A routine inside a routine is refused, and the *block* is what asks.**
   * A routine cannot ask about itself: its own `down inroutine` is pushed on
   * the way in and is still in scope when its checks run on the way out, so
   * it would see its own answer. The block inside it sees the routine's, and
   * the program's block sees the program's. *)
  Block ! $inroutine and size($routines) > 0
          : "a routine inside a routine is not compiled: C has no nested functions, and this does not hoist them"
        : down known = [...$shapes, ...$known]
        : down spans = [...$spanmap, ...$spans]
        : decls      = "{}{}{}" of join($consts.out, ""), join($types.out, ""),
                                join($vars.out, "")
        : routinecode = join($routines.out, "\n")
        : code     = $body.out
        : out      = "{{\n{}{}\n}}" of $decls, $code
        : inner    = "{}{}" of $decls, $code .

  (* ---- statements ---- *)

  Compound : out = "  {{\n{}\n  }}" of join($body.out, "\n") .

  (* `goto` is one of the things emitting C makes easy and emitting Solveig
   * could not: `docs/PASCAL.md` in the Solveig repository records that a
   * translator into *source* has no control-flow syntax to translate it into.
   * A C label cannot be a number, so it gets a letter in front. *)
  Goto     : out = "  goto L{};" of $label .
  Labelled : out = "  L{}: ;\n{}" of $label, $do.out .
  Empty    : out = "  ;" .
  Assign   : out = "  {} = {};" of $target.out, $value.out .

(* **Every body is braced, even a single statement.** `writeln(x)` is two C
   * statements -- a `printf` and the newline -- so `if (c) writeln(x);` would
   * put the newline outside the `if` and print it every time. A brace is free
   * and a one-statement body that is secretly two is not. `cc -Wall` found
   * this, which is a good argument for compiling what a compiler emits. *)
  If     : out = "  if ({}) {{\n{}\n  }}"                 of $cond.out, $then.out .
  IfElse : out = "  if ({}) {{\n{}\n  }} else {{\n{}\n  }}"
                   of $cond.out, $then.out, $else.out .
  While  : out = "  while ({}) {{\n{}\n  }}"              of $cond.out, $body.out .
  Repeat : out = "  do {{\n{}\n  }} while (!({}));"
             of join($body.out, "\n"), $until.out .

  (* Pascal's `case` is C's `switch`, and every arm breaks -- Pascal has no
   * fall-through, so putting one in would be inventing a behaviour. *)
  Case   : out = "  switch ({}) {{\n{}\n  }}" of $value.out, join($elements.out, "\n") .
  CaseOf : out = "{}\n{}\n    break;"
             of join(each($values.out, "    case {}:"), "\n"), $do.out .

  (* `with origin do ... x ...` -- the fields are spelled `origin.x` inside,
   * and *that is all it is*. The table of names C spells differently already
   * existed for `var` parameters, so a `with` is four lines and no mechanism.
   * Only the first of `with a, b do` is taken, as in the typechecker. *)
(* The prefix is the *spelled* form of the variable, not its name: inside
   * `with o do with p do ...`, `p` is already `o.p`, so `a` has to become
   * `o.p.a` and not `p.a`. Looking the prefix up in the table this clause is
   * extending is the whole of that. *)
  With   : down spelled = [...bind([], $fields,
                                   each($fields, "{}.{{}}"
                                          of lookup($spelled, at($vars, 1).name,
                                                    at($vars, 1).name))),
                           ...$spelled]
         : out = "  {{\n{}\n  }}" of $body.out .

  For(dir: "to")     : out = "  for ({} = {}; {} <= {}; {}++) {{\n{}\n  }}"
                         of $var, $from.out, $var, $to.out, $var, $body.out .
  For(dir: "downto") : out = "  for ({} = {}; {} >= {}; {}--) {{\n{}\n  }}"
                         of $var, $from.out, $var, $to.out, $var, $body.out .

  (* ---- calls ----
   *
   * `writeln(x)` picks its format from the argument's *type*, which the
   * typechecker worked out and left on the node. The choice is a `lookup`
   * against a table, which is what a notation with no conditional uses for
   * one. *)

  Argument : out   = $value.out
           : write = lookup($writes, $value.type,
                            "printf(\"%11ld\", (long)({})); ") of $value.out .

  (* `write(x:8)` -- a field width, which C spells with a `*` and an extra
   * argument. The template takes the width first and the value second. *)
  Padded   : out   = $value.out
           : write = lookup($padded, $value.type,
                            "printf(\"%*ld\", (int)({}), (long)({})); ")
                       of $width.out, $value.out .

  (* `write(x:8:3)` -- fixed point, and the only place Pascal writes a real
   * without an exponent. *)
  Rounded  : out   = $value.out
           : write = "printf(\"%*.*f\", (int)({}), (int)({}), (double)({})); "
                       of $width.out, $places.out, $value.out .

  CallStatement(name: "writeln") : out = "  {}printf(\"\\n\");"
                                           of join($args.write, "") .
  CallStatement(name: "write")   : out = "  {}" of join($args.write, "") .
(* A call has to know which of the routine's parameters are by reference,
   * so that it can take the address. The routine was declared earlier and its
   * name is bound to its parameter list -- **another backward hop** -- and
   * `each` over two lists pairs the arguments with what goes in front of
   * them. *)
  CallStatement : out = "  {}({});"
                    of $name, join(each(flatten([...lookup($known, $name, Shape(iname: "", startsat: "1", node: [])).node.addr]),
                                        $args.out, "{}{}"), ", ") .

  (* ---- Pascal's standard functions ----
   *
   * None of these is a C function, and each is one line. `abs` is the only one
   * that depends on its argument's type, which the typechecker worked out and
   * left on the node -- so the choice is a `lookup`, as every choice here is.
   *
   * `sqr` evaluates its argument twice in C, which is wrong for anything with
   * a side effect; Pascal has no expression with one, so it is right here and
   * would not be in another language. *)

  CallExpression(name: "abs")   : out = "{}({})"
                                    of lookup([["real", "fabs"]],
                                              at($args, 1).type, "labs"),
                                       at($args, 1).out .
  CallExpression(name: "sqr")   : out = "(({}) * ({}))" of at($args, 1).out,
                                                           at($args, 1).out .
  CallExpression(name: "odd")   : out = "((({}) & 1) != 0)" of at($args, 1).out .
  CallExpression(name: "ord")   : out = "((long)({}))"  of at($args, 1).out .
  CallExpression(name: "chr")   : out = "((char)({}))"  of at($args, 1).out .
  (* `succ` of a char is a char, so C has to be told to keep it one. *)
  CallExpression(name: "succ")  : out = lookup([["char", "((char)(({}) + 1))"]],
                                               at($args, 1).type, "(({}) + 1)")
                                         of at($args, 1).out .
  CallExpression(name: "pred")  : out = lookup([["char", "((char)(({}) - 1))"]],
                                               at($args, 1).type, "(({}) - 1)")
                                         of at($args, 1).out .
  CallExpression(name: "round") : out = "((long)phx_round({}))" of at($args, 1).out .
  CallExpression(name: "trunc") : out = "((long)({}))"  of at($args, 1).out .

  CallExpression(name: "sqrt")   : out = "sqrt({})" of at($args, 1).out .
  CallExpression(name: "sin")    : out = "sin({})"  of at($args, 1).out .
  CallExpression(name: "cos")    : out = "cos({})"  of at($args, 1).out .
  CallExpression(name: "ln")     : out = "log({})"  of at($args, 1).out .
  CallExpression(name: "exp")    : out = "exp({})"  of at($args, 1).out .
  CallExpression(name: "arctan") : out = "atan({})" of at($args, 1).out .

  CallExpression : out = "{}({})"
                    of $name, join(each(flatten([...lookup($known, $name, Shape(iname: "", startsat: "1", node: [])).node.addr]),
                                        $args.out, "{}{}"), ", ") .

  (* ---- expressions ---- *)

  Not : out = "(!{})" of $value.out .

  (* `+ - *` on sets are union, difference and intersection, which on a bit
   * per member are `| &~ &`. Which of the two meanings is wanted is the
   * operands' type, and the typechecker knows it. *)
  Binary(op: "+") : out = lookup([["set", "({} | {})"]], $left.type, "({} + {})")
                            of $left.out, $right.out .
  Binary(op: "-") : out = lookup([["set", "({} & ~{})"]], $left.type, "({} - {})")
                            of $left.out, $right.out .
  Binary(op: "*") : out = lookup([["set", "({} & {})"]], $left.type, "({} * {})")
                            of $left.out, $right.out .

  Binary(op: "div") : out = "({} / {})"  of $left.out, $right.out .
  (* **`mod` is not `%`.** ISO Pascal's `i mod j` is the non-negative
   * remainder and wants `j > 0`: `-7 mod 2` is 1 where C says -1, and
   * `7 mod -2` is an error where C answers. `fpc -Miso` does this and the
   * first version of this file did not; `tests/oracle/run.sh` is what said
   * so. *)
  Binary(op: "mod") : out = "phx_mod({}, {})" of $left.out, $right.out .
  Binary(op: "and") : out = "({} && {})" of $left.out, $right.out .
  Binary(op: "or")  : out = "({} || {})" of $left.out, $right.out .
  Binary(op: "/")   : out = "((double)({}) / (double)({}))" of $left.out, $right.out .
  Binary            : out = "({} {} {})" of $left.out, $op, $right.out .

(* **Comparing text is `strcmp`, not `<`.** C compares two string literals by
   * address, which is undefined and *happened to agree with fpc* -- the
   * compiler had pooled the literals and laid them out in order. That is the
   * same way the array bounds agreed while writing outside themselves: an
   * accident that looks like a pass.
   *
   * Every comparison gets a clause of its own rather than one with the
   * operator in a hole, because the two templates want their operands in
   * different places. *)
  Compare(op: "=")  : out = lookup([["string", "(strcmp({}, {}) == 0)"]],
                                   $left.type, "({} == {})") of $left.out, $right.out .
  Compare(op: "<>") : out = lookup([["string", "(strcmp({}, {}) != 0)"]],
                                   $left.type, "({} != {})") of $left.out, $right.out .
  Compare(op: "<")  : out = lookup([["string", "(strcmp({}, {}) < 0)"]],
                                   $left.type, "({} < {})")  of $left.out, $right.out .
  Compare(op: ">")  : out = lookup([["string", "(strcmp({}, {}) > 0)"]],
                                   $left.type, "({} > {})")  of $left.out, $right.out .
  Compare(op: "<=") : out = lookup([["string", "(strcmp({}, {}) <= 0)"]],
                                   $left.type, "({} <= {})") of $left.out, $right.out .
  Compare(op: ">=") : out = lookup([["string", "(strcmp({}, {}) >= 0)"]],
                                   $left.type, "({} >= {})") of $left.out, $right.out .
  Compare(op: "in") : out = "((({}) >> ({})) & 1)" of $right.out, $left.out .

  (* `[Red, Blue, 2 .. 6]` is those bits set. Each element says what its own
   * bits are, because a member is one bit and a range is a run of them and a
   * set cannot ask which it has. The leading `0` is not decoration: it makes
   * the empty set `(0)` rather than `()`, without a second clause for a case
   * the arithmetic already covers. *)
  Member : mask = "(1L << ({}))" of $value.out .
  SetOf  : out  = "(0{})" of join(each($elements.mask, " | {}"), "") .
  (* `[2..6]` -- every bit from the low to the high, both included. *)
  Range : mask = "(((1L << (({}) + 1)) - 1) & ~((1L << ({})) - 1))"
            of $high.out, $low.out .

  (* ---- variables ----
   *
   * A name that is by reference looks up to `(*name)`; one that is not looks
   * up to itself, because that is the default. No conditional, and no second
   * clause for a distinction the table already makes. *)

  (* Each step wraps what it reaches into, so each one emits what is below it
   * and then its own part. The lower bound is the array's own -- the
   * typechecker worked it out on this very node, which is why the accessors
   * had to nest: with a flat list there was nowhere to put it. *)
  Variable : out = lookup($spelled, $name, $name) .
  FieldOf  : out = "{}.{}"           of $of.out, $name .
  Deref    : out = "(*{})"           of $of.out .
  Indexed  : out = "{}[({}) - ({})]" of $of.out, at($at, 1).out, $lowbound .

  (* ---- the whole ---- *)

  (* Pascal's type names in C -- a name that is not here is a typedef and
   * stands for itself -- and where a variable lives. Both are handed down,
   * and all of Program's clauses go in the one rule. *)
  (* ------------------------------------------------------------------
   * What Pascal needs that C does not have, emitted once at the top.
   *
   * These were all found by `tests/oracle/run.sh`, which compiles the same
   * program with `fpc -Miso` and compares. Every one of them is a place C's
   * obvious answer is not Pascal's answer.
   *
   * **`mod` is not `%`.** ISO Pascal's `i mod j` is the non-negative
   * remainder and requires `j > 0`: `-7 mod 2` is 1 where C says -1, and
   * `7 mod -2` is an error where C says 1. fpc gets this right and the first
   * version of this file did not.
   *
   * **A real is written in scientific notation with a three-digit
   * exponent**, and C's `%e` gives two. A positive one is preceded by a
   * space where the sign would be.
   *)
  Program : down inroutine = false
          : down known = []
          : down spans = []
          : down ctypes = [["integer", "long"], ["real", "double"],
                           ["boolean", "int"], ["char", "char"]]
          : down storage = "static "

          (* Names that C spells differently: a `var` parameter, and Pascal's
           * two boolean literals -- which the grammar makes ordinary variable
           * references, because that is what they look like. *)
          : down spelled = [["true", "1"], ["false", "0"]]

          (* How each Pascal type is *written*, as a whole C statement rather
           * than a format -- because a boolean is words and a real needs a
           * helper, and neither is a `printf` conversion. The default widths
           * are fpc's: 11 for an integer, 5 for a boolean, 24 for a real.
           *
           * A table, because that is what this notation has instead of a
           * conditional, and because it reads as what it is: a list of the
           * types that differ. *)
          : down writes =
              [["integer", "printf(\"%11ld\", (long)({})); "],
               ["real",    "phx_real(24, {}); "],
               ["boolean", "printf(\"%5s\", ({}) ? \"true\" : \"false\"); "],
               ["char",    "printf(\"%c\", (char)({})); "],
               ["string",  "printf(\"%s\", {}); "]]

          (* The same, given a field width. *)
          : down padded =
              [["integer", "printf(\"%*ld\", (int)({}), (long)({})); "],
               ["real",    "phx_real((int)({}), {}); "],
               ["boolean", "printf(\"%*s\", (int)({}), ({}) ? \"true\" : \"false\"); "],
               ["char",    "printf(\"%*c\", (int)({}), (char)({})); "],
               ["string",  "printf(\"%*s\", (int)({}), {}); "]]
          (* Two things Pascal has that C does not, written into every
           * program. Both were found by the oracle: `mod` is not `%`, and a
           * real is written in scientific notation with a *three*-digit
           * exponent where C's `%e` gives two.
           *
           * Built with `join` rather than as one literal, because adjacent
           * strings do not run together in this notation -- and because the
           * braces in C code are then *values* rather than template syntax,
           * so none of them has to be doubled.
           *
           * They are not `static`: a program that never writes a real never
           * calls `phx_real`, and a `static` function nothing calls is a
           * warning `cc -Werror` refuses. External linkage in a
           * single-translation-unit program costs nothing and says nothing
           * about whether it is used. *)
          : helpers = join([
              "long phx_mod(long a, long b)",
              "{",
              "    long r;",
              "    if (b <= 0) { fprintf(stderr, \"Runtime error 200\\n\"); exit(200); }",
              "    r = a % b;",
              "    return r < 0 ? r + b : r;",
              "}",
              "",
              "long phx_round(double v)",
              "{",
              "    return (long)(v < 0 ? v - 0.5 : v + 0.5);",
              "}",
              "",
              "void phx_real(int width, double v)",
              "{",
              "    char buf[64], out[96];",
              "    char *e = buf;",
              "    int mant, exp;",
              "    snprintf(buf, sizeof buf, \"%.16e\", v);",
              "    while (*e && *e != 'e') e++;",
              "    mant = (int)(e - buf);",
              "    exp = (int)strtol(e + 1, 0, 10);",
              "    snprintf(out, sizeof out, \"%s%.*se%c%03d\",",
              "             v < 0 ? \"\" : \" \", mant, buf,",
              "             exp < 0 ? '-' : '+', exp < 0 ? -exp : exp);",
              "    printf(\"%*s\", width, out);",
              "}"], "\n")

          : out = "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n{}\n\n{}\n{}\nint main(void)\n{{\n{}\n  return 0;\n}}\n"
              of $helpers, $body.decls, $body.routinecode, $body.code .

%driver c = symbols, typecheck, prepare, emit-c -> out .
