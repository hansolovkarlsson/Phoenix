(* calc-solveig.phx -- the calculator, compiled to Solveig.
 *
 *     phx --run emit-sol examples/calc-solveig.phx prog.calc > prog.sol
 *     solas prog.sol -o prog.sob && solvm prog.sob
 *
 * **Parked, and now cheap to keep.** Phoenix targets C: Solveig is still
 * changing, and nothing here is run by `make test`. But this file is *read* on
 * every build, so the notation cannot drift out from under it -- and since
 * `%import` arrived it can no longer drift from `calc.phx` either, because it
 * holds no copy of anything. It is an emit pass and a line naming the language.
 *
 * `PHX_TEST_SOLVEIG=1 make test` runs the round trip for anyone with `solas`.
 *
 * That is the argument for `%import` in one file: this was 90 lines of
 * duplicated grammar that would have gone quietly wrong the first time
 * `calc.phx` changed.
 *)

%import "calc.phx"

(* ------------------------------------------------------------------ *)
(* Solveig has no operators and no control-flow syntax. `@expr( )` is a
 * bounded region where infix is notation for the sends it reads as, and
 * an integer is written with a `#`. Division is a message rather than an
 * operator, so it needs a clause of its own -- and `:div` is floored
 * where calc's division truncates, which is why it is `quotient` that is
 * modelled here and not the bare send.
 *
 * The control-flow clauses are missing on purpose: `ifTrue:` and
 * `whileTrue:` take blocks, and emitting them is the work this backend
 * still needs. Phoenix will say which clause is absent the first time a
 * program reaches for one, which is the right way round.
 *)

%pass emit-sol
  Number   : out = "#{}" of $text .
  Variable : out = "{}" of $name .

  Binary(op: "/") : out = "{}:quo({})" of $left.out, $right.out .
  Binary          : out = "@expr({} {} {})" of $left.out, $op, $right.out .

  (* Solveig's `@expr` region spells these `~ & |`, in that precedence. *)
  Negate : out = "{}:negated" of $value.out .
  Not    : out = "@expr(~{})" of $value.out .
  Logical(op: "and") : out = "@expr({} & {})" of $left.out, $right.out .
  Logical(op: "or")  : out = "@expr({} | {})" of $left.out, $right.out .

  Compare(op: "=")  : out = "@expr({} = {})"  of $left.out, $right.out .
  Compare(op: "<>") : out = "@expr({} <> {})" of $left.out, $right.out .
  Compare           : out = "@expr({} {} {})" of $left.out, $op, $right.out .

  Let      : out = "{} := {}." of $name, $value.out .
  Assign   : out = "{} := {}." of $name, $value.out .

  (* `display` rather than `print`: `print` writes an integer in its
   * literal form, `#97`, and every backend has to answer the same. *)
  Print    : out = "{}:display. \"\\n\":display." of $value.out .

  Block    : out = join($body.out, "\n") .
  Program  : out = join($body.out, "\n") .
