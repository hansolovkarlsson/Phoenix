(* calc-solveig.phx -- the calculator, emitting Solveig instead of C.
 *
 * **Parked, not removed.** Phoenix targets C for now: Solveig is still
 * changing, and keeping a second backend in step with a moving language costs
 * maintenance to prove a property that docs/semantics.md and the
 * interpreted-versus-generated conformance test already prove.
 *
 * This file is still *read* by the test suite, so the notation cannot drift
 * out from under it. It is not run, and there is no `solas` in Phoenix's
 * dependencies. Bringing Solveig back is writing these clauses again -- it is
 * not a change to Phoenix, because the language a compiler emits was never
 * Phoenix's business.
 *
 *   phx --run emit-sol examples/calc-solveig.phx prog.calc > prog.sol
 *   solas prog.sol -o prog.sob && solvm prog.sob
 *)

(* calc.phx -- the smallest language worth having a compiler for.
 *
 *   bin/phx examples/calc.phx examples/sum.calc
 *
 * Stage 0 is the grammar half only: this file says what a `.calc` program
 * looks like, and Phoenix scans one, parses it and prints the tree. There is
 * nothing here yet about what a program *means* -- that is stage 2.
 *)

(* ------------------------------------------------------------------ *)
(* Characters to tokens.                                              *)

(* `letter` and `digit` are what the token rules are written out of, and are
 * never tokens themselves. Without this line a file comes back as a stream of
 * `letter`, because both rules match `x` and ties go to the one declared
 * first. *)
%fragment letter digit

letter = "a" .. "z" | "A" .. "Z" | "_" .
digit  = "0" .. "9" .

name   = letter { letter | digit } .
number = digit { digit } [ "." digit { digit } ] .

symbol = ":=" | "+" | "-" | "*" | "/" | "(" | ")" | ";" .

comment = "#" { ! "\n" } .
space   = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .

%skip space comment

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* Every word-shaped literal below is a reserved word, worked out from  *)
(* this half rather than declared -- so `print` cannot be a variable,   *)
(* and nothing here had to say so.                                     *)

%syntax
%start program

(* `->` says what an alternative *means*, as against what it looks like.
 * Without one, a rule answers what it matched. *)

program   = { statement } -> Program(body: $1) .

statement = "print" e:expression ";"          -> Print(value: $e)
          | "let" n:name ":=" e:expression ";" -> Let(name: $n, value: $e) .

(* `$$` is what has been built so far, so an action mentioning it replaces the
 * value before it rather than following it. That is a left fold, and it is how
 * the flat repetition every grammar writes for a binary operator becomes the
 * left-leaning tree it means. *)

expression = term { ( "+" | "-" ) term -> Binary(op: $1, left: $$, right: $2) } .
term       = factor { ( "*" | "/" ) factor -> Binary(op: $1, left: $$, right: $2) } .

factor     = number             -> Number(text: $1)
           | name               -> Variable(name: $1)
           | "(" expression ")" -> $2 .

(* ------------------------------------------------------------------ *)
(* Solveig has no operators and no control-flow syntax: `@expr( )` is a
 * bounded region where infix is notation for the sends it reads as, and
 * integers are written with a `#`. Division is a message rather than an
 * operator inside `@expr`, so it needs a clause of its own. *)

%pass emit-sol
  Number   : out = "#{}" of $text .
  Variable : out = "{}" of $name .

  Binary(op: "/") : out = "{}:div({})" of $left.out, $right.out .
  Binary          : out = "@expr({} {} {})" of $left.out, $op, $right.out .

  Let      : out = "{} := {}." of $name, $value.out .

  (* `display` rather than `print`: `print` writes an integer in its literal
   * form, `#97`, and every backend has to answer the same thing. *)
  Print    : out = "{}:display. \"\\n\":display." of $value.out .
  Program  : out = join($body.out, "\n") .
