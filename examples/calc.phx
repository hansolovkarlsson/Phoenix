(* calc.phx -- the smallest language worth having a compiler for.
 *
 *   bin/phx examples/calc.phx examples/sum.calc
 *
 * Stage 0 is the grammar half only: this file says what a `.calc` program
 * looks like, and Phoenix scans one, parses it and prints the tree. There is
 * nothing here yet about what a program *means* -- that is stage 2.
 *)

(* ------------------------------------------------------------------ *)
(* Characters to tokens.                                              *)

(* `letter` and `digit` are what the token rules are written out of, and are
 * never tokens themselves. Without this line a file comes back as a stream of
 * `letter`, because both rules match `x` and ties go to the one declared
 * first. *)
%fragment letter digit

letter = "a" .. "z" | "A" .. "Z" | "_" .
digit  = "0" .. "9" .

name   = letter { letter | digit } .
number = digit { digit } [ "." digit { digit } ] .

symbol = ":=" | "+" | "-" | "*" | "/" | "(" | ")" | ";" .

comment = "#" { ! "\n" } .
space   = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .

%skip space comment

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* Every word-shaped literal below is a reserved word, worked out from  *)
(* this half rather than declared -- so `print` cannot be a variable,   *)
(* and nothing here had to say so.                                     *)

%syntax
%start program

(* `->` says what an alternative *means*, as against what it looks like.
 * Without one, a rule answers what it matched. *)

program   = { statement } -> Program(body: $1) .

statement = "print" e:expression ";"          -> Print(value: $e)
          | "let" n:name ":=" e:expression ";" -> Let(name: $n, value: $e) .

(* `$$` is what has been built so far, so an action mentioning it replaces the
 * value before it rather than following it. That is a left fold, and it is how
 * the flat repetition every grammar writes for a binary operator becomes the
 * left-leaning tree it means. *)

expression = term { ( "+" | "-" ) term -> Binary(op: $1, left: $$, right: $2) } .
term       = factor { ( "*" | "/" ) factor -> Binary(op: $1, left: $$, right: $2) } .

factor     = number             -> Number(text: $1)
           | name               -> Variable(name: $1)
           | "(" expression ")" -> $2 .

(* ------------------------------------------------------------------ *)
(* What a program means.                                              *)
(*                                                                     *)
(* A pass is clauses keyed on the vocabulary above. They are tried in   *)
(* order and the first match wins -- the same rule the syntactic half   *)
(* uses for `|`, so there is one thing to know about ordering and not   *)
(* two.                                                                 *)

%pass eval

  (* An environment flows along the tree in document order: it enters a
   * node, may be changed by it, and leaves to whatever comes next. That
   * is what a symbol table is, and it is the one shape plain synthesised
   * and inherited attributes cannot express. *)
  thread env = empty

  Number   : val = int($text) .
  Variable : val = lookup($env, $name)
           ! not defined($env, $name) : "'{}' is not defined" of $name .

  Binary(op: "+") : val = $left.val + $right.val .
  Binary(op: "-") : val = $left.val - $right.val .
  Binary(op: "*") : val = $left.val * $right.val .
  Binary(op: "/") : val = $left.val div $right.val
                  ! $right.val = 0 : "division by zero" .

  Let      : env = bind($env, $name, $value.val)
           : out = "" .
  Print    : out = "{}\n" of $value.val .

  (* `$body` is a list, and reading an attribute of a list reads it from
   * every element -- so this is the `out` of each statement, joined. *)
  Program  : out = join($body.out) .

(* ------------------------------------------------------------------ *)
(* Two compilers, from one description.                                *)
(*                                                                     *)
(* Neither pass knows what language Phoenix itself emits. An emit pass  *)
(* builds a string and nothing cares what is in it, which is the whole  *)
(* reason a `.phx` can target something other than Solveig.             *)

%pass emit-sol
  Number   : out = "#{}" of $text .
  Variable : out = "{}" of $name .

  Binary(op: "/") : out = "{}:div({})" of $left.out, $right.out .
  Binary          : out = "@expr({} {} {})" of $left.out, $op, $right.out .

  Let      : out = "{} := {}." of $name, $value.out .
  (* `display` rather than `print`: `print` writes an integer in its
   * literal form, `#97`, and the answer has to be the same three ways. *)
  Print    : out = "{}:display. \"\\n\":display." of $value.out .
  Program  : out = join($body.out, "\n") .

%pass emit-c
  Number   : out = "{}" of $text .
  Variable : out = "{}" of $name .
  Binary   : out = "({} {} {})" of $left.out, $op, $right.out .

  Let      : out = "    long {} = {};" of $name, $value.out .
  Print    : out = "    printf(\"%ld\\n\", {});" of $value.out .
  Program  : out = "#include <stdio.h>\n\nint main(void)\n{\n{}\n    return 0;\n}"
                     of join($body.out, "\n") .
