(* pascal.phx -- ISO 7185 Pascal: what it looks like, and what it means.
 *
 *   bin/phx --tree examples/pascal.phx prog.pas
 *   bin/phx --nodes examples/pascal.phx
 *
 * **The grammar is Wirth's and is not this project's work.** It came from
 * `tests/pascal/pascal.bnf`, which is kept unmodified because three tests
 * depend on it being a real published grammar that Phoenix reads without
 * being met halfway. What is added here is the `->` clauses: what each
 * construct *builds*, which is the half a grammar does not have.
 *
 * The point of doing this to Pascal rather than to another toy is that the
 * grammar was written by somebody else, for another purpose, years before
 * Phoenix existed. Everything the notation could not say about it is a
 * finding.
 *
 * The source is *Pascal User Manual and Report*, Jensen and Wirth, where the
 * syntax is given in this notation and the lexical rules are given in it too.
 * What is here is that grammar, rearranged in three ways and no more:
 *
 *   1. Alternatives are ordered so that ordered choice picks the right one --
 *      the longer of two overlapping alternatives goes first. Every place that
 *      mattered is marked below with an "order" note.
 *   2. The punctuation is gathered into one `symbol` token rule, because a
 *      grammar that is matched over tokens needs something to have made them.
 *   3. Names are hyphenated. Wirth writes `unsigned integer`, with a space,
 *      which cannot be told from two names in a row.
 *
 * Simplified on purpose, and each of these is a place a real compiler differs:
 * a formal parameter section takes only `var`, not procedural parameters; a
 * conformant array is not here; and `forward` is treated as a reserved word
 * rather than as the directive it technically is.
 *)

(* ------------------------------------------------------------------ *)
(* The lexical half: characters to tokens.                            *)

(* Helpers, not tokens. Without this line `T` comes out as a `letter`: both
 * rules match it, longest match ties are broken by declaration order, and
 * `letter` is declared first. *)
%fragment letter digit .

letter = "a" .. "z" .
digit  = "0" .. "9" .

identifier = letter { letter | digit } .

(* Longest match across rules settles `3` against `3.14` without either rule
 * knowing about the other. It does not settle `3..5`: this rule requires a
 * digit after the point, so it fails on `3..` and `integer-number` takes the
 * `3`, leaving `..` to `symbol`. *)
real-number = digit { digit }
              ( "." digit { digit } [ "e" [ "+" | "-" ] digit { digit } ]
              | "e" [ "+" | "-" ] digit { digit } ) .

integer-number = digit { digit } .

(* A doubled quote is an escaped quote, so it has to be tried first. *)
string = "'" { "''" | ! "'" } "'" .                          (* order *)

comment = "{" { ! "}" } "}"
        | "(*" { ! "*)" } "*)" .

space = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .

(* Ordered choice inside one rule, so every two-character symbol must come
 * before the character it starts with. `.` before `..` would mean the tool
 * never saw a subrange. *)
symbol = ":=" | "<=" | ">=" | "<>" | ".."                    (* order *)
       | "+" | "-" | "*" | "/" | "=" | "<" | ">"
       | "(" | ")" | "[" | "]" | "," | ";" | ":" | "." | "^" | "@" .

%skip space comment .

(* ------------------------------------------------------------------ *)
(* The syntactic half: tokens to a program.                           *)
(*                                                                     *)
(* Every word-shaped literal below is a reserved word, worked out from *)
(* this half of the file rather than declared -- so `begin` cannot be  *)
(* used as a variable, and nothing here had to say so.                 *)

%syntax .
%ignorecase .
%start program .

(* ------------------------------------------------------------------ *)
(* Three habits run through everything below, and each was learned by   *)
(* getting it wrong on this grammar first.                              *)
(*                                                                     *)
(* **A separator has to be dropped where it is matched.** `{ "," name }` *)
(* answers *everything* it matched, commas included, so the repetition   *)
(* carries an action -- `{ "," n:name -> $n }` -- and the list comes out *)
(* holding names.                                                       *)
(*                                                                     *)
(* **An empty alternative beats an option** for a part that may be       *)
(* absent. `[ constant-part ]` answers a list of nought or one *lists*,  *)
(* which a pass then has to unwrap; a rule with an empty alternative     *)
(* answers a list either way, and `Block` holds declarations rather than *)
(* a box containing declarations.                                       *)
(*                                                                     *)
(* **A node that is nearly always empty is not worth having.**           *)
(* `[ "+" | "-" ] ... -> Signed(sign: $1, ...)` wraps every expression   *)
(* in the program in a `Signed` holding no sign. Written as two          *)
(* alternatives, a `Signed` appears only where one was written, and      *)
(* means something wherever a pass finds it.                            *)

program = "program" n:identifier p:program-parameters ";" b:block "."
        -> Program(name: $n, params: $p, body: $b) .

program-parameters = "(" i:identifier { "," n:identifier -> $n } ")" -> [$i, ...$3]
                   | -> [] .

block = l:label-part c:constant-part t:type-part v:variable-part
        r:{ procedure-or-function } b:compound-statement
      -> Block(labels: $l, consts: $c, types: $t, vars: $v,
               routines: $r, body: $b) .

label-part    = "label" i:integer-number { "," n:integer-number -> $n } ";"
                  -> [$i, ...$3]
              | -> [] .
constant-part = "const" d:constant-definition ";"
                { e:constant-definition ";" -> $e } -> [$d, ...$4]
              | -> [] .
type-part     = "type" d:type-definition ";"
                { e:type-definition ";" -> $e } -> [$d, ...$4]
              | -> [] .
variable-part = "var" d:variable-declaration ";"
                { e:variable-declaration ";" -> $e } -> [$d, ...$4]
              | -> [] .

constant-definition  = n:identifier "=" v:constant -> ConstDef(name: $n, value: $v) .
type-definition      = n:identifier "=" t:type     -> TypeDef(name: $n, type: $t) .
variable-declaration = i:identifier { "," n:identifier -> $n } ":" t:type
                     -> VarDecl(names: [$i, ...$2], type: $t) .

(* A signed *constant* is not a signed *expression*: this one is only ever a
 * number or a named constant, and `symbols` asks it what type it is. Sharing
 * `Signed` with `simple-expression` meant asking a `Variable` the same
 * question, which it cannot answer. *)
constant = s:( "+" | "-" ) v:unsigned-constant                          (* order *)
             -> SignedConstant(sign: $s, value: $v)
         | unsigned-constant .

unsigned-constant = real-number     -> Real(text: $1)                  (* order *)
                  | integer-number  -> Integer(text: $1)
                  | string          -> Text(value: $1)
                  | "nil"           -> Nil
                  | identifier      -> NamedConstant(name: $1) .

(* ---- types ---- *)

type = structured-type | pointer-type | simple-type .

pointer-type = "^" t:identifier -> Pointer(to: $t) .

(* `packed` asks for a representation the machine does not let a program
 * choose, and is read and ignored -- but the node exists where it was
 * written, so a pass can say it was ignored instead of pretending it was
 * never there. *)
structured-type = "packed" t:unpacked-type -> Packed(type: $t)
                | unpacked-type .

unpacked-type = array-type | record-type | set-type | file-type .

array-type  = "array" "[" i:simple-type { "," s:simple-type -> $s } "]" "of" t:type
            -> ArrayType(indices: [$i, ...$4], of: $t) .
record-type = "record" f:field-list "end" -> RecordType(fields: $f) .
set-type    = "set" "of" t:simple-type    -> SetType(of: $t) .
file-type   = "file" "of" t:type          -> FileType(of: $t) .

field-list     = r:record-section { ";" s:record-section -> $s } [ ";" ] -> [$r, ...$2]
               | -> [] .
record-section = i:identifier { "," n:identifier -> $n } ":" t:type
               -> FieldDecl(names: [$i, ...$2], type: $t) .

(* A subrange begins with a constant and so does a plain type name; the one
 * that goes on to want `..` has to be asked first. *)
simple-type = enumerated-type | subrange-type | named-type .          (* order *)

named-type      = n:identifier -> NamedType(name: $n) .
enumerated-type = "(" i:identifier { "," n:identifier -> $n } ")"
                -> EnumType(names: [$i, ...$3]) .
subrange-type   = lo:constant ".." hi:constant -> Subrange(low: $lo, high: $hi) .

(* ---- statements ---- *)

compound-statement = "begin" s:statement { ";" t:statement -> $t } "end"
                   -> Compound(body: [$s, ...$3]) .

statement = l:integer-number ":" s:any-statement -> Labelled(label: $l, do: $s)
          | any-statement .

any-statement = structured-statement | simple-statement .

simple-statement = assignment | goto-statement | procedure-statement | empty .
empty = -> Empty .

assignment          = t:variable ":=" v:expression -> Assign(target: $t, value: $v) .
goto-statement      = "goto" l:integer-number      -> Goto(label: $l) .
procedure-statement = n:identifier a:arguments     -> CallStatement(name: $n, args: $a) .

arguments = "(" a:actual-parameter { "," b:actual-parameter -> $b } ")" -> [$a, ...$3]
          | -> [] .

structured-statement = compound-statement | if-statement | case-statement
                     | while-statement | repeat-statement | for-statement
                     | with-statement .

if-statement     = "if" c:expression "then" t:statement "else" f:statement
                     -> IfElse(cond: $c, then: $t, else: $f)                (* order *)
                 | "if" c:expression "then" t:statement
                     -> If(cond: $c, then: $t) .

case-statement   = "case" v:expression "of" e:case-element
                   { ";" f:case-element -> $f } [ ";" ] "end"
                 -> Case(value: $v, elements: [$e, ...$5]) .

case-element     = c:constant { "," d:constant -> $d } ":" s:statement
                     -> CaseOf(values: [$c, ...$2], do: $s)
                 | -> Empty .

while-statement  = "while" c:expression "do" b:statement -> While(cond: $c, body: $b) .

repeat-statement = "repeat" s:statement { ";" t:statement -> $t } "until" c:expression
                 -> Repeat(body: [$s, ...$3], until: $c) .

for-statement    = "for" v:identifier ":=" f:expression d:( "to" | "downto" )
                   t:expression "do" b:statement
                 -> For(var: $v, from: $f, dir: $d, to: $t, body: $b) .

with-statement   = "with" v:variable { "," w:variable -> $w } "do" b:statement
                 -> With(vars: [$v, ...$3], body: $b) .

(* ---- expressions ---- *)

expression = simple-expression [ o:relational-operator s:simple-expression
                                 -> Compare(op: $o, left: $$, right: $s) ] .

(* Two characters before one, again -- `<` first would leave the `=` of `<=`
 * behind, and the error would appear at the token after it. *)
relational-operator = "<=" | ">=" | "<>" | "=" | "<" | ">" | "in" .   (* order *)

(* The leading sign is Wirth's and applies to the whole of what follows, so it
 * wraps the sum. **The sum needs a rule of its own**: `$$` is what the
 * enclosing sequence built last, so a fold and the value it folds onto must be
 * in one list -- and they are not, once the enclosing alternative builds
 * something of its own. Phoenix refuses the one-rule version when it reads it,
 * with that explanation. *)
simple-expression = s:( "+" | "-" ) x:sum -> Signed(sign: $s, value: $x)
                  | sum .

sum = term { o:adding-operator t:term -> Binary(op: $o, left: $$, right: $t) } .
adding-operator = "+" | "-" | "or" .

term = factor { o:multiplying-operator f:factor -> Binary(op: $o, left: $$, right: $f) } .
multiplying-operator = "*" | "/" | "div" | "mod" | "and" .

(* A function call and a variable both begin with an identifier, and the call
 * is the longer of the two. *)
factor = unsigned-constant-not-name                                       (* order *)
       | function-designator
       | variable
       | "(" e:expression ")" -> $e
       | "not" f:factor       -> Not(value: $f)
       | set-constructor .

(* `identifier` is left out here: in an expression a bare name is a variable,
 * and `unsigned-constant`'s last alternative would take it first. *)
unsigned-constant-not-name = real-number    -> Real(text: $1)             (* order *)
                           | integer-number -> Integer(text: $1)
                           | string         -> Text(value: $1)
                           | "nil"          -> Nil .

function-designator = n:identifier "(" a:actual-parameter
                      { "," b:actual-parameter -> $b } ")"
                    -> CallExpression(name: $n, args: [$a, ...$4]) .

set-constructor = "[" e:element { "," f:element -> $f } "]" -> SetOf(elements: [$e, ...$3])
                | "[" "]" -> SetOf(elements: []) .

(* A member and a range are two things, and a set constructor has to be able
 * to ask which: one is a single bit and the other is a run of them. Written
 * as `Range | expression` the plain case had no node of its own, so the set
 * shifted a range that was already a mask. *)
element = lo:expression ".." hi:expression -> Range(low: $lo, high: $hi)  (* order *)
        | e:expression                     -> Member(value: $e) .

(* A variable is a name, and then possibly ways of reaching into it.
 *
 * **Two node types rather than one with a list that is usually empty** -- the
 * same lesson as `Labelled`, learned again for a different reason. A pass that
 * wants to treat `x` differently from `x[i].f` has to be able to *ask*, and a
 * pattern can match a node type but not the emptiness of a list. So the
 * grammar makes the distinction it already knows and a clause keys on it. *)
variable = n:identifier a:accessor { b:accessor -> $b }
             -> Accessed(base: $n, access: [$a, ...$3])           (* order *)
         | n:identifier -> Variable(name: $n) .

accessor = "[" e:expression { "," f:expression -> $f } "]" -> Index(at: [$e, ...$3])
         | "." f:identifier                                -> FieldOf(name: $f)
         | "^"                                             -> Deref .

(* `write(x:8:2)` -- the field widths are part of the call syntax, and they
 * belong to the argument rather than to the call. *)
(* Three shapes rather than one with fields that are usually nil: a pattern
 * can tell node types apart and cannot ask whether a field is nil, which is
 * the same lesson `Labelled` and `Accessed` taught. *)
actual-parameter = v:expression ":" w:expression ":" p:expression            (* order *)
                     -> Rounded(value: $v, width: $w, places: $p)
                 | v:expression ":" w:expression
                     -> Padded(value: $v, width: $w)
                 | v:expression
                     -> Argument(value: $v) .

(* ---- procedures and functions ---- *)

procedure-or-function = f:( procedure-declaration | function-declaration ) ";" -> $f .

(* The result type is optional because a function declared `forward` gives its
 * heading once and repeats only the name. Accepting it where it is not needed
 * is the deliberate direction to be wrong in: a checker that rejects a correct
 * file is worse than one that accepts a slightly wider language. *)
procedure-declaration = "procedure" n:identifier p:formal-parameters ";" b:body
                      -> Procedure(name: $n, params: $p, body: $b) .
function-declaration  = "function" n:identifier p:formal-parameters r:returns ";" b:body
                      -> Function(name: $n, params: $p, returns: $r, body: $b) .

(* A node rather than `nil`, because there is no `if` in the notation and a
 * pass reading `$returns.show` should not have to ask first. This is the
 * design working rather than being worked around: where another language
 * would test for absence, this one gives absence a name. *)
returns = ":" t:identifier -> NamedType(name: $t)
        | -> NoType .

body = "forward" -> Forward
     | block .

formal-parameters = "(" s:formal-section { ";" t:formal-section -> $t } ")"
                      -> [$s, ...$3]
                  | -> [] .

(* `var` on a parameter is Pascal saying by reference, and it is the whole of
 * an analysis that another language needs a pass for. *)
formal-section    = "var" i:identifier { "," n:identifier -> $n } ":" t:identifier
                      -> Param(byref: true, names: [$i, ...$3], type: $t)
                  | i:identifier { "," n:identifier -> $n } ":" t:identifier
                      -> Param(byref: false, names: [$i, ...$2], type: $t) .


(* ------------------------------------------------------------------ *)
(* What the names in a program are.                                    *)
(*                                                                     *)
(* A Pascal block declares things and then uses them, and a nested      *)
(* block sees the enclosing one's names as well as its own. That is an  *)
(* **inherited** attribute -- a scope is handed down and restored on the *)
(* way back out -- and an inherited clause runs on the way *in*, before  *)
(* this node's children have been looked at.                            *)
(*                                                                     *)
(* So a block cannot both gather its declarations and hand them down in  *)
(* one pass: gathering is bottom-up and handing down is top-down. It     *)
(* takes two passes, and that is not a workaround -- collect, then use,  *)
(* is how a hand-written compiler does it too, and it is what `%driver`  *)
(* exists to write down.                                                *)

%pass symbols

  (* A type, named. Structural checking of records and arrays is not here:
   * these names are what a later pass compares, so `Small` and `integer`
   * being both "integer" is the whole of what makes a subrange assignable. *)
(* Both of a node's clauses go in one rule: clauses are tried in order and
   * the first match wins, so a second `NamedType` rule further down would
   * never be reached, and Phoenix refuses one.
   *
   * `entries` is what a type *declares* beyond itself, which is nothing for
   * all of these but an enumeration -- and `TypeDef` reads it from whatever
   * type it was given, so every one of them has to answer. *)
  (* `low` is where an index into a value of this type starts. A named type
   * answers with its own name, so that one more lookup in the table resolves
   * it -- which is what lets `Vector = array [Small] of integer` find what
   * `Small` starts at. *)
  NamedType : tname = $name     : entries = [] : iname = $name : startsat = $name : span = 0 .
  NoType    : tname = "void"    : entries = [] : iname = "" : startsat = "1" : span = 0 .
  Subrange  : tname = "integer" : entries = [] : iname = "" : startsat = $low.ctext : span = $high.num - $low.num + 1 .
  ArrayType : tname = "array"   : entries = [] : iname = "" : startsat = at($indices, 1).startsat : span = 0 .
  RecordType: tname = "record"  : entries = [] : iname = "" : startsat = "1" : span = 0 .
  SetType   : tname = "set"     : entries = [] : iname = "" : startsat = "1" : span = 0 .
  FileType  : tname = "file"    : entries = [] : iname = "" : startsat = "1" : span = 0 .
  Pointer   : tname = "pointer" : entries = [] : iname = "" : startsat = "1" : span = 0 .

  EnumType  : tname = "integer" : entries = bind([], $names, "integer") : iname = "" : startsat = "0" : span = size($names) .
  Packed    : tname = $type.tname : entries = $type.entries : iname = "" : startsat = $type.startsat : span = $type.span .

  (* A Pascal string literal arrives with its quotes on and its doubled
   * quotes undoubled. `plain` is what it actually says, and **a literal
   * saying one character is a `char`, not a string** -- `c := 'a'` is an
   * ordinary assignment and the first version of this called it a type
   * error. *)
  Text          : plain = join(split(slice($value, 2, size($value) - 1), "''"), "'")
                : ctype = lookup([[1, "char"]], size($plain), "string")
                : ctext = "0" : num = 0 .

  (* A constant as C would write it. `symbols` can do this because a Pascal
   * constant is a literal or a name and C spells both the same way -- which
   * matters, because an array's lower bound has to be known here and used
   * in `emit-c`, two passes later. *)
  (* Constants as numbers, so that a set can be asked how many members it
   * would need. A named constant answers nought, meaning *unknown*, and the
   * check below does not fire on an unknown. *)
  Integer       : ctype = "integer" : ctext = $text : num = int($text) .
  Real          : ctype = "real" : ctext = $text : num = 0 .
  Nil           : ctype = "pointer" : ctext = "0" : num = 0 .
  NamedConstant : ctype = "integer" : ctext = $name : num = 0 .
  SignedConstant(sign: "-") : ctype = $value.ctype
                            : ctext = "(-{})" of $value.ctext
                            : num   = 0 - $value.num .
  SignedConstant            : ctype = $value.ctype
                            : ctext = "(+{})" of $value.ctext
                            : num   = $value.num .

  (* Two things per declaration, in one rule because clauses for one pattern
   * cannot be split across two: `entries` binds a name to its type's *name*,
   * which is what type checking compares, and `shape` binds it to the type
   * *node*, which is what following a record's fields needs. *)
  ConstDef  : entries = bind([], $name, $value.ctype)
            : shape   = [] .
  TypeDef   : entries = flatten([bind([], $name, $type.tname), $type.entries])
            : lowentry  = bind([], $name, $type.startsat)
            : spanentry = bind([], $name, $type.span)
            : shape   = bind([], $name, Shape(iname: $type.iname,
                                              startsat: $type.startsat, node: $type)) .
  VarDecl   : entries = bind([], $names, $type.tname)
            : shape   = bind([], $names, Shape(iname: $type.iname,
                                               startsat: $type.startsat, node: $type)) .
  Param     : entries = bind([], $names, $type)
            : shape   = bind([], $names, Shape(iname: $type, startsat: "1",
                                               node: NamedType(name: $type))) .
  FieldDecl : entries = bind([], $names, $type.tname)
            : shape   = bind([], $names, Shape(iname: $type.iname,
                                               startsat: $type.startsat, node: $type)) .



  (* ---- names bound to *nodes* rather than to type names ----
   *
   * A value in this notation can be a node, and reading `.field` of one works
   * wherever the value came from. So an environment binding a name to the
   * thing it was declared as is already expressible, and a pass can follow it:
   * `origin` to its `NamedType`, that to `Point`, `Point` to its `RecordType`,
   * and that to the fields.
   *
   * **Every one of those steps points backwards** -- at a node the walk has
   * already visited and finished with -- which is why this needs nothing that
   * was not already here. *)
  (* A routine binds its name to its **parameter list**, so that a heading
   * repeated after a `forward` can find the parameters it is repeating. That
   * declaration comes earlier in the same list, and `lookup` answers the first
   * match, so the forward one is what a repeat finds. *)
  Procedure : entries = bind([], $name, "void")
            : shape   = bind([], $name, Shape(iname: "", startsat: "1", node: $params))
            : own     = flatten([...$params.entries]) .
  Function  : entries = bind([], $name, $returns.tname)
            : shape   = bind([], $name, Shape(iname: "", startsat: "1", node: $params))
            : own     = flatten([bind([], $name, $returns.tname),
                                 ...$params.entries]) .

  (* Everything a block declares, in one list. `[...$vars.entries]` opens one
   * level and leaves a list of lists, because each declaration names several
   * things -- `flatten` is what there is no way to write in the notation. *)
  Block : scope = flatten([...$consts.entries, ...$types.entries,
                           ...$vars.entries, ...$routines.entries])
        : shapes = flatten([...$consts.shape, ...$types.shape,
                            ...$vars.shape, ...$routines.shape])

        (* Type names to where their indices start, so that `a : Low` can be
         * asked what `Low` starts at. *)
        : lowmap  = flatten([...$types.lowentry])
        : spanmap = flatten([...$types.spanentry]) .

(* ------------------------------------------------------------------ *)
(* Are the names declared, and do the types line up?                   *)

%pass typecheck

  (* The scope a program starts in. Written out rather than built in, so that
   * what Phoenix considers standard Pascal is readable and arguable. *)
  (* `with origin do ... x ...` opens a record's fields into scope, and
   * knowing which fields those are means knowing the *structure* of `Point`,
   * not just that `origin` is one. This table maps a name to a type's name
   * and stops there.
   *
   * So inside a `with`, names are not checked. That is the honest version of
   * the limit: a checker that invented an error on a correct program would be
   * worse than one that says nothing, and this says nothing exactly where it
   * does not know. Making it know is a table that carries structures, and it
   * is written down in the roadmap rather than guessed at here. *)
  Program : type = "void"
          : down known = []
          : down lows  = []
          : down spans = []
          : down checking = true
          : down env =
      (* A base type is bound to **itself**, so that resolving an alias is
       * one lookup more and resolving a base type is a fixed point. `Small`
       * answers `integer` and `integer` answers `integer`, and neither needs
       * to be asked which of the two it was. *)
      [["integer","integer"], ["real","real"], ["boolean","boolean"],
       ["char","char"], ["text","text"],
       ["array","array"], ["record","record"], ["set","set"],
       ["file","file"], ["pointer","pointer"], ["string","string"],
       ["void","void"], ["unknown","unknown"],
       ["true","boolean"], ["false","boolean"], ["maxint","integer"],
       ["input","file"], ["output","file"],
       ["write","void"], ["writeln","void"], ["read","void"], ["readln","void"],
       ["abs","integer"], ["sqr","integer"], ["odd","boolean"],
       ["ord","integer"], ["chr","char"], ["succ","integer"], ["pred","integer"],
       ["round","integer"], ["trunc","integer"],
       ["sqrt","real"], ["sin","real"], ["cos","real"],
       ["ln","real"], ["exp","real"], ["arctan","real"],
       ["eof","boolean"], ["eoln","boolean"],
       ["new","void"], ["dispose","void"]] .

  (* `$scope` was worked out by the pass before this one, so it is on the node
   * already and can be read on the way *in* -- which is the whole reason there
   * are two passes rather than one. *)
  (* `shapes` is what this block declares, worked out by the pass before.
   * `known` is everything visible here, handed down. Two names, because they
   * are two things -- Phoenix warns when one pass overwrites another's
   * attribute, and it was right to. *)
  Block     : type = "void"
            : down lows  = [...$lowmap, ...$lows]
            : down spans = [...$spanmap, ...$spans]
            : down env   = [...$scope, ...$env]
            : down known = [...$shapes, ...$known] .
  Procedure : type = "void" : down env = [...$own, ...$env] .

  (* `function Area;` after a `function Area(r : real) : real; forward;` --
   * the heading is repeated and the parameters belong to the declaration it
   * repeats. A function with no result type can only be that, so the pattern
   * is exact.
   *
   * **Finding the earlier declaration is a reference to another node**, which
   * is what this design cannot do: an attribute is computed in one walk and
   * cannot reach sideways. So names are not checked in here, and the env is
   * left alone -- the forward declaration's binding is already in the block's
   * scope, and shadowing it with this heading's empty one is what produced
   * `cannot assign real to void`.
   *
   * The roadmap says what would fix it: [2.1], reference attributes, which
   * this is now the first real argument for rather than a speculation. *)
(* `function Area;` after `function Area(r : real) : real; forward;` --
   * the heading is repeated, and its parameters belong to the declaration it
   * repeats. A function with no result type can only be that, so the pattern
   * is exact.
   *
   * The earlier declaration bound its name to its parameter list, and it is
   * earlier in the same list, so `lookup` finds it. **A backward reference,
   * which the walk has already finished with** -- which is why this needs
   * nothing beyond what was here.
   *
   * The env is otherwise left alone: the forward declaration's `Area -> real`
   * is already in the block's scope, and shadowing it with this heading's
   * empty result type is what produced `cannot assign real to void`. *)
  Function(returns: NoType)
            : type = "void"
            : down env = [...flatten([...lookup($known, $name,
                                                Shape(iname: "", startsat: "1",
                                                      node: [])).node.entries]),
                          ...$env] .
  Function  : type = "void" : down env = [...$own, ...$env] .

  (* Two lookups: the first answers the type this name was declared with, the
   * second resolves an alias to what it stands for. A base type answers
   * itself, so the second lookup is harmless where there was no alias. *)
  Variable : type = lookup($env, lookup($env, $name, "unknown"), "unknown")
           ! $checking and not defined($env, $name)
             : "'{}' is not declared" of $name .

  (* Reaching into something -- an index, a field, a dereference -- takes the
   * checker past what a name can say, so the type is unknown from here down
   * and comparisons against it pass. Being quiet is right: a checker that
   * invents an error on a correct program is worse than one that misses. *)
(* **Where this array's indices start.** Pascal indexes from wherever the
   * declaration says, and C from nought, so every index has its lower bound
   * subtracted -- and getting that wrong is not a wrong answer but memory
   * written outside the array. `array [5..9]` with one subtracted writes past
   * the end and reads it back consistently, which is how the oracle agreed
   * with itself while the program was corrupting memory.
   *
   * Two hops: the variable to its type, and a named type to what it stands
   * for. `iname` is "" for a type written out, which no scope binds, so the
   * lookup falls through to that type's own answer. *)
  Accessed : low1 =
        lookup($lows,
               lookup($known, $base,
                      Shape(iname: "", startsat: "1", node: NoType)).iname,
               lookup($known, $base,
                      Shape(iname: "", startsat: "1", node: NoType)).startsat)

           (* Twice, because a named type answers with its name: `Vector`
            * answers `Small` and `Small` answers `1`. A number answers
            * itself, since no type is called `5`. *)
           : lowbound = lookup($lows, $low1, $low1)
           : type = "unknown"
           ! $checking and not defined($env, $base)
             : "'{}' is not declared" of $base .

  Integer       : type = "integer" .
  Real          : type = "real" .
  Text          : type = lookup([[1, "char"]], size($plain), "string") .
  Nil           : type = "pointer" .
  NamedConstant : type = lookup($env, lookup($env, $name, "unknown"), "unknown") .
  Signed         : type = $value.type .
  SignedConstant : type = $value.type .
  SetOf         : type = "set" .
  Range         : type = "integer" .
  Member        : type = $value.type .
  Not           : type = "boolean" .
(* The standard functions whose result depends on the argument rather than
   * on the name. Everything else is in the table `Program` hands down. *)
  CallExpression(name: "succ") : type = at($args, 1).type .
  CallExpression(name: "pred") : type = at($args, 1).type .
  CallExpression(name: "abs")  : type = at($args, 1).type .
  CallExpression(name: "sqr")  : type = at($args, 1).type .

  CallExpression: type = lookup($env, lookup($env, $name, "unknown"), "unknown")
                ! $checking and not defined($env, $name)
                  : "'{}' is not declared" of $name .
  Argument : type = $value.type .
  Padded   : type = $value.type .
  Rounded  : type = $value.type .

  (* An array's index range, resolved. It is written out (`array [1..30]`) or
   * named (`array [Small]`), and only this pass has the scope to follow the
   * name -- so it finds the subrange and `emit-c` reads it off the node.
   * `iname` is "" for a range written out, which no scope binds, so the
   * lookup falls through to the range itself. *)
  (* The index range, resolved: written out (`array [1..30]`) or named
   * (`array [Small]`). The table holds a `Shape` around each type, so the
   * default wraps the index itself and both sides answer `.node`. *)
  ArrayType : type = "void"
            : bound = lookup($known, at($indices, 1).iname,
                             Shape(iname: "", startsat: "1",
                                   node: at($indices, 1))).node .

  (* What a parameter's declared type turns out to *be* -- "array", "record",
   * "integer" and so on. Only this pass can answer it, because only this pass
   * has the scope; `emit-c` runs later and reads it off the node. *)
(* A node built inside a clause has **fields but no attributes** -- a pass
   * puts attributes on the nodes it walks, and one made here was never walked.
   * So the default of a lookup cannot be `NamedType(name: "?")` and then be
   * asked for its `tname`.
   *
   * It does not need to be: `env` already maps a name to its type's *name*,
   * which is what this wants. *)
  Param    : type = "void"
           : shapeof = lookup($env, $type, "?") .

  Compare  : type = "boolean" .
  Binary(op: "/")   : type = "real" .
  Binary(op: "div") : type = "integer" .
  Binary(op: "mod") : type = "integer" .
  Binary(op: "and") : type = "boolean" .
  Binary(op: "or")  : type = "boolean" .
  Binary            : type = $left.type .

(* Written out rather than put in the library, because it *can* be written
   * out. A checker's rule about what may be assigned to what is the thing a
   * language description is for saying, and moving it into Phoenix would make
   * it Phoenix's opinion about Pascal.
   *
   * `unknown` on either side passes: it is what reaching into an array or a
   * record answers, and a checker that invented an error there would be worse
   * than one that says nothing. Integer to real is Pascal's one widening. *)
  Assign   : type = "void"
           ! not ($target.type = $value.type
                  or $target.type = "unknown" or $value.type = "unknown"
                  or ($target.type = "real" and $value.type = "integer"))
             : "cannot assign {} to {}" of $value.type, $target.type .

  If       : type = "void"
           ! not ($cond.type = "boolean" or $cond.type = "unknown")
             : "an if wants a boolean, and this is {}" of $cond.type .
  IfElse   : type = "void"
           ! not ($cond.type = "boolean" or $cond.type = "unknown")
             : "an if wants a boolean, and this is {}" of $cond.type .
  While    : type = "void"
           ! not ($cond.type = "boolean" or $cond.type = "unknown")
             : "a while wants a boolean, and this is {}" of $cond.type .
  Repeat   : type = "void"
           ! not ($until.type = "boolean" or $until.type = "unknown")
             : "an until wants a boolean, and this is {}" of $until.type .
  For      : type = "void"
           ! $checking and not defined($env, $var)
                  : "'{}' is not declared" of $var .

  CallStatement : type = "void"
                ! $checking and not defined($env, $name)
                  : "'{}' is not declared" of $name .

  (* Everything else a walk reaches, so that a node above it can read a type
   * without asking which kind of statement it was. *)
  Goto     : type = "void" .
  Labelled : type = "void" .
  Empty    : type = "void" .
  Compound : type = "void" .
  Case     : type = "void" .
  CaseOf   : type = "void" .
  (* `with origin do ... x ...` -- the fields of `origin`'s record come into
   * scope, and finding them is three lookups through nodes:
   *
   *     origin  ->  NamedType(name: "Point")   the variable's declared type
   *     "Point" ->  RecordType(fields: [...])  what that type is
   *     fields  ->  the entries `symbols` left on each FieldDecl
   *
   * All three point backwards, at nodes the walk has already finished with.
   * That is why this needs nothing that was not already here.
   *
   * Only the first of `with a, b do` is followed: taking all of them is a
   * fold, and there is no fold in the notation. *)
  With     : type = "void"

           (* The names the `with` brought into scope, left on the node for a
            * later pass. This is computed on the way *out*, where the `down`
            * clause below runs on the way in -- so the two say the chain
            * twice rather than sharing it, which is the price of one walk
            * having two phases. *)
           : fields = flatten([...lookup($known,
                                         lookup($known, at($vars, 1).name,
                                                Shape(iname: "?", startsat: "1",
                                                      node: NoType)).iname,
                                         Shape(iname: "", startsat: "1",
                                               node: RecordType(fields: []))
                                       ).node.fields.names])

           : down env = [...flatten([...lookup($known,
                                              lookup($known, at($vars, 1).name,
                                                     Shape(iname: "?", startsat: "1",
                                                           node: NoType)).iname,
                                              Shape(iname: "", startsat: "1",
                                                    node: RecordType(fields: []))
                                            ).node.fields.entries]),
                         ...$env]

           (* The fields' *shapes* as well as their types, so that a `with`
            * inside a `with` can find the record a field names. `with o do
            * with p do ...` needs `p`'s type, and `p` is only in scope
            * because the outer one put it there. *)
           : down known = [...flatten([...lookup($known,
                                                 lookup($known, at($vars, 1).name,
                                                        Shape(iname: "?", startsat: "1",
                                                              node: NoType)).iname,
                                                 Shape(iname: "", startsat: "1",
                                                       node: RecordType(fields: []))
                                               ).node.fields.shape]),
                           ...$known] .
  Forward  : type = "void" .

(* Analysis alone, with nothing asked of it but an answer about whether the
 * program is sound. A driver with no `->` prints nothing and says what it has
 * to say with its exit status. *)

%driver check = symbols, typecheck .
