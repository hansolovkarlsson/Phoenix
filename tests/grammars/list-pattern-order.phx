(* The ordering hazard, one level in: a list of two binders takes every list of
 * two, so a list of two literals below it never runs. *)
%fragment digit .
digit  = "0" .. "9" .
number = digit { digit } .
comma  = "," .
space  = " " { " " } .
%skip space .
%syntax .
%start line .
line = number { "," number -> $2 } -> Row(cells: [$1, ...$2]) .

%pass p
  Row(cells: [a, b])     : out = "any two" .
  Row(cells: ["1", "2"]) : out = "one two" .
