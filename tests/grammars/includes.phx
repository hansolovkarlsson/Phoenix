(* A language with an include, and nothing else in it.
 *
 * `%include` names the node one is built as and the field holding the file --
 * two names, and what happens then is fixed: the file is read with this same
 * grammar and its items take the include's place, before any pass walks
 * anything. `show` below has a clause for `Use` all the same, because
 * `--no-includes` is a question about one file's own text and that is the
 * shape it answers in.
 *)
%fragment letter digit .
letter = "a" .. "z" .
digit  = "0" .. "9" .
name   = letter { letter | digit } .
number = digit { digit } .
string = "\"" { ! "\"" } "\"" .
space  = ( " " | "\t" | "\r" | "\n" ) { " " | "\t" | "\r" | "\n" } .
punct  = ";" | "=" .
%skip space .

%syntax .
%start file .

file = { item } -> File(items: $1) .
item = use | let .

(* The quotes come off here: how a language spells a string is a thing only
 * its own description knows, so `path` is the file name and nothing else. *)
use  = "use" p:string ";" -> Use(path: slice($p, 2, size($p) - 1)) .
let  = n:name "=" v:number ";" -> Let(name: $n, value: $v) .

%include Use path .

%pass show
  File : show = join($items.show, " ") .
  Let  : show = "{}={}" of $name, $value .
  Use  : show = "use {}" of $path .

(* Where each thing came from -- the same list, said by position rather than
 * by content, which is what a line table in a binary format is.
 *
 * `$pos` answers a node, so `.file`, `.line` and `.column` are ordinary field
 * reads, and `.` over a list already means "that of each" -- so a table with a
 * row per item is written the way every other list is. *)
%pass where
  File : where = join(each($items.pos.file, $items.pos.line, "{}:{} "), "")
       : cols  = join(each($items.pos.column, "{} "), "") .

(* `sizes` and `bytes` over a list: the size of each element of a list, and a
 * column of numbers each as fixed-width bytes. A table in a binary format is a
 * column, and without these the only way to write one was the same line of
 * notation once per node type that could be a row. *)
%pass widths
  File : widths = join(each(bytes(sizes($items.show), 2), "{}"), "") .

%driver show = show -> show .
%driver where   = where -> where .
%driver columns = where -> cols .
%driver widths  = show, widths -> widths .
