(* `%names` binding a field the action computes rather than takes from a
 * factor: there is no moment in the match at which to bind it. *)
%fragment letter .
letter = "a" .. "z" .
name   = letter { letter } .
symbol = ";" .
space  = " " { " " } .
%skip space .
%syntax .
%start program .
program = { statement } -> Program(body: $1) .
statement = "type" n:name ";" -> Type(name: text($n))
          | t:type-name n:name ";" -> Var(type: $t, name: $n) .
type-name = name .

%names types declare Type.name guard type-name .
