(* A default reading an inherited attribute where a node has a field of its
 * name.
 *
 * `p` hands `tag` down from the root, and its default reads `$tag` at every
 * node. At a `W` that is the field, the word, and not what was handed down,
 * so the line printed is the words where "root" was meant. The shape is
 * `languages/units/`'s on 2026-10-10, whose `order` pass handed its uses
 * table down as `uses` past three node types with a field `uses`.
 *
 * `q` is the same pass with a rule that answers `seen` at `W` itself, so its
 * default never runs where the field is, and it is not warned about. The
 * suite counts one warning.
 *)
%fragment letter .
letter = "a" .. "z" .
word   = letter { letter } .
space  = " " { " " } .
%skip space .

%syntax .
%start line .
line = { w:word -> W(tag: $w) } -> L(items: $1) .

%pass p
  L : down tag = "root"
    : out = "{}\n" of join($items.seen, ",")
  otherwise seen = $tag .

%pass q
  L : down tag = "root"
    : out = "{}\n" of join($items.seen, ",")
  W : seen = "word"
  otherwise seen = $tag .

%driver d = p -> out .
