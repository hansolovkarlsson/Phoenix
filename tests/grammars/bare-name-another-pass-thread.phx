(* `count` threads `n`, and `show` reads it bare. A thread lives only in the
 * walk of the pass that declares it, so no later pass can see it. The C
 * `types` pass did this with a `locals` thread on 2026-09-22. *)
%import "lexical.phx" .
%skip space .
%syntax .
%start line .

line = a:atom b:atom -> Pair(left: $a, right: $b) .
atom = integer       -> N(text: $1) .

%pass count
  thread n = 0
  N    : n = $n + 1 .
  Pair : total = $n .

%pass show
  N    : show = "{}#{}" of $text, $n .
  Pair : show = "{} {}" of $left.show, $right.show .

%driver run = count, show -> show .
