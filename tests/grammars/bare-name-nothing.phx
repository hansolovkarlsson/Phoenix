(* `show` reads `$sig`, which no binding, field, pass or embed could ever be.
 * Until 2026-09-23 this read cleanly and was reported once per `N` a program
 * reached, or never. *)
%import "lexical.phx" .
%skip space .
%syntax .
%start line .

line = a:atom b:atom -> Pair(left: $a, right: $b) .
atom = integer       -> N(text: $1) .

%pass show
  N    : show = "{}{}" of $text, $sig .
  Pair : show = "{} {}" of $left.show, $right.show .

%driver run = show -> show .
