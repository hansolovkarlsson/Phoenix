(* solvm-sob.phx -- the assembler: SolVM assembly to `.sob` bytecode.
 *
 *   phx --raw languages/solvm/solvm-sob.phx prog.sasm > prog.sob
 *   solvm prog.sob
 *
 * **This file is only the two passes that make bytes.** The grammar, the tree
 * and the checks that are about the program rather than about the format are
 * in `solvm.phx` and are imported.
 *
 * ---------------------------------------------------------------------------
 * Why an assembler is two passes and cannot be one
 *
 * A jump names a label, and a label is very often *below* the jump. Nothing in
 * a walk can look ahead, so the address of every instruction is worked out in
 * one pass and the offsets are resolved in the next.
 *
 * `layout` threads a byte counter, interns the side tables, and gathers the
 * label table. `sob` takes that table back *down* and writes the bytes.
 *
 * **A third pair of passes is imported rather than written here.** A slot may
 * be named instead of numbered, and the script's frame is declared by a
 * `.slots` that is a sibling of the instructions using it -- the same
 * declared-below-its-use shape, so it wants the same two passes. It is in
 * `solvm.phx` because a name no slot answers to is a mistake in the *program*,
 * which makes it `--driver render`'s business as much as this file's. What
 * arrives here from it is `$slot.num` on every slot operand and `$ownsnames`
 * on every chunk; the drivers at the foot name the order.
 *
 * ---------------------------------------------------------------------------
 * Why the tables are threads and the labels are not
 *
 * A side-table index is assigned **where the name is first seen**, which is a
 * fold over the walk in document order: a thread. A label is used before it is
 * defined, so it cannot be one -- it is gathered on the way up and handed back
 * down. Two mechanisms, because there are two questions.
 *
 * And both nest, because a block is its own chunk with its own tables, its own
 * code and its own addresses. A `down` clause naming a threaded attribute sets
 * the thread for the subtree, which makes the save an ordinary `down`
 * attribute and the restore this node's own leaving clause.
 *
 * ---------------------------------------------------------------------------
 * The format
 *
 * From `solum/include/solum/serialize.h` in the Solveig repository.
 * Little-endian throughout.
 *
 *   header      "SOLB", u16 version, u16 script slot count (at least 1)
 *   names       u32 count, then each: u16 length + bytes
 *   constants   u32 count, then each: u8 tag + payload
 *                                     (0 nil, 1 i64, 2 f64, 3 bool as u8)
 *   code        u32 length, then that many bytes
 *   lines       u32 run count, then each: u32 run length + u32 line
 *   files       u32 count, then each: u16 length + bytes
 *   fileruns    u32 run count, then each: u32 run length + u32 file index
 *   slotnames   u16 count, then each: u16 length + bytes
 *   methods     u32 count, then each: u16 name length + bytes, u16 arity,
 *                                     u16 slot count, u16 flags
 *                                     (1 = block, 2 = captures its home
 *                                     frame), then that method's chunk
 *
 * **The version is an equality, not a floor.** A build reads exactly its own
 * and refuses every other in both directions, so the 14 below is a fact about
 * one release of SolVM rather than a minimum -- and the whole diagnosis on
 * disagreeing is `unsupported bytecode version`. `tests/run.sh` checks it
 * against `SOL_SOB_VERSION` in that header whenever a Solveig checkout is to
 * hand.
 *)

%import "solvm.phx" .

(* ------------------------------------------------------------------ *)
(* Pass one: where does everything sit, and what is in the tables?    *)

%pass layout

  (* The address of the next instruction, **within this chunk**. *)
  thread pc = 0

  (* The names table -- selectors, global names, and the bytes a `string`
   * builds its string from -- and the constants table. Both intern, and
   * interning is a fold over the walk in document order, which is a thread. *)
  thread names     = []
  thread nametext  = ""
  thread consts    = []
  thread consttext = ""

  (* ---- what each instruction costs, in bytes ----
   *
   * `addr` is written before `pc` is advanced, so it reads the value arriving
   * at this node: clauses in a rule run in the order they are written.
   * The lengths are `sol_op_length`'s, which is the one place SolVM writes
   * them down.
   *)

  Nil    : addr = $pc : pc = $pc + 1 .
  Pop    : addr = $pc : pc = $pc + 1 .
  Return : addr = $pc : retend = [$pc + 1] : pc = $pc + 1 .
  Halt   : addr = $pc : haltend = [$pc + 1] : pc = $pc + 1 .

  (* No one-byte bound on a slot here, and it is not an omission. A frame is
   * at most 255 slots, so *past the frame it was declared in* is strictly
   * tighter than *wider than a byte* -- and `slotrefs` in `solvm.phx` checks
   * the first, in an earlier pass. There is no program the byte bound could
   * catch that the frame bound does not, and the frame bound says something
   * useful when it fires. The depth keeps its byte bound below, because
   * nothing bounds a depth more tightly than the nesting does. *)
  Local    : addr = $pc : pc = $pc + 2 .
  SetLocal : addr = $pc : pc = $pc + 2 .

  (* Reading an enclosing frame is what the `CAPTURES` flag records, and the
   * flag is about **this chunk only**. `solas`'s own comment on it: *a nested
   * chunk is not consulted: its depths are counted from its own frame, so
   * whether it reaches past this one is its business, recorded on its own
   * flag.* So a `.block` contributes nothing upward, and the depth is not
   * looked at -- which is `touches_home` in `solas/src/compiler.c`. *)
  Outer    : addr = $pc : pc = $pc + 3
           : outs = [true]
           ! int($depth) > 255
               : "a depth has to fit one byte, and {} does not" of $depth .
  SetOuter : addr = $pc : pc = $pc + 3
           : outs = [true]
           ! int($depth) > 255
               : "a depth has to fit one byte, and {} does not" of $depth .

  Jump      : addr = $pc : pc = $pc + 3 .
  ExitFalse : addr = $pc : pc = $pc + 3 .
  Loop      : addr = $pc : pc = $pc + 3 .
  PushBlock : addr = $pc : pc = $pc + 3 .

  Global    : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .
  SetGlobal : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .
  Str       : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .
  Sym       : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .
  SetSlot   : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .
  CheckBool : addr = $pc : pc = $pc + 3 : nm = [$sel.word] .

  (* `jumpf` carries the selector it was inlined from, so that a non-boolean
   * complains the way the real send would have. *)
  JumpFalse : addr = $pc : pc = $pc + 5 : nm = [$sel.word] .

  Send : addr = $pc : pc = $pc + 4 : nm = [$sel.word]
       ! int($argc) > 255
           : "an argument count has to fit one byte, and {} does not" of $argc .

  Const : addr = $pc : pc = $pc + 3 : kn = [$value.enc] .

  (* The two items that occupy no space: one names an address, the other fills
   * a slot in the methods table. *)
  (* `entry` is the table a jump resolves against; `lname` is the same names
   * without their addresses, because `positions` dedupes whole values and two
   * labels of one name at two addresses are two different pairs. *)
  Label : addr = $pc : entry = [[$name, $pc]] : lname = [$name] .

  (* ---- a constant, as the bytes it will be written as ----
   *
   * The **encoding** is the interning key, so an integer 1 and a float 1.0
   * cannot share an entry: they differ in the tag byte, which is the first
   * thing in the key.
   *)
  IntConst  : enc = "{}{}"
                of bytes(1, 1), bytes(int(slice($text, 2, size($text))), 8) .
  RealConst : enc = "{}{}" of bytes(2, 1), bytes(float($text), 8) .

  (* The three that are spelled rather than written out. A clause, so that a
   * fourth spelling is a diagnosis naming the three there are rather than a
   * syntax error naming a token. *)
  NamedConst : enc = lookup([["#true",  "{}{}" of bytes(3, 1), bytes(1, 1)],
                             ["#false", "{}{}" of bytes(3, 1), bytes(0, 1)],
                             ["#nil",   bytes(0, 1)]], $text, bytes(0, 1))
             ! not defined([["#true", 1], ["#false", 1], ["#nil", 1]], $text)
                 : "no constant is spelled '{}' -- they are #true, #false and #nil" of $text .

  (* A frame is written as a count or as its slots' names; `"0"` is what the
   * grammar leaves in `count` for the second, since a frame of no slots is
   * refused either way. *)
  (* `$n` is the declared size, from `frames`. What stays here are the two
   * bounds the *format* imposes on it. *)
  Slots ! $n < 1
            : "a frame has at least one slot, for the receiver"
        ! $n > 255
            : "a frame reserves at most 255 slots, and this asks for {}" of $n .

  (* ---- interning, said once ----
   *
   * Every instruction that names something contributes a one-element `nm`,
   * and every instruction that does not contributes nothing. What turns that
   * into an index is the six clauses below -- written **once**, because they
   * are about every node rather than about any one opcode, and that is what
   * `otherwise` is for. The alternative is these six lines on each of eight
   * rules.
   *
   * They run in the order written, after the node's own clauses, so `nidx`
   * reads the table as it arrives and the two after it are what change it.
   *)
  otherwise nm      = []
  otherwise kn      = []
  otherwise bdef    = []
  otherwise outs    = []
  otherwise entry   = []
  otherwise lname   = []
  otherwise haltend = []
  otherwise retend  = []

  otherwise iw   = at([...$nm, ""], 1)
  otherwise ik   = at([...$kn, ""], 1)
  otherwise nidx = lookup($names, $iw, size($names))
  otherwise kidx = lookup($consts, $ik, size($consts))
  otherwise nnew = size($nm) > 0 and not defined($names, $iw)
  otherwise knew = size($kn) > 0 and not defined($consts, $ik)

  otherwise names     = lookup([[true, bind($names, $iw, size($names))]],
                               $nnew, $names)
  otherwise nametext  = lookup([[true, "{}{}{}"
                                   of $nametext, bytes(size($iw), 2), $iw]],
                               $nnew, $nametext)
  otherwise consts    = lookup([[true, bind($consts, $ik, size($consts))]],
                               $knew, $consts)
  otherwise consttext = lookup([[true, "{}{}" of $consttext, $ik]],
                               $knew, $consttext)

  (* ---- a block is its own chunk ----
   *
   * Which is what makes every table above nest. A `down` clause naming a
   * threaded attribute sets the thread for the subtree, so the save is an
   * ordinary `down` attribute and the restore is this node's own leaving
   * clause -- which works because a node's scope is torn down *after* its
   * leaving clauses run.
   *
   * A definition emits nothing where it stands, so `pc` goes back untouched.
   *)
  BlockDef : down bdepth = $bdepth + 1
           : down heldpc = $pc
           : down heldnm = $names
           : down heldnt = $nametext
           : down heldks = $consts
           : down heldkt = $consttext

           : down pc        = 0
           : down names     = []
           : down nametext  = ""
           : down consts    = []
           : down consttext = ""

             (* read before the restore, which is the next four clauses *)
           : ownlabels    = flatten($items.entry)
           : ownblocktab  = positions(flatten($items.bdef))
           : ownnnames    = size($names)
           : ownnametext  = $nametext
           : ownnconsts   = size($consts)
           : ownconsttext = $consttext
           : ownsize      = $pc
           : ownretend    = flatten($items.retend)

           : owncaptures  = size(flatten($items.outs)) > 0

             (* A nested chunk is not consulted, so a definition contributes
              * nothing to the chunk that holds it. *)
           : outs         = []

           : pc        = $heldpc
           : names     = $heldnm
           : nametext  = $heldnt
           : consts    = $heldks
           : consttext = $heldkt

           : bdef = [$name]

           ! size(positions(flatten($items.bdef)))
               < size(flatten($items.bdef))
               : "two blocks in '{}' have the same name" of $name
             (* Both resolve to the first, and nothing downstream can tell --
              * so it is refused rather than left as a wart. *)
           ! size(positions(flatten($items.lname)))
               < size(flatten($items.lname))
               : "two labels in '{}' have the same name" of $name
           ! size($items) = 0 : "a block needs at least one instruction"
           ! size(flatten($items.retend)) = 0
               : "block '{}' has to end with return" of $name
           ! size(flatten($items.retend)) > 0
             and at(flatten($items.retend), size(flatten($items.retend))) <> $pc
               : "block '{}' has to end with return" of $name
           ! $pc > 65535
               : "block '{}' is {} bytes, and a jump offset is two bytes"
                   of $name, $pc

             (* Three bounds the verifier enforces, checked here so that they
              * arrive with a line of assembly rather than as a refusal to
              * load. A frame holds the receiver and then the arguments, so it
              * cannot be smaller than both. *)
           ! int($arity) > 255
               : "a block takes at most 255 arguments, and '{}' declares {}"
                   of $name, $arity
           ! $ownnslots > 255
               : "a block reserves at most 255 slots, and '{}' asks for {}"
                   of $name, $ownnslots
           ! $ownnslots < int($arity) + 1
               : "'{}' takes {} arguments, so it needs at least {} slots -- the receiver is slot 0"
                   of $name, $arity, int($arity) + 1
           ! $bdepth > 16
               : "'{}' is nested {} deep, and SolVM follows at most 16 frames"
                   of $name, $bdepth .

  Unit : down bdepth    = 0
       : ownlabels    = flatten($items.entry)
       : ownblocktab  = positions(flatten($items.bdef))
       : ownnnames    = size($names)
       : ownnametext  = $nametext
       : ownnconsts   = size($consts)
       : ownconsttext = $consttext
       : ownsize      = $pc

       ! size(positions(flatten($items.bdef))) < size(flatten($items.bdef))
           : "two blocks in the script have the same name"
       ! size(positions(flatten($items.lname))) < size(flatten($items.lname))
           : "two labels in the script have the same name"
       ! size($items) = 0 : "there is nothing here to assemble"
       ! size(flatten($items.haltend)) = 0
           : "the script has to end with halt"
       ! size(flatten($items.haltend)) > 0
         and at(flatten($items.haltend), size(flatten($items.haltend))) <> $pc
           : "the script has to end with halt"
       ! $pc > 65535
           : "the script is {} bytes, and a jump offset is two bytes" of $pc
       ! size($names) > 65536 : "a chunk holds at most 65536 names"
       ! size($consts) > 65536 : "a chunk holds at most 65536 constants" .

(* ------------------------------------------------------------------ *)
(* Pass two: the bytes.                                               *)

%pass sob

  (* ---- the instruction set, in opcode order ---- *)

  Const     : code = "{}{}" of bytes(0, 1), bytes($kidx, 2) .
  Nil       : code = bytes(1, 1) .
  Global    : code = "{}{}" of bytes(2, 1), bytes($nidx, 2) .
  SetGlobal : code = "{}{}" of bytes(3, 1), bytes($nidx, 2) .
  Local     : code = "{}{}" of bytes(4, 1), bytes($slot.num, 1) .
  SetLocal  : code = "{}{}" of bytes(5, 1), bytes($slot.num, 1) .
  Outer     : code = "{}{}{}"
                of bytes(6, 1), bytes(int($depth), 1), bytes($slot.num, 1) .
  SetOuter  : code = "{}{}{}"
                of bytes(7, 1), bytes(int($depth), 1), bytes($slot.num, 1) .

  PushBlock : code = "{}{}" of bytes(8, 1), bytes(lookup($blocktab, $name, 0), 2)
            ! not defined($blocktab, $name)
                : "no block called '{}' is defined in this chunk" of $name .

  Str       : code = "{}{}" of bytes(9, 1), bytes($nidx, 2) .
  Sym       : code = "{}{}" of bytes(10, 1), bytes($nidx, 2) .
  Send      : code = "{}{}{}"
                of bytes(11, 1), bytes($nidx, 2), bytes(int($argc), 1) .
  SetSlot   : code = "{}{}" of bytes(12, 1), bytes($nidx, 2) .

  (* ---- the jumps ----
   *
   * An offset is counted from the byte **after** the instruction, and it is
   * unsigned -- so forward and backward are different opcodes, and which one
   * a label needs is a fact about the program the assembler can check rather
   * than guess. `lookup`'s default is what keeps an unresolved label from
   * turning into arithmetic on nil: the check below is the diagnosis, and a
   * second complaint about nil would only bury it.
   *)
  Jump : code = "{}{}" of bytes(13, 1),
                bytes(lookup($labels, $target, $addr + 3) - ($addr + 3), 2)
       ! not defined($labels, $target)
           : "no label called '{}'" of $target
       ! defined($labels, $target)
         and lookup($labels, $target, 0) < $addr + 3
           : "'{}' is behind this, and a backward jump is `loop`" of $target .

  JumpFalse : code = "{}{}{}" of bytes(14, 1),
                     bytes(lookup($labels, $target, $addr + 5) - ($addr + 5), 2),
                     bytes($nidx, 2)
            ! not defined($labels, $target)
                : "no label called '{}'" of $target
            ! defined($labels, $target)
              and lookup($labels, $target, 0) < $addr + 5
                : "'{}' is behind this, and a backward jump is `loop`" of $target .

  ExitFalse : code = "{}{}" of bytes(15, 1),
                     bytes(lookup($labels, $target, $addr + 3) - ($addr + 3), 2)
            ! not defined($labels, $target)
                : "no label called '{}'" of $target
            ! defined($labels, $target)
              and lookup($labels, $target, 0) < $addr + 3
                : "'{}' is behind this, and a backward jump is `loop`" of $target .

  CheckBool : code = "{}{}" of bytes(16, 1), bytes($nidx, 2) .

  Loop : code = "{}{}" of bytes(17, 1),
                bytes(($addr + 3) - lookup($labels, $target, $addr + 3), 2)
       ! not defined($labels, $target)
           : "no label called '{}'" of $target
       ! defined($labels, $target)
         and lookup($labels, $target, 0) > $addr + 3
           : "'{}' is ahead of this, and a forward jump is `jump`" of $target .

  Pop    : code = bytes(18, 1) .
  Return : code = bytes(19, 1) .
  Halt   : code = bytes(20, 1) .

  (* A label, a `.slots`, a block definition and every operand node emit no
   * code where they stand. *)
  otherwise code   = "" .
  otherwise record = [] .

  (* ---- a chunk ----
   *
   * The nine fields, twice: once for a block and once for the script, which
   * differs only in having the header on the front. A line run per item, so
   * a label contributes a run of no bytes -- which the loader accepts and
   * which keeps this one expression instead of a clause per opcode.
   *)
  BlockDef : down labels   = $ownlabels
           : down blocktab = $ownblocktab
           : bodycode = join($items.code)
           : lineruns = join(each(bytes(sizes($items.code), 4),
                                  bytes($items.pos.line, 4), "{}{}"))
           : methods  = join(flatten($items.record))
           : flags    = lookup([[true, 3]], $owncaptures, 1)
           : chunk = join([
               bytes($ownnnames, 4), $ownnametext,
               bytes($ownnconsts, 4), $ownconsttext,
               bytes(size($bodycode), 4), $bodycode,
               bytes(size($items), 4), $lineruns,
               bytes(1, 4), ("{}{}" of bytes(size($pos.file), 2), $pos.file),
               bytes(1, 4), ("{}{}" of bytes(size($bodycode), 4), bytes(0, 4)),
               bytes(size($ownsnames), 2),
               join(each(bytes(sizes($ownsnames), 2), $ownsnames, "{}{}")),
               bytes(size(flatten($items.record)), 4), $methods
             ], "")
           : record = [join([bytes(size($name), 2), $name,
                             bytes(int($arity), 2), bytes($ownnslots, 2),
                             bytes($flags, 2), $chunk], "")] .

  Unit : down labels   = $ownlabels
       : down blocktab = $ownblocktab
       : bodycode = join($items.code)
       : lineruns = join(each(bytes(sizes($items.code), 4),
                              bytes($items.pos.line, 4), "{}{}"))
       : methods  = join(flatten($items.record))
       : out = join([
           "SOLB", bytes(14, 2), bytes($ownnslots, 2),
           bytes($ownnnames, 4), $ownnametext,
           bytes($ownnconsts, 4), $ownconsttext,
           bytes(size($bodycode), 4), $bodycode,
           bytes(size($items), 4), $lineruns,
           bytes(1, 4), ("{}{}" of bytes(size($pos.file), 2), $pos.file),
           bytes(1, 4), ("{}{}" of bytes(size($bodycode), 4), bytes(0, 4)),
           bytes(size($ownsnames), 2),
           join(each(bytes(sizes($ownsnames), 2), $ownsnames, "{}{}")),
           bytes(size(flatten($items.record)), 4), $methods
         ], "") .

%driver sob   = selectors, frames, slotrefs, layout, sob -> out .
%driver check = selectors, frames, slotrefs, layout, sob .
