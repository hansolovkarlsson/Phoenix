(* solvm.phx -- an assembly language for SolVM, and the tree it builds.
 *
 *   phx --tree languages/solvm/solvm.phx prog.sasm
 *   phx --driver render languages/solvm/solvm.phx prog.sasm
 *
 * **The language, and nothing about the file format.** The grammar, the tree,
 * the checks that are about the *program* rather than about `.sob`, and a pass
 * that writes the program back out. `solvm-sob.phx` imports this and adds the
 * two passes that turn it into bytecode.
 *
 * ---------------------------------------------------------------------------
 * What this is for
 *
 * SolVM's instruction set is documented in one place --
 * `solum/include/solum/bytecode.h` in the Solveig repository -- and its
 * container in another, `solum/include/solum/serialize.h`. There was a
 * compiler that produced `.sob` (`solas`), a disassembler that read it
 * (`solvm --dump`), and nothing in between: no way to write a chunk by hand
 * and no way to hand-check what a code generator ought to have emitted.
 *
 * **Phoenix can emit `.sob` and cannot read it**, and that is not an
 * oversight. The format is length-prefixed -- a count, then that many things
 * -- so parsing one needs the match to depend on a number it has just read,
 * and there is no way to say that in this notation. So this is the producing
 * half only; `solvm --dump` stays the reading half.
 *
 * ---------------------------------------------------------------------------
 * The one thing to know about the syntax
 *
 * **Every mnemonic is a reserved word**, worked out from this grammar rather
 * than declared -- so a label cannot be called `loop` and `arity` and `slots`
 * are spoken for. A *selector* that collides with one is written in quotes:
 * `send "return", 0`.
 *)

(* ------------------------------------------------------------------ *)
(* Characters to tokens.                                              *)

%fragment letter digit escape .

letter = "a" .. "z" | "A" .. "Z" | "_" .
digit  = "0" .. "9" .

name = letter { letter | digit | "-" } .

(* A frame slot, an argument count, a nesting depth, a line: all bare. *)
integer = digit { digit } .

(* `#45` is an integer constant and `45.5` is a float one, which is Solveig's
 * own spelling and is what `solvm --dump` prints. Longest match settles `45`
 * against `45.5` without either rule knowing about the other. *)
intlit  = "#" [ "-" ] digit { digit } .
reallit = [ "-" ] digit { digit } "." digit { digit } .

(* `#true`, `#false` and `#nil`. **A word-shaped literal in the syntactic half
 * becomes a reserved word**, so spelling these `true` and `false` would take
 * those names away from every other position -- and Solveig reaches its
 * booleans *as globals*, so `global true` is the first thing anybody writes.
 * The marker keeps them out of the way, and which ones there are is a clause
 * rather than a set of literals, so the complaint about a fourth one can say
 * what the three are. *)
valuelit = "#" letter { letter } .

(* Enumerated rather than "a backslash and then anything": `! ""` never
 * matches, since an empty literal always matches and so *one character
 * provided nothing matches here* always fails. *)
escape = "\\" ( "\"" | "\\" | "n" | "t" | "r" ) .
text   = "\"" { escape | ! "\"" } "\"" .

(* A directive is a word with a dot in front, which is what keeps `.end` from
 * having to be told apart from a label called `end`. *)
directive = "." letter { letter } .

symbol  = ":" | "," .
comment = ";" { ! "\n" } .
space   = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .

%skip space comment .

(* ------------------------------------------------------------------ *)
(* Tokens to a chunk.                                                 *)

%syntax .
%start unit .

unit = { top } -> Unit(items: $1) .

(* `.slots` belongs to the script and to nothing else: a block declares its
 * own frame in its header, so the grammar puts the directive where it means
 * something rather than accepting it anywhere and complaining later. *)
top = ".slots" n:integer   -> Slots(count: $n, slotnames: [])
    | ".slots" s:slotnames -> Slots(count: "0", slotnames: $s)
    | item .

(* A frame may be declared as a count, or as the names of its slots in slot
 * order -- `self, total, i` is three slots, and the first is slot 0. The names
 * go into the chunk so that `solvm --trace` can write `value(n: #41)` where it
 * would otherwise write `value(#41)`; nothing in an *instruction* refers to
 * them, and a slot is still addressed by number.
 *
 * Comma-separated rather than juxtaposed, because a list that ended wherever a
 * name stopped could not tell its last entry from the label on the line below
 * it. *)
slotnames = a:name { "," b:name -> $b } -> [$a, ...$2] .

item = ".block" b:name "arity" a:integer "slots" s:integer c:{ item } ".end"
         -> BlockDef(name: $b, arity: $a, slots: $s, slotnames: [], items: $c)
     | ".block" b:name "arity" a:integer "slots" n:slotnames c:{ item } ".end"
         -> BlockDef(name: $b, arity: $a, slots: "0", slotnames: $n, items: $c)
     | l:name ":" -> Label(name: $l)
     | instruction .

(* The instruction set, in opcode order, which is the order
 * `bytecode.h` declares it in. *)
instruction =
    "const"   k:constant                -> Const(value: $k)
  | "nil"                               -> Nil
  | "global"  n:sel                     -> Global(sel: $n)
  | "setglob" n:sel                     -> SetGlobal(sel: $n)
  | "local"   s:slotref                 -> Local(slot: $s)
  | "setlocl" s:slotref                 -> SetLocal(slot: $s)
  | "outer"   d:integer "," s:slotref   -> Outer(depth: $d, slot: $s)
  | "setoutr" d:integer "," s:slotref   -> SetOuter(depth: $d, slot: $s)
  | "block"   b:name                    -> PushBlock(name: $b)
  | "string"  t:sel                     -> Str(sel: $t)
  | "symbol"  n:sel                     -> Sym(sel: $n)
  | "send"    n:sel "," a:integer       -> Send(sel: $n, argc: $a)
  | "setslot" n:sel                     -> SetSlot(sel: $n)
  | "jump"    t:name                    -> Jump(target: $t)
  | "jumpf"   t:name "," s:sel          -> JumpFalse(target: $t, sel: $s)
  | "exitf"   t:name                    -> ExitFalse(target: $t)
  | "chkbool" s:sel                     -> CheckBool(sel: $s)
  | "loop"    t:name                    -> Loop(target: $t)
  | "pop"                               -> Pop
  | "return"                            -> Return
  | "halt"                              -> Halt .

(* A name, or -- for a selector a reserved word has taken, or one with a
 * character a name cannot hold -- a text literal. *)
sel = n:name -> Bare(word: $n)
    | t:text -> Quoted(raw: $t) .

(* A slot, as its number or -- when the frame it belongs to was declared as
 * its slots' names -- as one of those names. Which frame that is depends on
 * the instruction: `local` means this one and `outer d` means `d` out, so the
 * operand cannot resolve itself and is handed the frame in the `slotrefs`
 * pass below.
 *
 * A node rather than two spellings of one field, which is what `sel` above
 * does for the same reason: the resolving happens once, in a clause, and
 * every instruction that takes a slot reads `$slot.num` without knowing
 * which spelling it was given. *)
slotref = n:integer -> SlotNum(text: $n)
        | n:name    -> SlotName(name: $n) .

constant = intlit   -> IntConst(text: $1)
         | reallit  -> RealConst(text: $1)
         | valuelit -> NamedConst(text: $1) .

(* ------------------------------------------------------------------ *)
(* What a selector's text actually is.                                *)
(*                                                                     *)
(* Its own pass, because both backends need it and neither should       *)
(* work it out again -- and because the quotes come off in a clause,     *)
(* which is the only place that knows how this language spells a         *)
(* string.                                                              *)

%pass selectors

  (* `Bare` needs no clause: it carries a **field** called `word`, and a field
   * is read before an attribute, so the node answers for itself. That is what
   * the `otherwise` at the foot of this pass is "otherwise" to. *)

  (* `\n`, `\t` and `\"` come off; a doubled backslash is refused rather
   * than guessed at. Unescaping in a notation with no conditional is a
   * chain of split-and-join, and each step here can only ever fire on
   * what the step before it left -- which holds because `\\` is not
   * accepted, so nothing can produce another escape's trigger. *)
  Quoted : inner = slice($raw, 2, size($raw) - 1)
         : nl    = join(split($inner, "\\n"), "\n")
         : tab   = join(split($nl, "\\t"), "\t")
         : cr    = join(split($tab, "\\r"), "\r")
         : word  = join(split($cr, "\\\""), "\"")
         ! size(split($raw, "\\\\")) > 1
             : "a doubled backslash in a text literal is not supported" .

  otherwise word = "" .

(* ------------------------------------------------------------------ *)
(* Which slot a name means.                                           *)
(*                                                                     *)
(* Two passes, and it is the same reason an assembler is two passes:    *)
(* the script's frame is declared by a `.slots` that is a *sibling* of   *)
(* the instructions using it, and very often below them. So the names    *)
(* are gathered on the way up in one pass and handed back down in the     *)
(* next -- exactly what `layout` and `sob` do for labels.                 *)
(*                                                                        *)
(* A block needs neither, since its frame is in its own header; it is the  *)
(* script that cannot be done in one walk, and one mechanism is written    *)
(* rather than two.                                                       *)
(*                                                                        *)
(* **This is here and not in the assembler** because a name that no slot   *)
(* answers to is a mistake in the *program*, not in the bytes -- so        *)
(* `--driver render` refuses it too, and `solvm.phx` stays the file that   *)
(* holds every check of that kind.                                        *)

%pass frames

  (* Gathered up. A `.slots` is the only item that contributes, and it can
   * only appear at the top: a block declares its frame in its header. *)
  Slots     : snames = $slotnames .
  otherwise snames = [] .

  Unit     : ownsnames = flatten($items.snames)
           ! size(positions(flatten($items.snames))) < size(flatten($items.snames))
               : "two slots in the script's frame have the same name" .

  BlockDef : ownsnames = $slotnames
           ! size(positions($slotnames)) < size($slotnames)
               : "two slots in '{}' have the same name" of $name .

%pass slotrefs

  (* Handed back down. One table for every frame on the way in, keyed by the
   * frame's depth and the name -- a space cannot occur in either half, so the
   * two cannot run together. Flat rather than a stack of tables, because
   * `lookup` takes a table and a list of them would need a second mechanism
   * to index.
   *
   * `positions` is what turns the names into slot numbers: it answers
   * `[value, index]` pairs and its index is zero-based, which is how slots
   * are counted. `fnames` is the same names again, joined, and exists only so
   * that a refusal can say what the frame does have.
   *
   * The inner frame's entries go on the **front**, so `lookup` reaches the
   * nearest one first. *)
  Unit : down bdepth = 0
       : down ftable = positions(each($ownsnames, "0 {}"))
       : down fnames = [[0, lookup([[0, "nothing named"]], size($ownsnames),
                                   join($ownsnames, ", "))]] .

  (* Written before `bdepth` is advanced, so `$bdepth + 1` says this block's
   * own depth once rather than reading a value that has just changed
   * underneath it. Clauses run in the order they are written. *)
  BlockDef : down ftable = [...positions(each($slotnames,
                                              "{} {}" of ($bdepth + 1), "{}")),
                            ...$ftable]
           : down fnames = [[$bdepth + 1,
                              lookup([[0, "nothing named"]], size($slotnames),
                                     join($slotnames, ", "))], ...$fnames]
           : down bdepth = $bdepth + 1 .

  (* Which frame the operand below is to be read against. This is the whole
   * reason the operand does not resolve itself. *)
  Local    : down fdepth = $bdepth .
  SetLocal : down fdepth = $bdepth .

  (* The depth is checked here rather than left to the machine, because the
   * lexical chain is a fact about the *text*: a chunk nested `n` deep has `n`
   * frames outside it and no more, whenever it runs. Without this a name one
   * step too far out would be reported as a name the frame has not got, which
   * is true and is not the mistake.
   *
   * **Both ends, because SolVM checks both ends.** `serialize.c` refuses
   * `d < 1 || d > ancestor_count`, and it indexes the chain as `ancestors[d
   * - 1]` -- so depth is one-based and depth 0 is not this frame, it is
   * nothing. Reaching this frame is what `local` is for. *)
  Outer    : down fdepth = $bdepth - int($depth)
           ! int($depth) < 1
               : "a depth counts from one, and this frame's own slots are `local`"
           ! int($depth) > $bdepth
               : "depth {} reaches past the outermost frame, and this chunk is nested {} deep"
                   of $depth, $bdepth .
  SetOuter : down fdepth = $bdepth - int($depth)
           ! int($depth) < 1
               : "a depth counts from one, and this frame's own slots are `setlocl`"
           ! int($depth) > $bdepth
               : "depth {} reaches past the outermost frame, and this chunk is nested {} deep"
                   of $depth, $bdepth .

  SlotNum  : num = int($text) .

  (* Three things about the four lines below.
   *
   * The key is written out twice rather than named once, because a check runs
   * before the attributes of the rule it guards -- so an attribute holding it
   * could not be read here.
   *
   * `$fdepth >= 0` leaves a depth past the outermost frame to the check
   * above. Below zero there is no frame to hold a slot of any name, and
   * saying *this frame has not got it* would be true and would not be the
   * mistake.
   *
   * So what is left for `lookup`'s default to cover is the frame that was
   * declared as a count: it has no names, and "nothing named" is what the
   * refusal should say about it. *)
  SlotName : num = lookup($ftable, ("{} {}" of $fdepth, $name), 0)
           ! $fdepth >= 0
             and not defined($ftable, ("{} {}" of $fdepth, $name))
               : "no slot is called '{}' here -- the frame has {}"
                   of $name, lookup($fnames, $fdepth, "nothing named") .

(* ------------------------------------------------------------------ *)
(* Writing it back out.                                               *)
(*                                                                     *)
(* Not decoration: a program that parses, renders and parses to the     *)
(* same tree is the cheapest evidence the grammar reads what it looks    *)
(* like it reads -- and it is the half of the testing that needs no      *)
(* SolVM. It is deliberately *not* the same shape as `solvm --dump`,     *)
(* which prints resolved offsets and side-table entries: that is a       *)
(* listing of a chunk, and this is the source of one.                    *)

%pass render

  Bare       : out = $word .
  Quoted     : out = "{}" of $raw .

  (* A slot goes back out as it came in: the node kept its spelling, so a
   * program written with names renders with names. *)
  SlotNum    : out = $text .
  SlotName   : out = $name .

  IntConst   : out = $text .
  RealConst  : out = $text .
  NamedConst : out = $text .

  Const      : out = "    const   {}" of $value.out .
  Nil        : out = "    nil" .
  Global     : out = "    global  {}" of $sel.out .
  SetGlobal  : out = "    setglob {}" of $sel.out .
  Local      : out = "    local   {}" of $slot.out .
  SetLocal   : out = "    setlocl {}" of $slot.out .
  Outer      : out = "    outer   {}, {}" of $depth, $slot.out .
  SetOuter   : out = "    setoutr {}, {}" of $depth, $slot.out .
  PushBlock  : out = "    block   {}" of $name .
  Str        : out = "    string  {}" of $sel.out .
  Sym        : out = "    symbol  {}" of $sel.out .
  Send       : out = "    send    {}, {}" of $sel.out, $argc .
  SetSlot    : out = "    setslot {}" of $sel.out .
  Jump       : out = "    jump    {}" of $target .
  JumpFalse  : out = "    jumpf   {}, {}" of $target, $sel.out .
  ExitFalse  : out = "    exitf   {}" of $target .
  CheckBool  : out = "    chkbool {}" of $sel.out .
  Loop       : out = "    loop    {}" of $target .
  Pop        : out = "    pop" .
  Return     : out = "    return" .
  Halt       : out = "    halt" .

  Label      : out = "{}:" of $name .

  (* `"0"` is what the grammar puts in `count` when the frame was written as
   * names, since a frame of no slots is refused anyway. *)
  Slots      : out = ".slots {}"
                 of lookup([[0, join($slotnames, ", ")]], int($count), $count) .

  BlockDef   : out = ".block {} arity {} slots {}\n{}\n.end"
                 of $name, $arity,
                    lookup([[0, join($slotnames, ", ")]], int($slots), $slots),
                    join($items.out, "\n") .

  Unit       : out = join($items.out, "\n") .

%driver render = selectors, frames, slotrefs, render -> out .
