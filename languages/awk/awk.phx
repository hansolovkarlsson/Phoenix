(* awk.phx -- awk: what it looks like, and what it builds.
 *
 *   bin/phx --tree languages/awk/awk.phx prog.awk
 *   bin/phx --nodes languages/awk/awk.phx
 *
 * ---------------------------------------------------------------------------
 * The third language, and the first whose grammar is not vendored
 *
 * Pascal's grammar came from Wirth's report and Solveig's from that project's
 * `solum.bnf`, both held character for character in `tests/`. There is no awk
 * grammar on this machine to hold this against: what is below is the POSIX
 * definition **transcribed** into Wirth's notation, and saying so is the
 * honest version of that difference.
 *
 * What keeps it honest instead is the oracle. `/usr/bin/awk` is the arbiter of
 * whether a program is awk, and `tests/corpus/` is seven awk programs written
 * by other people for other reasons -- e2fsprogs, ncurses, vim, gettext --
 * which this has to read and write back unchanged.
 *
 * ---------------------------------------------------------------------------
 * Why awk, and what it is here to test
 *
 * Pascal has statements, expressions and a type system; Solveig has one thing
 * that happens. awk has neither shape. A program is a list of **pattern-action
 * rules** run over every line of input, there is no declaration of anything,
 * a variable's type is whatever it last held, and a function may be **called
 * above where it is defined** -- which is the forward reference
 * `docs/ROADMAP.md` 2.1 has been waiting for a language to need.
 *
 * ---------------------------------------------------------------------------
 * The one place this description guesses, and it is awk's fault
 *
 * `/` is division, and `/re/` is a regular expression. **Which one it is
 * depends on the parser**, not on the characters: real awk lexers ask whether
 * the previous token could end an expression. Phoenix's scanner is longest
 * match over the token rules and has no such feedback -- deliberately, and
 * `docs/ROADMAP.md` 3.3 says why.
 *
 * So `ere` below requires the character after the `/` to be neither a space, a
 * tab, an `=` nor a newline, and requires the closing `/` on the same line.
 * That reads every `/re/` in the corpus and every division in it, because
 * nobody writes `a/b/c` without spaces. **It is a guess and it has a shape it
 * gets wrong**, which is written down in `tests/refused/` rather than left to
 * be found.
 *)

%fragment letter digit exponent escape restchar .

letter   = "a" .. "z" | "A" .. "Z" | "_" .
digit    = "0" .. "9" .

name     = letter { letter | digit } .

(* awk's numbers are all doubles, and `.5` is one. *)
number   = digit { digit } [ "." { digit } ] [ exponent ]
         | "." digit { digit } [ exponent ] .
exponent = ( "e" | "E" ) [ "+" | "-" ] digit { digit } .

(* A string does not span lines; a backslash claims the character after it. *)
string   = "\"" { escape | ! ( "\"" | "\n" ) } "\"" .
escape   = "\\" ! "\n" .

(* The regular expression literal -- see the header. The first character
 * carries the whole of the guess: a space, a tab or an `=` after the `/` says
 * this is division or `/=`, because no regexp anybody writes starts with one. *)
ere      = "/" restchar { escape | ! ( "/" | "\n" ) } "/" .
restchar = escape | ! ( "/" | "\n" | " " | "\t" | "=" ) .

(* **A newline is a token**, because in awk it ends a statement. It is the one
 * thing in this file that a language with braces would have skipped, and it is
 * why `optnl` appears in twenty places below: awk allows a line break after
 * some things and not others, and the grammar has to say which. *)
newline  = "\r" "\n" | "\n" .

blank    = ( " " | "\t" ) { " " | "\t" } .
comment  = "#" { ! "\n" } .
joined   = "\\" "\n" .

punctuation = ">>" | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "%=" | "^="
            | "==" | "!=" | "<=" | ">=" | "&&" | "||" | "!~"
            | "{" | "}" | "(" | ")" | "[" | "]" | ";" | "," | "?" | ":"
            | "+" | "-" | "*" | "/" | "%" | "^" | "!" | ">" | "<" | "|"
            | "~" | "$" | "=" .

%skip blank comment joined .

(* ------------------------------------------------------------------ *)
(* What a program is                                                    *)

%syntax .
%start program .

program = { optnl i:item -> $i } optnl -> Program(items: $1) .

(* A statement ends at a newline or a `;`, and any number of either may sit
 * between two of anything. *)
optnl = { newline | ";" } .

(* **And a line break alone**, where a `;` means something. Inside a `for`
 * header the semicolons are the header's own -- `for (;;)` has two and no
 * statements -- so a rule that ate them would leave the second one looking for
 * a third. POSIX writes `newline_opt` in exactly these places and this is the
 * same distinction under a shorter name. *)
nl = { newline } .

item = "BEGIN" a:action -> Begin(body: $a)
     | "END"   a:action -> End(body: $a)
     | "function" n:name "(" p:params ")" nl a:action
         -> Function(name: $n, params: $p, body: $a)
     | p:pattern a:action -> Rule(pattern: $p, body: $a)
     | p:pattern          -> Rule(pattern: $p, body: nil)
     | a:action           -> Rule(pattern: nil, body: $a) .

params = n:name { "," nl m:name -> $m } -> [$n, ...$2]
       | -> [] .

(* `/from/,/to/` is a range: every line from one match to the next. *)
pattern = a:expr "," nl b:expr -> Range(from: $a, to: $b)
        | e:expr                  -> $e .

action = "{" s:statements "}" -> $s .

statements = { optnl s:statement -> $s } optnl -> $1 .

(* ------------------------------------------------------------------ *)
(* Statements                                                           *)

statement = "if" "(" c:expr ")" optnl t:statement optnl "else" optnl e:statement
              -> If(cond: $c, then: $t, otherwise: $e)
          | "if" "(" c:expr ")" optnl t:statement
              -> If(cond: $c, then: $t, otherwise: nil)
          | "while" "(" c:expr ")" optnl b:statement -> While(cond: $c, body: $b)
          | "do" optnl b:statement optnl "while" "(" c:expr ")"
              -> DoWhile(body: $b, cond: $c)
          | "for" "(" v:name "in" a:name ")" optnl b:statement
              -> ForIn(var: Var(name: $v), array: Var(name: $a), body: $b)
          | "for" "(" i:forpart ";" nl c:forpart ";" nl u:forpart ")"
              optnl b:statement
              -> For(init: $i, cond: $c, step: $u, body: $b)
          | "break"    -> Break
          | "continue" -> Continue
          | "next"     -> Next
          | "exit"   e:optexpr -> Exit(value: $e)
          | "return" e:optexpr -> Return(value: $e)
          | "delete" n:name "[" x:exprlist "]"
              -> Delete(array: Var(name: $n), index: $x)
          | "delete" n:name -> DeleteAll(array: Var(name: $n))
          | a:action -> Block(body: $a)
          | s:simple -> $s .

(* A `for` header's three parts may each be left out, and an omitted one is a
 * **node** rather than a nil: `lookup` is how this notation writes a
 * conditional and it evaluates both answers, so a nil there would have to be
 * asked about before it could be skipped. A node that renders as nothing is
 * asked about by rendering it. *)
forpart = e:expr -> $e | -> Nothing .

(* `exit` and `return` are different: nothing follows them at all, and there is
 * no third thing to render. *)
optexpr = e:expr -> $e | -> nil .

simple = "print"  a:printargs r:redirect -> Print(args: $a, to: $r)
       | "printf" a:printargs r:redirect -> Printf(args: $a, to: $r)
       | e:expr -> $e .

redirect = ">>" e:concat -> Append(file: $e)
         | ">"  e:concat -> Write(file: $e)
         | "|"  e:concat -> Pipe(command: $e)
         | -> nil .

(* **`print a > b` writes to a file**, so a print's arguments cannot contain a
 * relation at all -- not `>`, and not `==` or `<` either, which awk rejects
 * for the symmetry rather than the ambiguity. `print (a > b)` is how you
 * compare, and the parenthesis is what says which you meant.
 *
 * So the ladder below is the one above with **one rung taken out**, and it is
 * duplicated rather than shared because there is nothing in the notation that
 * parameterises a rule. awk's own grammar does exactly this, under the names
 * `unary_expr` and `non_unary_expr`; this is the same split with the same
 * cost, said once instead of twice. *)
printargs = e:printitem { "," nl f:printitem -> $f } -> [$e, ...$2]
          | -> [] .

printitem = t:lvalue o:assignop v:printitem -> Assign(target: $t, op: $o, value: $v)
          | pternary .

pternary = c:pdisjunction "?" nl t:pternary ":" nl e:pternary
             -> Cond(cond: $c, then: $t, otherwise: $e)
         | pdisjunction .

pdisjunction = pconjunction { "||" nl a:pconjunction
                                -> Logical(op: "||", left: $$, right: $a) } .
pconjunction = pmembership  { "&&" nl a:pmembership
                                -> Logical(op: "&&", left: $$, right: $a) } .
pmembership  = pmatching { "in" a:name -> In(index: $$, array: Var(name: $a)) } .
pmatching    = concat { o:matchop r:concat
                          -> Match(op: $o, left: $$, right: $r) } .

(* ------------------------------------------------------------------ *)
(* Expressions, loosest first                                           *)

expr = t:lvalue o:assignop v:expr -> Assign(target: $t, op: $o, value: $v)
     | ternary .

assignop = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "^=" .

ternary = c:disjunction "?" nl t:ternary ":" nl e:ternary
            -> Cond(cond: $c, then: $t, otherwise: $e)
        | disjunction .

disjunction = conjunction { "||" nl a:conjunction
                              -> Logical(op: "||", left: $$, right: $a) } .
conjunction = membership  { "&&" nl a:membership
                              -> Logical(op: "&&", left: $$, right: $a) } .

membership = matching { "in" a:name -> In(index: $$, array: Var(name: $a)) } .

matching = comparison { o:matchop r:comparison
                          -> Match(op: $o, left: $$, right: $r) } .
matchop = "~" | "!~" .

(* Not associative: `a < b < c` is two comparisons in C and nonsense here. *)
comparison = a:concat o:relop b:concat -> Compare(op: $o, left: $a, right: $b)
           | concat .
relop = "<=" | "!=" | "==" | ">=" | "<" | ">" .

(* **Concatenation has no operator**, which is awk's most distinctive syntax
 * and the reason its grammar is not LL(1). Here it is a repetition of the rung
 * below, which is what juxtaposition is. *)
concat = additive { a:additive -> Concat(left: $$, right: $a) } .

additive = multiplicative { o:addop m:multiplicative
                              -> Binary(op: $o, left: $$, right: $m) } .
addop = "+" | "-" .

multiplicative = unary { o:mulop u:unary -> Binary(op: $o, left: $$, right: $u) } .
mulop = "*" | "/" | "%" .

unary = "!" u:unary -> Not(value: $u)
      | "-" u:unary -> Negate(value: $u)
      | "+" u:unary -> Positive(value: $u)
      | power .

(* `^` is right-associative and binds tighter than unary minus, so `-2^2` is
 * -4 and not 4. *)
power = p:postfix "^" u:unary -> Binary(op: "^", left: $p, right: $u)
      | postfix .

postfix = l:lvalue "++" -> PostIncr(target: $l)
        | l:lvalue "--" -> PostDecr(target: $l)
        | primary .

(* **`getline` has to be described even though nothing compiles it**, because
 * the alternative is worse than refusing: `getline` is not a keyword unless
 * some rule says so, and without one `getline line` reads as *two variables
 * concatenated* -- a silent mis-parse of ordinary awk.
 *
 * Four of its six forms are here, which is the two that read from a file or
 * from the input. `cmd | getline` is the other two, and `|` is not an
 * expression operator here, so those do not parse -- loudly, which is the
 * point. Mentioning the word at all is what makes it reserved. *)
primary = "getline" l:lvalue "<" e:concat -> Getline(into: $l, from: $e)
        | "getline" "<" e:concat          -> Getline(into: nil, from: $e)
        | "getline" l:lvalue              -> Getline(into: $l, from: nil)
        | "getline"                       -> Getline(into: nil, from: nil)
        | "++" l:lvalue -> PreIncr(target: $l)
        | "--" l:lvalue -> PreDecr(target: $l)
        | "$" p:primary -> Field(index: $p)
        | "(" e:exprlist ")" -> Group(items: $e)
        | n:number -> Number(text: $n)
        | s:string -> Str(text: $s)
        | r:ere    -> Regex(text: $r)
        | b:builtin "(" a:arglist ")" -> Call(name: $b, args: $a)
        | b:builtin -> Call(name: $b, args: [])
        | n:name "(" a:arglist ")" -> Apply(name: $n, args: $a)
        | n:name "[" x:exprlist "]" -> Index(array: Var(name: $n), index: $x)
        | n:name -> Var(name: $n) .

(* An lvalue is the only thing that may be assigned to or stepped. *)
lvalue = "$" p:primary -> Field(index: $p)
       | n:name "[" x:exprlist "]" -> Index(array: Var(name: $n), index: $x)
       | n:name -> Var(name: $n) .

builtin = "length" | "substr" | "index" | "split" | "sub" | "gsub" | "match"
        | "sprintf" | "sin" | "cos" | "atan2" | "exp" | "log" | "sqrt"
        | "int" | "rand" | "srand" | "tolower" | "toupper" | "system"
        | "close" | "fflush" .

exprlist = e:expr { "," nl f:expr -> $f } -> [$e, ...$2] .

arglist = e:expr { "," nl f:expr -> $f } -> [$e, ...$2]
        | -> [] .

(* ------------------------------------------------------------------ *)
(* Writing it back out
 *
 * **A check on the tree rather than a pretty-printer.** Every awk program
 * there is here is parsed, written back out by this pass, and parsed again;
 * the two trees must be identical. That catches a node built with the wrong
 * shape, an argument list dropped, or a fold that went the wrong way -- over
 * programs other people wrote, rather than over the ones somebody thought to
 * look at.
 *
 * It is not a round trip of *source*. Comments are skipped and do not come
 * back, statements come out separated by `;` whatever they were written with,
 * and a line break inside an expression is gone. It is a round trip of
 * **structure**, and it works because a parenthesis is a `Group` node: no
 * bracket comes back that was not written, and none that was written is lost.
 *)
%pass show

  Program : show = join($items.show, "\n") .

  Begin    : show = "BEGIN { {} }" of join($body.show, "; ") .
  End      : show = "END { {} }"   of join($body.show, "; ") .
  Function : show = "function {}({}) { {} }"
                      of $name, join($params, ", "), join($body.show, "; ") .

  Rule(pattern: nil) : show = "{ {} }" of join($body.show, "; ") .
  Rule(body: nil)    : show = "{}" of $pattern.show .
  Rule               : show = "{} { {} }" of $pattern.show, join($body.show, "; ") .

  Range : show = "{}, {}" of $from.show, $to.show .

  (* ---- statements ---- *)

  (* **A `;` before `else` is a syntax error when the branch is a block**, and
   * required when it is not: awk wants a *terminated* statement there, a
   * block terminates itself, and a `}` followed by `;` ends the whole `if`
   * with an `else` left over. Two clauses, chosen by the shape of the branch,
   * which is what a pattern is for. *)
  If(otherwise: nil)  : show = "if ({}) {}" of $cond.show, $then.show .
  If(then: Block)     : show = "if ({}) {} else {}"
                                 of $cond.show, $then.show, $otherwise.show .
  If                  : show = "if ({}) {}; else {}"
                                 of $cond.show, $then.show, $otherwise.show .
  While     : show = "while ({}) {}" of $cond.show, $body.show .
  (* And the same again for `do`: awk wants a terminated statement before the
   * `while`, a block terminates itself, and a `}` followed by `;` ends the
   * `do` with a `while` left over. *)
  DoWhile(body: Block) : show = "do {} while ({})" of $body.show, $cond.show .
  DoWhile              : show = "do {}; while ({})" of $body.show, $cond.show .
  ForIn     : show = "for ({} in {}) {}" of $var.show, $array.show, $body.show .
  For       : show = "for ({}; {}; {}) {}"
                       of $init.show, $cond.show, $step.show, $body.show .
  Nothing   : show = "" .
  Break     : show = "break" .
  Continue  : show = "continue" .
  Next      : show = "next" .

  (* `exit` and `return` with nothing after them, and the two `for` parts that
   * may be empty, are all a nil where an expression would be. *)
  Exit(value: nil)   : show = "exit" .
  Exit               : show = "exit {}" of $value.show .
  Return(value: nil) : show = "return" .
  Return             : show = "return {}" of $value.show .

  Delete    : show = "delete {}[{}]" of $array.show, join($index.show, ", ") .
  DeleteAll : show = "delete {}" of $array.show .
  Block     : show = "{ {} }" of join($body.show, "; ") .

  Print(to: nil)  : show = "print {}" of join($args.show, ", ") .
  Print           : show = "print {} {}" of join($args.show, ", "), $to.show .
  Printf(to: nil) : show = "printf {}" of join($args.show, ", ") .
  Printf          : show = "printf {} {}" of join($args.show, ", "), $to.show .

  Append : show = ">> {}" of $file.show .
  Write  : show = "> {}"  of $file.show .
  Pipe   : show = "| {}"  of $command.show .

  (* ---- expressions ---- *)

  Assign  : show = "{} {} {}" of $target.show, $op, $value.show .
  Cond    : show = "{} ? {} : {}" of $cond.show, $then.show, $otherwise.show .
  Logical : show = "{} {} {}" of $left.show, $op, $right.show .
  In      : show = "{} in {}" of $index.show, $array.show .
  Match   : show = "{} {} {}" of $left.show, $op, $right.show .
  Compare : show = "{} {} {}" of $left.show, $op, $right.show .

  (* The one operator with no spelling: two things beside each other. *)
  Concat  : show = "{} {}" of $left.show, $right.show .

  Binary  : show = "{} {} {}" of $left.show, $op, $right.show .
  Not     : show = "!{}" of $value.show .
  Negate  : show = "-{}" of $value.show .
  Positive : show = "+{}" of $value.show .

  PostIncr : show = "{}++" of $target.show .
  PostDecr : show = "{}--" of $target.show .
  PreIncr  : show = "++{}" of $target.show .
  PreDecr  : show = "--{}" of $target.show .

  Getline(into: nil, from: nil) : show = "getline" .
  Getline(into: nil) : show = "getline < {}" of $from.show .
  Getline(from: nil) : show = "getline {}" of $into.show .
  Getline            : show = "getline {} < {}" of $into.show, $from.show .

  Field   : show = "${}" of $index.show .
  Group   : show = "({})" of join($items.show, ", ") .
  Number  : show = "{}" of $text .
  Str     : show = "{}" of $text .
  Regex   : show = "{}" of $text .
  Var     : show = "{}" of $name .
  Index   : show = "{}[{}]" of $array.show, join($index.show, ", ") .
  Call    : show = "{}({})" of $name, join($args.show, ", ") .
  Apply   : show = "{}({})" of $name, join($args.show, ", ") .

%driver show = show -> show .

(* ------------------------------------------------------------------ *)
(* What a call means
 *
 * **awk resolves a call by name, at run time, over the whole program.** A
 * function may be called above where it is defined -- `tests/conformance/
 * functions.awk` calls `greet` from `BEGIN` before its body appears, and awk
 * prints the answer. So the check that a call names something has to see a
 * node the walk has not reached, which is the forward reference
 * `docs/ROADMAP.md` 2.1 is about.
 *
 * **It is two passes, and that is the whole of it.** The first walks the
 * program and collects what functions there are; the second hands that table
 * down and checks the calls against it. Attributes stay on the nodes between
 * passes, so the second reads what the first left on the root -- which is what
 * a hand-written compiler does, and why 2.1 has stayed unbuilt.
 *
 * What that costs, said plainly: the walk happens twice. What it saves is
 * demand-driven evaluation and the cycle detection that comes with it.
 *)
%pass functions

  thread known = []

  Function : known = [...$known, [$name, size($params)]] .

  (* The table, left on the root for the pass after this one. Every function in
   * the program is in it by the time this clause runs, wherever it was
   * written, because a leaving clause runs after the whole subtree. *)
  Program : table = $known .

%pass calls

  (* And handed back down, from the node the first pass left it on. *)
  Program : down declared = $table .

  Apply ! not defined($declared, $name)
          : "'{}' is not a function in this program" of $name

        (* awk allows a call with **fewer** arguments than the function has --
         * the rest are its locals, which is how awk says local at all -- and
         * refuses more. `lookup` answers this call's own count when the name
         * is unknown, so a call to nothing is one message rather than two. *)
        ! size($args) > lookup($declared, $name, size($args))
          : "'{}' takes {} argument{}, and this gives {}"
              of $name, lookup($declared, $name, 0),
                 lookup([[1, ""]], lookup($declared, $name, 0), "s"),
                 size($args) .

%driver check = functions, calls .
