; The forward jump's size decides whether the backward one fits, and the
; second walk gets both. 123 bytes of filler, and arithmetic countable by hand:
;
;   top:    nop            1 byte, at 0
;           br far         at 1, two bytes or three
;           123 nops
;           br top         at A = 1 + (that size) + 123
;   far:    halt
;
; Walk one assumes the forward `br` is long, A is 127, and the backward
; displacement is -129 -- one out of range, so that one is long too: 131 bytes.
;
; Walk two has walk one's table. The forward `br` fits in two, which puts A at
; 126, and the backward displacement is exactly -128, which fits. **129**, and
; that is the minimum.
;
; So one extra walk is enough *here*. `../../divergent/two-rounds.z80` is the
; same shape one round deeper and is not enough there, which is the difference
; between another pass and a fixpoint.
top:    nop
        br far
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
