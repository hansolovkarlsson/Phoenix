; The forward jump's size decides whether the backward one fits -- which is
; the fixpoint, in eleven bytes of real instructions and 123 of filler.
;
; The arithmetic, and it is countable by hand:
;
;   top:    nop            1 byte, at 0
;           br far         at 1, two bytes or three
;           123 nops
;           br top         at A = 1 + (that size) + 123
;   far:    halt
;
; A backward `jr` reaches -128. With the forward `br` taking three bytes,
; A = 127 and the backward displacement is -129, one out of range -- so it
; takes three bytes too, and the program is 131 bytes.
;
; With the forward `br` taking two, A = 126, the displacement is exactly -128,
; and it fits. Both short is consistent, and the program is **129**.
;
; So the answer is not reachable by deciding each jump once, and not by one
; more walk either: the first shrink is what makes the second possible, and
; the second is what makes the first worth having. Iterate until the sizes
; stop changing -- and nothing in this notation iterates over a table.
top:    nop
        br far
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
        nop
