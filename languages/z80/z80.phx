(* z80.phx -- a Z80 subset, assembled to raw bytes.
 *
 *   phx --driver code --raw languages/z80/z80.phx prog.z80 > prog.bin
 *   z80asm -o want.bin prog.z80 && cmp want.bin prog.bin
 *
 * ---------------------------------------------------------------------------
 * What this is for
 *
 * [ROADMAP 2.5](../../docs/ROADMAP.md#25-circular-attributes--from-jastadd)
 * has wanted a customer since it opened: an analysis that needs a **fixpoint
 * over a table** rather than over the shape of a tree. A Z80 assembler is the
 * cheapest one, because `jr e` is two bytes and reaches 127 in either
 * direction while `jp nn` is three and reaches anywhere -- so choosing the
 * short form shrinks the code, moves every label after it, and can bring a
 * further branch into range. The sizes have to be iterated until they stop
 * changing.
 *
 * **`jr` is here, and `br` is what it costs.** A relative jump is two bytes
 * and an absolute one is three, so an assembler that picks between them for
 * you has a size that depends on a distance that depends on sizes. `br` is
 * that pseudo-instruction, and this description **cannot decide it**: `layout`
 * makes one walk, so a *backward* target's address is known and a forward
 * one's is not. What it does instead is written under the pass, and the
 * witnesses are in [`divergent/`](divergent/).
 *
 * The finding, in one line: **the notation can check a relative jump and
 * cannot choose one.** `jr` written by hand is verified against the label
 * table in the second walk, where every address is known; `br` has to have its
 * size settled in the first, where they are not.
 *
 * ---------------------------------------------------------------------------
 * The subset, and what is outside it
 *
 * Immediate loads into the eight-bit registers, the three immediate
 * arithmetic instructions that take `a`, `inc`, `dec`, the absolute jumps and
 * calls, the relative jumps, `br`, and the three instructions that are one
 * byte on their own. No index registers, no sixteen-bit arithmetic and no `ld`
 * between two registers.
 *
 * Numbers are decimal. The assembly starts at address 0, which is `z80asm`'s
 * default with no `org`, and there is no `org` here to disagree with it.
 *
 * **Every word-shaped literal in the syntactic half is reserved**, so `ld`,
 * `jp`, `a`, `nz` and the rest are not available as label names. That is the
 * bargain ROADMAP 5 already describes for `lib/expression.phx`, met here in a
 * language whose mnemonics are ordinary words.
 *)

%fragment letter digit .

letter  = "a" .. "z" | "A" .. "Z" | "_" .
digit   = "0" .. "9" .

word    = letter { letter | digit } .
number  = digit { digit } .
space   = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .
comment = ";" { ! "\n" } .
symbol  = ":" | "," .

%skip space comment .

%syntax .
%start program .

program = { item } -> Program(items: $1) .

(* A label first, because `n:word ":"` fails on a mnemonic and falls through --
 * which is what ordered choice asks for, and what `languages/solvm/` does with
 * the same rule for the same reason. *)
item = n:word ":" -> Label(name: $n)
     | instruction .

(* The conditional jump is above the unconditional one. `jp nz, loop` would
 * otherwise take `nz` as the target and leave the comma over. *)
instruction =
    "ld"   r:reg "," v:number  -> LdImm(reg: $r, value: $v)
  | "add"  "a" "," v:number    -> AddImm(value: $v)
  | "sub"  v:number            -> SubImm(value: $v)
  | "cp"   v:number            -> CpImm(value: $v)
  | "inc"  r:reg               -> Inc(reg: $r)
  | "dec"  r:reg               -> Dec(reg: $r)
  | "jp"   c:cond "," t:word   -> JpCond(cond: $c, target: $t)
  | "jp"   t:word              -> Jp(target: $t)
  | "jr"   c:cond "," t:word   -> JrCond(cond: $c, target: $t)
  | "jr"   t:word              -> Jr(target: $t)
  | "br"   t:word              -> Br(target: $t)
  | "call" t:word              -> Call(target: $t)
  | "ret"                      -> Ret
  | "nop"                      -> Nop
  | "halt"                     -> Halt .

(* A register is its **encoding**, in the grammar, because that is the one
 * place the seven of them are written down -- and three instructions below
 * would otherwise each carry a copy of the same table. `ld r, n` is
 * `0x06 + 8r`, `inc r` is `0x04 + 8r` and `dec r` is `0x05 + 8r`, so the
 * number is all any of them needs. It is a string because that is what an
 * action builds; `int` takes it back.
 *
 * A node rather than the number alone, because there are two backends now and
 * the listing has to write the letter back out. That is the ordinary reason
 * this repository keeps a second backend: one of them alone can throw away
 * something the description should have kept. *)
reg = "b" -> Reg(name: "b", code: "0") | "c" -> Reg(name: "c", code: "1")
    | "d" -> Reg(name: "d", code: "2") | "e" -> Reg(name: "e", code: "3")
    | "h" -> Reg(name: "h", code: "4") | "l" -> Reg(name: "l", code: "5")
    | "a" -> Reg(name: "a", code: "7") .

(* A condition is its whole opcode rather than a field of one, because the
 * four conditional jumps are four unrelated bytes and not a base plus an
 * index: 0xC2, 0xCA, 0xD2, 0xDA. *)
cond = "nz" -> Cond(name: "nz", jp: "194", jr: "32")
     | "z"  -> Cond(name: "z",  jp: "202", jr: "40")
     | "nc" -> Cond(name: "nc", jp: "210", jr: "48")
     | "c"  -> Cond(name: "c",  jp: "218", jr: "56") .

(* ------------------------------------------------------------------ *)
(* Pass one: where does everything sit?                               *)

%pass layout

  thread pc = 0

  (* The labels **already met**, which is every backward target and no forward
   * one. A thread, because that is what *what has been passed* is. *)
  thread seen = empty

  (* One byte. *)
  Nop  : pc = $pc + 1 .
  Halt : pc = $pc + 1 .
  Ret  : pc = $pc + 1 .
  Inc  : pc = $pc + 1 .
  Dec  : pc = $pc + 1 .

  (* An opcode and its immediate byte. The bound is here rather than in the
   * pass that writes the bytes, because it is a fact about the program and
   * not about the encoding: `ld a, 300` is a mistake in the assembly. *)
  LdImm  : pc = $pc + 2
         ! int($value) > 255
             : "an immediate byte is at most 255, and this is {}" of $value .
  AddImm : pc = $pc + 2
         ! int($value) > 255
             : "an immediate byte is at most 255, and this is {}" of $value .
  SubImm : pc = $pc + 2
         ! int($value) > 255
             : "an immediate byte is at most 255, and this is {}" of $value .
  CpImm  : pc = $pc + 2
         ! int($value) > 255
             : "an immediate byte is at most 255, and this is {}" of $value .

  (* An opcode and a sixteen-bit address. *)
  Jp     : pc = $pc + 3 .
  JpCond : pc = $pc + 3 .
  Call   : pc = $pc + 3 .

  (* An opcode and a signed displacement. Whether the target is *reachable*
   * is not asked here -- that is a distance, and the pass that has every
   * address is the next one. What is fixed here is only the size, and a `jr`
   * the programmer wrote has one whether it reaches or not. *)
  Jr     : addr = $pc : pc = $pc + 2 .
  JrCond : addr = $pc : pc = $pc + 2 .

  (* ---- `br`, which is the entry ----
   *
   * Two bytes if the target is within reach of a relative jump and three if
   * it is not -- so the size of this instruction depends on a distance, and
   * every distance past it depends on this size.
   *
   * `seen` is what one walk can offer: the labels **already met**, which is
   * every backward target and no forward one. So a backward `br` is decided
   * exactly, and a forward `br` is assumed long, because assuming short and
   * being wrong emits a jump that goes somewhere else.
   *
   * **That is correct and it is not minimal**, and the gap is the roadmap
   * entry. `divergent/short-forward.z80` is three bytes where two would do;
   * `divergent/chain.z80` is the case a second walk would not fix either,
   * because shrinking one `br` is what brings the next into range. The answer
   * is to iterate until the sizes stop changing, and there is nothing in this
   * notation that iterates over a table.
   *)
  Br : addr  = $pc
     : known = defined($seen, $target)
     : back  = lookup($seen, $target, 0) - ($pc + 2)
     : first = $known and $back >= -128
     : pc    = $pc + lookup([[true, 2]], $first, 3) .

  (* The one item that occupies no space and is the reason for two passes.
   * `seen` is a thread and `entry` is not, which is the whole difference
   * between the two questions: a thread answers *what has been passed*, and
   * the table handed back down answers *what is there*. `br` can only ask the
   * first. *)
  Label : entry = [[$name, $pc]] : lname = [$name]
        : seen  = bind($seen, $name, $pc) .

  otherwise entry = []
  otherwise lname = []

  Program : labels = flatten($items.entry)
          : size   = $pc
          ! size($items) = 0 : "there is nothing here to assemble"
          ! size(positions(flatten($items.lname))) < size(flatten($items.lname))
              : "two labels have the same name"
          ! $pc > 65536
              : "the assembly is {} bytes, and an address is two" of $pc .

(* ------------------------------------------------------------------ *)
(* Pass two: the same walk again, with the first one's answers.       *)
(*                                                                     *)
(* **This pass is `layout` written a second time**, and that is the     *)
(* entry. The first walk had to assume every forward `br` was long,     *)
(* because it had not met the target. This one has `layout`'s table, so *)
(* it can decide a forward `br` too -- against an address that is an    *)
(* over-estimate, which is the only direction that is safe.             *)
(*                                                                     *)
(* *Why shrinking is monotone, and so why this terminates.* Every       *)
(* address in the table came from a layout in which nothing was shorter *)
(* than it will be. Shrinking a `br` only pulls later addresses down,   *)
(* so a distance computed here can only over-state the final one -- and *)
(* a `br` that fits here still fits when everything settles. The walk   *)
(* can be run again and will never have to grow one back.               *)
(*                                                                     *)
(* *And that is why one round is not the answer.* Round two shrinks     *)
(* what round one's estimate allowed; round three shrinks what round    *)
(* two's shrinking allowed. `divergent/two-rounds.z80` is a program     *)
(* that needs the third, and this description stops after the second.   *)
(* The mechanism 2.5 wants is this pass with *until nothing moves* in    *)
(* front of it, instead of a copy of it per round.                       *)

%pass relax

  thread pc2 = 0

  Nop  : pc2 = $pc2 + 1 .
  Halt : pc2 = $pc2 + 1 .
  Ret  : pc2 = $pc2 + 1 .
  Inc  : pc2 = $pc2 + 1 .
  Dec  : pc2 = $pc2 + 1 .

  LdImm  : pc2 = $pc2 + 2 .
  AddImm : pc2 = $pc2 + 2 .
  SubImm : pc2 = $pc2 + 2 .
  CpImm  : pc2 = $pc2 + 2 .

  Jp     : pc2 = $pc2 + 3 .
  JpCond : pc2 = $pc2 + 3 .
  Call   : pc2 = $pc2 + 3 .

  Jr     : addr2 = $pc2 : pc2 = $pc2 + 2 .
  JrCond : addr2 = $pc2 : pc2 = $pc2 + 2 .

  (* The decision, made against the previous round's addresses. Both
   * directions this time: the table has every label in it. *)
  Br : addr2 = $pc2
     : est   = lookup($table, $target, 0) - ($pc2 + 2)
     : short = $est >= -128 and $est <= 127
     : pc2   = $pc2 + lookup([[true, 2]], $short, 3) .

  Label : entry2 = [[$name, $pc2]] .

  otherwise entry2 = []

  Program : down table = $labels
          : labels2 = flatten($items.entry2)
          : size2   = $pc2 .

(* ------------------------------------------------------------------ *)
(* Pass three: how far is it?                                         *)
(*                                                                     *)
(* A pass of its own, and the tool asked for it. A check runs *before*  *)
(* the attributes it guard, so a rule cannot both compute `disp` and    *)
(* complain about it -- `phx` refuses that with the fix in the message: *)
(* write the expression out here, or compute it in an earlier pass.     *)
(* Writing it out means three copies of one subtraction in six places,  *)
(* so it is a pass, and `code` below reads the answer.                  *)

%pass reach

  Program : down table = $labels2 .

  Jr     : disp = lookup($table, $target, $addr2 + 2) - ($addr2 + 2) .
  JrCond : disp = lookup($table, $target, $addr2 + 2) - ($addr2 + 2) .
  Br     : disp = lookup($table, $target, $addr2 + 2) - ($addr2 + 2) .

(* ------------------------------------------------------------------ *)
(* Pass four: the bytes.                                              *)

%pass code

  Program : down table = $labels2
          : out = join($items.out) .

  Nop  : out = bytes(0, 1) .
  Halt : out = bytes(118, 1) .
  Ret  : out = bytes(201, 1) .

  LdImm : out = join([bytes(6 + 8 * int($reg.code), 1), bytes(int($value), 1)]) .
  Inc   : out = bytes(4 + 8 * int($reg.code), 1) .
  Dec   : out = bytes(5 + 8 * int($reg.code), 1) .

  AddImm : out = join([bytes(198, 1), bytes(int($value), 1)]) .
  SubImm : out = join([bytes(214, 1), bytes(int($value), 1)]) .
  CpImm  : out = join([bytes(254, 1), bytes(int($value), 1)]) .

  (* An address is absolute and little-endian, which is what `bytes(n, 2)`
   * writes. `lookup`'s default keeps an unresolved label out of the
   * arithmetic; the check under it is the diagnosis. *)
  Jp     : out = join([bytes(195, 1), bytes(lookup($table, $target, 0), 2)])
         ! not defined($table, $target)
             : "no label called '{}'" of $target .
  JpCond : out = join([bytes(int($cond.jp), 1),
                       bytes(lookup($table, $target, 0), 2)])
         ! not defined($table, $target)
             : "no label called '{}'" of $target .

  (* ---- the relative jumps ----
   *
   * A displacement is counted from the byte **after** the instruction and is
   * signed, so `mod 256` is what writes it: -2 is 0xFE. Every address is known
   * in this walk, which is why the reach can be checked here and the size
   * could not be decided in the last one.
   *)
  Jr : out = join([bytes(24, 1), bytes($disp mod 256, 1)])
     ! not defined($table, $target)
         : "no label called '{}'" of $target
     ! defined($table, $target) and ($disp < -128 or $disp > 127)
         : "'{}' is {} away, and a jr reaches 127" of $target, $disp .

  JrCond : out = join([bytes(int($cond.jr), 1), bytes($disp mod 256, 1)])
         ! not defined($table, $target)
             : "no label called '{}'" of $target
         ! defined($table, $target) and ($disp < -128 or $disp > 127)
             : "'{}' is {} away, and a jr reaches 127" of $target, $disp .

  (* `short` was decided in `layout` and is read back here, so the two walks
   * cannot disagree about how many bytes this is. *)
  Br : out = lookup([[true, join([bytes(24, 1), bytes($disp mod 256, 1)])]],
                    $short,
                    join([bytes(195, 1), bytes(lookup($table, $target, 0), 2)]))
     ! not defined($table, $target)
         : "no label called '{}'" of $target
     (* The monotonicity argument, checked rather than believed. A `br` that
      * took the short form against an over-estimate must still reach now that
      * every address is final -- if this ever fires, shrinking was not safe
      * and the reasoning above is wrong. *)
     ! $short and ($disp < -128 or $disp > 127)
         : "'{}' was in reach when the size was chosen and is {} away now"
             of $target, $disp .

  Call   : out = join([bytes(205, 1), bytes(lookup($table, $target, 0), 2)])
         ! not defined($table, $target)
             : "no label called '{}'" of $target .

  (* A label is where the bytes after it are, and none of its own. *)
  otherwise out = ""

(* ------------------------------------------------------------------ *)
(* The same tree as assembly, with every `br` resolved.                *)
(*                                                                     *)
(* This is what makes `br` checkable at all. `z80asm` has no `br`, so   *)
(* the oracle cannot assemble the source this description was given --  *)
(* it can assemble the source this description *decided on*, and the    *)
(* bytes from the two routes have to be the same. A wrong displacement  *)
(* or a wrong opcode shows up; a needlessly long encoding does not,     *)
(* which is why the divergences are pinned separately.                  *)

%pass listing

  Program : out = join($items.out, "\n") .

  Label : out = "{}:" of $name .
  Nop   : out = "        nop" .
  Halt  : out = "        halt" .
  Ret   : out = "        ret" .

  LdImm : out = "        ld {}, {}" of $reg.name, $value .
  Inc   : out = "        inc {}" of $reg.name .
  Dec   : out = "        dec {}" of $reg.name .

  AddImm : out = "        add a, {}" of $value .
  SubImm : out = "        sub {}" of $value .
  CpImm  : out = "        cp {}" of $value .

  Jp     : out = "        jp {}" of $target .
  JpCond : out = "        jp {}, {}" of $cond.name, $target .
  Jr     : out = "        jr {}" of $target .
  JrCond : out = "        jr {}, {}" of $cond.name, $target .
  Call   : out = "        call {}" of $target .

  (* The decision, written out. *)
  Br : out = lookup([[true, "        jr {}" of $target]], $short,
                    "        jp {}" of $target) .

%driver code    = layout, relax, reach, code -> out .
%driver listing = layout, relax, listing -> out .
