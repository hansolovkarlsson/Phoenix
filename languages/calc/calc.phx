(* calc.phx -- the calculator: what it looks like, and what it means.
 *
 * **The language, and nothing about any target.** The grammar, the tree it
 * builds, the typechecker and the interpreter are all here, because none of
 * them has an opinion about what a compiler for this language should emit.
 * A target is a small file that imports this one and adds an emit pass:
 * `calc-c.phx` is C, `calc-solveig.phx` is Solveig.
 *
 *   phx languages/calc/calc-c.phx prog.calc                 the tree
 *   phx --run typecheck --show type languages/calc/calc-c.phx prog.calc
 *   phx --run eval languages/calc/calc-c.phx prog.calc      run it
 *   phx --run emit-c languages/calc/calc-c.phx prog.calc    compile it
 *)

(* ------------------------------------------------------------------ *)
(* Characters to tokens.                                              *)
(*                                                                     *)
(* The lexical half is nearly the same in every language, so it is      *)
(* imported rather than written again: `name`, `integer`, `real`, the   *)
(* comment shapes and `space` come from there, along with the           *)
(* `%fragment` declarations that keep `letter` from being a token.      *)
(*                                                                     *)
(* Whether whitespace is thrown away is the *language's* business,      *)
(* though -- a layout-sensitive one would keep it -- so `%skip` is      *)
(* said here and not there.                                            *)

%import "lexical.phx" .
%import "expression.phx" .
%skip space line-comment .

(* calc's own punctuation, and all of it. The operators belong to
 * `expression.phx` and live in its own `operator` rule; the scanner takes the
 * longest match across every token rule, so neither has to know the other is
 * there. *)
symbol = ":=" | ";" .

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* Every word-shaped literal below is a reserved word, worked out from  *)
(* this half rather than declared -- so `print` cannot be a variable,   *)
(* and nothing here had to say so.                                     *)

%syntax .
%start program .

(* `->` says what an alternative *means*, as against what it looks like.
 * Without one, a rule answers what it matched. *)

program   = { statement } -> Program(body: $1) .

statement = "print" e:expression ";"           -> Print(value: $e)
          | "let" n:name ":=" e:expression ";"  -> Let(name: $n, value: $e)
          | "if" c:expression "then" t:block "else" f:block "end"
                                                -> IfElse(cond: $c, then: $t, else: $f)
          | "if" c:expression "then" t:block "end"
                                                -> If(cond: $c, then: $t)
          | "while" c:expression "do" b:block "end"
                                                -> While(cond: $c, body: $b)
          | n:name ":=" e:expression ";"        -> Assign(name: $n, value: $e) .

block = { statement } -> Block(body: $1) .

(* `$$` is what has been built so far, so an action mentioning it replaces the
 * value before it rather than following it. That is a left fold, and it is how
 * the flat repetition every grammar writes for a binary operator becomes the
 * left-leaning tree it means. *)

(* The hole `expression.phx` left open. An expression grammar cannot know
 * what a language's atoms are, and these two lines are calc's whole
 * answer to that -- the precedence, the associativity, the comparisons,
 * the grouping and unary minus all come from the module. *)

primary = integer -> Number(text: $1)
        | name    -> Variable(name: $1) .


(* ------------------------------------------------------------------ *)
(* `lib/expression.phx` brings a `show` pass that renders an expression  *)
(* back to something close to what was read, for putting inside a        *)
(* diagnostic. It covers the nodes the module builds and no others, so   *)
(* calc adds the statements -- which it needs anyway, because a pass     *)
(* walks the whole tree and every node it reaches wants a clause.        *)

%pass show
  Print    : show = "print {};"    of $value.show .
  Let      : show = "let {} := {};" of $name, $value.show .
  Assign   : show = "{} := {};"     of $name, $value.show .
  If       : show = "if {} then ..." of $cond.show .
  IfElse   : show = "if {} then ... else ..." of $cond.show .
  While    : show = "while {} do ..." of $cond.show .
  Block    : show = "..." .
  Program  : show = "..." .

(* ------------------------------------------------------------------ *)
(* Pass one: are the names defined, and do the types line up?          *)
(*                                                                     *)
(* This is the pass a hand-written compiler spends a visitor class and  *)
(* a traversal on. Here it is the clauses, and no traversal.            *)

%pass typecheck

  (* A symbol table is a fold over the tree in document order, which is
   * exactly what a threaded attribute is. *)
  thread env = empty

  Number   : type = "int" .
  Variable : type = lookup($env, $name)
           ! not defined($env, $name) : "'{}' is not defined" of $name .

  Let      : env  = bind($env, $name, $value.type)
           : type = "void" .

  Assign   : type = "void"
           ! not defined($env, $name)
               : "'{}' is assigned before it is declared" of $name
           ! $value.type <> lookup($env, $name)
               : "'{}' holds {}, and this assigns {}"
                   of $name, lookup($env, $name), $value.type .

  (* `$left.show` is `lib/expression.phx`'s doing, and it is readable here
   * only because a driver runs `show` before `typecheck`. A pass reading
   * another pass's work is the whole reason a sequence is written down. *)
  Binary   : type = "int"
           ! $left.type <> "int" or $right.type <> "int"
               : "'{}' wants two ints: {} is {} and {} is {}"
                   of $op, $left.show, $left.type, $right.show, $right.type .

  Compare  : type = "bool"
           ! $left.type <> $right.type
               : "'{}' compares {} with {}" of $op, $left.type, $right.type .

  (* `expression.phx` builds these three, so calc has to answer for them
   * even though it did not write the grammar that makes them. That is what
   * importing a grammar module costs, and the module says so. *)
  Negate   : type = "int"
           ! $value.type <> "int" : "'-' wants an int, and got {}" of $value.type .
  Not      : type = "bool"
           ! $value.type <> "bool" : "'not' wants a bool, and got {}" of $value.type .
  Logical  : type = "bool"
           ! $left.type <> "bool" or $right.type <> "bool"
               : "'{}' wants two bools, and got {} and {}"
                   of $op, $left.type, $right.type .

  Print    : type = "void"
           ! $value.type <> "int"
               : "print wants an int, and {} is {}" of $value.show, $value.type .

  If       : type = "void"
           ! $cond.type <> "bool"
               : "an if wants a bool, and {} is {}" of $cond.show, $cond.type .
  IfElse   : type = "void"
           ! $cond.type <> "bool"
               : "an if wants a bool, and {} is {}" of $cond.show, $cond.type .
  While    : type = "void"
           ! $cond.type <> "bool"
               : "a while wants a bool, and {} is {}" of $cond.show, $cond.type .

  Block    : type = "void" .
  Program  : type = "void" .

(* ------------------------------------------------------------------ *)
(* Pass two: run it, without generating anything.                      *)
(*                                                                     *)
(* **This pass works on straight-line programs and cannot work on any   *)
(* other kind, and the reason is worth understanding rather than        *)
(* working around.** An attribute is computed once per node, in one     *)
(* walk. A `while` needs its body evaluated an unknown number of times, *)
(* and a branch that is not taken must leave the variables alone -- and *)
(* neither of those is a thing a value computed once per node can say.  *)
(*                                                                     *)
(* So interpreting is for checking a language while it is being         *)
(* designed, and compiling is what Phoenix is for. The clauses below    *)
(* say so where a program runs into it, rather than failing obscurely.  *)

%pass eval
  thread env = empty

  Number   : val = int($text) .
  Variable : val = lookup($env, $name)
           ! not defined($env, $name) : "'{}' is not defined" of $name .

  Binary(op: "+") : val = $left.val + $right.val .
  Binary(op: "-") : val = $left.val - $right.val .
  Binary(op: "*") : val = $left.val * $right.val .
  (* `quotient`, not `div`. Phoenix's `div` is floored and C's `/`
   * truncates, so `0 - 7 / 2` would be -4 interpreted and -3 compiled --
   * the same program answering two things. **calc's division truncates**,
   * and saying so once here is what makes the two passes agree.
   *
   * This is docs/semantics.md's headline in miniature: Phoenix's
   * arithmetic is not the target's, and a pass that models a target
   * writes the model out. *)
  (* **This check is the interpreter's, and only the interpreter's.** It reads
   * `$right.val`, so it can only fire where the value is known at walk time --
   * and that is a property of `eval`, not of calc. A *compiled* calc program
   * divides by zero at run time and the two backends answer differently:
   * `awk` is fatal and says so, and C is undefined behaviour, which on the
   * machine this was written on quietly produced 0.
   *
   * Nothing here is wrong. It is a thing calc has never said, the way it had
   * never said what `/` means until `quotient` was written down -- and the
   * cost is that a divide-by-zero program is outside the conformance rule
   * rather than covered by it. Saying it would mean a check the *backends*
   * emit, which is a language decision this calculator has not needed to make. *)
  Binary(op: "/") : val = quotient($left.val, $right.val)
                  ! $right.val = 0 : "division by zero" .

  Compare(op: "=")  : val = $left.val = $right.val .
  Compare(op: "<>") : val = $left.val <> $right.val .
  Compare(op: "<")  : val = $left.val < $right.val .
  Compare(op: ">")  : val = $left.val > $right.val .
  Compare(op: "<=") : val = $left.val <= $right.val .
  Compare(op: ">=") : val = $left.val >= $right.val .

  Negate   : val = 0 - $value.val .
  Not      : val = not $value.val .
  Logical(op: "and") : val = $left.val and $right.val .
  Logical(op: "or")  : val = $left.val or $right.val .

  Let      : env = bind($env, $name, $value.val)
           : out = "" .
  Assign   : env = bind($env, $name, $value.val)
           : out = "" .
  Print    : out = "{}\n" of $value.val .

  Block    : out = join($body.out) .
  Program  : out = join($body.out) .

  (* An attribute is computed once. These need a node evaluated a number
   * of times that depends on the program, so they are refused here and
   * compiled instead. *)
  While    : out = ""
           ! true : "a loop cannot be interpreted -- compile it with emit-c" .
  If       : out = ""
           ! true : "a branch cannot be interpreted -- compile it with emit-c" .
  IfElse   : out = ""
           ! true : "a branch cannot be interpreted -- compile it with emit-c" .
