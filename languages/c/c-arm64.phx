(* c-arm64.phx -- the C subset, compiled to arm64 assembly.
 *
 *     phx --driver arm64 languages/c/c-arm64.phx prog.c > prog.s
 *     cc prog.s -o prog && ./prog
 *
 * **This file is only the emit pass.** The grammar, the tree and the symbol
 * pass are in `c.phx` and are imported, because none of them has an opinion
 * about a machine.
 *
 * ---------------------------------------------------------------------------
 * The target is arm64 assembly text in the syntax `cc` assembles on this
 * machine, which is macOS's: `_main` with the underscore, `.p2align 2`, and
 * a local label that starts with `L` so the linker does not keep it. `cc`
 * assembles and links, which is what every C compiler except tcc borrows.
 *
 * **The emit pass is a stack machine.** Every expression leaves its value in
 * `x0`; a binary operator pushes the left operand, computes the right into
 * `x0`, and pops the left into `x1`. There is no register allocator, and the
 * output is slow and correct, which is chibicc's shape and tcc's. Every local
 * lives in the frame at a byte offset the `locals` pass assigned, below the
 * saved frame pointer.
 *
 * **The calling convention** is the machine's, AAPCS64 as Apple applies it:
 * the first eight integer arguments in `x0` to `x7`, the result in `x0`, or
 * for a struct in `x0` and `x1` or wherever the caller's `x8` says, and
 * `sp` sixteen-aligned at the call. A caller evaluates its arguments left to
 * right, pushing each, then loads the registers from the stack and drops it,
 * so an argument that is itself a call finds the ones before it safe. A
 * callee stores each parameter register into the parameter's slot in the
 * prologue, and from then on a parameter is a local. Nothing is kept in a
 * register across a call, so no register has to be saved.
 *
 * **A place is a second attribute and not a second node.** `x` on the right
 * of an `=` is a load and `x` on the left is an address, and both are the
 * same `Variable` in the tree; this pass gives it an `out` and an `addr` and
 * lets the parent ask for the one it meant. A pointer is a value like any
 * other, so `&` is the `addr` of a place and `*` is an `ldr` from a value,
 * and neither needs a register or an instruction the subset did not have.
 *
 * **An `int` is thirty-two bits and a pointer is sixty-four**, which is what
 * this machine's C says and, since 2026-09-22, what this file says. The two
 * are the same register: `w0` is the low half of `x0`, and **every write to a
 * `w` register zeroes the upper half**, so `x0` always holds the zero-extended
 * `w0` and a push of either is lossless. That is why the stack machine, the
 * calling convention and the frame are all unchanged by the width: what
 * changes is one letter per instruction, chosen from the node's type by a
 * table with one row in it.
 *
 * The value used to be sixty-four bits wide in a register C calls a 32-bit
 * `int`, which is chibicc's first shape. `tests/oracle/overflow.c` is the
 * program that ended it: `cc` wraps at thirty-two bits and exits 218, and
 * this file exited 160 until it wrapped too. See
 * [ROADMAP 6.1](../../docs/ROADMAP.md#61-step-one--a-subset-that-runs-and-cc-as-its-oracle)
 * for why a sixty-four bit `int` was a legal answer that was not taken.
 *)

%import "c.phx" .

%pass emit-arm64

  (* Every branch needs a label the program never wrote. A thread, counted on
   * leaving, so the number a node takes is one no node before it in the walk
   * took, its own children included. The names are local to the assembler
   * because they start with `L`. *)
  thread label = 0

  (* ---- which half of the register ----
   *
   * `lookup([[0, "w"]], t, "x")` is the whole of the width in this pass: a
   * type of no stars is an `int` and lives in a `w`, and anything with a star
   * is a pointer and lives in an `x`. It is written out at each use rather
   * than hidden behind a name, because *which* type is being asked about is
   * the part that differs: a load asks the node's own, a store asks the place
   * it is storing into, and a comparison asks its left operand. The `types`
   * pass in `c.phx` counts the stars and has no opinion about registers,
   * which is the split this file exists for. *)

  (* ---- and how many bytes of it ----
   *
   * `char` made the width a size rather than a letter. A value is one byte,
   * four or eight, and a load and a store each have three instructions, one
   * per size, in the two tables below: every load and store in this pass
   * reads one of them with the size of the thing in memory.
   *
   * **A `char` is loaded with `ldrsb`**, which sign-extends its byte into
   * `w0`, because a plain `char` is **signed** on Apple's arm64: Apple departs
   * from AAPCS64 here, whose `char` is unsigned, and `char-is-signed.c` in the
   * oracle is the program that knows. Sign-extending into a `w` is also the
   * whole of C11 6.3.1.1's promotion: what arrives in `w0` is already the
   * `int` the expression around it wants, zero-extended into `x0` like any
   * other. A store is `strb`, which keeps the low byte, and that is the
   * conversion 6.3.1.3 leaves to the implementation and this one does
   * modulo 256, as `cc` does. *)

  (* `ldr w0, =n` is the assembler's pseudo-instruction for *any* constant:
   * it becomes a `mov` when the value fits and a load from a literal pool
   * when it does not, and this description does not have to know which. A
   * constant written in a C program is an `int`, so it is always a `w`. *)
  Number : out = "\tldr w0, ={}\n" of $text .

  (* A character constant is an `int` too, and its code was worked out by the
   * `types` pass, because what `'a'` is worth is C's business. *)
  Character : out = "\tldr w0, ={}\n" of $code .

  (* ---- string literals ----
   *
   * A string literal is an array in static storage, C11 6.4.5, so its bytes
   * go in `__TEXT,__cstring` under a label of their own, and the expression
   * is the address: `adrp` finds the 4K page the label is on and `add` the
   * offset within it, which is how anything outside the frame is reached on
   * this machine. The label is numbered from the thread every branch uses,
   * so no two things share a number.
   *
   * The literals are collected by a second thread, `data`, in the order the
   * walk meets them, and written out once by `Program`, after the code. A
   * thread is what a walk in document order has, and reading one in the
   * clause of the node that ends the walk gives its last value, which is how
   * `Function` reads its frame size off `bytes` in `c.phx`.
   *
   * **The assembler is handed the text, not the bytes.** The notation has
   * no way to walk text one character at a time, so the escapes cannot be
   * turned into numbers here; the assembler reads `\n \t \\ \"` as C does.
   * It does **not** read `\'`, which this machine's `as` refuses as an
   * unrecognised escape and C allows, so that one is rewritten as the quote
   * it stands for. A `\'` has to be told apart from the end of `\\'`,
   * which is an escaped backslash and then a plain quote, so the escaped
   * backslashes are set aside as tabs first, the way the `types` pass counts
   * the length, and put back after. *)
  thread data = ""

  String : n    = $label : label = $label + 1
         : asm  = join(split(join(split(join(split($body, "\\\\"), "\t"), "\\'"), "'"),
                             "\t"), "\\\\")
         : data = "{}Lstr{}:\n\t.asciz \"{}\"\n" of $data, $n, $asm
         : out  = "\tadrp x0, Lstr{}@PAGE\n\tadd x0, x0, Lstr{}@PAGEOFF\n" of $n, $n .

  (* ---- places, and the two questions a node can be asked ----
   *
   * A local starts at `x29` minus its offset and runs upward from there, so
   * `[x29, #-offset]` is its first byte. `x29` is the frame pointer and the
   * saved pair sits at it, so the frame extends downward.
   *
   * A `Variable`, a `Deref` and a `Member` each answer **two** attributes,
   * because each is two things depending on who is asking: `out` is the
   * value, which is what an expression wants, and `addr` is where that value
   * lives, which is what an assignment, `&` and a member want. For an
   * assignment and `&` the `place` rule in `c.phx` sees that nothing else is
   * asked. A member is asked of anything that is a struct, which is these
   * three and two that compute one: an assignment of a struct, and a call
   * that returns one, since 2026-09-23. Each of those two leaves the
   * struct's address in `x0`, so its `addr` is its `out`. *)
  (* **An array is its own address, and so is a struct.** A name that is an
   * array decays to a pointer to its first element, and the address is what
   * it already had, so the load a scalar needs is the thing an array does not
   * do. A struct is not loaded either, because no register holds one: what
   * is done with a struct is to find a member of it, or its address, and
   * both start from where it is. The `types` pass says which a name is, as
   * `aggregate`, and the unused `load` costs a string.
   *
   * *For a struct this has no witness, and cannot have one.* A member and
   * `&` ask for `addr`, so the only thing that asks a struct for its `out` is
   * a statement that throws it away, `s;` or `*p;`. Leaving the load in was
   * tried, here and at `Deref`, and changed no byte of any program in the
   * oracle. It is kept because a load of eight bytes from a struct of two is
   * a read past the object, which a program cannot see and should not do.
   * An array's decay is the half that is observed. The register for a
   * scalar comes from its `size` rather than its stars, because `size` is
   * the thing that knows. *)
  Variable  : load = "\t{}, [x29, #-{}]\n"
                  of lookup([[1, "ldrsb w0"], [4, "ldr w0"]], $size, "ldr x0"), $offset
            : addr = "\tsub x0, x29, #{}\n" of $offset
            : out  = lookup([[true, $addr]], $aggregate, $load) .

  (* A dereference is a load from what the value came out as, and its address
   * is that value before the load, so `&*p` emits exactly what `p` emits and
   * the identity C11 6.5.3.2 states falls out of the pair rather than being
   * written anywhere. *)
  (* A dereference of a pointer to a struct is the struct, and so is its own
   * address like any other: `p->x` is `(*p).x`, and the `*` there is where
   * `p` points, with nothing loaded. *)
  Deref     : out  = lookup([[true, $value.out]], $aggregate,
                            "{}\t{}, [x0]\n"
                              of $value.out,
                                 lookup([[1, "ldrsb w0"], [4, "ldr w0"]], $size, "ldr x0"))
            : addr = $value.out .

  (* **A member is its struct's address plus its offset**, and then a load
   * like any other scalar's, or no load when it is an array or a struct in
   * its own right. The struct's address is its `addr`, which every node that
   * can have a struct's type answers: a name, a `*` and another member.
   * `s.a.b` is therefore two `add`s, and `p->next->v` a load between them,
   * which is what the tree says it is and nobody had to arrange.
   *
   * The offset is an immediate, which `add` takes up to 4095. A member
   * further in than that would not assemble, and no program here has one. *)
  Member    : addr = "{}\tadd x0, x0, #{}\n" of $value.addr, at($entry, 1)
            : out  = lookup([[true, $addr]], $aggregate,
                            "{}\t{}, [x0]\n"
                              of $addr,
                                 lookup([[1, "ldrsb w0"], [4, "ldr w0"]], $size, "ldr x0")) .

  (* `&` is the address and nothing more. *)
  Addr      : out  = $place.addr .

  (* The address first, pushed, then the value, then the store. The value
   * stays in `x0`, which is what makes `a = b = 21` and `*p = *q = 4` work:
   * an assignment is an expression worth what it assigned. Which side is
   * evaluated first C leaves unspecified, so this description decides, the
   * same way it decided for a binary operator: left first. *)
  (* The address is pushed and popped as an `x` whatever is being stored
   * through it, and the store itself takes the width of the **place**, which
   * is what C11 6.5.16.1 converts to.
   *
   * *And the value left behind is the place's too.* C11 6.5.16 makes an
   * assignment worth what the left side holds after it, so `(c = 300)` is
   * 44 and not 300 when `c` is a `char`. The `strb` kept one byte in memory
   * and nothing in `w0`, so a `sxtb` narrows the register the same way, and
   * is emitted only for a one-byte place, where the two can differ. *)
  (* **A struct is copied a byte at a time**, from the address in one
   * register to the address in another, counting down from its size to
   * zero. The count and the byte are in `x9` and `w10`, which AAPCS64 leaves
   * to whoever is running and which no argument travels in, so a copy can
   * run in a prologue between two parameters without disturbing either.
   * A struct is never empty here, so the loop runs at least once.
   *
   * Slow, and the stack machine's shape: one loop in every place a struct is
   * copied rather than a call to `memcpy`, which would need declaring and
   * would make every copy a call with registers to save around it. Counting
   * down makes `s = s` harmless, which C11 6.5.16.1 allows, and copying the
   * bytes rather than the members copies the padding too, which C11 6.2.6.1
   * leaves unspecified and `cc` also copies. The label is the one thing a
   * copy needs from the rest of the program, and a node takes a number only
   * when it copies, so no scalar program's labels moved.
   *
   * The loop is written once, as `copy` on `Program` at the foot of this
   * pass, and handed down: a pass has no constants, and everything under the
   * root can read what the root hands down. *)

  (* An assignment of a struct copies it, and is worth the destination, whose
   * address is what a struct is worth anywhere: `a = b = c` copies twice.
   * *Which of the two it is worth has no witness*: after the copy their
   * bytes are the same, and the one thing that would tell them apart is the
   * address of an assignment, which C has no way to take and the `types`
   * pass refuses. C11 6.5.16 says the left operand, and that is kept. *)
  Assign    : n     = $label : label = $label + lookup([[true, 1]], $aggregate, 0)
            : store = "{}\tstr x0, [sp, #-16]!\n{}\tldr x1, [sp], #16\n\t{}, [x1]\n{}"
                        of $place.addr, $value.out,
                           lookup([[1, "strb w0"], [4, "str w0"]], $place.size, "str x0"),
                           lookup([[1, "\tsxtb w0, w0\n"]], $place.size, "")
            : copied = "{}\tstr x0, [sp, #-16]!\n{}\tldr x1, [sp], #16\n{}\tmov x0, x1\n"
                        of $place.addr, $value.out,
                           ($copy of $place.size, $n, "x0", "x1", $n)
            : out   = lookup([[true, $copied]], $aggregate, $store)
            : addr  = $out .

  (* A declaration with an initialiser knows its own slot, so it stores
   * straight into it rather than working out an address it already has. *)
  LocalInit : copies = $ptrs = 0 and $base.tagname <> ""
            : n     = $label : label = $label + lookup([[true, 1]], $copies, 0)
            : out   = lookup([[true, "{}\tsub x1, x29, #{}\n{}"
                                       of $value.out, $offset,
                                          ($copy of $basew, $n, "x0", "x1", $n)]],
                             $copies,
                             "{}\t{}, [x29, #-{}]\n"
                               of $value.out,
                                  lookup([[1, "strb w0"], [4, "str w0"]],
                                         lookup([[0, $basew]], $ptrs, 8), "str x0"),
                                  $offset) .
  Local      : out = "" .
  LocalArray : out = "" .
  Discard   : out = $value.out .

  (* ---- calls ----
   *
   * An argument knows its index from a thread the call resets, and how many
   * there are from an attribute the call hands down; a nested call resets
   * the thread for its own subtree and puts it back, so the outer argument
   * still counts from where it was. Every argument is pushed, sixteen bytes
   * each, so argument i of n sits 16 * (n - 1 - i) above `sp` once all are
   * pushed, and that is where its register is loaded from.
   *
   * The load is an `x` whatever the argument is, and needs no width for the
   * same reason the condition does not: an `int` was pushed zero-extended, so
   * loading the whole register puts the right thirty-two bits in `w{i}`,
   * which is where AAPCS64 says a 32-bit argument goes. *)
  thread argn = 0

  (* **A struct passed whole**, since 2026-09-23, is AAPCS64's rule B.3 and
   * C.10 to C.12 as this machine applies them. One of up to eight bytes goes
   * in a register and one of up to sixteen in two, its bytes packed in order
   * as they lie in memory; a larger one is **copied by the caller** and the
   * copy's address goes in one register, so the callee may do what it likes
   * with it and the caller's struct is untouched. Nothing here is a float,
   * so the homogeneous aggregates of rule B.2 do not arise.
   *
   * So an argument is no longer one register, and which register it starts
   * at is counted on a second thread, `argreg`, beside the position that
   * finds its slot on the stack. The slot is still sixteen bytes for every
   * argument: a small struct is copied into its slot, zeroed first so that
   * a struct of three bytes leaves no stale bytes in the register, and read
   * back out with one `ldr` or an `ldp`; a large one's slot holds the
   * address of its copy, like any pointer.
   *
   * *The zeroing has no witness, and cannot have one*: without it the bytes
   * past a small struct's end are whatever was on the stack, and neither a
   * callee here nor one `cc` compiled reads them. It was taken out, and the
   * oracle and `tests/abi/` both stayed green. It is kept so that what a
   * register holds does not depend on what ran before.
   *
   * *Nor has the caller's copy, in the oracle*: a callee compiled here
   * copies a large struct again, so it would never notice a caller that did
   * not. A callee `cc` compiled writes into the memory it is handed, and
   * `tests/abi/` is the program that sees it.
   *
   * The copies of large structs live at the bottom of the caller's frame,
   * below its locals, each where the thread `temps` says, and `Function`
   * lowers `sp` by that much more. A copy is made when its argument is
   * evaluated and lasts to the end of the function, which is longer than
   * it needs and never shorter. *)
  thread argreg = 0
  thread temps  = 0

  Arg  : index  = $argn : argn = $argn + 1
       : small  = $value.record and $value.size <= 16
       : large  = $value.record and $value.size > 16
       : words  = lookup([[true, 2]], $small and $value.size > 8, 1)
       : reg    = $argreg : argreg = $argreg + $words
       : room   = (($value.size + 15) div 16) * 16
       : tpos   = $framebase + $temps + $room
       : temps  = $temps + lookup([[true, $room]], $large, 0)
       : n      = $label : label = $label + lookup([[true, 1]], $value.record, 0)
       : scalar = "{}\tstr x0, [sp, #-16]!\n" of $value.out
       : packed = "{}\tsub sp, sp, #16\n\tstp xzr, xzr, [sp]\n\tmov x1, sp\n{}"
                    of $value.out, ($copy of $value.size, $n, "x0", "x1", $n)
       : copied = "{}\tsub x1, x29, #{}\n{}\tstr x1, [sp, #-16]!\n"
                    of $value.out, $tpos, ($copy of $value.size, $n, "x0", "x1", $n)
       : out    = lookup([[true, $packed]], $small, lookup([[true, $copied]], $large, $scalar))
       : load   = lookup([[2, "\tldp x{}, x{}, [sp, #{}]\n" of $reg, $reg + 1, 16 * ($nargs - 1 - $index)]],
                         $words,
                         "\tldr x{}, [sp, #{}]\n" of $reg, 16 * ($nargs - 1 - $index)) .

  (* **A struct returned** is AAPCS64's rule B.5 and C.8 read backwards,
   * since 2026-09-23. One of up to sixteen bytes comes back packed in `x0`
   * and `x1`, the way it would have gone out as an argument; a larger one is
   * written by the callee into memory the caller provides, whose address the
   * caller passes in `x8`. Either way the caller ends up with the struct in
   * a place of its own in its frame, one of the `temps` an argument's copy
   * uses, and the call is worth its address, as any struct is. A small one
   * is stored there from the two registers after the call: both are stored,
   * which may write past the struct's own bytes and never past the sixteen
   * the temporary has.
   *
   * `x8` is set last, after the argument registers are loaded, because it is
   * not one of them and nothing between it and the `bl` touches it. *)
  Call : down held    = $argn
       : down heldreg = $argreg
       : down argn    = 0
       : down argreg  = 0
       : down nargs   = size($args)
       : argn   = $held
       : argreg = $heldreg
       : small  = $tag <> "" and $width <= 16
       : large  = $tag <> "" and $width > 16
       : room   = (($width + 15) div 16) * 16
       : tpos   = $framebase + $temps + $room
       : temps  = $temps + lookup([[true, $room]], $tag <> "", 0)
       : out = "{}{}\tadd sp, sp, #{}\n{}\tbl _{}\n{}"
           of join($args.out), join($args.load), 16 * size($args),
              lookup([[true, "\tsub x8, x29, #{}\n" of $tpos]], $large, ""),
              $name,
              lookup([[true, "\tsub x9, x29, #{}\n\tstp x0, x1, [x9]\n\tmov x0, x9\n" of $tpos]], $small,
                     lookup([[true, "\tsub x0, x29, #{}\n" of $tpos]], $large, ""))
       : addr = $out .

  (* A parameter's register is counted by the `locals` pass, which gives a
   * struct of nine to sixteen bytes two of them, and its half is its own
   * declaration's. AAPCS64 passes a 32-bit `int` in `w0` to `w7`, which are
   * the same eight registers as `x0` to `x7`, so the convention did not
   * notice the width change.
   *
   * A struct arrives the way `Arg` sent it: in one register, stored whole
   * into a slot of eight; in two, stored with an `stp` into a slot of
   * sixteen; or as the address of the caller's copy, copied from there into
   * the slot. The copy uses `x9` to `x11`, so the parameters after it are
   * still in their registers when their turn comes. *)
  Param : n      = $label : label = $label + lookup([[true, 1]], $whole and $basew > 16, 0)
        : scalar = "\t{}{}, [x29, #-{}]\n"
                     of lookup([[1, "strb w"], [4, "str w"]], lookup([[0, $basew]], $ptrs, 8), "str x"),
                        $preg, $offset
        : pair   = "\tstp x{}, x{}, [x29, #-{}]\n" of $preg, $preg + 1, $offset
        : one    = "\tstr x{}, [x29, #-{}]\n" of $preg, $offset
        : copied = "\tsub x11, x29, #{}\n{}"
                     of $offset, ($copy of $basew, $n, ("x{}" of $preg), "x11", $n)
        : out    = lookup([[true, lookup([[2, $pair]], $regs,
                                         lookup([[true, $copied]], $basew > 16, $one))]],
                          $whole, $scalar) .

  (* **The operand is not evaluated**, which is C11 6.5.3.4 and the whole
   * reason these two clauses do not mention `$value.out`: `sizeof bump(&x)`
   * does not call `bump`, and `sizeof(x = 2)` does not assign. The earlier
   * passes still walk the operand, so a name nothing declared and a call with
   * the wrong arity are refused inside a `sizeof` exactly as outside one,
   * which is also C.
   *
   * The size of a type is its base's width with no stars, which the `locals`
   * pass read off the layouts for an `int`, a `char` and a struct alike, and
   * eight with any. *)
  SizeOfType : out = "\tldr w0, ={}\n"
                   of lookup([[0, $base.basew]], $ptrs, 8) .
  SizeOfExpr : out = "\tldr w0, ={}\n" of $value.size .

  (* A condition is false when `x0` is 0, which is what C11 6.8.4 and 6.8.5
   * say and what `cset` left there. This one needs no width: an `int` in
   * `w0` is zero exactly when `x0` is, because `w0` was written last and
   * writing it zeroed the half above, and a pointer wants the whole of `x0`
   * tested anyway. So `cmp x0, #0` is right for both kinds of condition. *)
  If     : n = $label : label = $label + 1
         : out = "{}\tcmp x0, #0\n\tb.eq L{}.end\n{}L{}.end:\n"
             of $cond.out, $n, $then.out, $n .
  IfElse : n = $label : label = $label + 1
         : out = "{}\tcmp x0, #0\n\tb.eq L{}.else\n{}\tb L{}.end\nL{}.else:\n{}L{}.end:\n"
             of $cond.out, $n, $then.out, $n, $n, $else.out, $n .
  While  : n = $label : label = $label + 1
         : out = "L{}.top:\n{}\tcmp x0, #0\n\tb.eq L{}.end\n{}\tb L{}.top\nL{}.end:\n"
             of $n, $cond.out, $n, $body.out, $n, $n .
  (* A missing condition is a loop that runs until a `return`, so the test
   * is there only when the condition is: the table answers "" for an empty
   * list and the branch for one of one. The other two clauses join to
   * nothing when empty and need no table. *)
  For    : n = $label : label = $label + 1
         : test = lookup([[0, ""]], size($cond),
                         "{}\tcmp x0, #0\n\tb.eq L{}.end\n" of join($cond.out), $n)
         : out = "{}L{}.top:\n{}{}{}\tb L{}.top\nL{}.end:\n"
             of join($init.out), $n, $test, $body.out, join($step.out), $n, $n .

  (* The push is sixteen bytes for an eight-byte value, because `sp` on this
   * machine must stay sixteen-aligned at every instruction that uses it, and
   * a push that kept the value dense would have to be paired to hold that.
   * The operands are evaluated left first, which C leaves unspecified and
   * this description therefore decides.
   *
   * One rule and a table, rather than a rule per operator: clauses for one
   * pattern go together, and a general `Binary` above `Binary(op: "+")` would
   * take everything, which `phx` refuses at read time.
   *
   * `sdiv` truncates toward zero, which is what C11 6.5.5 says `/` does, so
   * `(0 - 7) / 2` is -3 on both routes. A quotient by zero is undefined in C
   * and 0 on this processor, and no program in the oracle asks.
   *
   * **A pointer and an int is a multiply and an add.** After the pop the
   * left operand is in `x0` and the right in `x1`, and the `types` pass has
   * said which of them is the pointer. `smaddl x0, w{i}, w2, x{p}` takes the
   * int's thirty-two bits and the element's width, **sign-extends** both to
   * sixty-four, multiplies them and adds the pointer, and `smsubl` is the
   * same with a subtraction. The sign extension is where a 32-bit index
   * meets a 64-bit pointer: an `int` sits in its register zero-extended, so
   * `p[-1]` without it lands gigabytes past `p` rather than one element
   * before. The multiply is C11 6.5.6 counting in elements, and the
   * width is read off the result's type, which has the one star the element
   * does not. `-` takes the pointer on the left only, which is all C
   * allows, so the same template serves.
   *
   * *It was one instruction until `struct`*: `add x0, x{p}, w{i}, sxtw #s`,
   * which sign-extends, shifts and adds, and a shift is a multiply by 1, 4
   * or 8, which were the only widths an element had. A struct's width is
   * whatever its members make it, twelve for three `int`s, and no shift
   * multiplies by twelve. One template for every width was kept over a
   * shift for three of them and a multiply for the rest, because two
   * templates are a choice this pass would have to make correctly forever,
   * and the multiply is right for all of them.
   *
   * **Two pointers is the other way round**: subtract the addresses, then
   * divide by the element's width, which was a shift for the same reason
   * and is an `sdiv` for the same reason. The division is exact, because two
   * pointers into one array are a whole number of elements apart, so `sdiv`
   * truncating toward zero never rounds anything. The answer is an `int`, so
   * the last instruction writes `w0` to itself, which is what puts the
   * header's promise back: `x0` holds the zero-extended `w0`. The two sides
   * have the same width, because the `types` pass refuses two pointers that
   * differ, so the divisor is read off the left one.
   *
   * *The `mov` has no witness, and cannot yet*: it restores the upper half
   * nothing here reads, and is written for the day `ptrdiff_t` arrives with
   * `long` and the answer is the whole of `x0`, when it becomes the one to
   * delete. It was to be `typedef`, and `typedef` came without it: the type
   * has a name now and still no width to be.
   *
   * *The division gained one with `struct`.* It is **signed** because a
   * difference can be negative. While every width was a power of two, `asr`
   * and `lsr` differed only in bits an `int` does not keep, and that
   * breakage came back green. A width of twelve is not a power of two, and
   * `udiv` of -24 by 12 leaves `0x55555553` in the low half where `sdiv`
   * leaves -2. `struct-pointer-difference-negative.c` is the program that
   * sees it.
   *
   * Which of the three a node is, the `types` pass has already said: a
   * pointer on each side is a difference, a pointer answer is a step, and
   * anything else is two `int`s. *)
  Binary : mnemonic   = lookup([["+", "add"], ["-", "sub"], ["*", "mul"], ["/", "sdiv"]], $op, "?")
         : plain      = "\t{} w0, w0, w1\n" of $mnemonic
         : scaled     = "\tldr w2, ={}\n\tsm{}l x0, w{}, w2, x{}\n"
                          of lookup([[1, $width]], $type, 8),
                             $mnemonic,
                             lookup([[0, 0]], $left.type, 1),
                             lookup([[0, 1]], $left.type, 0)
         : difference = "\tsub x0, x0, x1\n\tldr x1, ={}\n\tsdiv x0, x0, x1\n\tmov w0, w0\n"
                          of lookup([[1, $left.width]], $left.type, 8)
         : out = "{}\tstr x0, [sp, #-16]!\n{}\tmov x1, x0\n\tldr x0, [sp], #16\n{}"
             of $left.out, $right.out,
                lookup([[true, $difference]], $left.type > 0 and $right.type > 0,
                       lookup([[0, $plain]], $type, $scaled)) .

  Negate : out = "{}\tneg w0, w0\n" of $value.out .

  (* The same push and pop, then a compare and a conditional set: `x0` is 1
   * where the condition held and 0 where it did not, which is what C11 6.5.8
   * and 6.5.9 say a comparison is worth. The conditions are the **signed**
   * ones, `lt` and not `lo`, because `int` is signed and `-1 < 1` has to be 1. *)
  Compare : out = "{}\tstr x0, [sp, #-16]!\n{}\tmov x1, x0\n\tldr x0, [sp], #16\n\tcmp {}0, {}1\n\tcset w0, {}\n"
              of $left.out, $right.out,
                 lookup([[0, "w"]], $left.type, "x"),
                 lookup([[0, "w"]], $left.type, "x"),
                 lookup([["==", "eq"], ["!=", "ne"], ["<", "lt"], ["<=", "le"],
                         [">", "gt"], [">=", "ge"]], $op, "?") .

  (* The value is already in `x0`, so returning is a jump to the epilogue.
   * The epilogue's label is the enclosing function's, handed down.
   *
   * **A struct is copied on its way out**, from its address in `x0`. One of
   * up to sixteen bytes is copied into sixteen zeroed bytes below `sp` and
   * loaded from there into `x0` and `x1` with one `ldp`, which is the
   * argument's packing again, and for the same reason: an `ldp` straight
   * from the struct would read past its end. A larger one is copied to the
   * address the caller passed in `x8`, which the prologue kept, since a call
   * in the body may have used `x8` for a struct of its own. The epilogue puts
   * `sp` back from `x29`, so nothing lowered here has to be raised.
   *
   * *The zeroing has no witness*, as an argument's has none, and for the
   * same reason: the bytes past a small struct's end are read by nobody, and
   * taking it out left the oracle green. It is kept so that what comes back
   * in the registers does not depend on what ran before. *Keeping `x8`* has
   * two: `struct-return-recursive.c`, whose large struct is returned after
   * a call that returned one of its own, and `tests/abi/`, where a callee
   * `cc` compiled does the same. *)
  Return : n     = $label : label = $label + lookup([[0, 0]], $retsize, 1)
         : small = "{}\tsub sp, sp, #16\n\tstp xzr, xzr, [sp]\n\tmov x1, sp\n{}\tldp x0, x1, [sp]\n"
                     of $value.out, ($copy of $retsize, $n, "x0", "x1", $n)
         : large = "{}\tldr x1, [x29, #-{}]\n{}"
                     of $value.out, $x8slot, ($copy of $retsize, $n, "x0", "x1", $n)
         : out   = "{}\tb L{}.ret\n"
                     of lookup([[0, $value.out]], $retsize,
                               lookup([[true, $small]], $retsize <= 16, $large)),
                        $fname .

  Block  : out = join($body.out) .

  (* The prologue saves the frame pointer and the return address, and lowers
   * `sp` past the locals, rounded up to the sixteen the machine insists on
   * (the frame is a count of bytes since arrays arrived, and was a count of
   * slots before);
   * the epilogue restores `sp` from `x29` and so needs no count. Between
   * them, the body -- and before the epilogue's label, on the path that falls
   * off the end of the body, a zero. C11 5.1.2.2.3 says reaching the `}` of
   * `main` returns 0, and for any other function it says nothing, of which 0
   * is one instance.
   *
   * *A function returning a large struct keeps `x8`* in the first of its
   * `temps`, sixteen bytes held back from the start for it, and stores it
   * there before anything else in the prologue can disturb it. `retsize` is
   * 0 for an `int`, which is what every `Return` asks first. *)
  Function : down fname     = $name
           : down framebase = $frame
           : down retsize   = lookup([[true, $ret.basew]], $ret.tagname <> "", 0)
           : down x8slot    = $frame + 8
           : down temps     = lookup([[true, 16]], $retsize > 16, 0)
           : out = "\t.globl _{}\n\t.p2align 2\n_{}:\n\tstp x29, x30, [sp, #-16]!\n\tmov x29, sp\n\tsub sp, sp, #{}\n{}{}{}\tmov x0, #0\nL{}.ret:\n\tmov sp, x29\n\tldp x29, x30, [sp], #16\n\tret\n"
               of $name, $name, (($frame + $temps + 15) div 16) * 16,
                  lookup([[true, "\tstr x8, [x29, #-{}]\n" of $x8slot]], $retsize > 16, ""),
                  join($params.out), join($body.out), $name .

  Prototype : out = "" .
  StructDef : out = "" .
  Typedef   : out = "" .
  Program   : down copy = "\tldr x9, ={}\nL{}.copy:\n\tsub x9, x9, #1\n\tldrb w10, [{}, x9]\n\tstrb w10, [{}, x9]\n\tcbnz x9, L{}.copy\n"
            : out = "\t.text\n{}\n\t.section __TEXT,__cstring\n{}" of join($items.out, "\n"), $data .

%driver arm64 = functions, locals, types, emit-arm64 -> out .
%driver check = functions, locals, types .
