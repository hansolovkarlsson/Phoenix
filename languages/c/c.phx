         : sone   = join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split(join(split($shex, "\\0"), "\x04"), "\\1"), "\x04"), "\\2"), "\x04"), "\\3"), "\x04"), "\\4"), "\x07"), "\\5"), "\x07"), "\\6"), "\x07"), "\\7"), "\x07"), "\x040"), "\x05"), "\x041"), "\x05"), "\x042"), "\x05"), "\x043"), "\x05"), "\x044"), "\x05"), "\x045"), "\x05"), "\x046"), "\x05"), "\x047"), "\x05"), "\x050"), "\x06"), "\x051"), "\x06"), "\x052"), "\x06"), "\x053"), "\x06"), "\x054"), "\x06"), "\x055"), "\x06"), "\x056"), "\x06"), "\x057"), "\x06"), "\x070"), "\x08"), "\x071"), "\x08"), "\x072"), "\x08"), "\x073"), "\x08"), "\x074"), "\x08"), "\x075"), "\x08"), "\x076"), "\x08"), "\x077"), "\x08"), "\x080"), "\x0b"), "\x081"), "\x0b"), "\x082"), "\x0b"), "\x083"), "\x0b"), "\x084"), "\x0b"), "\x085"), "\x0b"), "\x086"), "\x0b"), "\x087"), "\x0b")
         : snum   = size(split($ssingle, "\\")) <> size(split($sone, "\\"))
         : slen   = size($sone) - (size(split($sone, "\\")) - 1) - 2 * (size(split($sone, "\"\"")) - 1) .

  (* **A character constant's code**, since 2026-10-04, worked out here and
   * not in `types`, so that `ev` and `eok` have it and an enumerator can be
   * written `A = 'a'`, C11 6.6p6. *)
  Character : inner = slice($text, 2, size($text) - 1)
            : chex  = slice($inner, 1, 2) = "\\x"
            : coct  = slice($inner, 1, 1) = "\\" and slice($inner, 2, 2) >= "0" and slice($inner, 2, 2) <= "7"
            : cdig  = lookup([[true, slice($inner, 3, size($inner))]], $chex,
                             lookup([[true, slice($inner, 2, size($inner))]], $coct, "0"))
            : cnum  = lookup([[true, int(lookup([[true, $cdig]], size($cdig) <= 2, "0"), 16)]], $chex,
                             lookup([[true, int(lookup([[true, $cdig]], $coct, "0"), 8)]], $coct, 0))
            : cval  = lookup([[true, $cnum]], $chex or $coct,
                       lookup([["\\n", 10], ["\\t", 9], ["\\\\", 92], ["\\'", 39],
                              ["\\\"", 34], ["\\a", 7], ["\\b", 8],
                              ["\\f", 12], ["\\r", 13], ["\\v", 11], ["\\?", 63]], $inner,
                             size(at(split(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~",
                                           $inner), 1)) + 32))
            : code  = lookup([[true, $cval - 256]], $cval > 127, $cval)
            : ev    = $code
            : eok   = true .

  (* **A global takes no frame**, and is bound in `globals` instead of
   * `env`, with the name its entry needs and nothing the frame counts. Its
   * width and alignment are the emit pass's, to lay it out in
   * `__DATA,__data`. The refusals are a local's, and three of file scope's
   * own: a name a function or a typedef already has, a global declared
   * again with another type, and two initialisers. A second declaration
   * with the same type is C11 6.9.2's tentative definition, since ROADMAP
   * 6.12's second part, and was refused by name until then; the entry
   * keeps whether any declaration so far had an initialiser. *)
  (* **A name declared through a typedef of a function's type** declares a
   * function, `binop add;`, C11 6.7.6.3, since ROADMAP 6.14's fourth part,
   * when such a typedef could be written: refused by name in each
   * declarator below, `Local`, `Static`, `Param` and `MemberScalar`, since
   * what it declares has no body and no storage. As a parameter it would
   * be a pointer to the function, 6.7.6.3p8.
   *
   * **At file scope it is a prototype**, since 2026-10-04: `fnty` says
   * so, and the `Global` binds no global and takes no storage, but copies
   * the typedef's entries in the five tables a call reads, which its `Sig`
   * bound under its key, to its own name. The `functions` pass counts a
   * function's parameters to check its declarations agree and cannot see
   * a typedef's, so `tdfns` keeps the names declared this way, and each
   * declaration of a function checks its count against them here, kept
   * in `tdfns` itself, since a definition has bound its own by then.
   * A typedef with no prototype, `typedef int F();`, says no count, so
   * neither it nor a `()` declaration is checked against one, and its
   * entries are copied only where the name has none, as a `()` prototype
   * binds, so a prototype written before it still says what is taken.
   * The thread is declared above `Prototype`, since a function declared
   * in a block records its count in it too. *)
  otherwise fnty = false
  Global      : down dbase   = $base
              : fnty    = $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> ""
              : fnkey   = at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6)
              : fnun    = at(lookup($funcs, $fnkey, [0, 0]), 2) = 2
              : funcs   = lookup([[true, bind($funcs, $name, lookup($funcs, $fnkey, [0, 0]))]], $fnty and not ($fnun and defined($funcs, $name)), $funcs)
              : sigs    = lookup([[true, bind($sigs, $name, lookup($sigs, $fnkey, []))]], $fnty and not ($fnun and defined($funcs, $name)), $sigs)
              : rets    = lookup([[true, bind($rets, $name, lookup($rets, $fnkey, ["", 4, 0, false, "0"]))]], $fnty and not ($fnun and defined($funcs, $name)), $rets)
              : pwidths = lookup([[true, bind($pwidths, $name, lookup($pwidths, $fnkey, []))]], $fnty and not ($fnun and defined($funcs, $name)), $pwidths)
              : plvs    = lookup([[true, bind($plvs, $name, lookup($plvs, $fnkey, []))]], $fnty and not ($fnun and defined($funcs, $name)), $plvs)
              : tdfns   = lookup([[true, bind($tdfns, $name, lookup($funcs, $fnkey, [0, 0]))]], $fnty, $tdfns)
              : fblock  = lookup([[true, bind($fblock, $name, false)]], $fnty, $fblock)
              ! $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> "" and defined($funcs, $name)
                and lookup($funcs, $name, [0, 0]) <> lookup($funcs, at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6), [0, 0])
                and at(lookup($funcs, $name, [0, 0]), 2) <> 2 and at(lookup($funcs, at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6), [0, 0]), 2) <> 2
                  : "'{}' is declared twice, with a different number of parameters or '...' each time" of $name
              ! $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> "" and defined($rets, $name)
                and lookup($rets, $name, []) <> lookup($rets, at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6), [])
                  : "'{}' is declared twice, returning a different type each time" of $name
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                size($paren), join($paren.t))
              : lv     = $lvin
              : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = int(at(split(at(split($lv, "|"), 1), ":"), 2))
              : galign = int(at(split(at(split($lv, "|"), 1), ":"), 4))
              : whole  = $ebytes
              : globals = lookup([[true, $globals]], $fnty, bind($globals, $name, [0, $ptrs, 0, $basew, $base.tagname, true, defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 7),
                                                 $base.buns, $name, $dquals, false, $lv]))
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void" and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) = ""
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0 and not $base.sext and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) = ""
                  : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 3), lookup([[true, 0]], at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "" and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "void", at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 4)), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 10)] <> [$stars + $base.ptrs, 0, lookup([[true, 0]], $base.tagname <> "" and $base.tagname <> "void", $base.basew), $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
