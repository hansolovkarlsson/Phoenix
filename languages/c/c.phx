(* c.phx -- a C subset: what it looks like, and what it means.
 *
 * **The language, and nothing about any target.** The grammar, the tree it
 * builds and the symbol pass are here; `c-arm64.phx` imports this file and
 * adds one emit pass.
 * That is the split `languages/README.md` prescribes and the reason a second
 * target could arrive without touching this file.
 *
 *   phx languages/c/c-arm64.phx prog.c                       the tree
 *   phx --driver check languages/c/c-arm64.phx prog.c         the symbols
 *   phx --driver arm64 languages/c/c-arm64.phx prog.c > prog.s
 *   cc prog.s -o prog && ./prog
 *
 * ---------------------------------------------------------------------------
 * What this is for
 *
 * [ROADMAP 6](../../docs/ROADMAP.md#6-a-c-compiler) is the one entry on that
 * page that is a language rather than a mechanism: the compiler is the goal
 * and the mechanisms it turns out to need are the findings. The subset grows
 * in chibicc's order, one construct at a time with the suite green at each.
 * Step one stopped before `typedef` on purpose, because that was where the
 * tool was expected to need a change, and the change was to arrive with the
 * construct that wanted it. It did: `typedef` is here, and `%names`, below,
 * is the change.
 *
 * **What is here is every construct of step one**: `int main(){return 42;}`,
 * then `+ - * /` with parentheses, then unary minus and the six comparisons,
 * then a local `int`, then `if`, `while`, `for` and blocks as statements,
 * then functions with `int` parameters and calls, then `&` and `*` with the
 * pointer declarators that make them useful, then `sizeof`, then an array of
 * `int` or of pointers, which decays to a pointer to its first element, then
 * a subscript and the pointer arithmetic it is made of, then `char`,
 * character constants and string literals, then `struct` with `.` and `->`.
 * A function returning `int` with up to eight parameters, a body of declarations, assignments, expression
 * statements, control flow and `return`s, and expressions over constants,
 * locals, calls, pointers and members, prototypes so that a call can come
 * above the function it names, and structs defined at file scope. A name nothing declared, one declared twice in a
 * scope, one used outside its block, a call before a declaration or with the
 * wrong number of arguments, a function defined twice or declared with two
 * arities, a ninth parameter, a `*` on what is not a pointer, and arithmetic
 * on one, are refused.
 *
 * **Then `typedef`**, at file scope, of a base and any number of stars, a
 * struct included, and hidden by an ordinary name declared in a block or as
 * a parameter until that scope ends. A typedef declared twice for two types
 * is refused.
 *
 * **Then a struct copied whole**, by `=`, by an initialiser and as an
 * argument, the last under AAPCS64 so that a struct passes between this
 * code and `cc`'s. A copy between two kinds of struct, or between a struct
 * and anything else, is refused, and so is a struct anywhere C wants a
 * number, which compiled until then into the struct's address.
 *
 * **Then a struct returned**, under AAPCS64 again, in `x0` and `x1` or
 * through the address the caller passes in `x8`. A function returns an `int`
 * or a struct: a `char` or a pointer returned is refused by name, and so is
 * a `main` that returns a struct.
 *
 * **Then `long`**, signed and eight bytes, as a base like `int` and `char`.
 * An `int` meeting a `long` is converted to one, C11 6.3.1.8, and the
 * difference of two pointers is a `long`, as C has it; `sizeof` was one too
 * until 2026-09-27, when it became the `unsigned long` C has. A decimal
 * constant too big for an `int` is a `long`; a suffix was a syntax error
 * until the same day, when hex, octal and the suffixes arrived with C11
 * 6.4.4.1's table of types.
 *
 * **Then the specifiers as C11 6.7 has them**, since ROADMAP 6.12's first
 * part: the words of a type in any order and counted, `int long unsigned`,
 * a storage class anywhere among them, `auto` and `register`, and every one
 * of C11's 44 keywords reserved, those whose feature is not here refused by
 * name. A list of words that is no type, two storage classes, and a storage
 * class where C forbids it are refused.
 *
 * **Then declarations of several names**, ROADMAP 6.12's second part:
 * `int a = 1, b, *p;` at file scope, in a block and in a struct, a `for`
 * that declares, parameters without names in a prototype, `extern`, C11
 * 6.9.2's tentative definitions, `_Static_assert`, and a definition with an
 * identifier list, whose declarations come one name each and in its order.
 *
 * ---------------------------------------------------------------------------
 * The lexical half is written here rather than imported. `lib/lexical.phx`
 * reads `#` as a line comment, which C does not, and every rule it carries
 * would become a token kind whether the subset has it or not. C's own
 * conventions -- hex and octal constants, suffixes, character literals,
 * strings with escapes -- arrive with the constructs that need them.
 *)

%fragment letter digit hexdigit isuffix escape plain sescape splain .

letter   = "a" .. "z" | "A" .. "Z" | "_" .
digit    = "0" .. "9" .
hexdigit = "0" .. "9" | "a" .. "f" | "A" .. "F" .

name    = letter { letter | digit } .

(* **An integer constant is decimal, octal or hex, with a suffix**, since
 * 2026-09-27, ROADMAP 6.9: `u`, `l`, or both in either order and either
 * case, C11 6.4.4.1. The scanner takes the longest match, so what C
 * refuses is a syntax error at the letters left over: `0x` with no digits
 * stops at the `x`, `1uu` at its second `u`, and `1ll`, `long long`'s
 * suffix, which is not here, at its second `l`. An octal constant with an
 * 8 or a 9 in it is scanned whole and refused by the `types` pass, which
 * reads the digits. *)
isuffix = ( "u" | "U" ) [ "l" | "L" ] | ( "l" | "L" ) [ "u" | "U" ] .
integer = ( "0" ( "x" | "X" ) hexdigit { hexdigit } | digit { digit } ) [ isuffix ] .

(* A character constant is one character between single quotes, or one
 * escape. **Printable ASCII only**, and the three ranges are that and nothing
 * else: a space to `~`, less the quote at 39 and the backslash at 92, which
 * are what an escape is for. A tab typed between the quotes is C and is
 * refused here, as are `'ab'`, which C leaves to the implementation, and the
 * octal and hex escapes, which arrive when a program wants one.
 *
 * The lexer saying exactly this is what lets the `types` pass work out a
 * code without asking whether it can: anything that reaches it is one of the
 * ninety-five characters in its table, or one of six escapes. *)
escape    = "\\" ( "n" | "t" | "\\" | "'" | "\"" | "0" ) .
plain     = " " .. "&" | "(" .. "[" | "]" .. "~" .
character = "'" ( escape | plain ) "'" .

(* A string literal is the same characters between double quotes, where the
 * double quote needs an escape and the single one does not, and with **five**
 * escapes rather than six. `\0` is left out because a string is where it
 * stops meaning what it seems to: C reads up to three octal digits after the
 * backslash, so `"\01"` is one byte and not a NUL and a `1`, and a lexer
 * that knew only `\0` would count two. It is refused rather than
 * miscounted, and arrives with the octal escapes. A character constant keeps
 * it, because the closing quote ends it there. Two literals side by side,
 * which C joins, are a syntax error here. *)
sescape = "\\" ( "n" | "t" | "\\" | "'" | "\"" ) .
splain  = " " .. "!" | "#" .. "[" | "]" .. "~" .
string  = "\"" { sescape | splain } "\"" .

space         = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .
line-comment  = "//" { ! "\n" } .
block-comment = "/*" { ! "*/" } "*/" .

(* Three characters before two before one, every time: `<` first would leave the `=` of
 * `<=` behind, and the error would surface at the token after it. It matters
 * most for `&&`, since 2026-09-25: before it was a token, `a && b` was lexed
 * as two `&`s, and the day binary `&` arrives that spelling would parse, as
 * `a & (&b)`, which is ROADMAP 6.3's reason for building `&&` first. *)
symbol = "<<=" | ">>=" | "..."
       | "==" | "!=" | "<=" | ">=" | "->" | "&&" | "||" | "<<" | ">>"
       | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^="
       | "(" | ")" | "{" | "}" | ";" | "," | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "="
       | "&" | "|" | "^" | "~" | "!" | "?" | ":" | "[" | "]" | "." .

%skip space line-comment block-comment .

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* `int` and `return` are reserved by appearing below, which is what   *)
(* C's keyword list says about them too.                              *)

%syntax .
%start program .

program = { item } -> Program(items: $1) .

(* **What the parse keeps**, which is the one thing C asks of a parser that
 * no other language here has. `x * y;` declares `y` when `x` names a type and
 * multiplies when it does not, and `sizeof(x)` is the size of a type or of a
 * variable by the same test, so which rule a name belongs to is a question
 * about the declarations **above** it. ROADMAP 1.8 has the failure this
 * answers, measured before the notation had a way to say it.
 *
 * A `Typedef` declares its name a type. Every declaration of an ordinary
 * name hides one, because C11 6.2.1 lets `int T;` in a block make `T` a
 * variable until the block ends; a member does not, because members are a
 * name space of their own, 6.2.3. A block and a function each end what was
 * bound inside them, which is what makes the hiding end, and `function`
 * covers a prototype's parameters as much as a definition's, since C11 gives
 * a prototype a scope of its own. `typedef-name` is the one rule that asks. *)
%names typedef-names
    declare Typedef.name
    hide    Param.name Local.name LocalInit.name LocalArray.name
            Static.name StaticInit.name StaticArray.name
    scope   block function for-declaration
    guard   typedef-name .

(* A prototype or a definition, and the prototype first because it is the
 * shorter: the header is the same and `;` fails on `{`. C99 6.5.2.2 wants a
 * declaration above every call, so a prototype is how a call reaches a
 * function defined below it, and how two functions call each other.
 *
 * One return type. The body is the statements themselves and not a `Block`,
 * because C11 6.2.1 puts the parameters in the same scope as the body's
 * outermost declarations: `int f(int a) { int a; }` is declared twice, and a
 * `Block` would open a scope the parameters are not in. *)
item = function
     (* **`_Static_assert`**, C11 6.7.10, since ROADMAP 6.12's second part:
      * a condition the `constants` pass works out, and a message it gives
      * when the condition is zero. It may be an item or a statement. *)
     | "_Static_assert" "(" c:conditional "," m:string ")" ";" -> StaticAssert(cond: $c, message: $m, file: true)
     (* A struct is defined at file scope and only there, and always with a
      * tag. C allows both a definition inside a block, with the block's scope,
      * and a struct with no tag at all; neither is here yet, and a program
      * that writes one gets a syntax error rather than a wrong answer. A
      * struct with no members is **not** a syntax error, so that it can be
      * refused by name: see the `locals` pass. *)
     | "struct" n:name "{" f:{ member } "}" ";"
         -> StructDef(name: $n, members: $f)
     (* **A typedef is a name for a declaration's type**, a base and some
      * stars, and like a struct it is at file scope only: C allows one in a
      * block, with the block's scope, and the `locals` pass refuses it by
      * name. No array, `typedef int v[3];`, because a declaration's count is
      * a field of the declaration and not of its type; that arrives with
      * ROADMAP 6.12's fourth part, and is refused by name until then. The
      * word may stand anywhere among the specifiers, `int typedef t;`, as
      * C11 6.7.1 lets any storage class: see `tdspecifiers`. *)
     | b:tdspecifiers d:typedef-declarator r:{ "," e:typedef-declarator -> $e } ";"
         -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "file")
     (* **A global is a declaration at file scope**, since 2026-09-26,
      * ROADMAP 6.8, and is written as a local is: a base, stars and a name,
      * with a count in brackets or an initialiser. It is tried after a
      * function, which fails at the `;`, `[` or `=` where its `(` was
      * wanted. Three nodes, for the reason a local is three. *)
     | b:specifiers d:global-declarator r:{ "," e:global-declarator -> $e } ";"
         -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "file") .

(* **One declarator**, since ROADMAP 6.12's second part, when a declaration
 * became a `Decls`: the specifiers once, as `spec`, and each name after
 * them a node of its own in `items`, `int a = 1, b, *p;` three. Every pass
 * hands the specifiers down to the declarators as `base`, which is the name
 * the field had when each declaration was one name, so no clause that
 * reads `$base` changed. A declarator is the stars, the name, and a count
 * in brackets or an initialiser, as a declaration was; the three forms are
 * three nodes for the reason given for a local's, below. *)
typedef-declarator = s:pointer n:name
                       -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}"))) .
global-declarator  = s:pointer n:name "[" c:integer "]"
                       -> GlobalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c))
                   | s:pointer n:name "=" e:assignment
                       -> GlobalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), value: $e)
                   | s:pointer n:name
                       -> Global(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0) .
member-declarator  = s:pointer n:name "[" c:integer "]"
                       -> MemberArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c))
                   | s:pointer n:name
                       -> MemberScalar(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0) .
static-declarator  = s:pointer n:name "[" c:integer "]"
                       -> StaticArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c))
                   | s:pointer n:name "=" e:assignment
                       -> StaticInit(name: $n, stars: size($s), squals: join(each($s, "{}")), value: $e)
                   | s:pointer n:name
                       -> Static(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0) .
local-declarator   = s:pointer n:name "[" c:integer "]"
                       -> LocalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c))
                   | s:pointer n:name "=" e:assignment
                       -> LocalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), value: $e)
                   | s:pointer n:name
                       -> Local(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0) .

(* **`(void)` is a list of no parameters**, C11 6.7.6.3p10, since
 * 2026-09-26. It is two alternatives of its own, tried first, because the
 * notation has no syntactic lookahead: a `params` that took `void` alone
 * would have taken the `void` of `(void *p)` and been unable to give it
 * back. Here the whole alternative fails at the `*`, and the next is tried
 * from the name. *)
(* A function is a rule of its own because it is a **scope**: see `%names`
 * above. Its parameters hide a typedef of the same name from the `(` to the
 * end of the body, or to the `;` of a prototype, and no further.
 *
 * **What it returns is a `base` and some stars.** The base arrived on
 * 2026-09-23, and was the keyword `int` before: a struct returned whole is the
 * reason, and a base is the one node that already answers what a struct is.
 * The stars arrived on 2026-09-25, ROADMAP 6.2, and until then `int *f()` was
 * a syntax error and a typedef of a pointer was the only way to write one.
 * `char f()` parses too, and the `locals` pass refuses it by name.
 *
 * `item` tries this alternative first, and a struct's definition fails it at
 * the `{` after the tag, where a function's name was wanted, and moves on.
 *
 * **`static` says no other file can name it**, C11 6.2.2p3, since
 * 2026-09-29, ROADMAP 6.10, and the `functions` pass reads it from the
 * specifiers' words. A global takes it the same way, below. Until ROADMAP
 * 6.12's first part it was the first word or not there, and
 * `int static f(void)` was a syntax error; it may stand anywhere among the
 * specifiers now, as C11 6.7 has it. *)
function = r:specifiers t:pointer n:name "(" "void" ")" ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0)
         | r:specifiers t:pointer n:name "(" "void" ")" "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0,
                         body: $s, ids: [])
         | r:specifiers t:pointer n:name "(" p:params v:dots ")" ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                          variadic: size($v))
         | r:specifiers t:pointer n:name "(" p:params v:dots ")" "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                         variadic: size($v), body: $s, ids: [])
         | r:specifiers t:pointer n:name "(" i:name j:{ "," x:name -> $x } ")" p:{ kr-declaration } "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                         variadic: 0, body: $s, ids: flatten([[$i], $j])) .

(* A member is declared the way a local is, and is two nodes for the reason a
 * local is: `int a[0];` and `int a;` must not be spelled the same. There is no
 * initialiser, because C has none for a member. *)
member = b:sqlist d:member-declarator r:{ "," e:member-declarator -> $e } ";"
           -> MDecls(spec: $b, items: flatten([[$d], $r])) .

(* A parameter is a node and not a name, because it takes a slot the way a
 * local does and the emit pass has to store a register into it. The
 * repetition's action is what makes this a list of parameters rather than a
 * list of parameters and commas, and the rule's own action is what makes it
 * a list at all: a rule with no action answers the one thing it matched, so
 * one parameter would arrive bare and two would arrive in a node called
 * `params`. `-> $1` says *the list, whatever its length*. *)
params = [ param { "," q:param -> $q } ] -> $1 .

(* **`...` after the parameters**, since 2026-09-26, ROADMAP 6.6: a list of
 * one when the function is variadic and of none when it is not, so that
 * `size` is the flag, as it is the count of a declaration's stars. It needs
 * the comma, so `int f(...)`, which C11 6.7.6.3 refuses for want of a named
 * parameter before it, is `(` then `...` here and a syntax error at the
 * `...`; so is `...` anywhere but last, where the `)` was wanted. A
 * repetition's iteration that fails gives back what it took, which is what
 * lets `params` stop at the `,` in front of the `...`. *)
dots   = [ "," e:"..." -> $e ] -> $1 .
(* **A parameter may have no name**, since ROADMAP 6.12's second part:
 * `int add(int, int);` is a prototype of two. One without a name is bound
 * as "", which nothing can look up, and is not "a parameter twice". A definition's parameters are named, C11 6.9.1p5, which the
 * `functions` pass asks. *)
param  = b:specifiers s:pointer n:name -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")))
       | b:specifiers s:pointer n:no-name -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}"))) .

(* **The name of a parameter that has none**: nothing, answering "". It is
 * a factor so that `%names` has one to bind, and what it hides is a
 * typedef named "", which no program can write. The option inside it is
 * never taken, since two `...` in a row are no C; the notation has no rule
 * that matches nothing, and this is one that does. *)
no-name = [ "..." "..." ] -> "" .

(* **A definition with an identifier list**, C11 6.9.1p6, obsolescent and
 * still C: the names in the parentheses and a declaration for each before
 * the body. Each declaration is a parameter's, one name to one, and the
 * `functions` pass asks that they come in the list's order, which C does
 * not: this subset's limit, and a refusal by name. *)
kr-declaration = b:specifiers s:pointer n:name ";" -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}"))) .

(* What is at the bottom of the stars. **A node since `struct`**, and a keyword
 * before it: `int` and `char` were two words the `locals` pass turned into a
 * width with a table written out at each of five declarations. A struct's
 * width is not in any table written here, because the program defines it, so
 * the question moved to the one node that can answer it for every
 * declaration at once.
 *
 * **A typedef's name builds a node of its own** rather than a `Base`,
 * because what it names is a base *and some stars*, and a `Base` has no
 * stars to give. The `locals` pass has each answer how many, and a
 * declaration adds its own.
 *
 * **A declaration's specifiers are what C11 6.7 says**, since ROADMAP 6.12's
 * first part: storage classes, qualifiers, function specifiers and the words
 * of a type, **in any order**. Until then they came in one order, with
 * `static` first or not there, and `long unsigned` was a syntax error. Every
 * word is kept, spelled, in `words`, each with a space on both sides, so
 * that how many times a word was written is the pieces `split` makes of it
 * less one, and the `functions` pass counts the words of the type against
 * the list in 6.7.2p2 to find which type they name: `int long` is `long`,
 * and `long char` is none. A `Base` keeps its tag in `name` when it is a
 * struct, and "" when it is words.
 *
 * **All 44 of C11's keywords are here**, 6.4.1, because a word the grammar
 * names is reserved and one it does not is a name: until this part 21 of
 * them were, and `int float = 1;` compiled. A keyword whose feature is not
 * in the subset is still read, where C puts it, so that the passes can
 * refuse it by name and not a parse at whatever came after it. *)
typedef-name = name .

(* The words that are not the type's. A storage class, C11 6.7.1, is one of
 * six, `typedef` among them for syntax's sake; a function specifier one of
 * two, 6.7.4; a qualifier one of four, 6.7.3, and `_Alignas`, 6.7.5, reads
 * like one. `_Atomic` with parentheses is a type specifier, 6.7.2.4, and is
 * refused by the same name as the qualifier. *)
qualifier = "const" | "volatile" | "restrict"
          | "_Atomic" "(" typename ")" -> "_Atomic"
          | "_Atomic"
          | "_Alignas" "(" ( typename | conditional ) ")" -> "_Alignas" .
storage   = "static" | "typedef" | "extern" | "register" | "auto" | "_Thread_local" .
function-specifier = "inline" | "_Noreturn" .
type-word = "void" | "char" | "short" | "int" | "long" | "float" | "double"
          | "signed" | "unsigned" | "_Bool" | "_Complex" | "_Imaginary" .

(* **The specifiers of a declaration**, 6.7: any number of the words above,
 * and one of a struct, a union or an enum with its tag, a typedef's name,
 * or a run of the words of a type with the others among them. The name is
 * the one that must come alone, because C11 6.7.2p2 lets a typedef's name
 * be the only type specifier, and is what keeps `T x` from reading `x` as a
 * second type when it is a typedef's name too: it is taken once, and every
 * word after it is one of the others. A union and an enum are read to be
 * refused, and a struct's definition is an item of its own, below. *)
specifier = qualifier | storage | function-specifier .
specifiers = a:{ specifier } "struct" t:name b:{ specifier }
               -> Base(name: $t, words: " {} " of join(flatten([$a, ["struct"], $b]), "  "))
           | a:{ specifier } k:( "union" | "enum" ) t:name b:{ specifier }
               -> Base(name: "", words: " {} " of join(flatten([$a, [$k], $b]), "  "))
           | a:{ specifier } t:typedef-name b:{ specifier }
               -> Named(name: $t, words: " {} " of join(flatten([$a, $b]), "  "))
           | a:{ specifier } w:type-word r:{ type-word | specifier }
               -> Base(name: "", words: " {} " of join(flatten([$a, [$w], $r]), "  ")) .

(* **The same, with one `static` in it**, which is what makes a local a
 * `Static`, and **with one `typedef`**, which makes a declaration at file
 * scope a `Typedef`. Each is a rule of its own because the grammar is what
 * decides which node is built, and `%names` has to know a typedef while the
 * parse is going on. The word may stand before the type or among it; a
 * second one is left for `specifiers` to take, and a pass to refuse. *)
not-static  = qualifier | function-specifier | "typedef" | "extern" | "register" | "auto" | "_Thread_local" .
sspecifiers = a:{ not-static } "static" b:{ not-static } "struct" t:name c:{ not-static }
                -> Base(name: $t, words: " {} " of join(flatten([$a, ["static"], $b, ["struct"], $c]), "  "))
            | a:{ not-static } "struct" t:name b:{ not-static } "static" c:{ not-static }
                -> Base(name: $t, words: " {} " of join(flatten([$a, ["struct"], $b, ["static"], $c]), "  "))
            | a:{ not-static } "static" b:{ not-static } t:typedef-name c:{ not-static }
                -> Named(name: $t, words: " {} " of join(flatten([$a, ["static"], $b, $c]), "  "))
            | a:{ not-static } t:typedef-name b:{ not-static } "static" c:{ not-static }
                -> Named(name: $t, words: " {} " of join(flatten([$a, $b, ["static"], $c]), "  "))
            | a:{ not-static } "static" b:{ not-static } w:type-word r:{ type-word | not-static }
                -> Base(name: "", words: " {} " of join(flatten([$a, ["static"], $b, [$w], $r]), "  "))
            | a:{ not-static } w:type-word r:{ type-word | not-static } "static" c:{ type-word | not-static }
                -> Base(name: "", words: " {} " of join(flatten([$a, [$w], $r, ["static"], $c]), "  ")) .

not-typedef  = qualifier | function-specifier | "static" | "extern" | "register" | "auto" | "_Thread_local" .
tdspecifiers = a:{ not-typedef } "typedef" b:{ not-typedef } "struct" t:name c:{ not-typedef }
                 -> Base(name: $t, words: " {} " of join(flatten([$a, ["typedef"], $b, ["struct"], $c]), "  "))
             | a:{ not-typedef } "struct" t:name b:{ not-typedef } "typedef" c:{ not-typedef }
                 -> Base(name: $t, words: " {} " of join(flatten([$a, ["struct"], $b, ["typedef"], $c]), "  "))
             | a:{ not-typedef } "typedef" b:{ not-typedef } t:typedef-name c:{ not-typedef }
                 -> Named(name: $t, words: " {} " of join(flatten([$a, ["typedef"], $b, $c]), "  "))
             | a:{ not-typedef } t:typedef-name b:{ not-typedef } "typedef" c:{ not-typedef }
                 -> Named(name: $t, words: " {} " of join(flatten([$a, $b, ["typedef"], $c]), "  "))
             | a:{ not-typedef } "typedef" b:{ not-typedef } w:type-word r:{ type-word | not-typedef }
                 -> Base(name: "", words: " {} " of join(flatten([$a, ["typedef"], $b, [$w], $r]), "  "))
             | a:{ not-typedef } w:type-word r:{ type-word | not-typedef } "typedef" c:{ type-word | not-typedef }
                 -> Base(name: "", words: " {} " of join(flatten([$a, [$w], $r, ["typedef"], $c]), "  ")) .

(* **A member's, a cast's and `sizeof`'s**, C11 6.7.2.1 and 6.7.7: the
 * words of a type and its qualifiers, and no storage class, so `static` in
 * a member is a syntax error and not a refusal, as it was. *)
sqlist = a:{ qualifier } "struct" t:name b:{ qualifier }
           -> Base(name: $t, words: " {} " of join(flatten([$a, ["struct"], $b]), "  "))
       | a:{ qualifier } k:( "union" | "enum" ) t:name b:{ qualifier }
           -> Base(name: "", words: " {} " of join(flatten([$a, [$k], $b]), "  "))
       | a:{ qualifier } t:typedef-name b:{ qualifier }
           -> Named(name: $t, words: " {} " of join(flatten([$a, $b]), "  "))
       | a:{ qualifier } w:type-word r:{ type-word | qualifier }
           -> Base(name: "", words: " {} " of join(flatten([$a, [$w], $r]), "  ")) .

(* A type named where no declaration is, in `_Alignas`, `_Alignof`, `_Atomic`
 * and `_Generic`: read so that each can be refused by name. *)
typename = sqlist pointer .

(* **The stars of a declarator**, each with the `const`s after it. *)
pointer = { "*" cq:{ "const" } -> size($cq) } -> $1 .

block = "{" { statement } "}" -> Block(body: $2) .

(* **A `for` that declares**, C99 6.8.5p3, since ROADMAP 6.12's second part,
 * is a block holding the declaration and a `for` without one, which is the
 * scope C gives it: the names reach the end of the loop and no further. It
 * is a rule of its own so that `%names` ends a typedef's hiding there, as a
 * block's end does. What it may declare is refused in the `locals` pass. *)
for-declaration = "for" "(" b:specifiers d:local-declarator r:{ "," e:local-declarator -> $e } ";"
                    c:[ expression ] ";" t:[ expression ] ")" x:statement
                    -> Block(body: [Decls(spec: $b, items: flatten([[$d], $r]), kind: "for"),
                                    For(init: [], cond: $c, step: $t, body: $x)]) .

(* A declaration is two nodes rather than one with an optional initialiser,
 * because a node whose field is sometimes there is a node every pass has to
 * ask about. `int x = e;` is `int x; x = e;` and the emit pass says so.
 *
 * The stars are **counted** rather than kept: `int **p` declares a name with
 * two of them, and two is the whole of what any pass here asks. A type in this
 * subset is a base and a number of stars, so it fits in the keyword and the
 * number the node was going to carry anyway. This said until 2026-09-22 that
 * `char` would be the day a type needs a node of its own; `char` needed a
 * second number. `struct` was the day it was to need a node, and gave one
 * to the base instead: see `base` above and the `types` pass. *)
statement = "return" e:expression ";"              -> Return(value: $e)
          (* **`return;` returns nothing**, since 2026-09-26, ROADMAP 6.7,
           * and is refused by the `types` pass in a function that returns
           * something, as `cc` refuses it. *)
          | "return" ";"                             -> ReturnNothing
          (* **A label is a name and a `:` before a statement**, and a
           * `goto` names one, since 2026-09-25, ROADMAP 6.4. The label is
           * tried before an expression statement, which would read the name
           * and fail at the `:`, and before a declaration, whose base is a
           * reserved word or a typedef's name and so never a label's. *)
          (* **A `switch` is a statement with labels in it**, C11 6.8.4.2,
           * since 2026-09-25: its body is any statement, and a `case` or a
           * `default` is a label on one of the statements inside, however
           * deep, which is why a `case` can sit inside a loop inside the
           * `switch` and still be the `switch`'s. A `case` label is C's
           * *constant-expression*, which is a `conditional`: it may have a
           * `?:` in it, whose own `:` it keeps, and not a comma. *)
          | "switch" "(" c:expression ")" b:statement -> Switch(cond: $c, body: $b)
          | "case" v:conditional ":" b:statement     -> Case(value: $v, body: $b)
          | "default" ":" b:statement                -> Default(body: $b)
          | "goto" n:name ";"                        -> Goto(name: $n)
          | n:name ":" b:statement                   -> Labelled(name: $n, body: $b)
          (* An array first, because the three declaration forms are told
           * apart by the token after the name and this one's is `[`. The
           * count is a constant in the source and so is a field rather than a
           * subtree: C99's variable-length arrays are not in this subset, and
           * a count that a pass would have to evaluate is a different
           * mechanism from a count that is written down.
           *
           * It is a **node of its own** for the reason `Local` and
           * `LocalInit` are two nodes: a count that is sometimes there is a
           * count every pass has to ask about, and here the question has a
           * sharp edge. `int a[0]` is a count of zero and `int a;` is no
           * count at all, and one node would have to spell both the same. *)
          (* **A `static` local is a local in scope and a global in storage**,
           * C11 6.2.4p3, since 2026-09-29, ROADMAP 6.10: it is kept for the
           * whole run and initialised once, before the program starts. The
           * three forms are a local's, and three nodes of their own, since
           * nothing a pass says about a local's frame is true of one. The
           * word may stand anywhere among the specifiers since ROADMAP
           * 6.12's first part, `int static n;`, which is `sspecifiers`'
           * question; `auto` and `register` are a plain local's words. *)
          | b:sspecifiers d:static-declarator r:{ "," e:static-declarator -> $e } ";"
                   -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "block")
          | b:specifiers d:local-declarator r:{ "," e:local-declarator -> $e } ";"
                   -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "block")
          (* The `else` form first. Trying it first is also what settles the
           * dangling else: an inner `if` gets the chance to take the `else`
           * before the outer one does, which is what C11 6.8.4 says. *)
          | "if" "(" c:expression ")" t:statement "else" f:statement
                                                    -> IfElse(cond: $c, then: $t, else: $f)
          | "if" "(" c:expression ")" t:statement   -> If(cond: $c, then: $t)
          | "while" "(" c:expression ")" b:statement
                                                    -> While(cond: $c, body: $b)
          (* Each clause of a `for` may be missing, and an option is a list
           * that is empty when it did not match, so the node carries three
           * lists of at most one. That is the same shape as a block's body,
           * and the emit pass joins them the same way. *)
          | for-declaration
          | "for" "(" i:[ expression ] ";" c:[ expression ] ";" s:[ expression ] ")"
                b:statement                         -> For(init: $i, cond: $c, step: $s, body: $b)
          (* **A `do` runs its body before it tests**, C11 6.8.5.2, so once
           * even when the condition is false, and ends with a `;` of its own.
           * `break` and `continue` are statements with nothing in them, and
           * a `;` alone is the empty statement, the body of `for (...) ;`.
           * All four arrived on 2026-09-25, ROADMAP 6.4, and naming `do`,
           * `break` and `continue` here is what reserved them: before, `break;`
           * was an expression statement naming a variable. *)
          | "do" b:statement "while" "(" c:expression ")" ";"
                                                    -> DoWhile(body: $b, cond: $c)
          | "break" ";"                             -> Break
          | "continue" ";"                          -> Continue
          | ";"                                     -> Empty
          | block
          | "_Static_assert" "(" c:conditional "," m:string ")" ";" -> StaticAssert(cond: $c, message: $m, file: false)
          | e:expression ";"                        -> Discard(value: $e) .

(* C's expression grammar, all fifteen of its levels. `lib/expression.phx`
 * is not imported: its table is calc's, with `and`, `or`, `not` and `<>` in
 * it, and C's is written here a level at a time as the constructs arrive.
 * The shape is the module's, though, and so is the fold: `$$` is what has
 * been built so far, and an action naming it replaces that, which is what
 * makes `100 - 50 - 25` group to the left without anybody saying so. *)
expression = assignment { "," a:assignment -> Comma(left: $$, right: $a) } .

(* **The comma operator is the loosest level**, since 2026-09-25, and so is
 * what `expression` means: C11 6.5.17 evaluates the left, throws it away and
 * is worth the right. That is also why an argument and an initialiser are
 * *not* an `expression`, and read an `assignment` instead: `f(a, b)` is two
 * arguments and `int x = 1, y;` would otherwise be a comma. A subscript, a
 * condition and a parenthesis take the whole thing, as C's do. *)

(* Assignment is an expression in C, worth the value assigned, and it groups
 * to the right: `a = b = 21` sets both. What is on the left is a **place**
 * and no longer a name, which is the whole of what `&` and `*` change about
 * this rule: `*p = 3` puts a value where a pointer says, and C11 6.5.16 asks
 * for an lvalue there rather than for an expression. The first alternative
 * fails at `=` on anything that is not an assignment and the choice moves on,
 * which is what ordered choice is for; `==` is a different token, so `x == 1`
 * never gets this far. *)
assignment = p:place "=" a:assignment -> Assign(place: $p, value: $a)
           | p:place o:compound a:assignment
               -> Update(place: $p, op: $o, value: $a, post: false)
           | conditional .

(* **A compound assignment changes a place in place**, since 2026-09-25, and
 * is not built as `a = a + b`: C11 6.5.16.2 says `a` is evaluated once, and
 * `x[k++] += 10` moves `k` once. So it is a node of its own, `Update`, which
 * `++` and `--` build too: C11 6.5.3.1 defines `++a` as `a += 1`, and `a++`
 * is the same step worth the value from before it, which is `post`. The
 * operator is kept as written, for the messages. *)
compound = "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" .

(* **`?:` is one arm or the other, never both**, C11 6.5.15, and groups to
 * the right: `a ? b : c ? d : e` is `a ? b : (c ? d : e)`. The middle takes
 * a whole `expression`, since nothing can end it early but the `:`. *)
conditional = c:logical-or "?" t:expression ":" f:conditional
                -> Choose(cond: $c, then: $t, other: $f)
            | logical-or .

(* **`||` and `&&`**, since 2026-09-25, the loosest levels below assignment:
 * `a || b && c` is `a || (b && c)`, and both group to the left. They are one
 * node with an operator in it, as the arithmetic is, and not a `Binary`,
 * because they are not arithmetic: C11 6.5.13 and 6.5.14 evaluate the right
 * side only when the left has not decided, and the answer is 0 or 1, never
 * an operand's value. *)
logical-or  = logical-and { "||" logical-and
                              -> Logical(op: $1, left: $$, right: $2) } .
logical-and = bit-or      { "&&" bit-or
                              -> Logical(op: $1, left: $$, right: $2) } .

(* **The bitwise three sit between `&&` and the comparisons**, since
 * 2026-09-25, which is C's order and its famous trap: `a & b == c` is
 * `a & (b == c)`. They are arithmetic, and a `Binary` like `+`. *)
bit-or  = bit-xor { "|" bit-xor -> Binary(op: $1, left: $$, right: $2) } .
bit-xor = bit-and { "^" bit-and -> Binary(op: $1, left: $$, right: $2) } .
bit-and = equality { "&" equality -> Binary(op: $1, left: $$, right: $2) } .

(* A place is somewhere a value can be **put**, and it is the one thing `&`
 * can be asked for. There are two: a name, and a dereference of anything.
 * Saying that here rather than in a pass is what keeps `1 = 2` and `&1` out
 * without any pass having to ask what kind of node it was handed -- C11
 * 6.5.3.2 makes the operand of `&` an lvalue, and this rule is that
 * constraint written in the grammar, where it costs nothing to check.
 *
 * A place builds the same `Variable` and `Deref` nodes a *read* of one builds,
 * because they are the same nodes: what differs is which attribute the parent
 * asks them for. The emit pass gives both an address as well as a value, and
 * an assignment reads the address where a read reads the value.
 *
 * The third alternative is a **parenthesised** place, which C allows and this
 * rule refused until 2026-09-22: `(x) = 4` and `&(x)` are ordinary C and were
 * a syntax error here. Parentheses group without changing what a thing is,
 * and the action says exactly that by answering the place inside them rather
 * than building anything. It has to come before the name and after the `*`,
 * for the reason every ordered choice here does: `(` decides it.
 *
 * A subscripted place is the fourth, and `a[i]` is a place because it is a
 * `*`, which is all a subscript is. A member is a place too, `s.x` and
 * `p->x` alike, and arrives in the same alternative because it is written
 * in the same position, after a primary. The alternative is **first**,
 * before the parenthesised one, because ordered choice does not come back:
 * `(a)[1] = 2` would match `(a)` as a parenthesised place, fail at `[` where
 * the `=` was wanted, and never be tried as anything else. Tried first, a
 * place that has nothing after its primary fails at the token that follows
 * it and the choice moves on. *)
place = suffixed
      | "*" u:unary   -> Deref(value: $u)
      | "(" p:place ")" -> $p
      | n:name        -> Variable(name: $n) .

(* A comparison is an `int`, 0 or 1, and it chains: `3 > 2 > 1` is
 * `(3 > 2) > 1`, which is 0, and C means that. So these are repetitions
 * like the arithmetic below them, where `lib/expression.phx` has an option
 * because calc does not chain. Equality is looser than the relations, so
 * `0 == 1 < 2` is `0 == (1 < 2)`. *)
equality       = relational     { ( "==" | "!=" ) relational
                                    -> Compare(op: $1, left: $$, right: $2) } .
relational     = shift          { ( "<" | "<=" | ">" | ">=" ) shift
                                    -> Compare(op: $1, left: $$, right: $2) } .
shift          = additive       { ( "<<" | ">>" ) additive
                                    -> Binary(op: $1, left: $$, right: $2) } .

additive       = multiplicative { ( "+" | "-" ) multiplicative
                                    -> Binary(op: $1, left: $$, right: $2) } .
multiplicative = unary          { ( "*" | "/" | "%" ) unary
                                    -> Binary(op: $1, left: $$, right: $2) } .

(* `&` takes a place and `*` takes anything, which is C11 6.5.3.2 as written.
 * `&*p` is therefore `p` without anybody saying so: the address of a
 * dereference is the thing dereferenced, and the emit pass gets that from the
 * shape of the tree rather than from a rule about it.
 *
 * `sizeof` has two shapes and the **type** one goes first, because `sizeof
 * (x)` would otherwise be taken by the expression form's parenthesised
 * primary and `sizeof(int)` would fail there: `int` is a reserved word and
 * no expression begins with it. The two build different nodes rather than
 * one node with a field that is sometimes a type, for the reason the
 * declarations give above. *)
(* **A cast is a type in parentheses before a unary expression**, C11
 * 6.5.4, since 2026-09-26, ROADMAP 6.7. It is tried first, because a
 * parenthesised expression is a `primary` and would take the `(`; a base
 * is a keyword or a name `%names` has made a typedef, so `(x)` with `x` a
 * variable fails at once and falls through to the expression it is. It
 * binds tighter than every binary operator and looser than a suffix, so
 * `(char)x + 1` is `((char)x) + 1` and `(char)a[1]` is `(char)(a[1])`, as
 * in C. `sizeof (int) x` stays a syntax error, since the type form of
 * `sizeof` is tried before this and leaves the `x`. *)
unary   = "(" b:sqlist s:pointer ")" u:unary
            -> Cast(base: $b, stars: size($s), squals: join(each($s, "{}")), value: $u)
        | "-" u:unary -> Negate(value: $u)
        | "!" u:unary -> Not(value: $u)
        | "~" u:unary -> Invert(value: $u)
        | "+" u:unary -> Plus(value: $u)
        | "++" p:place -> Update(place: $p, op: "++", value: Number(text: "1"), post: false)
        | "--" p:place -> Update(place: $p, op: "--", value: Number(text: "1"), post: false)
        | "&" p:place -> Addr(place: $p)
        | "*" u:unary -> Deref(value: $u)
        | "_Alignof" "(" typename ")" -> Unsupported(word: "_Alignof")
        | "sizeof" "(" b:sqlist s:pointer ")" -> SizeOfType(base: $b, stars: size($s), squals: join(each($s, "{}")))
        | "sizeof" u:unary                 -> SizeOfExpr(value: $u)
        | postfix .

(* **A subscript builds no node of its own.** C11 6.5.2.1 defines `E1[E2]` as
 * `(*((E1)+(E2)))`, and these actions build exactly that, so indexing is a
 * `Deref` of a `+` and every pass already knows what those are. What made
 * `a[i]` wait was never the brackets: it was the `+`, which has to count in
 * elements, and that is the `types` pass's business and the emit pass's.
 * `2[a]` is therefore `*(2 + a)`, which is C, and `x[0]` on an `int` is a
 * `*` on an `int` and refused as one.
 *
 * **Nor does `->`.** C11 6.5.2.3 defines `E->m` by what `(*E).m` would
 * be, and the action builds that, so a `Member` is always asked of a struct
 * and never of a pointer, and the `*` refuses a `->` on anything that is not
 * a pointer, in its own words. A member is a node, because unlike a
 * subscript it is not something else written differently: which member is
 * the struct's layout to say, and no other node carries a name to look up.
 *
 * `suffixed` has at least one suffix and `postfix` may have none. The place
 * rule wants the first, because a place without a suffix is one of its
 * other three; an expression wants the second. The fold is written twice
 * because a rule cannot both build its first suffix and fold the rest in
 * one list: `$$` needs its base in the list it folds, and `suffix` is that
 * base. The three suffixes are one repetition and not three, because C
 * mixes them freely: `a[i].next->v[2]` is four of them, in one fold.
 *
 * **A postfix `++` or `--` is a suffix too**, since 2026-09-25, for the same
 * reason: `q++->c` and `p++[0]` are C, and a `++` outside the fold would end
 * the chain. What it is a suffix *of* need not be a place, in the grammar: a
 * `++` on a call or on an assignment parses, and the `types` pass refuses it
 * as `cc` does, since `lvalue` is what knows. *)
postfix   = suffixed | primary .
suffixed  = suffix { "[" e:expression "]"
                          -> Deref(value: Binary(op: "+", left: $$, right: $e))
                      | "." n:name  -> Member(value: $$, name: $n)
                      | "->" n:name -> Member(value: Deref(value: $$), name: $n)
                      | "++" -> Update(place: $$, op: "++", value: Number(text: "1"), post: true)
                      | "--" -> Update(place: $$, op: "--", value: Number(text: "1"), post: true) } .
suffix    = p:primary "[" e:expression "]"
              -> Deref(value: Binary(op: "+", left: $p, right: $e))
          | p:primary "." n:name  -> Member(value: $p, name: $n)
          | p:primary "->" n:name -> Member(value: Deref(value: $p), name: $n)
          | p:primary "++" -> Update(place: $p, op: "++", value: Number(text: "1"), post: true)
          | p:primary "--" -> Update(place: $p, op: "--", value: Number(text: "1"), post: true) .

(* A call before a variable, because `f` fails at `(` and falls through.
 * Each argument is a node of its own for the same reason a parameter is:
 * the emit pass has to know which register it goes in, and that is a fact
 * about the argument's place in the list, which a node can be handed and an
 * expression cannot. *)
primary = n:name "(" a:args ")" -> Call(name: $n, args: $a)
        | integer -> Number(text: $1)
        | character -> Character(text: $1)
        | string    -> String(text: $1)
        | name    -> Variable(name: $1)
        | "_Generic" "(" assignment { "," ( typename | "default" ) ":" assignment } ")" -> Unsupported(word: "_Generic")
        | "(" expression ")" -> $2 .

args = [ arg { "," b:arg -> $b } ] -> $1 .   (* `-> $1` as for params *)
arg  = e:assignment -> Arg(value: $e) .

(* ------------------------------------------------------------------ *)
(* Pass one: the questions about functions that no order can answer.   *)
(*                                                                     *)
(* Whether a call names a declared function is a question about what   *)
(* came *above*, and the next pass asks it of a thread. Whether a       *)
(* function is defined twice, or declared with two different numbers of *)
(* parameters, is a question about the whole file, and this pass       *)
(* gathers what it needs on the way up and asks at the top. awk needed  *)
(* the gathered table for the call itself, because awk lets a call come *)
(* first; C does not, and the table here is only for the two checks.    *)

%pass functions

  (* **A declaration hands its specifiers down**, since ROADMAP 6.12's
   * second part: `base` in every pass is the `spec` of the `Decls` above,
   * so a declarator reads its words and its type as it did when they were
   * its own field. A struct's members do the same through `MDecls`. The
   * lists this pass gathers at the top are its items' lists joined, and
   * a node with none gives none. *)
  Decls  : down base = $spec
         : shape  = flatten($items.shape)
         : dshape = flatten($items.dshape)
         : dname  = flatten($items.dname)
         : fdefs  = flatten($items.fdefs)
         : ginit  = flatten($items.ginit) .
  MDecls : down base = $spec .
  otherwise shape  = []
  otherwise dshape = []
  otherwise dname  = []
  otherwise fdefs  = []
  otherwise ginit  = []

  (* **Whether each function is its file's own**, since 2026-09-29, ROADMAP
   * 6.10, in document order, because C11 6.2.2p4 decides it by what came
   * first: a declaration without `static` takes the linkage of one above
   * it, so `static int f(void);` then `int f(void) { ... }` is internal,
   * and a `static` one after a declaration without it is refused, as `cc`
   * refuses it. The name's first declaration decides and the entry is never
   * changed, which is why `hidden` reads the same whether it is read before
   * the node's own binding or after. A global is declared once here, so
   * its own word is all it has. *)
  thread linkage = empty

  (* **What a declaration's words say**, since ROADMAP 6.12's first part,
   * worked out here so that the `locals` pass can check it: a check cannot
   * read what its own rule computes, and the next pass can. Each is a count
   * of one spelled word in `words`, see `specifiers`. `key` is how many
   * times each of the twelve words of a type was written, in 6.7.2p2's
   * order, and `tname` the type that list is, or "" for a list that is
   * none; a struct's is its tag. `unsup` is the first word whose feature is
   * not in the subset, the three that C11 lets an implementation leave out
   * first, and `pword` the first storage class a parameter may not have. *)
  Base  : stat    = size(split($words, " static ")) > 1
        : tdef    = size(split($words, " typedef ")) > 1
        : sauto   = size(split($words, " auto ")) > 1
        : sreg    = size(split($words, " register ")) > 1
        : sext    = size(split($words, " extern ")) > 1
        : nstore  = (size(split($words, " static ")) - 1) + (size(split($words, " typedef ")) - 1) + (size(split($words, " extern ")) - 1) + (size(split($words, " register ")) - 1) + (size(split($words, " auto ")) - 1) + (size(split($words, " _Thread_local ")) - 1)
        : pword   = at(split(("{}{}{}" of lookup([[true, "static "]], size(split($words, " static ")) > 1, ""), lookup([[true, "typedef "]], size(split($words, " typedef ")) > 1, ""), lookup([[true, "auto "]], size(split($words, " auto ")) > 1, "")), " "), 1)
        : unsup   = at(split(("{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}" of
                                   lookup([[true, "_Complex "]], size(split($words, " _Complex ")) > 1, ""),
                                   lookup([[true, "_Imaginary "]], size(split($words, " _Imaginary ")) > 1, ""),
                                   lookup([[true, "_Atomic "]], size(split($words, " _Atomic ")) > 1, ""),
                                   lookup([[true, "short "]], size(split($words, " short ")) > 1, ""),
                                   lookup([[true, "float "]], size(split($words, " float ")) > 1, ""),
                                   lookup([[true, "double "]], size(split($words, " double ")) > 1, ""),
                                   lookup([[true, "_Bool "]], size(split($words, " _Bool ")) > 1, ""),
                                   lookup([[true, "enum "]], size(split($words, " enum ")) > 1, ""),
                                   lookup([[true, "union "]], size(split($words, " union ")) > 1, ""),
                                   lookup([[true, "volatile "]], size(split($words, " volatile ")) > 1, ""),
                                   lookup([[true, "restrict "]], size(split($words, " restrict ")) > 1, ""),
                                   lookup([[true, "_Thread_local "]], size(split($words, " _Thread_local ")) > 1, ""),
                                   lookup([[true, "inline "]], size(split($words, " inline ")) > 1, ""),
                                   lookup([[true, "_Noreturn "]], size(split($words, " _Noreturn ")) > 1, ""),
                                   lookup([[true, "_Alignas "]], size(split($words, " _Alignas ")) > 1, "")), " "), 1)
        : key     = "{}{}{}{}{}{}{}{}{}{}{}{}" of
                         size(split($words, " void ")) - 1,
                         size(split($words, " char ")) - 1,
                         size(split($words, " short ")) - 1,
                         size(split($words, " int ")) - 1,
                         size(split($words, " long ")) - 1,
                         size(split($words, " float ")) - 1,
                         size(split($words, " double ")) - 1,
                         size(split($words, " signed ")) - 1,
                         size(split($words, " unsigned ")) - 1,
                         size(split($words, " _Bool ")) - 1,
                         size(split($words, " _Complex ")) - 1,
                         size(split($words, " _Imaginary ")) - 1
        : tname   = lookup([[true, $name]], $name <> "", lookup([
                                  ["100000000000", "void"],
                                  ["010000000000", "char"],
                                  ["010000010000", "char"],
                                  ["010000001000", "unsigned char"],
                                  ["000100000000", "int"],
                                  ["000000010000", "int"],
                                  ["000100010000", "int"],
                                  ["000000001000", "unsigned int"],
                                  ["000100001000", "unsigned int"],
                                  ["000010000000", "long"],
                                  ["000110000000", "long"],
                                  ["000010010000", "long"],
                                  ["000110010000", "long"],
                                  ["000010001000", "unsigned long"],
                                  ["000110001000", "unsigned long"],
                                  ["000020000000", "long long"],
                                  ["000120000000", "long long"],
                                  ["000020010000", "long long"],
                                  ["000120010000", "long long"],
                                  ["000020001000", "unsigned long long"],
                                  ["000120001000", "unsigned long long"]], $key, ""))
        : display = join(split(slice($words, 2, size($words) - 1), "  "), " ") .
  Named : stat    = size(split($words, " static ")) > 1
        : tdef    = size(split($words, " typedef ")) > 1
        : sauto   = size(split($words, " auto ")) > 1
        : sreg    = size(split($words, " register ")) > 1
        : sext    = size(split($words, " extern ")) > 1
        : nstore  = (size(split($words, " static ")) - 1) + (size(split($words, " typedef ")) - 1) + (size(split($words, " extern ")) - 1) + (size(split($words, " register ")) - 1) + (size(split($words, " auto ")) - 1) + (size(split($words, " _Thread_local ")) - 1)
        : pword   = at(split(("{}{}{}" of lookup([[true, "static "]], size(split($words, " static ")) > 1, ""), lookup([[true, "typedef "]], size(split($words, " typedef ")) > 1, ""), lookup([[true, "auto "]], size(split($words, " auto ")) > 1, "")), " "), 1)
        : unsup   = at(split(("{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}" of
                                   lookup([[true, "_Complex "]], size(split($words, " _Complex ")) > 1, ""),
                                   lookup([[true, "_Imaginary "]], size(split($words, " _Imaginary ")) > 1, ""),
                                   lookup([[true, "_Atomic "]], size(split($words, " _Atomic ")) > 1, ""),
                                   lookup([[true, "short "]], size(split($words, " short ")) > 1, ""),
                                   lookup([[true, "float "]], size(split($words, " float ")) > 1, ""),
                                   lookup([[true, "double "]], size(split($words, " double ")) > 1, ""),
                                   lookup([[true, "_Bool "]], size(split($words, " _Bool ")) > 1, ""),
                                   lookup([[true, "enum "]], size(split($words, " enum ")) > 1, ""),
                                   lookup([[true, "union "]], size(split($words, " union ")) > 1, ""),
                                   lookup([[true, "volatile "]], size(split($words, " volatile ")) > 1, ""),
                                   lookup([[true, "restrict "]], size(split($words, " restrict ")) > 1, ""),
                                   lookup([[true, "_Thread_local "]], size(split($words, " _Thread_local ")) > 1, ""),
                                   lookup([[true, "inline "]], size(split($words, " inline ")) > 1, ""),
                                   lookup([[true, "_Noreturn "]], size(split($words, " _Noreturn ")) > 1, ""),
                                   lookup([[true, "_Alignas "]], size(split($words, " _Alignas ")) > 1, "")), " "), 1) .

  (* A shape is a name and an arity as one text, so that `positions` can
   * count how many distinct ones there are: more shapes than names means a
   * name with two arities. **A `dshape` is the name and whether it ends in
   * `...`**, since 2026-09-26, counted the same way and kept apart so that
   * each refusal says which of the two differs. *)
  Prototype : internal = lookup([[true, 1]], $ret.stat, 0)
            : shape = ["{}/{}" of $name, size($params)]
            : dshape = ["{}/{}" of $name, $variadic]
            : dname = [$name]
            : fdefs = []
            : hidden  = lookup($linkage, $name, $internal = 1)
            : linkage = bind($linkage, $name, lookup($linkage, $name, $internal = 1))
            ! $ret.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params)
            ! $ret.unsup = "" and $ret.nstore < 2 and $ret.tdef
                : "'{}' is a typedef of a function type, which C allows and this subset does not have yet" of $name
            ! $ret.unsup = "" and $ret.nstore < 2 and ($ret.sauto or $ret.sreg)
                : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $ret.sauto, "register") .
  Function  : internal = lookup([[true, 1]], $ret.stat, 0)
            : shape = ["{}/{}" of $name, size($params)]
            : dshape = ["{}/{}" of $name, $variadic]
            : dname = [$name]
            : fdefs = [$name]
            : hidden  = lookup($linkage, $name, $internal = 1)
            : linkage = bind($linkage, $name, lookup($linkage, $name, $internal = 1))
            ! $ret.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params)
            ! $ret.unsup = "" and $ret.nstore < 2 and $ret.tdef
                : "'{}' is a typedef of a function type, which C allows and this subset does not have yet" of $name
            ! $ret.unsup = "" and $ret.nstore < 2 and ($ret.sauto or $ret.sreg)
                : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $ret.sauto, "register")
            ! size($params) > 0 and size(split((",{}," of join($params.name, ",")), ",,")) > 1
                : "a parameter of a function's definition has a name, C11 6.9.1p5"
            ! size(positions($ids)) < size($ids)
                : "'{}' has a name twice in its list of parameters, C11 6.9.1p6" of $name
            ! size(positions($ids)) = size($ids) and size($ids) > 0 and join($ids, ",") <> join($params.name, ",")
                : "'{}' does not declare one parameter for each name in its list, in the list's order: C11 6.9.1p6 asks for one each, and this subset for the order too" of $name .

  (* **A keyword read only to be refused**, since ROADMAP 6.12's first part:
   * `_Generic` and `_Alignof`, which are expressions; `_Static_assert` was
   * one too, until the second part. It is refused in the first pass so that
   * no later one has to say what such an expression is. *)
  Unsupported ! true : "'{}' is C11's, and not this subset's yet" of $word .

  (* A struct is an item and not a function, and adds nothing to either count. *)
  StructDef : shape = []
            : dshape = []
            : dname = []
            : fdefs = [] .
  Typedef   : shape = []
            : dshape = []
            : dname = []
            : fdefs = [] .
  Global      : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .
  GlobalInit  : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              : ginit  = [$name]
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .
  GlobalArray : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .

  (* Written out rather than named: a check runs before the attributes its
   * rule computes, so it cannot read them, and `phx` says so. *)
  (* **Which globals are initialised somewhere in the file**, since ROADMAP
   * 6.12's second part: C11 6.9.2 makes a declaration without an
   * initialiser a tentative definition, which is the definition only when
   * no other is, and the emit pass writes a global's storage once, at its
   * initialiser if it has one and at its first tentative definition if not.
   * A question about the whole file, so it is gathered here and asked there. *)
  Program : inits = flatten($items.ginit)
          ! size(positions(flatten($items.fdefs))) < size(flatten($items.fdefs))
              : "a function is defined twice"
          ! size(positions(flatten($items.shape))) > size(positions(flatten($items.dname)))
              : "a function is declared with two different numbers of parameters"
          ! size(positions(flatten($items.dshape))) > size(positions(flatten($items.dname)))
              : "a function is declared with '...' in one place and without it in another" .

(* ------------------------------------------------------------------ *)
(* Pass two: which local is which, where does it live, and what is it? *)
(*                                                                     *)
(* A local lives at a **byte offset** below its function's frame        *)
(* pointer, and the frame is how many bytes the function needs. It was  *)
(* a numbered slot until arrays arrived: `int a[10]` is forty bytes and *)
(* one slot cannot hold it, so a declaration's type reaches the frame   *)
(* here for the first time.                                             *)
(*                                                                     *)
(* Everything is given a multiple of eight and started on one. An       *)
(* `int` is four bytes and takes eight, which wastes half of every      *)
(* scalar and is what the frame did anyway when a slot was eight. The   *)
(* alternative, packing each thing at its own width, is not observable  *)
(* by any program: the distance between two **separate** objects is not *)
(* something C defines, and the distance between two elements of one    *)
(* array is the element's width either way. So the cheaper rule is the  *)
(* one that is kept. A struct's members are laid out by another rule,   *)
(* below, because the distance between two of them is measurable.       *)
(*                                                                     *)
(* A name means **five** things: where it lives, how many stars stood   *)
(* in front of it, how many elements it has, zero meaning it is not an  *)
(* array, how wide the thing at the bottom of the stars is, 4 for an    *)
(* `int`, 1 for a `char` and the struct's size for a struct, and which  *)
(* struct that is, or "" for none. All five go in one table rather than *)
(* in five side by side, because a second table would need the same     *)
(* `down` at a function and the same save-and-restore at a block, and   *)
(* two copies of a scope rule are two chances to disagree about what a  *)
(* scope is.                                                            *)
(*                                                                     *)
(* The width is `basew` here and `width` in the `types` pass, which     *)
(* reads it off a name and carries it through every expression, and the *)
(* struct is `tagname` here and `tag` there. Two names each because two *)
(* passes defining one attribute is a thing `phx` warns about, rightly. *)
(*                                                                     *)
(* **A struct's layout is worked out here too**, because a member is    *)
(* laid out by the same walk in document order that lays out a frame:   *)
(* each member starts at the first offset after the one before it that  *)
(* its own alignment allows, which is C11 6.7.2.1 and the ABI together, *)
(* and the struct is as long as that rounded up to its widest member's  *)
(* alignment. The frame rounds everything to eight and a struct cannot, *)
(* because the distance between two members of **one** object is a     *)
(* thing a program can measure, with `sizeof` and with `&`.             *)

%pass locals

  (* **What a `for` may declare**, C11 6.8.5p3: objects that are `auto` or
   * `register`, and so no `static`, `extern` or `typedef`, which `cc`
   * refuses as C23's. `dkind` tells a declarator it is in one. *)
  Decls  : down base = $spec
         : down dkind = $kind
         ! $kind = "for" and ($spec.stat or $spec.tdef or size(split($spec.words, " extern ")) > 1)
             : "a 'for' declares only objects that are 'auto' or 'register', C11 6.8.5p3" .

  (* **A static assertion's names** are the file's when it is an item, as a
   * global's initialiser's are, and the block's when it is a statement. *)
  StaticAssert : down env = lookup([[true, $globals]], $file, $env) .
  MDecls : down base = $spec
         : mconst = flatten($items.mconst) .

  (* **What a constant's text says**, since 2026-09-27: its suffix, its
   * base and its digits, read here and not in `types`, because a check
   * there reads them before the value they guard is worked out. A letter
   * `u` or `l` anywhere in it is a suffix, since no hex digit is one. *)
  Number : ihasu   = size(split($text, "u")) > 1 or size(split($text, "U")) > 1
         : ihasl   = size(split($text, "l")) > 1 or size(split($text, "L")) > 1
         : ibody   = slice($text, 1, size($text) - lookup([[true, 1]], $ihasu, 0) - lookup([[true, 1]], $ihasl, 0))
         : ihex    = slice($ibody, 1, 2) = "0x" or slice($ibody, 1, 2) = "0X"
         : ioct    = not $ihex and slice($ibody, 1, 1) = "0" and size($ibody) > 1
         : idec    = not $ihex and not $ioct
         : idigits = lookup([[true, slice($ibody, 3, size($ibody))]], $ihex, $ibody)
         : ndigits = size($idigits) .

  (* The table is a thread, because *what has been declared so far* is what
   * a walk in document order has. All three are set afresh at each function
   * by a `down` clause, which is what makes a thread nest.
   *
   * `env` is every name in sight and `scope` is only this block's, and they
   * answer different questions: a read asks the first, and a declaration
   * asks the second, because C11 6.2.1 lets an inner block declare a name
   * the outer one already has. One table cannot answer both -- the first
   * version of this pass had one, and refused `{ int x = 1; { int x = 2; } }`
   * as declared twice. *)
  thread env   = empty
  thread scope = empty
  thread bytes = 0

  (* Which register a parameter arrives in is its **position**, which a byte
   * offset no longer says. It said it while every declaration was one slot
   * and parameter k was slot k; now it is counted on its own. *)
  thread pindex = 0

  (* The functions declared so far, name to its arity and whether it ends in
   * `...`, 1 or 0, since 2026-09-26. A definition binds itself
   * on the way *in*, with a `down` clause, so that its own body can call it;
   * the value flows on to the functions after it, which is what a `down` on
   * a thread does when nothing restores it. A prototype binds on the way
   * out, which for a node with no body is the same moment. *)
  thread funcs = empty

  (* **The globals declared so far**, since 2026-09-26, ROADMAP 6.8, each
   * the entry a local's is, with `true` for the sixth field, which says
   * *global* to the emit pass, and a seventh, whether it was initialised.
   * The offset is 0 and unused: a global is reached by its name. The thread
   * is never reset, and **a function starts its `env` from it** instead of
   * from `empty`, so a local or a parameter hides a global exactly as a
   * block's local hides an outer one, and a function above a global does
   * not see it, which is C11 6.2.1's order. *)
  thread globals = empty

  (* Only a name can be a global; everything else a `&` can be asked of is
   * not one, which the `constants` pass reads to tell `&answer` from
   * `&table[1]`. *)
  otherwise global = false

  (* **Whether a name was declared `register`**, since ROADMAP 6.12's first
   * part, the eleventh part of an entry: C11 6.5.3.2p1 forbids its address,
   * and only a name can be one, so every other place a `&` is asked of is
   * not. A member of a `register` struct is not followed, and `&r.m` is a
   * refusal `cc` makes and this does not; never a false one. *)
  otherwise vreg = false
  Addr ! $place.vreg
           : "'{}' is declared 'register', and C11 6.5.3.2p1 forbids taking its address" of $place.name .

  (* **What each function takes**, name to a list with one entry per
   * parameter: the tag of a struct passed whole, or "". Bound on the way out,
   * when the parameters have been worked out, which a `down` clause cannot
   * wait for; so this is not what a call checks its arity against, and the
   * `types` pass is handed the whole of it, at the root, to check a call's
   * arguments with. A call above its callee's declaration is refused anyway. *)
  thread sigs = empty

  (* **Every label in the program**, as the function's name and the label's
   * together, since 2026-09-25. A label belongs to its function, C11 6.2.1,
   * and to a name space of its own, 6.2.3, so it is never in `env` and
   * `x: x++;` names two different things. It is gathered on the way out and
   * handed to the `types` pass from the root, as `sigs` is, which is what
   * lets a `goto` name a label further down. *)
  thread labels = empty

  (* **What each function returns**, name to three things: the tag of the
   * struct at the bottom, or ""; its width, 4 for an `int`; and how many
   * stars are on top, since 2026-09-25. They are the three an expression's
   * type is, so a call reads its own off this without working anything
   * out. Bound on the way out, as `sigs` is and
   * for its reason: the return type is a child, worked out after a `down`
   * clause runs. So the `types` pass is handed the whole table at the root,
   * which is also what lets a function's own body call it. *)
  thread rets = empty

  (* **Which parameters are `long`s**, name to one boolean per parameter,
   * bound and handed on the way `sigs` is. A caller converts what it passes
   * to the parameter's type, C11 6.5.2.2p7, and an `int` put in a `long`
   * parameter has to be sign-extended into the whole register first: the
   * emit pass reads this at each call. *)
  thread pwidths = empty

  (* **The struct layouts defined so far**, tag to size, alignment and a
   * table of members. It starts with `int`, `char` and `long` in it, as three
   * structs with no members, and that is what lets `Base` answer a width with one
   * lookup whatever it names: the keyword and the tag are asked the same
   * question of the same table. A struct is defined at file scope only, so
   * this is never reset and flows from each definition to everything after
   * it, which is C11 6.2.1's scope for a tag declared outside any block.
   *
   * **`void` is the fourth**, since 2026-09-26, ROADMAP 6.7, and unlike the
   * other three it keeps its name as its tag: see `Base`. So a `void` value
   * is a `record` to the `types` pass, no stars and a tag, and every place
   * that refuses a struct where C wants a number refuses it too, which is
   * C11 6.3.2.2's rule that a void expression's value is never used. It is
   * nought bytes wide, which is what makes `void *` arithmetic something to
   * refuse rather than to count in. No struct can take the tag, because
   * `void` is reserved the moment `base` names it.
   *
   * *The width has no witness, and cannot have one*: arithmetic, `*` and
   * `sizeof` are the three that would read it, and each refuses a `void`
   * by name. Made four, the oracle and every refusal stayed green. *)
  thread layouts = [["int", [4, 4, empty, false]], ["char", [1, 1, empty, false]],
                    ["long", [8, 8, empty, false]], ["void", [0, 1, empty, false]],
                    ["unsigned int", [4, 4, empty, false]], ["unsigned char", [1, 1, empty, false]],
                    ["unsigned long", [8, 8, empty, false]]]

  (* **The typedefs so far**, name to the four things a declaration asks
   * of its base: a width, an alignment, a tag, and how many stars the typedef
   * already has. File scope only, like `layouts`, so never reset. The parse
   * has already decided which names are typedefs, with `%names`; this is what
   * each one *means*, which the parse has no way to hold. *)
  thread typedefs = empty

  (* The three a struct's members are laid out by, each set afresh by the
   * struct being defined: the members so far, the offset the next one may
   * start at, and the widest alignment seen. A member's entry is the same
   * five things a name's is, so that a member and a name are read alike. *)
  thread fields = empty
  thread moff   = 0
  thread malign = 1

  (* Which struct is being defined, so that it may point at itself. A struct
   * is not complete until its `}`, C11 6.7.2.1, so `struct node` inside its
   * own definition has no size and cannot be a member; a **pointer** to one
   * needs no size, and a linked list is made of exactly that. *)
  Program : down defining = ""
          : allsigs = $sigs
          : alllabels = $labels
          : allrets = $rets
          : allpwidths = $pwidths .

  (* A struct's layout is bound on the way out, when every member has been
   * placed. The check for a second definition runs before that, and so sees
   * the table without this one in it. A struct with no members is refused
   * by name: C11 6.7.2.1 wants at least one, and this `cc` takes `{}` as an
   * extension with a `sizeof` of 0, so it is a program both would compile
   * and answer differently, the way `int a[0]` is. *)
  StructDef : down defining = $name
            : down fields   = empty
            : down moff     = 0
            : down malign   = 1
            : layouts = bind($layouts, $name,
                             [(($moff + $malign - 1) div $malign) * $malign, $malign, $fields,
                              size(flatten($members.mconst)) > 0])
            ! defined($layouts, $name) : "'struct {}' is defined twice" of $name
            ! size($members) = 0
                : "'struct {}' has no members, which C11 6.7.2.1 forbids and this cc allows as an extension"
                    of $name .

  (* What a declaration's base is worth: a width, an alignment, and the tag
   * or "". A tag nothing defined is refused, **except** the one being
   * defined, which answers the default: a width of 0, which no complete type
   * has and which the members below read as *not yet complete*. C allows a
   * pointer to a struct nobody ever defines; this subset does not, yet,
   * because the only program here that needs one is a list, and a list
   * names its own struct. *)
  (* A typedef is its base and its stars, worked out once here and read by
   * every declaration that names it. C11 6.7p3 lets a typedef be declared
   * again **to the same type**, so a second one is refused only when it
   * says something different. *)
  Typedef : means    = [$base.basew, $base.align, $base.tagname, $stars + $base.ptrs, $base.buns,
                        "{}{}" of $base.bquals, $squals]
          : typedefs = bind($typedefs, $name, $means)
          (* **Not a typedef of `void` itself**, since 2026-09-26: C allows
           * one, and nothing here has needed it. `typedef void *vp;` is a
           * pointer and is allowed. *)
          ! $stars + $base.ptrs = 0 and $base.tagname = "void"
              : "'{}' is a typedef of 'void', which is C and is not here yet; a typedef of 'void *' is" of $name
          ! defined($globals, $name)
              : "'{}' is a global already, and a typedef and a global share one name space, C11 6.2.3" of $name
          ! defined($typedefs, $name)
              and lookup($typedefs, $name, empty)
                  <> [$base.basew, $base.align, $base.tagname, $stars + $base.ptrs, $base.buns,
                      "{}{}" of $base.bquals, $squals]
              : "'{}' is a typedef twice, for two different types" of $name .

  (* **A declaration's stars are its own and its typedef's**: `intp *q` with
   * `typedef int *intp` is two. A base that is a keyword or a tag has none,
   * and `ptrs` is the sum every declaration below reads in place of its
   * `stars` field. *)
  Named : means   = lookup($typedefs, $name, [4, 4, "", 0, false, "0"])
        : tq      = at($means, 6)
        : bquals  = "{}{}" of lookup([[true, slice($tq, 1, size($tq) - 1)]], size($tq) > 1, ""),
                              lookup([[true, "1"]], size(split($words, " const ")) > 1 or slice($tq, size($tq), size($tq)) = "1", "0")
        : hasconst = at(lookup($layouts, at($means, 3), [0, 1, empty, false]), 4)
        : buns    = at($means, 5)
        : basew   = at($means, 1)
        : align   = at($means, 2)
        : tagname = at($means, 3)
        : ptrs    = at($means, 4)
        ! $unsup <> ""
            : lookup([["_Atomic", "'_Atomic' is optional in C11, and left out here, as __STDC_NO_ATOMICS__ says"]],
                     $unsup, "'{}' is C11's, and not this subset's yet" of $unsup)
        ! $unsup = "" and $nstore > 1
            : "this declaration has {} storage classes, and C11 6.7.1p2 allows one" of $nstore .

  SizeOfType : ptrs = $stars + $base.ptrs .
  Cast       : ptrs = $stars + $base.ptrs
             : dquals = "{}{}" of $base.bquals, $squals .

  (* **The refusals a declaration's words make**, since ROADMAP 6.12's
   * first part, from what the `functions` pass worked out of them: a
   * keyword whose feature is not here, more than one storage class, and a
   * list of the words of a type that is no type, or `long long`. Each asks
   * that the one before it passed, so a declaration is refused once. *)
  Base : ptrs    = 0
       : bquals  = lookup([[true, "1"]], size(split($words, " const ")) > 1, "0")
       : layout  = lookup($layouts, $tname, [0, 1, empty, false])
       : hasconst = at($layout, 4)
       : basew   = at($layout, 1)
       : align   = at($layout, 2)
       : tagname = lookup([["int", ""], ["char", ""], ["long", ""], ["unsigned int", ""],
                           ["unsigned char", ""], ["unsigned long", ""]], $tname, $tname)
       : buns    = lookup([["unsigned int", true], ["unsigned char", true],
                           ["unsigned long", true]], $tname, false)
       ! $unsup <> ""
           : lookup([["_Complex", "'_Complex' is optional in C11, and left out here, as __STDC_NO_COMPLEX__ says"],
                     ["_Imaginary", "'_Imaginary' is optional in C11, and left out here, as __STDC_NO_COMPLEX__ says"],
                     ["_Atomic", "'_Atomic' is optional in C11, and left out here, as __STDC_NO_ATOMICS__ says"]],
                    $unsup, "'{}' is C11's, and not this subset's yet" of $unsup)
       ! $unsup = "" and $nstore > 1
           : "this declaration has {} storage classes, and C11 6.7.1p2 allows one" of $nstore
       ! $unsup = "" and $nstore < 2 and ($tname = "long long" or $tname = "unsigned long long")
           : "'{}' is C11's, and not this subset's yet" of $tname
       ! $unsup = "" and $nstore < 2 and $tname = ""
           : "'{}' is not one of the types C11 6.7.2p2 lists" of $display
       ! $name <> "" and not defined($layouts, $name) and $name <> $defining
           : "'struct {}' is not defined" of $name .

  (* A member starts at the next offset its alignment allows. An element is
   * aligned as its base is, or to eight when it is a pointer, and an array as
   * its element is. *)
  MemberScalar : ptrs   = $stars + $base.ptrs
               : basew  = $base.basew
               : dquals = "{}{}" of $base.bquals, $squals
               : mconst = lookup([[true, [1]]], slice($dquals, size($dquals), size($dquals)) = "1"
                                                or ($ptrs = 0 and $base.hasconst), [])
               : ebytes = lookup([[0, $basew]], $ptrs, 8)
               : ealign = lookup([[0, $base.align]], $ptrs, 8)
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, 0, $basew, $base.tagname, $base.buns, $dquals])
               : moff   = $offset + $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
               ! defined($fields, $name) : "'{}' is a member twice" of $name
               ! $stars + $base.ptrs = 0 and $base.basew = 0 and $base.tagname <> "void"
                   : "'struct {}' is not complete inside its own definition, so it cannot be a member of itself; a pointer to it can"
                       of $base.name
               ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                   : "'{}' is a member of type 'void', and a member's type has to be complete, C11 6.7.2.1p3" of $name .
  MemberArray  : ptrs   = $stars + $base.ptrs
               : basew  = $base.basew
               : dquals = "{}{}" of $base.bquals, $squals
               : mconst = lookup([[true, [1]]], slice($dquals, size($dquals), size($dquals)) = "1"
                                                or ($ptrs = 0 and $base.hasconst), [])
               : ebytes = lookup([[0, $basew]], $ptrs, 8)
               : ealign = lookup([[0, $base.align]], $ptrs, 8)
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, $count, $basew, $base.tagname, $base.buns, $dquals])
               : moff   = $offset + $count * $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
               ! $count < 1
                   : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                       of $name
               ! defined($fields, $name) : "'{}' is a member twice" of $name
               ! $stars + $base.ptrs = 0 and $base.basew = 0 and $base.tagname <> "void"
                   : "'struct {}' is not complete inside its own definition, so it cannot be a member of itself; a pointer to it can"
                       of $base.name
               ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                   : "'{}' is a member of type 'void', and a member's type has to be complete, C11 6.7.2.1p3" of $name .

  (* **A function returns an `int`, a `long`, a struct or a pointer.** A
   * struct is returned whole, since 2026-09-23, and a pointer since
   * 2026-09-25: its stars are the function's own and its typedef's, summed
   * as a declaration's are, into `rptrs`. A `char` is refused by name,
   * because nothing narrows `x0` on the way out, and it is C that `cc`
   * compiles. **A pointer to a struct has a tag and is not a struct**, so
   * every question below and in the emit pass that asks whether a function
   * returns a struct asks for no stars as well. `main` returning a struct is refused as well, although C11
   * 5.1.2.2.1 leaves room for it and `cc` compiles it with a warning: what
   * the shell then sees is whatever the struct left in `w0`, which is an
   * exit status neither compiler means and the oracle could not compare.
   *
   * A second declaration has to say the same thing as the first, which is
   * C11 6.7p4. *)
  Prototype : rptrs = $stars + $ret.ptrs
          : down env    = empty
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : funcs = bind($funcs, $name, [size($params), $variadic])
            : sigs  = bind($sigs, $name, $params.passes)
            : rets  = bind($rets, $name, [$ret.tagname, $ret.basew, $rptrs, $ret.buns, "{}{}" of $ret.bquals, $squals])
            : pwidths = bind($pwidths, $name, $params.pwide)
            ! defined($sigs, $name) and lookup($sigs, $name, empty) <> $params.passes
                : "'{}' is declared twice, and a parameter that is a struct in one is not the same struct in the other"
                    of $name
            ! defined($globals, $name)
                : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
            ! defined($rets, $name) and lookup($rets, $name, empty) <> [$ret.tagname, $ret.basew, $stars + $ret.ptrs, $ret.buns, "{}{}" of $ret.bquals, $squals]
                : "'{}' is declared twice, returning a different type each time" of $name
            ! defined($pwidths, $name) and lookup($pwidths, $name, empty) <> $params.pwide
                : "'{}' is declared twice, and a parameter that is a long in one is not in the other" of $name
            ! $stars + $ret.ptrs = 0 and $ret.tagname = "" and $ret.basew = 1
                : "'{}' returns a char, and a function here returns an int, a long, a struct or a pointer" of $name
            ! $name = "main" and $stars + $ret.ptrs = 0 and $ret.tagname <> ""
                : "'main' returns an int, C11 5.1.2.2.1, and this says '{}'"
                    of lookup([["void", "void"]], $ret.tagname, "struct {}" of $ret.tagname) .

  Function  : rptrs = $stars + $ret.ptrs
            : down fn     = $name
          : down env    = $globals
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : down funcs  = bind($funcs, $name, [size($params), $variadic])
            : sigs  = bind($sigs, $name, $params.passes)
            : rets  = bind($rets, $name, [$ret.tagname, $ret.basew, $rptrs, $ret.buns, "{}{}" of $ret.bquals, $squals])
            : pwidths = bind($pwidths, $name, $params.pwide)
            : frame = $bytes
            ! defined($sigs, $name) and lookup($sigs, $name, empty) <> $params.passes
                : "'{}' is declared twice, and a parameter that is a struct in one is not the same struct in the other"
                    of $name
            ! defined($globals, $name)
                : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
            ! defined($rets, $name) and lookup($rets, $name, empty) <> [$ret.tagname, $ret.basew, $stars + $ret.ptrs, $ret.buns, "{}{}" of $ret.bquals, $squals]
                : "'{}' is declared twice, returning a different type each time" of $name
            ! defined($pwidths, $name) and lookup($pwidths, $name, empty) <> $params.pwide
                : "'{}' is declared twice, and a parameter that is a long in one is not in the other" of $name
            ! $stars + $ret.ptrs = 0 and $ret.tagname = "" and $ret.basew = 1
                : "'{}' returns a char, and a function here returns an int, a long, a struct or a pointer" of $name
            ! $name = "main" and $stars + $ret.ptrs = 0 and $ret.tagname <> ""
                : "'main' returns an int, C11 5.1.2.2.1, and this says '{}'"
                    of lookup([["void", "void"]], $ret.tagname, "struct {}" of $ret.tagname) .

  Labelled : labels = bind($labels, ("{}/{}" of $fn, $name), true)
           ! defined($labels, "{}/{}" of $fn, $name)
               : "the label '{}' is in this function twice" of $name .

  (* A parameter is never an array, because the subset has no declarator for
   * one and C would have rewritten it to a pointer if it had. A scalar or a
   * pointer takes eight bytes and one register.
   *
   * **A struct takes its own size, rounded to eight, and one register or
   * two.** AAPCS64 passes a struct of up to sixteen bytes in registers, its
   * bytes packed, so one of nine to sixteen takes two; a larger one arrives
   * as the address of the caller's copy, in one, and the emit pass copies it
   * into the frame. So a register is counted here rather than a parameter,
   * and the ninth is refused as the ninth parameter is: it would be on the
   * stack, and nothing puts it there. *)
  Param : ptrs   = $stars + $base.ptrs
        : basew  = $base.basew
        : dquals = "{}{}" of $base.bquals, $squals
        : whole  = $ptrs = 0 and $base.tagname <> ""
        : passes = lookup([[true, $base.tagname]], $whole, "")
        : pwide  = $ptrs = 0 and $base.tagname = "" and $basew = 8
        : regs   = lookup([[true, 2]], $whole and $basew > 8 and $basew <= 16, 1)
        : takes  = lookup([[true, (($basew + 7) div 8) * 8]], $whole, 8)
        : offset = $bytes + $takes
        : preg   = $pindex
        : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg])
        : scope  = bind($scope, $name, true)
        : bytes  = $bytes + $takes
        : pindex = $pindex + $regs
        ! $name <> "" and defined($scope, $name) : "'{}' is a parameter twice" of $name
        ! $stars + $base.ptrs = 0 and $base.tagname = "void"
            : "'{}' is a parameter of type 'void', and only '(void)' alone, for no parameters, is C" of $name
        ! $pindex + lookup([[true, 2]], $stars + $base.ptrs = 0 and $base.tagname <> ""
                                        and $base.basew > 8 and $base.basew <= 16, 1) > 8
            : "'{}' needs a ninth register, and only eight are compiled: the rest go on the stack, and nothing here puts them there"
                of $name
        ! $base.unsup = "" and $base.nstore < 2 and $base.pword <> ""
            : "'{}' is a parameter declared '{}', and the one storage class a parameter may have is 'register', C11 6.7.6.3p2"
                of $name, $base.pword .

  Call ! not defined($funcs, $name)
           : "'{}' is called before it is declared" of $name
       ! defined($funcs, $name) and at(lookup($funcs, $name, [0, 0]), 2) = 0
           and size($args) <> at(lookup($funcs, $name, [0, 0]), 1)
           : "'{}' takes {} arguments, and this gives {}"
               of $name, at(lookup($funcs, $name, [0, 0]), 1), size($args)
       (* **A function that ends in `...` takes at least its named
        * arguments**, C11 6.5.2.2p2, and any number more. *)
       ! defined($funcs, $name) and at(lookup($funcs, $name, [0, 0]), 2) = 1
           and size($args) < at(lookup($funcs, $name, [0, 0]), 1)
           : "'{}' takes at least {} arguments, and this gives {}"
               of $name, at(lookup($funcs, $name, [0, 0]), 1), size($args) .

  (* A block is a scope: its declarations are torn down on the way out and
   * the enclosing tables come back. The byte counter is *not* restored,
   * because frame space is taken whether or not the name for it is still in
   * sight, and two blocks side by side may as well not share any. *)
  Block : down held      = $env
        : down heldscope = $scope
        : down scope     = empty
        : env   = $held
        : scope = $heldscope .

  (* A scalar is eight bytes of frame whether it is a one-byte `char`, a
   * four-byte `int` or an eight-byte pointer, and binds a count of zero,
   * which is what *not an array* is spelled as everywhere below. A struct is
   * its size rounded up to eight, the way an array is. *)
  Local     : ptrs   = $stars + $base.ptrs
            : basew  = $base.basew
            : dquals = "{}{}" of $base.bquals, $squals
            : takes  = lookup([[true, 0]], $base.sext, ((lookup([[0, $basew]], $ptrs, 8) + 7) div 8) * 8)
            : offset = $bytes + $takes
            : env    = bind($env, $name, lookup([[true, [0, $ptrs, 0, $basew, $base.tagname, true, false, $base.buns, $name, $dquals, false]]],
                                               $base.sext,
                                               [$offset, $ptrs, 0, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg]))
            : scope  = bind($scope, $name, true)
            : bytes  = $bytes + $takes
            ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
            ! defined($scope, $name) : "'{}' is declared twice" of $name
            ! $base.unsup = "" and $base.nstore < 2 and $base.tdef and $dkind <> "for"
                : "'{}' is a typedef in a block, which C allows and this subset does not have yet" of $name
            ! $base.unsup = "" and $base.nstore < 2 and $base.stat and $dkind <> "for"
                : "'{}' is 'static' and was read as a local that is not: a fault in c.phx, and not in the program" of $name
            ! $base.sext and defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 3), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 4), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 10)] <> [$stars + $base.ptrs, 0, $base.basew, $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                : "'{}' is declared again with another type, C11 6.7p4" of $name .
  (* **The name is bound on the way out**, after its initialiser has been
   * walked, so `int x = sizeof(x);` finds no `x` and is refused. C11 6.2.1p7
   * starts the scope at the end of the declarator, before the `=`, and `cc`
   * answers 4. A refusal and not a wrong answer, and so left; the parse gets
   * this right for a typedef hidden by its own local, see `%names`.
   *
   * A declaration with an initialiser is never an array: the subset has no
   * way to write the initialiser one would want. It may be a struct, since
   * 2026-09-23, which is copied into the frame, so it takes what a `Local`
   * takes; the `types` pass checks the two are the same kind. *)
  LocalInit : ptrs   = $stars + $base.ptrs
            : basew  = $base.basew
            : dquals = "{}{}" of $base.bquals, $squals
            : takes  = ((lookup([[0, $basew]], $ptrs, 8) + 7) div 8) * 8
            : offset = $bytes + $takes
            : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg])
            : scope  = bind($scope, $name, true)
            : bytes  = $bytes + $takes
            ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
            ! defined($scope, $name) : "'{}' is declared twice" of $name
            ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                : "'{}' is a typedef, and only an object has an initialiser, C11 6.7.9" of $name
            ! $base.unsup = "" and $base.nstore < 2 and $base.stat and $dkind <> "for"
                : "'{}' is 'static' and was read as a local that is not: a fault in c.phx, and not in the program" of $name
            ! $base.sext
                : "'{}' is declared 'extern' in a block, and C11 6.7.9p5 gives it no initialiser" of $name .

  (* An element is one byte, four or eight, or a struct's size, the whole
   * thing is `count` of them, and what the frame gives it is that rounded up to eight.
   *
   * A count of zero is refused rather than bound, and that is what keeps
   * *count of zero* free to mean *not an array* in every table and test
   * below. C11 6.7.6.2 wants a size greater than zero; this `cc` takes
   * `int a[0]` as an extension and gives it a `sizeof` of 0, so without the
   * refusal it is a program both compile and answer differently. *)
  LocalArray : ptrs   = $stars + $base.ptrs
             : basew  = $base.basew
             : dquals = "{}{}" of $base.bquals, $squals
             : ebytes = lookup([[0, $basew]], $ptrs, 8)
             : whole  = $count * $ebytes
             : takes  = lookup([[true, 0]], $base.sext, (($whole + 7) div 8) * 8)
             : offset = $bytes + $takes
             : env    = bind($env, $name, lookup([[true, [0, $ptrs, $count, $basew, $base.tagname, true, false, $base.buns, $name, $dquals, false]]],
                                                $base.sext,
                                                [$offset, $ptrs, $count, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg]))
             : scope  = bind($scope, $name, true)
             : bytes  = $bytes + $takes
             ! $count < 1
                 : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                     of $name
             ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                 : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
             ! defined($scope, $name) : "'{}' is declared twice" of $name
             ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                 : "'{}' is a typedef of an array, which C allows and this subset does not have yet" of $name
             ! $base.unsup = "" and $base.nstore < 2 and $base.sreg
                 : "'{}' is a 'register' array, and C11 6.3.2.1p3 makes using one undefined" of $name
             ! $base.unsup = "" and $base.nstore < 2 and $base.stat and $dkind <> "for"
                 : "'{}' is 'static' and was read as a local that is not: a fault in c.phx, and not in the program" of $name
             ! $base.sext and defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 3), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 4), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 10)] <> [$stars + $base.ptrs, $count, $base.basew, $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                 : "'{}' is declared again with another type, C11 6.7p4" of $name .

  (* **A `static` local takes no frame either**, since 2026-09-29, ROADMAP
   * 6.10: it is bound in `env` as a local is, so that it hides and is
   * hidden by the block's rules, and its entry says *global*, so that it is
   * reached as a global is, by a label. The label is the ninth part of an
   * entry, the name for a global and "" for what lives in the frame, and a
   * `static` local's is its function, its name and a number counted across
   * the file, because two functions may each have a `static int n` and so
   * may two blocks of one: `cc` writes `_f.n` and `_f.n.1`, and this writes
   * `_f.n.0` and `_f.n.1`. A dot cannot be in a C name, so no global's
   * label is ever one of these. *)
  thread statics = 0

  Static      : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $ebytes
              : label  = "{}.{}.{}" of $fn, $name, $statics
              : statics = $statics + 1
              : env    = bind($env, $name, [0, $ptrs, 0, $basew, $base.tagname, true, false, $base.buns, $label, $dquals, false])
              : scope  = bind($scope, $name, true)
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($scope, $name) : "'{}' is declared twice" of $name .
  StaticArray : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $count * $ebytes
              : label  = "{}.{}.{}" of $fn, $name, $statics
              : statics = $statics + 1
              : env    = bind($env, $name, [0, $ptrs, $count, $basew, $base.tagname, true, false, $base.buns, $label, $dquals, false])
              : scope  = bind($scope, $name, true)
              ! $count < 1
                  : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                      of $name
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($scope, $name) : "'{}' is declared twice" of $name .
  (* Its initialiser is walked where it stands, with the function's names in
   * sight, so `static int b = a;` finds a local `a` and is refused by the
   * `constants` pass because it is not worked out before the program runs,
   * as `cc` refuses it. The name is bound on the way out, as a local's is. *)
  StaticInit  : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $ebytes
              : label  = "{}.{}.{}" of $fn, $name, $statics
              : statics = $statics + 1
              : env    = bind($env, $name, [0, $ptrs, 0, $basew, $base.tagname, true, true, $base.buns, $label, $dquals, false])
              : scope  = bind($scope, $name, true)
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($scope, $name) : "'{}' is declared twice" of $name .

  (* **A global takes no frame**, and is bound in `globals` instead of
   * `env`, with the name its entry needs and nothing the frame counts. Its
   * width and alignment are the emit pass's, to lay it out in
   * `__DATA,__data`. The refusals are a local's, and three of file scope's
   * own: a name a function or a typedef already has, a global declared
   * again with another type, and two initialisers. A second declaration
   * with the same type is C11 6.9.2's tentative definition, since ROADMAP
   * 6.12's second part, and was refused by name until then; the entry
   * keeps whether any declaration so far had an initialiser. *)
  Global      : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $ebytes
              : globals = bind($globals, $name, [0, $ptrs, 0, $basew, $base.tagname, true, defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 7),
                                                 $base.buns, $name, $dquals, false])
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 3), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 4), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 10)] <> [$stars + $base.ptrs, 0, $base.basew, $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                  : "'{}' is declared again with another type, C11 6.7p4" of $name
              ! defined($funcs, $name)
                  : "'{}' is a function already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register") .
  GlobalArray : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $count * $ebytes
              : globals = bind($globals, $name, [0, $ptrs, $count, $basew, $base.tagname, true, defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 7),
                                                 $base.buns, $name, $dquals, false])
              ! $count < 1
                  : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                      of $name
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 3), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 4), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 10)] <> [$stars + $base.ptrs, $count, $base.basew, $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                  : "'{}' is declared again with another type, C11 6.7p4" of $name
              ! defined($funcs, $name)
                  : "'{}' is a function already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register")
              ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                  : "'{}' is a typedef of an array, which C allows and this subset does not have yet" of $name .
  (* An initialiser is an expression at file scope, where the names are the
   * globals above it: `int b = a;` finds `a`, and is refused because it is
   * not constant, as `cc` refuses it, rather than as undeclared. *)
  GlobalInit  : down env = $globals
              : ptrs   = $stars + $base.ptrs
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = lookup([[0, $basew]], $ptrs, 8)
              : galign = lookup([[0, $base.align]], $ptrs, 8)
              : whole  = $ebytes
              : globals = bind($globals, $name, [0, $ptrs, 0, $basew, $base.tagname, true, true, $base.buns, $name, $dquals, false])
              ! $stars + $base.ptrs = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 3), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 4), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false]), 10)] <> [$stars + $base.ptrs, 0, $base.basew, $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                  : "'{}' is declared again with another type, C11 6.7p4" of $name
              ! defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false]), 7)
                  : "'{}' is defined twice, with an initialiser each" of $name
              ! defined($funcs, $name)
                  : "'{}' is a function already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register")
              ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                  : "'{}' is a typedef, and only an object has an initialiser, C11 6.7.9" of $name .

  (* The five once, and their parts named from them. `Assign` has no clause
   * here: what it assigns to is a place, and the question is asked where the
   * name is rather than twice. *)
  Variable : means   = lookup($env, $name, [0, 0, 0, 4, "", false, false, false, "", "0", false])
           : vreg    = at($means, 11)
           : global  = at($means, 6)
           : vuns    = at($means, 8)
           : label   = at($means, 9)
           : vquals  = at($means, 10)
           : offset  = at($means, 1)
           : stars   = at($means, 2)
           : count   = at($means, 3)
           : basew   = at($means, 4)
           : tagname = at($means, 5)
           ! not defined($env, $name) : "'{}' is not declared" of $name .

  (* A member cannot be looked up here, because which struct it is in is the
   * `types` pass's to work out, and a thread is not something a later pass
   * can read. So the table is kept at the node, as it stood when the walk
   * reached it, for the pass that can use it. *)
  Member : known = $layouts .
  Assign : known = $layouts .

(* ------------------------------------------------------------------ *)
(* Pass three: how many stars, and what that makes impossible.         *)
(*                                                                     *)
(* Every value travels in one sixty-four-bit register, an `int` in its  *)
(* low half, so almost nothing comes out wrong from a pointer being     *)
(* taken for an `int`: the emit pass picks the half from the star count *)
(* worked out here, and that is all it asks. The places where C says    *)
(* more than that are what this pass is for, and there were two before  *)
(* `struct`.                                                            *)
(*                                                                     *)
(* One is `p + 1`, which C11 6.5.6 says is the **next int** and not the *)
(* next byte, so the answer is a pointer and the emit pass has to know  *)
(* how wide a step is. It was refused by name until a size arrived with *)
(* arrays; it is now a type this pass works out. The other is `*x` on   *)
(* an `int`, which C11 6.5.3.2 forbids and which would compile here     *)
(* into a load from whatever the int happened to be.                   *)
(*                                                                     *)
(* **A struct is the third.** A member is found by which struct it is   *)
(* in, so an expression carries that as `tag`. A struct is a thing in   *)
(* memory that no register holds, and the emit pass copies it where C   *)
(* copies it; what this pass refuses is a copy between two kinds, and a *)
(* struct anywhere C wants a number, where its address would be used.   *)
(*                                                                     *)
(* What this pass deliberately does **not** do is check that what is    *)
(* assigned, or passed, has the type it is given. C11 6.5.16.1 has a    *)
(* table for that and `cc` warns from it, but nothing compiled here     *)
(* comes out wrong for getting it wrong, and a check that only          *)
(* reproduces somebody else's diagnostic is a second opinion rather     *)
(* than a compiler. This pass refuses what it would otherwise           *)
(* mis-compile, and nothing else.                                       *)
(*                                                                     *)
(* That was first argued against an eight-byte `int`, where a pointer   *)
(* put in an `int` and taken out again kept sixty-four bits here and    *)
(* thirty-two under `cc`. Since `int` narrowed the two agree, and the   *)
(* program is one this `cc` refuses to compile anyway. See journal      *)
(* 2026-09-22.                                                          *)

%pass types

  Decls  : down base = $spec .
  MDecls : down base = $spec .

  (* Zero is "not a pointer", which is what a statement is, what a program is,
   * and what every node that is not an expression is. Saying it once here is
   * what keeps the clauses below to the nodes that have something to say. *)
  otherwise type = 0

  (* **A type is two numbers since `char`**: how many stars, and how wide the
   * thing at the bottom of them is, 4 for an `int` and 1 for a `char`. The
   * second was always 4 and so was never written, until there was a second
   * answer. It is carried by the expressions that have a pointer's or a
   * place's type, a name, a `*`, a `&`, an assignment and pointer
   * arithmetic, and everything else is 4. That default is **C11 6.3.1.1's
   * integer promotion**: a `char` in an expression is an `int` before any
   * operator sees it, so `c + 1`, `-c` and `c < d` are all `int`s, and only
   * a thing that is still a place, or points at one, can be narrower.
   *
   * `struct` was expected to be where two numbers stop being enough, because
   * a member has a type of its own and a number cannot hold one. It needed a
   * **third** and not a node: the member's type is looked up by the struct's
   * tag, in the table the `locals` pass built, so what an expression has to
   * carry is only which struct it is. The node went to the base of a
   * declaration instead, in the grammar. *)
  otherwise width = 4

  (* The third number, which is text: the tag of the struct at the bottom of
   * the stars, or "" when it is an `int` or a `char`. A struct value is
   * `type` 0 with a tag, and a pointer to one has stars and the same tag. *)
  otherwise tag = ""

  (* **Whether the value is a `long`**, since 2026-09-23: no stars, no tag,
   * and eight bytes wide. A `long` is the one scalar here wider than the
   * `int` everything promotes to, so it is the one that changes what an
   * operator does: C11 6.3.1.8's usual arithmetic conversions make `int`
   * op `long` a `long`, the `int` side converted first. The emit pass reads
   * this to pick an `x` register and to sign-extend the `int` side. *)
  otherwise wide = $type = 0 and $width = 8 and $tag = ""

  (* **Whether it is unsigned**, since 2026-09-26, ROADMAP 6.9, the fourth
   * part of a type beside the stars, the width and the tag. Like the width
   * and the tag it describes the thing at the bottom of the stars, so a
   * pointer to an `unsigned char` carries it and a load through one knows
   * to use `ldrb`. `puns` is the same question **after promotion**, C11
   * 6.3.1.1: an `unsigned char` is an `int` before any operator sees it,
   * since an `int` holds every value it has, so only an `unsigned int` or
   * an `unsigned long` makes arithmetic unsigned.
   *
   * **C11 6.3.1.8's usual arithmetic conversions** are then one
   * expression, written out at each operator that needs it: when either
   * side is eight bytes wide the answer is unsigned only if an eight-byte
   * side is, because a `long` holds every `unsigned int`; otherwise it is
   * unsigned if either side is, because an `int` beside an `unsigned int`
   * becomes one. *)
  otherwise uns  = false
  otherwise puns = $uns and $type = 0 and $width >= 4

  (* **Whether the value is its own address.** An array and a struct are
   * both things in memory that no register holds: an array decays to the
   * address of its first element, and a struct is only ever reached through
   * its address, by a member or by `&`. The emit pass reads this to leave out
   * the load a scalar would have, and `Assign` to refuse both. *)
  otherwise aggregate = false

  (* **Whether the value is a struct**, as opposed to a pointer to one or a
   * number. C11 takes a struct in exactly five places: `.`, `&`, `sizeof`,
   * a copy into a struct of the same type, and a statement that throws it
   * away. Everywhere else, arithmetic, a comparison, a condition and a copy
   * into anything else, a `return` from an `int` function included, `cc`
   * refuses it, and this
   * subset compiled it until 2026-09-23 into the struct's **address** used
   * as a number. So each of those places asks this, and refuses. *)
  otherwise record = $type = 0 and $tag <> ""

  (* **Which levels of the type are `const`**, since 2026-09-29, ROADMAP
   * 6.10's third part: the fifth part of a type, beside the stars, the
   * width, the tag and whether it is unsigned. It is text, one `0` or `1`
   * a level, in the order a declaration writes them: the base first, then
   * each star's, so `const char *const p` is `11` and `char *q` is `00`,
   * and **the last is the value's own**. So a `*` drops the last, a `&`
   * puts a `0` after, and a pointer's arithmetic keeps its pointer's. It
   * was to be a number, a bit a level, and is text because a declaration's
   * stars reach a pass as a list, and the notation can make text of a list
   * with `each` and `join` and has no way to make a number of one.
   *
   * **What it changes is what is refused**, C11 6.3.2.1p1: a place whose own
   * level is `const` is not one a value can be put in, by `=`, by an update
   * or by `++`, and nor is a struct with a `const` member anywhere in it,
   * put whole. A value this pass knows nothing about is `0`, one level, so
   * a pointer's is too short and what it points at is not `const` when
   * asked: the gap loses a refusal and never makes one, and a conversion
   * that drops a `const` without a cast is not checked, by 6.7's rule. *)
  otherwise quals    = "0"
  otherwise readonly = slice($quals, size($quals), size($quals)) = "1"

  (* **What a `record` is called in a message**, since 2026-09-26: a
   * `void` value is one, see `layouts` in the `locals` pass, so every
   * refusal of a struct where C wants a number refuses it too, and says
   * `'void'` where it would have said `'struct void'`. *)
  otherwise kind = lookup([["void", "void"]], $tag, "struct {}" of $tag)

  (* **Whether it is somewhere a value can be put**, C11 6.3.2.1's lvalue.
   * The `place` rule settled this in the grammar while the only places were
   * names and `*`s. A member is a place when what it is a member of is one,
   * and since structs are copied that need not be so: `(x = y).a` is a
   * member of a value, which C11 6.5.16 says an assignment is, and a program
   * that assigns to it or takes its address is refused by `cc` and was
   * compiled here into a write to `x`. *)
  otherwise lvalue = false

  (* And a size falls out of the type for everything except a name, because a
   * name is the only thing that can be an array: no operator here answers
   * one. `Variable` therefore says its own and this covers the rest. *)
  otherwise size = lookup([[0, $width]], $type, 8)

  (* **A name that is an array decays**, C11 6.3.2.1: in an expression it is a
   * pointer to its first element, so its `type` has one more star than it was
   * declared with. Its `size` does **not** decay, because `sizeof` is one of
   * the places C says the conversion does not happen, and the two attributes
   * being separate is what lets one of them answer a decayed question and the
   * other an undecayed one without either knowing about `sizeof`. *)
  Variable : width = $basew
           : uns   = $vuns
           : tag   = $tagname
           : elem  = lookup([[0, $width]], $stars, 8)
           : type  = lookup([[0, $stars]], $count, $stars + 1)
           : size  = lookup([[0, $elem]], $count, $count * $elem)
           : aggregate = $count > 0 or ($stars = 0 and $tag <> "")
           : quals = lookup([[0, $vquals]], $count, "{}0" of $vquals)
           : lvalue = true .
  Addr     : type  = $place.type + 1
           : quals = "{}0" of $place.quals
           : uns   = $place.uns
           : width = $place.width
           : tag   = $place.tag
           ! not $place.lvalue
               : "'&' wants somewhere a value is kept, and a member of an assignment or a call is a member of a value" .
  (* An array is not an lvalue, C11 6.3.2.1 again: it decays before anything
   * can be assigned to it, so there is nothing to assign to. Without this the
   * emit pass would store through the array's address and write element
   * zero, which is a wrong answer rather than a refusal.
   *
   * **A struct is an lvalue and C assigns it whole**, 6.5.16.1, which is a
   * copy of its bytes, and the emit pass copies them. What C asks is that
   * both sides be the **same** struct, and that is what is checked: a copy
   * between two sizes has no right length, and a struct put in a number, or
   * a number in a struct, would be an address stored as a value. The two
   * cases are told apart by the decay: an array's `type` has a star its
   * declaration did not, and a struct's has none.
   *
   * The assignment is worth the struct, as any assignment is worth what it
   * put, so `a = b = c` copies twice and `(a = b).x` is a member of `a`. *)
  Assign   : type  = $place.type
           : quals = "{}0" of lookup([[true, slice($place.quals, 1, size($place.quals) - 1)]], size($place.quals) > 1, "")
           : uns   = $place.uns
           : width = $place.width
           : tag   = $place.tag
           : aggregate = $place.aggregate and $place.type = 0
           ! $place.aggregate and $place.type > 0
               : "an array is not something a value can be put in"
           ! not $place.lvalue
               : "a member of an assignment or a call is a member of a value, and a value is not something another can be put in"
           ! $place.record and ($value.type <> 0 or $value.tag <> $place.tag)
               : "'struct {}' is assigned {}, and a struct takes only its own kind"
                   of $place.tag,
                      lookup([[true, "'{}'" of $value.kind]], $value.record,
                             "something that is not a struct")
           ! $value.record and not $place.record
               : "'{}' is put where a number or a pointer goes" of $value.kind
           ! $place.readonly
               : "'=' changes something declared 'const', and C11 6.3.2.1p1 says nothing may"
           ! $place.record and at(lookup($known, $place.tag, [0, 1, empty, false]), 4)
               : "'struct {}' has a 'const' member, so it is not assigned whole, C11 6.3.2.1p1" of $place.tag .

  (* **An update is an assignment that reads its place first**, C11
   * 6.5.16.2 and 6.5.2.4, so it is worth the place's type, and it takes what
   * `=` takes and what the operator takes, both. The place has to be one, and
   * not an array; a struct has no arithmetic, on either side; and the right
   * side is a number, because a pointer there is either two pointers added or
   * a pointer put in a number, and `cc` refuses both. A pointer on the left
   * steps by `+` and `-` only, as C11 6.5.6 allows it to. `arith` is the
   * operator the update stands for, `+` for `++` and for `+=`. *)
  Update   : type  = $place.type
           : quals = "{}0" of lookup([[true, slice($place.quals, 1, size($place.quals) - 1)]], size($place.quals) > 1, "")
           : uns   = $place.uns
           : width = $place.width
           : tag   = $place.tag
           : arith = lookup([["++", "+"], ["--", "-"], ["+=", "+"], ["-=", "-"],
                             ["*=", "*"], ["/=", "/"], ["%=", "%"], ["&=", "&"],
                             ["|=", "|"], ["^=", "^"], ["<<=", "<<"], [">>=", ">>"]],
                            $op, "?")
           ! $place.aggregate and $place.type > 0
               : "'{}' is given an array, and an array is not something a value can be put in" of $op
           ! not $place.lvalue
               : "'{}' wants somewhere a value is kept, and an assignment, a call or an update is a value" of $op
           ! $place.record
               : "'{}' wants a number or a pointer, and this is '{}'" of $op, $place.kind
           ! $value.record
               : "'{}' wants a number on its right, and this is '{}'" of $op, $value.kind
           ! $value.type > 0
               : "'{}' does not take a pointer on its right" of $op
           ! $place.type > 0 and $op <> "++" and $op <> "--" and $op <> "+=" and $op <> "-="
               : "'{}' does not take a pointer" of $op
           ! $place.type = 1 and $place.tag = "void"
               : "'{}' on a 'void *' counts in something of no size; this cc counts in bytes, as GNU C does" of $op
           ! $place.readonly
               : "'{}' changes something declared 'const', and C11 6.3.2.1p1 says nothing may" of $op .

  (* The same rule for a declaration's initialiser, which is an assignment to
   * a place the declaration names. `ptrs` and the base are the `locals`
   * pass's. *)
  LocalInit ! $ptrs = 0 and $base.tagname <> ""
                and ($value.type <> 0 or $value.tag <> $base.tagname)
                : "'{}' is a 'struct {}' initialised from {}, and a struct takes only its own kind"
                    of $name, $base.tagname,
                       lookup([[true, "a '{}'" of $value.kind]], $value.record,
                              "something that is not a struct")
            ! $value.record and not ($ptrs = 0 and $base.tagname <> "")
                : "'{}' is put where a number or a pointer goes" of $value.kind .

  (* **A global's initialiser** is an assignment too, since 2026-09-26, and
   * a value is all it can be: a struct global would need a brace-enclosed
   * initialiser, which the subset does not have, and is refused by name. *)
  GlobalInit ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void"
                 : "'{}' is a 'struct {}' with an initialiser, which wants braces, and they are not here yet"
                     of $name, $base.tagname
             ! $value.record and not ($ptrs = 0 and $base.tagname <> "")
                 : "'{}' is put where a number or a pointer goes" of $value.kind .

  StaticInit ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void"
                 : "'{}' is a 'struct {}' with an initialiser, which wants braces, and they are not here yet"
                     of $name, $base.tagname
             ! $value.record and not ($ptrs = 0 and $base.tagname <> "")
                 : "'{}' is put where a number or a pointer goes" of $value.kind .

  (* An argument is a copy into the parameter, so the same rule again, asked
   * of each argument where both sides are known: `$sig` is the callee's
   * parameters as the `locals` pass had them, each the tag of a struct passed
   * whole or "", and `$argi` is where this argument is in the call.
   *
   * **It was asked of the call, comparing two lists whole**, until
   * 2026-09-26. An argument past the named ones, to a function that ends in
   * `...`, has no parameter to be compared with, and the notation has no way
   * to take the first few of a list, so the question moved to where the
   * position is known. It counts the way the emit pass counts: the call
   * resets the thread for its own arguments and puts it back after.
   *
   * **A struct passed through `...` is refused by name**, though `cc`
   * compiles it: Apple's arm64 lays one out by rules of its own, and nothing
   * here needs it, `printf` having no conversion that reads one. A check
   * cannot read what its own rule computes, so the tag is written out. *)
  thread argi = 0

  Arg      : type = $value.type
           : carries = lookup([[true, $value.tag]], $value.record, "")
           : argi = $argi + 1
           ! $value.record and $value.tag = "void"
               : "'{}' is given the value of something 'void', which has none" of $callee
           ! $argi < size($sig) and $value.tag <> "void"
             and lookup([[true, $value.tag]], $value.record, "") <> at($sig, $argi + 1)
               : "'{}' is given a struct where its parameter is not that struct, or something else where its parameter is a struct"
                   of $callee
           ! $argi >= size($sig) and $value.record and $value.tag <> "void"
               : "'{}' is given a 'struct {}' through '...', and a struct is not passed that way here"
                   of $callee, $value.tag .
  Program  : down callees = $allsigs
           : down labelled = $alllabels
           : down results = $allrets
           : down wides   = $allpwidths .
  (* **A call is worth what its function returns**, the three numbers an
   * expression's type is, read off the `locals` pass's table: it was an `int`
   * whatever the function said until a function could return a pointer.
   * A pointer to a struct has the tag and is not a struct, so `aggregate`
   * asks for no stars.
   * A struct that comes back from a call is a value and not somewhere one
   * is kept, C11 6.5.2.2, so `f().x` can be read and not assigned or
   * pointed at: `lvalue` stays false, as it is for an assignment. The emit
   * pass puts it in the caller's frame, so, like any struct, it is its own
   * address. *)
  Call     : down sig    = lookup($callees, $name, [])
           : down callee = $name
           : down held   = $argi
           : down argi   = 0
           : argi      = $held
           : argwide   = lookup($wides, $name, [])
           : returns   = lookup($results, $name, ["", 4, 0, false, "0"])
           : quals     = at($returns, 5)
           : uns       = at($returns, 4)
           : tag       = at($returns, 1)
           : width     = at($returns, 2)
           : type      = at($returns, 3)
           : aggregate = $type = 0 and $tag <> "" and $tag <> "void" .

  (* **A `return` is a copy into what the function returns**, so it is the
   * assignment's rule once more: a struct takes only its own kind, and an
   * `int` no struct. What the function returns is handed down from it, and
   * a function returning a pointer to a struct gives "", since what it
   * returns is not one. *)
  Function : down gives = lookup([[0, $ret.tagname]], $rptrs, "")
           : down loops = 0
           : down switches = 0
           : down fn    = $name .
  Return ! $value.record and $gives = ""
             : "'{}' is returned, and this function returns an int" of $value.kind
         ! $value.record and $gives <> "" and $gives <> "void" and $value.tag <> $gives
             : "'{}' is returned, and this function returns 'struct {}'" of $value.kind, $gives
         ! not $value.record and $gives <> "" and $gives <> "void"
             : "a function that returns 'struct {}' returns something that is not a struct" of $gives
         (* **A `void` function returns nothing**, since 2026-09-26, and
          * `cc` refuses `return 1;` in one. `return f();` of another `void`
          * function is refused too, which C11 6.8.6.4 requires and `cc`
          * allows with a warning. *)
         ! $gives = "void"
             : "a function that returns 'void' returns a value; 'return;' returns nothing" .

  ReturnNothing ! $gives <> "void"
                    : "'return;' returns nothing, and this function returns a value, which C11 6.8.6.4 requires" .

  (* The places a number is wanted and a struct is not one. *)
  If     ! $cond.record  : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind .
  IfElse ! $cond.record  : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind .
  While  : down loops = $loops + 1
         ! $cond.record  : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind .
  For    : down loops = $loops + 1
         ! $cond.record = [true]
             : "a struct is a condition, and C tests only numbers and pointers" .
  DoWhile : down loops = $loops + 1
          ! $cond.record : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind .

  (* A `goto` names a label of its own function, anywhere in it, which the
   * `locals` pass has gathered; one in another function is not one. *)
  Goto     ! not defined($labelled, "{}/{}" of $fn, $name)
               : "there is no label '{}' in this function to go to" of $name .

  (* **`break` and `continue` belong to a loop**, C11 6.8.6.2 and 6.8.6.3, so
   * each counts the loops it is inside, from 0 at a function's start, and
   * one outside all of them is refused, as `cc` refuses it. A `break`
   * belongs to a `switch` as well, since 2026-09-25, and a `continue` does
   * not: one in a `switch` in no loop is refused, and one in a `switch` in a
   * loop goes on with the loop. *)
  Break    ! $loops = 0 and $switches = 0 : "'break' is not inside a loop or a switch" .
  Continue ! $loops = 0 : "'continue' is not inside a loop" .

  (* **A `switch` wants an integer**, C11 6.8.4.2, which it promotes, so a
   * pointer and a struct are refused as `cc` refuses them. A `case` and a
   * `default` are labels of the innermost `switch` around them, loops or no
   * loops between, and are refused outside every one. *)
  Switch   : down switches = $switches + 1
           ! $cond.record : "'switch' wants an integer, and this is '{}'" of $cond.kind
           ! $cond.type > 0 : "'switch' wants an integer, and this is a pointer" .
  Case     ! $switches = 0 : "'case' is not inside a switch" .
  Default  ! $switches = 0 : "'default' is not inside a switch" .
  (* **A comparison is signed or unsigned by the usual conversions**, and
   * its answer is an `int` either way, so `cuns` is for the emit pass to
   * pick `lo` over `lt`: `-1 < 1u` is 0 in C, because the `-1` becomes
   * 4294967295 first. *)
  Compare : cuns = lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                          $left.wide or $right.wide, $left.puns or $right.puns)
          ! $left.record or $right.record
              : "'{}' compares numbers and pointers, and this is '{}'"
                  of $op, lookup([[true, $left.kind]], $left.record, $right.kind) .
  (* `!`, `&&` and `||` test their operands the way a condition does, C11
   * 6.5.3.3 and 6.5.13 to 6.5.14, so a struct is refused in them for the same
   * reason. Each is an `int`, 0 or 1, which is what `type` and `width` say
   * already when nothing says otherwise. *)
  (* **`~` and unary `+` promote**, C11 6.5.3.3: a `char` comes out an `int`,
   * so `sizeof(+c)` is 4 where `sizeof(c)` is 1, and that is the whole of
   * what `+` does. Both want a number. *)
  Invert  : width = lookup([[true, 8]], $value.wide, 4)
          : uns   = $value.puns
          ! $value.record : "'~' wants a number, and this is '{}'" of $value.kind
          ! $value.type > 0 : "'~' wants a number, and this is a pointer" .
  Plus    : width = lookup([[true, 8]], $value.wide, 4)
          : uns   = $value.puns
          ! $value.record : "'+' wants a number, and this is '{}'" of $value.kind
          ! $value.type > 0 : "'+' wants a number, and this is a pointer" .

  (* **A comma is worth its right side**, C11 6.5.17, and is not a place.
   * An array on the right has decayed already, so `sizeof((0, a))` is a
   * pointer's 8 and not the array's, which `comma.c` asks. *)
  Comma   : type  = $right.type
          : quals = $right.quals
          : uns   = $right.uns
          : width = $right.width
          : tag   = $right.tag
          : aggregate = $right.aggregate .

  (* **`?:` brings its two arms to one type**, C11 6.5.15. Two numbers are
   * the usual arithmetic conversions, so a `long` arm makes it a `long` and
   * two `char`s make an `int`; two pointers must be to the same type; two
   * structs must be the same struct, and the answer is one. What `cc` also
   * takes and this does not: a pointer on one side and `0` on the other, a
   * null pointer constant, which would need this pass to know a literal 0
   * from any other `int`; and pointers to two types, which `cc` only warns
   * about and which has no one type to be. *)
  Choose  : type  = $then.type
          : quals = $then.quals
          : uns   = lookup([[0, lookup([[true, ($then.wide and $then.puns) or ($other.wide and $other.puns)]],
                                       $then.wide or $other.wide, $then.puns or $other.puns)]],
                           $then.type, $then.uns)
          : width = lookup([[0, lookup([[true, 8]], $then.wide or $other.wide, 4)]],
                           $then.type, $then.width)
          : tag   = $then.tag
          : aggregate = $then.record and $then.tag <> "void"
          ! $cond.record
              : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind
          ! $then.record <> $other.record
              : "'?:' has a struct on one side and not on the other"
          ! $then.record and $other.record and $then.tag <> $other.tag
              : "'?:' has '{}' on one side and '{}' on the other" of $then.kind, $other.kind
          ! ($then.type > 0) <> ($other.type > 0)
              : "'?:' has a pointer on one side and a number on the other, and this subset has no null pointer constant"
          ! $then.type > 0 and $other.type > 0
              and ($then.type <> $other.type or $then.width <> $other.width or $then.tag <> $other.tag)
              : "'?:' has pointers to two different types" .

  Not     ! $value.record
              : "'!' tests a number or a pointer, and this is '{}'" of $value.kind .
  Logical ! $left.record or $right.record
              : "'{}' tests numbers and pointers, and this is '{}'"
                  of $op, lookup([[true, $left.kind]], $left.record, $right.kind) .
  Deref    : type  = $value.type - 1
           : quals = lookup([[true, slice($value.quals, 1, size($value.quals) - 1)]], size($value.quals) > 1, "")
           : uns   = $value.uns
           : width = $value.width
           : tag   = $value.tag
           : aggregate = $type = 0 and $tag <> ""
           : lvalue = true
           ! $value.type < 1
               : "'*' wants a pointer, and this is {}"
                   of lookup([["", "an int"], ["void", "'void'"]], $value.tag, "a struct")
           (* **`*` on a `void *` is refused**, since 2026-09-26. `cc`
            * refuses it wherever the value is read, and only warns at a
            * statement that throws it away; here it is refused at both,
            * since there is nothing of no width to load. *)
           ! $value.type = 1 and $value.tag = "void"
               : "'*' on a 'void *' has nothing to read: convert it to a pointer to something first" .

  (* **A member is the struct's layout read at the member's name.** The
   * entry is the same five things a name's is, where it is, its stars, its
   * count, its width and its tag, and everything a `Variable` works out from
   * those it works out the same way: an array member decays and a struct
   * member is its own address. The offset is kept for the emit pass.
   *
   * `->` built `(*p).x` in the grammar, so there is one node and these two
   * checks between them cover both: a `->` on what is not a pointer was
   * already refused by the `*`, and what is left is a member asked of
   * something that is not a struct, or of a struct that has no such member.
   *
   * `$known` is the table the `locals` pass kept at this node, which is every
   * struct defined above the function. *)
  Member : entry = lookup(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name,
                          [0, 0, 0, 4, "", false, "0"])
         (* A member of a `const` struct is `const`, as `cc` has it: its own
          * level is its declaration's or the struct's, and an array member
          * decays as a name does. *)
         : mq    = at($entry, 7)
         : mown  = "{}{}" of lookup([[true, slice($mq, 1, size($mq) - 1)]], size($mq) > 1, ""),
                              lookup([[true, "1"]], slice($mq, size($mq), size($mq)) = "1" or $value.readonly, "0")
         : quals = lookup([[0, $mown]], at($entry, 3), "{}0" of $mown)
         : uns   = at($entry, 6)
         : width = at($entry, 4)
         : tag   = at($entry, 5)
         : elem  = lookup([[0, $width]], at($entry, 2), 8)
         : type  = lookup([[0, at($entry, 2)]], at($entry, 3), at($entry, 2) + 1)
         : size  = lookup([[0, $elem]], at($entry, 3), at($entry, 3) * $elem)
         : aggregate = at($entry, 3) > 0 or (at($entry, 2) = 0 and $tag <> "")
         : lvalue = $value.lvalue
         ! $value.type <> 0 or $value.tag = "" or $value.tag = "void"
             : "'{}' is asked for as a member of something that is not a struct" of $name
         ! $value.type = 0 and $value.tag <> "" and $value.tag <> "void"
               and not defined(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name)
             : "'struct {}' has no member '{}'" of $value.tag, $name .

  Negate : width = lookup([[true, 8]], $value.wide, 4)
         : uns   = $value.puns
         ! $value.record : "'-' wants a number, and this is '{}'" of $value.kind
         ! $value.type > 0 : "'-' wants a number, and this is a pointer" .

  (* **`sizeof` is worth an `unsigned long`**, C11 6.5.3.4's `size_t` on
   * this machine. It was an `int` here from 2026-09-22, because the subset
   * had no `long`, and one program showed it: `sizeof(sizeof(int))`, 8
   * under `cc` and 4 here. It was a `long` from 2026-09-23, and a comment
   * here said nothing could see the difference, a size never being
   * negative. **A size less a larger number can**, and the arithmetic is
   * C's, not the reader's: `sizeof(int) - 5 < 0` is 0, and every answer of
   * `sizeof-is-unsigned.c` differed until 2026-09-27, ROADMAP 6.9's second
   * part, when it became unsigned. The difference of two pointers stays a
   * `long`, C's `ptrdiff_t`. *)
  (* **A cast is worth the type it names**, C11 6.5.4, and is a value and
   * not a place, so `lvalue` stays false. A cast to `void` is a `void`
   * value, a record with the tag `void`, which a statement may throw away
   * and nothing may read, as for a call to a `void` function.
   *
   * C casts only to a number, a pointer or `void`, and only from a number
   * or a pointer, or anything at all to `void`. `cc` refuses a struct cast
   * to a number, and a `void` value cast to anything but `void`; it
   * compiles a cast **to** a struct of the same kind, as GNU C does, which
   * is refused here by name. *)
  Cast : type  = $ptrs
       : quals = $dquals
       : uns   = $base.buns
       : width = $base.basew
       : tag   = $base.tagname
       ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void"
           : "a cast to 'struct {}' is not C, C11 6.5.4; this cc allows one to the same struct, as GNU C does"
               of $base.tagname
       ! $value.record and not ($ptrs = 0 and $base.tagname <> "")
           : "'{}' is cast to something other than 'void', and only a number or a pointer can be"
               of $value.kind .

  SizeOfType : type = 0 : width = 8 : uns = true
             (* **`sizeof` of `void` is refused by name**, since 2026-09-26:
              * C11 6.5.3.4 wants a complete type, and `cc` answers 1, as GNU
              * C does. *)
             ! $ptrs = 0 and $base.tagname = "void"
                 : "'sizeof' of 'void' has no size, C11 6.5.3.4; this cc says 1, as GNU C does" .
  SizeOfExpr : type = 0 : width = 8 : uns = true
             ! $value.record and $value.tag = "void"
                 : "'sizeof' of 'void' has no size, C11 6.5.3.4; this cc says 1, as GNU C does" .

  (* **A constant's type is C11 6.4.4.1's table**, since 2026-09-27,
   * ROADMAP 6.9: the first of a list that can hold it, and the list
   * depends on the suffix and on whether it is decimal. Unsuffixed, a
   * decimal constant is an `int` or a `long`, and a hex or octal one may
   * also be an `unsigned int` between them, or an `unsigned long` after:
   * `4294967295` is a `long` and `0xffffffff` an `unsigned int`, which is
   * why `-1 < 0xffffffff` is 0. A `u` leaves only the unsigned ones, an
   * `l` only the eight-byte ones. `long long` is the width of `long` here,
   * so the table's last rows are not needed. **A decimal constant past the
   * largest `long` is an `unsigned long`**, which C11 leaves with no type
   * and `cc` and GNU C give that one, with a warning; until 2026-09-27 it
   * was refused by name.
   *
   * **The value is its sixty-four bits**, which are what `cc` writes and
   * what the notation's signed integers can hold: an `unsigned long` past
   * 2^63 is negative in `bits`. The library's `int` refuses text that does
   * not fit, so a constant is read in two halves, each small enough, and
   * put together in a way that cannot overflow. For hex, the low eight
   * digits and the rest, each thirty-two bits; for octal the low eleven,
   * thirty-three bits, and the rest; for decimal the low ten digits and
   * the rest, where 2^64 is 1844674407 and 3709551616 in those halves, and
   * one past the largest `long` is worked out from them as the value less
   * 2^64, by a route whose every step is in range. Each base's halves are
   * read from its own text or from nothing, because every entry of a
   * `lookup` is worked out and `int` of a hex digit in base 8 is an error.
   * Leading zeros above the sixty-four bits are allowed, as C allows them,
   * and anything else there is too big: a check is a guard, so the halves
   * are never worked out for a constant it refuses. *)
  Number : xhi    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 15, $ndigits - 8)]], $ihex and $ndigits > 8, "")), 16)
         : xlo    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 7, $ndigits)]], $ihex, "")), 16)
         : ohi    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 21, $ndigits - 11)]], $ioct and $ndigits > 11, "")), 8)
         : olo    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 10, $ndigits)]], $ioct, "")), 8)
         : dhi    = int("0{}" of lookup([[true, slice($idigits, $ndigits - 19, $ndigits - 10)]], $idec and $ndigits > 10, ""))
         : dlo    = int("0{}" of lookup([[true, slice($idigits, $ndigits - 9, $ndigits)]], $idec, ""))
         : dbig   = $idec and ($ndigits = 20 or ($ndigits = 19 and $idigits > "9223372036854775807"))
         : dsmall = lookup([[true, 0]], $dbig, $dhi) * 10000000000 + $dlo
         : dwrap  = (lookup([[true, $dhi]], $dbig, 1844674407) - 1844674407 + 1) * 10000000000
                    + ($dlo - 3709551616 - 10000000000)
         : bits   = lookup([[true, ($xhi - lookup([[true, 4294967296]], $xhi >= 2147483648, 0)) * 4294967296 + $xlo]],
                           $ihex,
                    lookup([[true, ($ohi - lookup([[true, 2147483648]], $ohi >= 1073741824, 0)) * 8589934592 + $olo]],
                           $ioct,
                    lookup([[true, $dwrap]], $dbig, $dsmall)))
         : fint   = $bits >= 0 and $bits <= 2147483647
         : fuint  = $bits >= 0 and $bits <= 4294967295
         : width  = lookup([[true, 4]], not $ihasl and ((not $ihasu and ($fint or (not $idec and $fuint)))
                                                      or ($ihasu and $fuint)), 8)
         : uns    = $ihasu or $bits < 0 or ($width = 4 and not $fint)
         ! $ioct and (size(split($idigits, "8")) > 1 or size(split($idigits, "9")) > 1)
             : "'{}' is an octal constant, and 8 and 9 are not octal digits" of $text
         ! ($ihex and $ndigits > 16 and join(split(slice($idigits, 1, $ndigits - 16), "0")) <> "")
           or ($ioct and (($ndigits > 22 and join(split(slice($idigits, 1, $ndigits - 22), "0")) <> "")
                          or ($ndigits >= 22 and slice($idigits, $ndigits - 21, $ndigits - 21) > "1")))
           or ($idec and ($ndigits > 20 or ($ndigits = 20 and $idigits > "18446744073709551615")))
             : "'{}' is too big for any integer type, C11 6.4.4.1" of $text .

  (* **A character constant is an `int`**, C11 6.4.4.4, which the defaults
   * above already say: no stars, four bytes, so `sizeof 'a'` is 4 as C has
   * it and not 1 as C++ does. What this adds is its **code**.
   *
   * The notation has no function from a character to its code, and does not
   * need one here. The ninety-five printable characters are written out in
   * order, and a character's code is how much of that text comes before it,
   * plus the 32 the table starts at: `split` at the character, and measure
   * the first piece. An escape is looked up first, because its text is two
   * characters and is not in the table. The lexer has already refused
   * anything that is neither, so the measurement never meets a character it
   * cannot find. `char-constant-every-one.c` walks the whole table. *)
  (* **A string literal is an array of `char`**, C11 6.4.5, one longer than
   * its characters for the NUL at the end, and it decays like any array: its
   * `type` is a pointer to `char` and its `size` is the whole array, so
   * `sizeof "abc"` is 4 and `"abc"[1]` is `'b'`.
   *
   * The length is counted rather than walked, because the notation has no
   * way to walk text. Every escape is two characters in the source and one
   * in the array, so the length is the text less one per escape. Counting
   * the escapes is counting backslashes, except that `\\` is two of them
   * and one escape. So the escaped backslashes are replaced first, by a
   * tab, which the lexer guarantees is not in the text; after that every
   * backslash left begins an escape of its own. Splitting at `\\` finds the
   * same pairs the escapes are made of, because both read left to right and
   * nothing else in an escape is a backslash.
   *
   * `string-length-agrees.c` holds this against the bytes the assembler
   * wrote, counted by walking them. *)
  String : body   = slice($text, 2, size($text) - 1)
         : single = join(split($body, "\\\\"), "\t")
         : length = size($single) - (size(split($single, "\\")) - 1)
         : type   = 1
         : width  = 1
         : size   = $length + 1 .

  Character : inner = slice($text, 2, size($text) - 1)
            : code  = lookup([["\\n", 10], ["\\t", 9], ["\\\\", 92], ["\\'", 39],
                              ["\\\"", 34], ["\\0", 0]], $inner,
                             size(at(split(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~",
                                           $inner), 1)) + 32) .

  (* C11 6.5.6 lets `+` take a pointer and an integer in either order, and `-`
   * a pointer and then an integer, and counts the integer in what the pointer
   * points at. The answer is a pointer of the same type, which is why the
   * type is a **sum** for `+`: exactly one side has stars, and the other adds
   * none. Counting in elements is the emit pass's, which reads the element's
   * width off this type.
   *
   * These were refusals until 2026-09-22, standing in for a size the subset
   * did not have. They are now the things C itself refuses.
   *
   * **The difference of two pointers is a `long`**, the count of elements
   * between them: C11 6.5.6's `ptrdiff_t`, which is a `long` on this
   * machine. It was an `int` from 2026-09-22 to the day `long` arrived, as
   * it was in K&R's first edition, and `sizeof(p - q)` was pinned as the
   * one program that showed it, beside `sizeof(sizeof(int))`, and moved
   * into the oracle with it. The type is a difference of star
   * counts, which is 0 for two pointers of one type and the pointer's own for
   * a pointer less an int; two pointers of **different** types are refused,
   * as 6.5.6 requires, and that is also what keeps the difference from
   * coming out as a type no value has. *)
  (* The width of a sum is the pointer's, from whichever side it is on, and
   * when there is no pointer it is 8 if either side is a `long` and 4
   * otherwise, which is C11 6.3.1.8's usual arithmetic conversions over the
   * promotion above. A difference of two pointers is 8, a `long`. *)
  Binary(op: "+") : type  = $left.type + $right.type
                  : quals = lookup([[0, "0"]], $type, lookup([[0, $right.quals]], $left.type, $left.quals))
                  : uns   = lookup([[0, lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)]],
                                   $type, lookup([[0, $right.uns]], $left.type, $left.uns))
                  : width = lookup([[0, lookup([[true, 8]], $left.wide or $right.wide, 4)]], $type,
                                   lookup([[0, $right.width]], $left.type, $left.width))
                  : tag   = lookup([[0, ""]], $type,
                                   lookup([[0, $right.tag]], $left.type, $left.tag))
      ! $left.record or $right.record
          : "'{}' wants numbers or pointers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 and $right.type > 0
          : "'+' does not add two pointers"
      (* **Arithmetic on a `void *` is refused by name**, since
       * 2026-09-26: C11 6.5.6 counts in what the pointer points at, and a
       * `void` has no size. `cc` counts in bytes, as GNU C does. *)
      ! ($left.type = 1 and $left.tag = "void") or ($right.type = 1 and $right.tag = "void")
          : "'{}' on a 'void *' counts in something of no size; this cc counts in bytes, as GNU C does" of $op .
  Binary(op: "-") : type  = $left.type - $right.type
                  : quals = lookup([[0, "0"]], $type, $left.quals)
                  : uns   = lookup([[true, lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)]],
                                   $left.type = 0 and $right.type = 0,
                                   lookup([[0, false]], $type, $left.uns))
                  : width = lookup([[0, lookup([[true, 8]], $left.wide or $right.wide
                                                             or $left.type > 0, 4)]],
                                   $type, $left.width)
                  : tag   = lookup([[0, ""]], $type, $left.tag)
      ! $left.record or $right.record
          : "'{}' wants numbers or pointers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type = 0 and $right.type > 0
          : "'-' does not take a pointer from a number"
      ! $left.type > 0 and $right.type > 0
            and ($left.type <> $right.type or $left.width <> $right.width
                 or $left.tag <> $right.tag)
          : "'-' takes two pointers only when they point at the same type"
      (* **Arithmetic on a `void *` is refused by name**, since
       * 2026-09-26: C11 6.5.6 counts in what the pointer points at, and a
       * `void` has no size. `cc` counts in bytes, as GNU C does. *)
      ! ($left.type = 1 and $left.tag = "void") or ($right.type = 1 and $right.tag = "void")
          : "'{}' on a 'void *' counts in something of no size; this cc counts in bytes, as GNU C does" of $op .
  (* **A shift is the type of its left side**, C11 6.5.7, and not of the
   * wider of the two: `1 << (long)3` is an `int`, and `shifts.c` asks its
   * `sizeof`. Both sides are integers, so a pointer or a struct on either is
   * C's refusal. The emit pass shifts in the left side's register, and a
   * `long` count is read from its low half, which is all a shift reads. *)
  Binary(op: "<<") : width = lookup([[true, 8]], $left.wide, 4)
                   : uns   = $left.puns
      ! $left.record or $right.record
          : "'{}' wants numbers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 or $right.type > 0
          : "'{}' does not take a pointer" of $op .
  Binary(op: ">>") : width = lookup([[true, 8]], $left.wide, 4)
                   : uns   = $left.puns
      ! $left.record or $right.record
          : "'{}' wants numbers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 or $right.type > 0
          : "'{}' does not take a pointer" of $op .
  (* C11 6.5.5 wants arithmetic on both sides of `*` and `/`, and integers on
   * both sides of `%`, which since 2026-09-25 is one of these too, and so are
   * `&`, `|` and `^`, C11 6.5.10 to 6.5.12. So a pointer on either is C's own
   * refusal rather than this subset's. *)
  Binary : width = lookup([[true, 8]], $left.wide or $right.wide, 4)
         : uns   = lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)
         ! $left.record or $right.record
      : "'{}' wants numbers, and this is '{}'"
          of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
         ! $left.type > 0 or $right.type > 0
      : "'{}' does not take a pointer" of $op .


(* ------------------------------------------------------------------- *)
(* **What is known before the program runs**, since 2026-09-25, ROADMAP *)
(* 6.5. C11 6.6 names the places an expression must be worked out at   *)
(* compile time, and a `case` label is the first here; array sizes,    *)
(* `enum`, a global's initialiser and the null pointer constant will   *)
(* read the same two attributes. `settled` says whether it can be, and   *)
(* `folded` what it is.                                                *)
(*                                                                     *)
(* **The arithmetic is C's, done in the notation's**, and the two      *)
(* differ in three ways this pass has to bridge. C's `int` wraps at     *)
(* thirty-two bits where the notation's integers trap at sixty-four,   *)
(* so an `int` result is cut to thirty-two with `bitand` and its sign  *)
(* put back. C's `/` truncates and `div` floors, so it is `quotient`.  *)
(* And the notation has no shift and no bits: `<<` and `>>` are a      *)
(* multiply and a `div` by a power of two, `div` flooring exactly as   *)
(* an arithmetic shift does, and `&`, `|` and `^` are the library's    *)
(* `bitand`, `bitor` and `bitxor`, which were added for this.          *)
(*                                                                     *)
(* **Nothing here may trap**, because a trap is the compiler stopping  *)
(* with an arithmetic error rather than a message. So an operator only *)
(* folds operands that fit in thirty-two bits, where no product passes *)
(* 2^62, and reads 0 for one that does not; a divisor of 0 is read as  *)
(* 1 and the answer is not known; a shift is folded only by 0 to 31.   *)
(* An operand that did not fold makes the answer not known, which a    *)
(* `case` then refuses.                                                *)
(*                                                                     *)
(* *The thirty-two bit wrap has no witness, and cannot have one.* An   *)
(* `int` result passes thirty-two bits only when C's arithmetic has    *)
(* overflowed, which is undefined, so no program the oracle may hold   *)
(* can tell. Taking it out changed no answer. It is kept because it is *)
(* what `cc` folds `1 << 31` to, and an `unsigned int`'s answer is the  *)
(* same cut without the sign put back, since 2026-09-27.               *)
(* ------------------------------------------------------------------- *)

%pass constants

  Decls  : down base = $spec .

  otherwise settled  = false
  otherwise folded = 0

  (* **Why a value is not settled**, since 2026-09-29, because a refusal
   * that said only *cannot be* was not true of most of them: `cc` works
   * out `sizeof(int) - 5` and `9223372036854775807 + 1`, and C works out
   * the first. `why` is 0 for a settled value and otherwise one of four,
   * and **the larger wins** where two operands disagree, since each is a
   * stronger claim than the one below it: an operand C leaves undefined
   * makes the whole undefined whatever else is wrong with it, and an
   * operand that is no constant at all makes it no constant.
   *
   *   1  an `unsigned long` past 2^63, which C works out and this does not
   *   2  a `long` shifted by 63, which this does not work out either
   *   3  what C leaves undefined: an overflow, or a shift past the width
   *   4  what is not a constant in C, `1 / 0` among them
   *
   * A node no clause below names, a variable or a call, is the fourth.
   * `because` is the words, written once for every refusal that asks.
   *
   * *An operator's own fourth, for a pointer, has no witness and cannot
   * have one yet.* No value with a pointer's type is settled, a string, an
   * `&` and a cast to a pointer among them, so an operand that is one has
   * already answered 4 before the operator is asked. Changing it changed
   * no refusal. It is kept for the day an address with an offset folds. *)
  otherwise why = lookup([[true, 0]], $settled, 4)
  otherwise because = lookup([[1, "this one is 'unsigned long' arithmetic past 2^63, which C works out and this compiler does not"],
                              [2, "this one shifts a 'long' by 63, which this compiler does not work out"],
                              [3, "C leaves this one undefined"]], $why,
                             "this one cannot be")

  (* **An address the assembler can write**, since 2026-09-26, ROADMAP 6.8:
   * C11 6.6p9's address constant, as far as the subset takes it. A string
   * literal is one, and so is `&` of a global and a global array's name,
   * which decays to the address of its first element, and since 2026-09-29
   * the same of a `static` local, under its own label; each is a label in
   * the object file, and a global initialised with one is written as that
   * label. **An address with an offset is not**: `&table[1]`, `table + 2`
   * and `"hi" + 1` are each a label and a number, which `cc` writes as
   * `_table+4`, and folding one needs this pass to carry a label beside a
   * number, which nothing here has asked for yet. *)
  otherwise anchored = false

  (* **Whether an address starts at a label at all**, since 2026-09-29,
   * which is what tells the two refusals apart: `&table[1]` and `"hi" + 1`
   * are a label and a number, which C works out and this does not yet, and
   * `&a` of a local, or a global pointer's value, is no constant in C. A
   * `static` local's initialiser was the first place both could be written,
   * since file scope has no locals. `rooted` is said of a value, an address
   * that starts at a label, and `sited` of a place, one that lives at one:
   * a global or a `static` local, a `*` of a rooted address, or a member of
   * a sited struct. An array decays to its address, so its name is rooted
   * when it is sited, and so is a member that is one. A `+` or a `-` keeps
   * its pointer side's, and a cast its operand's. *)
  otherwise rooted = false
  otherwise sited  = false
  String   : anchored = true : rooted = true .
  Variable : anchored = $global and $count > 0
           : sited  = $global
           : rooted = $global and $count > 0 .
  Addr     : anchored = $place.global : rooted = $place.sited .
  Deref    : sited  = $value.rooted .
  Member   : sited  = $value.sited
           : rooted = $value.sited and at($entry, 3) > 0 .

  (* Whether this `switch` compares all sixty-four bits, and the labels
   * it has seen and how many `default`s: each `switch` starts its own and
   * puts the outer one back, which is how a thread nests. *)
  thread seen     = empty
  thread defaults = 0

  (* **A static assertion is this pass's fourth customer**, since ROADMAP
   * 6.12's second part, after a `case`, a global's initialiser and a
   * `static` local's: its condition is worked out here, and a zero is
   * refused with the message the program gave, as `cc` gives it. *)
  StaticAssert ! not $cond.settled
                   : "'_Static_assert' has to be worked out before the program runs, C11 6.7.10p3, and this cannot be"
               ! $cond.settled and $cond.folded = 0
                   : "static assertion failed: {}" of slice($message, 2, size($message) - 1) .

  Number     : settled = true : folded = $bits .
  Character  : settled = true : folded = $code .
  SizeOfType : settled = true : folded = lookup([[0, $base.basew]], $ptrs, 8) .
  SizeOfExpr : settled = true : folded = $value.size .
  Plus       : settled = $value.settled : folded = $value.folded : why = $value.why .

  (* **An `unsigned int` wraps**, since 2026-09-27, ROADMAP 6.9's third
   * part, and is always held as the value C means, 0 to 4294967295, never
   * as the negative number with the same thirty-two bits. Each operator
   * converts its operands to one, `mod 4294967296`, when its answer is
   * one, and cuts its answer the same way without putting a sign back; a
   * shift converts only its left. Nothing two such numbers make passes the
   * notation's sixty-four bits except a product, which can reach 2^64, so
   * `*` multiplies by the halves of its right operand, sixteen bits each.
   * Where the value is held as C means it matters only once it widens: a
   * global keeps thirty-two bits either way, and the next unsigned
   * operator converts again, so `(1u - 2) + 0L`, which is 4294967295, is
   * what shows it. A cast to an unsigned type and a `?:` whose answer is
   * unsigned were refused where a constant is wanted until this was so.
   *
   * **An `unsigned long` folds only where it agrees with a `long`**, since
   * 2026-09-27, when `sizeof` became one, the first unsigned value this
   * pass could settle. Where its operands and its answer are all from 0 to
   * 2^63, every operator here gives the unsigned answer, and C's `size_t`
   * arithmetic stays there: `sizeof(long) - 4`, `sizeof(int) * 2`. Outside
   * it the answer is the notation's signed one and C's is not, so
   * `sizeof(int) - 5`, `-sizeof(int)` and `~sizeof(int)` are not settled,
   * and refused where a constant is wanted, which `cc` folds. **This is
   * the rule ROADMAP 6.9 chose and kept**, the notation's integers being
   * signed: a constant past 2^63 is carried as its bits, which is all a
   * literal or a label needs, and not folded further. **A comparison is
   * the exception**, because it has an answer that fits: two `unsigned
   * long`s compare as two `long`s with their top bits flipped, so `-1 <
   * sizeof(int)` is 0, as C has it.
   *
   * **A cast to an integer type folds whatever it is given**, since
   * 2026-09-26, C11 6.6p6: an integer constant expression may cast to one.
   * A cast cannot trap, so unlike an operator it does not ask that its
   * operand fit in thirty-two bits, and `(int)4294967341` is 45, which is
   * the one way a constant wider than an `int` legally reaches a `case`.
   * To a `char` it keeps eight bits and puts the sign back; to an `int`,
   * thirty-two; to a `long`, all of them. A cast to a pointer or to `void`
   * is not an integer constant expression, and is not settled. *)
  Cast       : rooted  = $value.rooted
             : low8    = $value.folded mod 256
             : low32   = $value.folded mod 4294967296
             : settled = $value.settled and $ptrs = 0 and $base.tagname = ""
             : why     = lookup([[true, 0]], $settled, lookup([[false, $value.why]], $value.settled, 4))
             : folded  = lookup([[1, $low8 - lookup([[true, 256]], $low8 >= 128 and not $base.buns, 0)],
                                 [4, $low32 - lookup([[true, 4294967296]], $low32 >= 2147483648 and not $base.buns, 0)]],
                                $base.basew, $value.folded) .
  Invert     : settled = $value.settled and not ($uns and $wide)
             : why     = lookup([[true, 0]], $settled, lookup([[false, $value.why]], $value.settled, 1))
             : folded  = lookup([[true, 4294967295 - $value.folded mod 4294967296]], $uns,
                                bitxor($value.folded, 0 - 1)) .
  Not        : settled = $value.settled : folded = lookup([[0, 1]], $value.folded, 0) : why = $value.why .

  (* Negating overflows only the most negative integer, so that is the one
   * a `-` does not fold: `-4294967296` is a `long` constant, and a label. *)
  Negate : settled = $value.settled and $value.folded > 0 - 9223372036854775807
                  and (not ($uns and $wide) or $value.folded = 0)
         : why    = lookup([[true, 0]], $settled,
                           lookup([[false, $value.why]], $value.settled,
                                  lookup([[true, 1]], $uns and $wide, 3)))
         : craw   = 0 - lookup([[true, $value.folded]], $settled, 0)
         : clow   = bitand($craw, 4294967295)
         : folded = lookup([[true, $craw]], $wide,
                           lookup([[true, $clow]], $uns,
                                  $clow - lookup([[true, 4294967296]], $clow >= 2147483648, 0))) .

  (* **One rule for every arithmetic operator**, with the answer read off a
   * table by the operator. Every entry is worked out whichever is asked
   * for, which is why each has to be safe on any operands it can be given.
   *
   * **A `long` folds too**, since 2026-09-26, ROADMAP 6.8. Until then an
   * operator folded only when both operands fitted in thirty-two bits, which
   * made every entry safe at once: nothing two such numbers make overflows
   * the notation's sixty-four. A `long` operand can be anything, so each
   * operator that can overflow asks first whether its answer fits, `fadd` to
   * `fshl`, with `and` and `or` that stop before the arithmetic that would
   * trap, and **its entry is worked out on its own operands**, which are the
   * real ones only when its answer fits and 0 otherwise. A `+` asked for
   * with two huge operands therefore works out a `*` of two zeros and not a
   * product that traps. An answer that does not fit is an overflow, which
   * C leaves undefined; `cc` wraps it and warns, and here it is not settled,
   * so a `case` of one is refused. An `int` answer is cut to thirty-two bits
   * as before: two `int`s never overflow sixty-four, so every test passes
   * for them and nothing about an `int` changed. *)
  Binary : cbase  = $left.settled and $right.settled and $left.type = 0 and $right.type = 0
         : cu32   = $uns and not $wide
         : cshift = $op = "<<" or $op = ">>"
         : cl     = lookup([[true, lookup([[true, $left.folded mod 4294967296]], $cu32, $left.folded)]], $cbase, 0)
         : cr     = lookup([[true, lookup([[true, $right.folded mod 4294967296]], $cu32 and not $cshift,
                                          $right.folded)]], $cbase, 0)
         : cmax   = 9223372036854775807
         : cmin   = 0 - 9223372036854775807 - 1
         : fadd   = ($cr >= 0 and $cl <= $cmax - $cr) or ($cr < 0 and $cl >= $cmin - $cr)
         : fsub   = ($cr >= 0 and $cl >= $cmin + $cr) or ($cr < 0 and $cl <= $cmax + $cr)
         : fmul   = $cr = 0
                    or ($cr > 0 and $cl <= $cmax div $cr and $cl >= quotient($cmin, $cr))
                    or ($cr = 0 - 1 and $cl > $cmin)
                    or ($cr < 0 - 1 and $cl >= quotient($cmax, $cr) and $cl <= $cmin div $cr)
         : fdiv   = $cr <> 0 and not ($cl = $cmin and $cr = 0 - 1)
         : climit = lookup([[true, 63]], $wide, 32)
         : ck     = lookup([[true, $cr]], $cr >= 0 and $cr < $climit, 0)
         : cpower = at([1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648, 4294967296, 8589934592, 17179869184, 34359738368, 68719476736, 137438953472, 274877906944, 549755813888, 1099511627776, 2199023255552, 4398046511104, 8796093022208, 17592186044416, 35184372088832, 70368744177664, 140737488355328, 281474976710656, 562949953421312, 1125899906842624, 2251799813685248, 4503599627370496, 9007199254740992, 18014398509481984, 36028797018963968, 72057594037927936, 144115188075855872, 288230376151711744, 576460752303423488, 1152921504606846976, 2305843009213693952, 4611686018427387904], $ck + 1)
         : fshl   = $cl <= $cmax div $cpower and $cl >= quotient($cmin, $cpower)
         : al     = lookup([[true, $cl]], $fadd, 0) : ar = lookup([[true, $cr]], $fadd, 0)
         : sl     = lookup([[true, $cl]], $fsub, 0) : sr = lookup([[true, $cr]], $fsub, 0)
         : ml     = lookup([[true, $cl]], $fmul, 0) : mr = lookup([[true, $cr]], $fmul, 0)
         : dl     = lookup([[true, $cl]], $fdiv, 0) : dr = lookup([[true, $cr]], $fdiv, 1)
         : pl     = lookup([[true, $cl]], $fshl, 0)
         : um     = lookup([[true, $cl]], $cu32, 0) : un = lookup([[true, $cr]], $cu32, 0)
         : umul   = ($um * ($un mod 65536) + (($um * ($un div 65536)) mod 65536) * 65536) mod 4294967296
         : craw   = lookup([["+", $al + $ar], ["-", $sl - $sr], ["*", lookup([[true, $umul]], $cu32, $ml * $mr)],
                           ["/", quotient($dl, $dr)], ["%", remainder($dl, $dr)],
                           ["&", bitand($cl, $cr)], ["|", bitor($cl, $cr)], ["^", bitxor($cl, $cr)],
                           ["<<", $pl * $cpower], [">>", $cl div $cpower]], $op, 0)
         : rooted = ($op = "+" or $op = "-") and ($left.rooted or $right.rooted)
         : clow   = bitand($craw, 4294967295)
         : fits   = lookup([["+", $fadd], ["-", $fsub], ["*", $fmul or $cu32], ["/", $fdiv], ["%", $fdiv],
                            ["<<", $fshl]], $op, true)
         : settled = $cbase and $type = 0 and $fits
                     and (($op <> "<<" and $op <> ">>") or ($cr >= 0 and $cr < $climit))
                     and (not ($uns and $wide) or ($cl >= 0 and $cr >= 0 and $craw >= 0))
         : cwhy   = lookup([[true, $left.why]], $left.why > $right.why, $right.why)
         : cwidth = lookup([[true, 64]], $wide, 32)
         : why    = lookup([[true, 0]], $settled,
                    lookup([[true, $cwhy]], $cwhy > 0,
                    lookup([[false, 4]], $cbase and $type = 0,
                    lookup([[true, lookup([[true, 3]], $cr < 0 or $cr >= $cwidth, 2)]],
                           $cshift and not ($cr >= 0 and $cr < $climit),
                    lookup([[true, lookup([[true, 4]], ($op = "/" or $op = "%") and $cr = 0,
                                          lookup([[true, 1]], $uns and $wide, 3))]], not $fits,
                           1)))))
         : folded = lookup([[true, $craw]], $wide,
                           lookup([[true, $clow]], $cu32,
                                  $clow - lookup([[true, 4294967296]], $clow >= 2147483648, 0))) .

  Compare : cuw = $cuns and ($left.wide or $right.wide)
          : cmin = 0 - 9223372036854775807 - 1
          : cl = lookup([[true, bitxor($left.folded, $cmin)]], $cuw,
                        lookup([[true, $left.folded mod 4294967296]], $cuns, $left.folded))
          : cr = lookup([[true, bitxor($right.folded, $cmin)]], $cuw,
                        lookup([[true, $right.folded mod 4294967296]], $cuns, $right.folded))
          : settled = $left.settled and $right.settled and $left.type = 0 and $right.type = 0
          : cwhy = lookup([[true, $left.why]], $left.why > $right.why, $right.why)
          : why = lookup([[true, 0]], $settled, lookup([[true, $cwhy]], $cwhy > 0, 4))
          : folded = lookup([[true, 1]],
                            lookup([["<", $cl < $cr], ["<=", $cl <= $cr], [">", $cl > $cr],
                                    [">=", $cl >= $cr], ["==", $cl = $cr], ["!=", $cl <> $cr]],
                                   $op, false), 0) .

  (* **An operand that is not evaluated need not be settled**, which is how
   * `cc` reads C11 6.6p3: `1 ? 40 : 1 / 0` is 40, and `0 && f()` is 0. So
   * `?:`, `&&` and `||` ask only of the side that decides. *)
  Logical : cdecides = lookup([["&&", $left.folded = 0]], $op, $left.folded <> 0)
          : settled = $left.settled and ($cdecides or $right.settled)
          : why = lookup([[true, 0]], $settled, lookup([[false, $left.why]], $left.settled, $right.why))
          : folded = lookup([[true, lookup([["&&", 0]], $op, 1)]], $cdecides,
                            lookup([[true, 1]], $right.folded <> 0, 0)) .
  Choose  : settled = $cond.settled and $type = 0
                      and lookup([[0, $other.settled]], $cond.folded, $then.settled)
          : why = lookup([[true, 0]], $settled,
                  lookup([[false, $cond.why]], $cond.settled,
                  lookup([[false, 4]], $type = 0,
                         lookup([[0, $other.why]], $cond.folded, $then.why))))
          : cpick  = lookup([[0, $other.folded]], $cond.folded, $then.folded)
          : folded = lookup([[true, $cpick mod 4294967296]], $uns and not $wide, $cpick) .

  (* **A `case` is refused unless it is settled**, and the labels of one
   * `switch` are gathered so that two alike can be refused, as `cc` refuses
   * them. A `switch` on an `int` compares an `int`, and a label too wide for
   * one is declined by name: `cc` converts it and warns, and keeping labels
   * the values they were written as keeps the comparison one width. *)
  Switch  : down held     = $seen
          : down helddef  = $defaults
          : down seen     = empty
          : down defaults = 0
          : down swide    = $cond.wide
          : down suns     = $cond.puns and not $cond.wide
          : seen     = $held
          : defaults = $helddef .
  Case    : klabel = lookup([[true, $value.folded mod 4294967296]], $suns, $value.folded)
          : seen   = bind($seen, text($klabel), true)
          ! not $value.settled
              : "a 'case' label has to be worked out before the program runs, and {}" of $value.because
          ! $value.settled and not $swide
              and ($value.folded < 0 - 2147483648
                   or $value.folded > lookup([[true, 4294967295]], $suns, 2147483647))
              : "'case {}' is wider than the {} this switch compares"
                  of $value.folded, lookup([[true, "unsigned int"]], $suns, "int")
          ! $value.settled
              and defined($seen, text(lookup([[true, $value.folded mod 4294967296]], $suns, $value.folded)))
              : "'case {}' is in this switch twice"
                  of lookup([[true, $value.folded mod 4294967296]], $suns, $value.folded) .
  Default : defaults = $defaults + 1
          ! $defaults > 0 : "this switch has a 'default' already" .

  (* **A global's initialiser is the pass's second customer**, since
   * 2026-09-26, ROADMAP 6.8: C11 6.7.9p4 wants it worked out before the
   * program runs, as a `case` label is, and `cc` refuses one that cannot
   * be. The emit pass writes the folded value into the object file. *)
  GlobalInit ! not $value.settled and ($ptrs = 0 or not ($value.anchored or $value.rooted))
                 : "'{}' has to be initialised with something worked out before the program runs, C11 6.7.9p4, and {}"
                     of $name, $value.because
             ! not $value.settled and $ptrs > 0 and not $value.anchored and $value.rooted
                 : "'{}' is initialised with an address this cannot write: a string, '&' of a global or a 'static' local, and such an array's name can be, and one with an offset is not yet"
                     of $name .

  (* **A `static` local's initialiser is the third customer**, since
   * 2026-09-29, ROADMAP 6.10: it is written into the object file as a
   * global's is, and wants what a global's wants, C11 6.7.9p4. *)
  StaticInit ! not $value.settled and ($ptrs = 0 or not ($value.anchored or $value.rooted))
                 : "'{}' is 'static', and has to be initialised with something worked out before the program runs, C11 6.7.9p4, and {}"
                     of $name, $value.because
             ! not $value.settled and $ptrs > 0 and not $value.anchored and $value.rooted
                 : "'{}' is 'static', and is initialised with an address this cannot write: a string, '&' of a global or a 'static' local, and such an array's name can be, and one with an offset is not yet"
                     of $name .
