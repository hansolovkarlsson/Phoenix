              ! defined($globals, $name) and $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> ""
                  : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register") .
  GlobalArray : down dbase   = $base
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                size($paren), join($paren.t))
              : lv     = "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin
              : ptrs   = lookup([[true, size(at(split($lvin, "a:"), 1)) div 8]], size(at(split($lvin, "a:"), 1)) < size(at(split($lvin, "b:"), 1)), size(at(split($lvin, "b:"), 1)) div 8)
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = int(at(split(at(split($lvin, "|"), 1), ":"), 2))
              : galign = int(at(split(at(split($lvin, "|"), 1), ":"), 4))
              : whole  = $count * $ebytes
              : globals = bind($globals, $name, [0, $ptrs, $count, $basew, $base.tagname, true, defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 7),
                                                 $base.buns, $name, $dquals, false, $lv])
              ! $count < 1
                  : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                      of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0 and not $base.sext
                  : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 3), lookup([[true, 0]], at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "" and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "void", at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 4)), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 10)] <> [$stars + $base.ptrs, $count, lookup([[true, 0]], $base.tagname <> "" and $base.tagname <> "void", $base.basew), $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                  : "'{}' is declared again with another type, C11 6.7p4" of $name
              ! defined($funcs, $name)
                  : "'{}' is a function already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register")
              ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                  : "'{}' is a typedef of an array, which C allows and this subset does not have yet" of $name .
  (* An initialiser is an expression at file scope, where the names are the
   * globals above it: `int b = a;` finds `a`, and is refused because it is
   * not constant, as `cc` refuses it, rather than as undeclared. *)
  GlobalInit  : down dbase   = $base
              : down early   = size($paren) = 0
              : down pearly  = size($paren) > 0
              : down pown    = lookup([[true, [$name, false, $base.basew, $base.tagname, true, true, $base.buns, $name, ("{}{}" of $base.bquals, $squals), false]]], $pearly, $pown)
              : down elv     = "{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv
              : down eptrs   = lookup([[true, size(at(split($elv, "a:"), 1)) div 8]], size(at(split($elv, "a:"), 1)) < size(at(split($elv, "b:"), 1)), size(at(split($elv, "b:"), 1)) div 8)
              : down env     = lookup([[true, bind($globals, $name, [0, $eptrs, 0, $base.basew, $base.tagname, true, true, $base.buns, $name, ("{}{}" of $base.bquals, $squals), false, $elv])]],
                                      $early, $globals)
              : down heldown = $ownname
              : down ownname = lookup([[true, $ownname]], $early, $name)
              : ownname = $heldown
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                size($paren), join($paren.t))
              : lv     = $lvin
              : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : ebytes = int(at(split(at(split($lv, "|"), 1), ":"), 2))
              : galign = int(at(split(at(split($lv, "|"), 1), ":"), 4))
              : whole  = $ebytes
              : globals = bind($globals, $name, [0, $ptrs, 0, $basew, $base.tagname, true, true, $base.buns, $name, $dquals, false, $lv])
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0 and not $base.sext
                  : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
              ! defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 3), lookup([[true, 0]], at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "" and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "void", at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 4)), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 10)] <> [$stars + $base.ptrs, 0, lookup([[true, 0]], $base.tagname <> "" and $base.tagname <> "void", $base.basew), $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                  : "'{}' is declared again with another type, C11 6.7p4" of $name
              ! defined($globals, $name) and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false]), 7)
                  : "'{}' is defined twice, with an initialiser each" of $name
              ! defined($funcs, $name)
                  : "'{}' is a function already, and a function and a global share one name space, C11 6.2.3" of $name
              ! defined($typedefs, $name)
                  : "'{}' is a typedef already, and a typedef and a global share one name space, C11 6.2.3" of $name
              ! $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                  : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register")
              ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                  : "'{}' is a typedef, and only an object has an initialiser, C11 6.7.9" of $name .

  (* The five once, and their parts named from them. `Assign` has no clause
   * here: what it assigns to is a place, and the question is asked where the
   * name is rather than twice. *)
  (* **A compound literal is looked up by its key**, since ROADMAP 6.13's
   * fourth part, which its `Literal` bound just before, and a name by its
   * name. Its initialiser may be inside another's, `{(int []){1, 2}}`, and
   * walks with the cursor of its own, so the outer one's is kept here and
   * put back. *)
  Variable : down hicur  = $icur
           : down hiend  = $iend
           : down hiback = $iback
           : icur    = $hicur
           : iend    = $hiend
           : iback   = $hiback
           : vkey    = lookup([[0, $name]], size($lit), join($lit.lname))
           : vname   = $name
           : means   = lookup($env, $vkey, lookup([[true, [0, 0, 0, 1, "", true, false, false, $vkey, "0", false, "b:1:0:1::{}" of $vkey]]],
                                                  defined($funcs, $vkey), [0, 0, 0, 4, "", false, false, false, "", "0", false, "b:4:0:4"]))
           (* An enumeration constant's entry has its value as a thirteenth
            * field, see `Enumerator`. *)
           : econst  = size($means) > 12
           : evalue  = at(flatten([$means, [0]]), 13)
           : ev      = $evalue
           : eok     = $econst
           : known   = $layouts
           : vreg    = at($means, 11)
           : vlv     = at($means, 12)
           : vrec    = at($means, 5) <> "" and at($means, 5) <> "void" and at($means, 2) = 0 and at($means, 3) = 0
           : global  = at($means, 6)
           : vuns    = at($means, 8)
           : label   = at($means, 9)
           : vquals  = at($means, 10)
           : offset  = at($means, 1)
           : stars   = at($means, 2)
           : count   = at($means, 3)
           : basew   = at($means, 4)
           : tagname = at($means, 5)
           ! not defined($env, $name) and size($lit) = 0 and $name = $ownname
               : "'{}' is named in its own initialiser, which C11 6.2.1p7 allows and this subset does not yet where it is an array with braces" of $name
           ! not defined($env, lookup([[0, $name]], size($lit), join($lit.lname))) and (not defined($funcs, $name) or lookup($fblock, $name, false)) and not (size($lit) = 0 and $name = $ownname)
               : lookup([[true, "'{}' is called before it is declared"]], $callpos, "'{}' is not declared") of $name .

  (* A member cannot be looked up here, because which struct it is in is the
   * `types` pass's to work out, and a thread is not something a later pass
   * can read. So the table is kept at the node, as it stood when the walk
   * reached it, for the pass that can use it. *)
  Member : known = $layouts
         : down callpos = false .
  Deref  : known = $layouts .
  Assign : known = $layouts .
  (* **And at every name and call**, since ROADMAP 6.12's third part: a
   * pointer to a struct records the struct's width where the pointer was
   * declared, which is 0 when the struct was not complete there, `struct
   * node *next` inside `struct node` itself. The `types` pass looks the
   * width up again here, where it is used. *)

(* ------------------------------------------------------------------ *)
(* Pass three: how many stars, and what that makes impossible.         *)
(*                                                                     *)
(* Every value travels in one sixty-four-bit register, an `int` in its  *)
(* low half, so almost nothing comes out wrong from a pointer being     *)
(* taken for an `int`: the emit pass picks the half from the star count *)
(* worked out here, and that is all it asks. The places where C says    *)
(* more than that are what this pass is for, and there were two before  *)
(* `struct`.                                                            *)
(*                                                                     *)
(* One is `p + 1`, which C11 6.5.6 says is the **next int** and not the *)
(* next byte, so the answer is a pointer and the emit pass has to know  *)
(* how wide a step is. It was refused by name until a size arrived with *)
(* arrays; it is now a type this pass works out. The other is `*x` on   *)
(* an `int`, which C11 6.5.3.2 forbids and which would compile here     *)
(* into a load from whatever the int happened to be.                   *)
(*                                                                     *)
(* **A struct is the third.** A member is found by which struct it is   *)
(* in, so an expression carries that as `tag`. A struct is a thing in   *)
(* memory that no register holds, and the emit pass copies it where C   *)
(* copies it; what this pass refuses is a copy between two kinds, and a *)
(* struct anywhere C wants a number, where its address would be used.   *)
(*                                                                     *)
(* What this pass deliberately does **not** do is check that what is    *)
(* assigned, or passed, has the type it is given. C11 6.5.16.1 has a    *)
(* table for that and `cc` warns from it, but nothing compiled here     *)
(* comes out wrong for getting it wrong, and a check that only          *)
(* reproduces somebody else's diagnostic is a second opinion rather     *)
(* than a compiler. This pass refuses what it would otherwise           *)
(* mis-compile, and nothing else.                                       *)
(*                                                                     *)
(* That was first argued against an eight-byte `int`, where a pointer   *)
(* put in an `int` and taken out again kept sixty-four bits here and    *)
(* thirty-two under `cc`. Since `int` narrowed the two agree, and the   *)
(* program is one this `cc` refuses to compile anyway. See journal      *)
(* 2026-09-22.                                                          *)

%pass types

  Decls  : down base = $spec .
  MDecls : down base = $spec .


  (* **What an initialiser's values may be**, since ROADMAP 6.13's first
   * part, from where the `locals` pass put each: an array without braces
   * takes only a string, a string must fit, a value past the object's end
   * is refused, and a struct is not a scalar. *)
