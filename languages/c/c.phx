(* c.phx -- a C subset: what it looks like, and what it means.
 *
 * **The language, and nothing about any target.** The grammar, the tree it
 * builds and the symbol pass are here; `c-arm64.phx` imports this file and
 * adds one emit pass.
 * That is the split `languages/README.md` prescribes and the reason a second
 * target could arrive without touching this file.
 *
 *   phx languages/c/c-arm64.phx prog.c                       the tree
 *   phx --driver check languages/c/c-arm64.phx prog.c         the symbols
 *   phx --driver arm64 languages/c/c-arm64.phx prog.c > prog.s
 *   cc prog.s -o prog && ./prog
 *
 * ---------------------------------------------------------------------------
 * What this is for
 *
 * [ROADMAP 6](../../docs/ROADMAP.md#6-a-c-compiler) is the one entry on that
 * page that is a language rather than a mechanism: the compiler is the goal
 * and the mechanisms it turns out to need are the findings. The subset grows
 * in chibicc's order, one construct at a time with the suite green at each.
 * Step one stopped before `typedef` on purpose, because that was where the
 * tool was expected to need a change, and the change was to arrive with the
 * construct that wanted it. It did: `typedef` is here, and `%names`, below,
 * is the change.
 *
 * **What is here is every construct of step one**: `int main(){return 42;}`,
 * then `+ - * /` with parentheses, then unary minus and the six comparisons,
 * then a local `int`, then `if`, `while`, `for` and blocks as statements,
 * then functions with `int` parameters and calls, then `&` and `*` with the
 * pointer declarators that make them useful, then `sizeof`, then an array of
 * `int` or of pointers, which decays to a pointer to its first element, then
 * a subscript and the pointer arithmetic it is made of, then `char`,
 * character constants and string literals, then `struct` with `.` and `->`.
 * A function returning `int` with up to eight parameters, a body of declarations, assignments, expression
 * statements, control flow and `return`s, and expressions over constants,
 * locals, calls, pointers and members, prototypes so that a call can come
 * above the function it names, and structs defined at file scope. A name nothing declared, one declared twice in a
 * scope, one used outside its block, a call before a declaration or with the
 * wrong number of arguments, a function defined twice or declared with two
 * arities, a ninth parameter, a `*` on what is not a pointer, and arithmetic
 * on one, are refused.
 *
 * **Then `typedef`**, at file scope, of a base and any number of stars, a
 * struct included, and hidden by an ordinary name declared in a block or as
 * a parameter until that scope ends. A typedef declared twice for two types
 * is refused.
 *
 * **Then a struct copied whole**, by `=`, by an initialiser and as an
 * argument, the last under AAPCS64 so that a struct passes between this
 * code and `cc`'s. A copy between two kinds of struct, or between a struct
 * and anything else, is refused, and so is a struct anywhere C wants a
 * number, which compiled until then into the struct's address.
 *
 * **Then a struct returned**, under AAPCS64 again, in `x0` and `x1` or
 * through the address the caller passes in `x8`. A function returns an `int`
 * or a struct: a `char` or a pointer returned is refused by name, and so is
 * a `main` that returns a struct.
 *
 * **Then `long`**, signed and eight bytes, as a base like `int` and `char`.
 * An `int` meeting a `long` is converted to one, C11 6.3.1.8, and the
 * difference of two pointers is a `long`, as C has it; `sizeof` was one too
 * until 2026-09-27, when it became the `unsigned long` C has. A decimal
 * constant too big for an `int` is a `long`; a suffix was a syntax error
 * until the same day, when hex, octal and the suffixes arrived with C11
 * 6.4.4.1's table of types.
 *
 * **Then the specifiers as C11 6.7 has them**, since ROADMAP 6.12's first
 * part: the words of a type in any order and counted, `int long unsigned`,
 * a storage class anywhere among them, `auto` and `register`, and every one
 * of C11's 44 keywords reserved, those whose feature is not here refused by
 * name. A list of words that is no type, two storage classes, and a storage
 * class where C forbids it are refused.
 *
 * **Then declarations of several names**, ROADMAP 6.12's second part:
 * `int a = 1, b, *p;` at file scope, in a block and in a struct, a `for`
 * that declares, parameters without names in a prototype, `extern`, C11
 * 6.9.2's tentative definitions, `_Static_assert`, and a definition with an
 * identifier list, whose declarations come one name each and in its order.
 *
 * **Then tags**, ROADMAP 6.12's third part: a struct defined in any
 * declaration's specifiers, in a block with the block's scope, with no tag,
 * or inside another, and `struct s;`; a typedef in a block; a pointer to a
 * struct that is not complete yet, whose width is looked up where it is
 * used, and an object, `*` or arithmetic of one refused until it is.
 *
 * **Then types built by declarators**, ROADMAP 6.12's fourth part, which
 * closed it: arrays of arrays, one level of parentheses, `int (*p)[3]` and
 * `int (*q[2])[3]`, abstract declarators in a cast and `sizeof`, a
 * parameter declared an array, and a typedef of an array. A type is text,
 * a level a field, see `Dim`; a pointer to a function is read and refused
 * by name.
 *
 * ---------------------------------------------------------------------------
 * The lexical half is written here rather than imported. `lib/lexical.phx`
 * reads `#` as a line comment, which C does not, and every rule it carries
 * would become a token kind whether the subset has it or not. C's own
 * conventions -- hex and octal constants, suffixes, character literals,
 * strings with escapes -- arrive with the constructs that need them.
 *)

%fragment letter digit hexdigit odigit isuffix escape plain splain .

letter   = "a" .. "z" | "A" .. "Z" | "_" .
digit    = "0" .. "9" .
hexdigit = "0" .. "9" | "a" .. "f" | "A" .. "F" .

name    = letter { letter | digit } .

(* **An integer constant is decimal, octal or hex, with a suffix**, since
 * 2026-09-27, ROADMAP 6.9: `u`, `l`, or both in either order and either
 * case, C11 6.4.4.1. The scanner takes the longest match, so what C
 * refuses is a syntax error at the letters left over: `0x` with no digits
 * stops at the `x` and `1uu` at its second `u`. **`ll` and `LL`**, `long
 * long`'s suffix, since ROADMAP 6.15's first part, are tried before one
 * `l`, and `lL` is no suffix, as C11 6.4.4.1 has it. An octal constant with an
 * 8 or a 9 in it is scanned whole and refused by the `types` pass, which
 * reads the digits. *)
isuffix = ( "u" | "U" ) [ "ll" | "LL" | "l" | "L" ] | ( "ll" | "LL" | "l" | "L" ) [ "u" | "U" ] .
integer = ( "0" ( "x" | "X" ) hexdigit { hexdigit } | digit { digit } ) [ isuffix ] .

(* A character constant is one character between single quotes, or one
 * escape. **Printable ASCII only**, and the three ranges are that and nothing
 * else: a space to `~`, less the quote at 39 and the backslash at 92, which
 * are what an escape is for. A tab typed between the quotes is C and is
 * refused here, as is `'ab'`, which C leaves to the implementation.
 *
 * The lexer saying exactly this is what lets the `types` pass work out a
 * code without asking whether it can: anything that reaches it is one of the
 * ninety-five characters in its table, or one of its escapes: six until
 * ROADMAP 6.16's first part, and twelve since, with `\a \b \f \r \v \?`;
 * or, since its third part, an octal escape of one to three digits or a hex
 * escape of one or more, which C11 6.4.4.4 reads as far as the digits go,
 * as a longest match does. *)
odigit    = "0" .. "7" .
escape    = "\\" ( "n" | "t" | "\\" | "'" | "\"" | "a" | "b" | "f" | "r" | "v" | "?"
                 | odigit [ odigit [ odigit ] ] | "x" hexdigit { hexdigit } ) .
plain     = " " .. "&" | "(" .. "[" | "]" .. "~" .
character = "'" ( escape | plain ) "'" .

(* A string literal is the same characters between double quotes, where the
 * double quote needs an escape and the single one does not, and with every
 * escape a character constant has but one. `\0` is left out because a string is where it
 * stops meaning what it seems to: C reads up to three octal digits after the
 * backslash, so `"\01"` is one byte and not a NUL and a `1`, and a lexer
 * that knew only `\0` would count two. It is refused rather than
 * miscounted, and arrives with the octal escapes. A character constant keeps
 * it, because the closing quote ends it there. Two literals side by side,
 * which C joins, are two tokens, and the grammar joins them, since ROADMAP
 * 6.16's second part. *)
splain  = " " .. "!" | "#" .. "[" | "]" .. "~" .
string  = "\"" { escape | splain } "\"" .

space         = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .
line-comment  = "//" { ! "\n" } .
block-comment = "/*" { ! "*/" } "*/" .

(* Three characters before two before one, every time: `<` first would leave the `=` of
 * `<=` behind, and the error would surface at the token after it. It matters
 * most for `&&`, since 2026-09-25: before it was a token, `a && b` was lexed
 * as two `&`s, and the day binary `&` arrives that spelling would parse, as
 * `a & (&b)`, which is ROADMAP 6.3's reason for building `&&` first. *)
symbol = "<<=" | ">>=" | "..."
       | "==" | "!=" | "<=" | ">=" | "->" | "&&" | "||" | "<<" | ">>"
       | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^="
       | "(" | ")" | "{" | "}" | ";" | "," | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "="
       | "&" | "|" | "^" | "~" | "!" | "?" | ":" | "[" | "]" | "." .

%skip space line-comment block-comment .

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* `int` and `return` are reserved by appearing below, which is what   *)
(* C's keyword list says about them too.                              *)

%syntax .
%start program .

program = { item } -> Program(items: $1) .

(* **What the parse keeps**, which is the one thing C asks of a parser that
 * no other language here has. `x * y;` declares `y` when `x` names a type and
 * multiplies when it does not, and `sizeof(x)` is the size of a type or of a
 * variable by the same test, so which rule a name belongs to is a question
 * about the declarations **above** it. ROADMAP 1.8 has the failure this
 * answers, measured before the notation had a way to say it.
 *
 * A `Typedef` declares its name a type. Every declaration of an ordinary
 * name hides one, because C11 6.2.1 lets `int T;` in a block make `T` a
 * variable until the block ends; a member does not, because members are a
 * name space of their own, 6.2.3. A block and a function each end what was
 * bound inside them, which is what makes the hiding end, and `function`
 * covers a prototype's parameters as much as a definition's, since C11 gives
 * a prototype a scope of its own. **So does `fn-suffix`**, since ROADMAP
 * 6.14's first part: the parameters of a pointer to a function are in a
 * prototype's scope too, C11 6.2.1p4, and `int (*f)(int T);` in a block
 * hid a typedef `T` to the block's end until it was one. `typedef-name` is
 * the one rule that asks. *)
%names typedef-names
    declare Typedef.name
    hide    Param.name Local.name LocalInit.name LocalArray.name
            Static.name StaticInit.name StaticArray.name LocalAgg.name StaticAgg.name
            Enumerator.name
    scope   block function for-declaration fn-suffix list-function
    guard   typedef-name .

(* A prototype or a definition, and the prototype first because it is the
 * shorter: the header is the same and `;` fails on `{`. C99 6.5.2.2 wants a
 * declaration above every call, so a prototype is how a call reaches a
 * function defined below it, and how two functions call each other.
 *
 * One return type. The body is the statements themselves and not a `Block`,
 * because C11 6.2.1 puts the parameters in the same scope as the body's
 * outermost declarations: `int f(int a) { int a; }` is declared twice, and a
 * `Block` would open a scope the parameters are not in. *)
(* **A typedef first**, since ROADMAP 6.14's fourth part, when one could
 * name a function's type, `typedef int binop(int, int);`: tried after
 * `function`, it was read as a prototype with `typedef` among its
 * specifiers. It needs the word, so nothing else is taken by it. *)
item = b:tdspecifiers d:typedef-declarator r:{ "," e:typedef-declarator -> $e } ";"
         -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "file")
     | function
     (* **`_Static_assert`**, C11 6.7.10, since ROADMAP 6.12's second part:
      * a condition the `constants` pass works out, and a message it gives
      * when the condition is zero. It may be an item or a statement. *)
     | "_Static_assert" "(" c:conditional "," m:string ms:{ string } ")" ";" -> StaticAssert(cond: $c, message: $m, more: $ms, file: true)
     (* **A declaration of no names**, since ROADMAP 6.12's third part:
      * `struct s { ... };` defines a struct and `struct s;` declares one,
      * C11 6.7.2.3. Until then a definition was an item of its own, at file
      * scope and with a tag; it is a specifier now, see `struct-core`. *)
     | b:specifiers ";" -> Decls(spec: $b, items: [], kind: "file")
     (* **A typedef is a name for a declaration's type**, a base and some
      * stars, and like a struct it is at file scope only: C allows one in a
      * block, with the block's scope, and the `locals` pass refuses it by
      * name.
 *
 * **Then initialisers in braces**, ROADMAP 6.13's first part: arrays and
 * scalars, at file scope, in a block and `static`, with inner braces or
 * without, strings filling arrays of `char`, and an array sized by what it
 * is given. See `InitList`. **Then structs and designators**, its second
 * and third parts: a struct member by member, `.member` and `[index]`,
 * braces left out anywhere C allows, and a global whose values go back
 * filled by a routine run before `main`. No array, `typedef int v[3];`, because a declaration's count is
      * a field of the declaration and not of its type; that arrives with
      * ROADMAP 6.12's fourth part, and is refused by name until then. The
      * word may stand anywhere among the specifiers, `int typedef t;`, as
      * C11 6.7.1 lets any storage class: see `tdspecifiers`. *)
     (* The typedef alternative is tried first, since ROADMAP 6.14's fourth
      * part, see `item`'s first alternative. *)
     (* **A global is a declaration at file scope**, since 2026-09-26,
      * ROADMAP 6.8, and is written as a local is: a base, stars and a name,
      * with a count in brackets or an initialiser. It is tried after a
      * function, which fails at the `;`, `[` or `=` where its `(` was
      * wanted. Three nodes, for the reason a local is three. *)
     (* **A function may be declared in the list**, since 2026-10-04, `int
      * x, f(void);`, by `list-function`, which is tried first at each
      * place, since a global's declarator would take the name and stop at
      * the `(`. A declaration of one function alone is still `function`'s,
      * which is tried before this. *)
     | b:specifiers d:list-declarator r:{ "," e:list-declarator -> $e } ";"
         -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "file") .

list-declarator = list-function | global-declarator .

(* **And in a block**, since 2026-10-04: `int f(void);` and `int x, f(void);`
 * declare a function there as at file scope, C11 6.7.6.3, the name in
 * force to the block's end as C11 6.2.1p4 has it. `static int f(void);`
 * is read here too, since `specifiers` take the word, and refused by
 * name, C11 6.7.1p7. *)
local-list = list-function | local-declarator .

(* **A function declared beside other names**, a `FnDecl`, which is a
 * `Prototype` whose return type is the `base` the `Decls` above hands down,
 * as every declarator's type is. A rule of its own because it is a scope,
 * as `function` is: see `%names`. A function returning a pointer to a
 * function is not written this way here. *)
list-function = t:pointer n:name "(" "void" ")"
                  -> FnDecl(name: $n, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0, rparen: [])
              | t:pointer n:name "(" ")"
                  -> FnDecl(name: $n, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 2, rparen: [])
              | t:pointer n:name "(" p:params v:dots ")"
                  -> FnDecl(name: $n, stars: size($t), squals: join(each($t, "{}")), params: $p, variadic: size($v), rparen: []) .

(* **One declarator**, since ROADMAP 6.12's second part, when a declaration
 * became a `Decls`: the specifiers once, as `spec`, and each name after
 * them a node of its own in `items`, `int a = 1, b, *p;` three. Every pass
 * hands the specifiers down to the declarators as `base`, which is the name
 * the field had when each declaration was one name, so no clause that
 * reads `$base` changed. A declarator is the stars, the name, and a count
 * in brackets or an initialiser, as a declaration was; the three forms are
 * three nodes for the reason given for a local's, below. *)
typedef-declarator = s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
                   | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)])
                   | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ]
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)])
                   | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ]
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)])
                   | s:pointer n:dname f:fn-suffix
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 0, dims: [], fn: [$f], extra: 0)])
                   | s:pointer n:dname "[" c:integer "]" d:[ brackets ]
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
                   | s:pointer n:dname
                     -> Typedef(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: []) .
global-declarator = s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix "=" i:init-top
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 0, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" "]" ")" f:fn-suffix "=" i:init-top
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 1, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix
                    -> GlobalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix "=" v:assignment
                    -> GlobalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)], value: $v)
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix
                    -> Global(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ] "=" i:init-top
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)], unsized: 0, init: $i)
                  | s:pointer n:dname "[" c:integer "]" d:[ brackets ] "=" i:init-top
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [], unsized: 0, init: $i)
                  | s:pointer n:dname "[" "]" d:[ brackets ] "=" i:init-top
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [], unsized: 1, init: $i)
                  | s:pointer n:dname "=" i:initializer
                    -> GlobalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [], unsized: 0, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ]
                    -> GlobalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ] "=" v:assignment
                    -> GlobalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)], value: $v)
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ]
                    -> Global(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)])
                  | s:pointer n:dname "[" c:integer "]" d:[ brackets ]
                    -> GlobalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
                  | s:pointer n:dname "=" v:assignment
                    -> GlobalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [], value: $v)
                  | s:pointer n:dname
                    -> Global(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: []) .
member-declarator = s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix
                    -> MemberArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix
                    -> MemberScalar(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ]
                    -> MemberArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ]
                    -> MemberScalar(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)])
                  | s:pointer n:dname "[" c:integer "]" d:[ brackets ]
                    -> MemberArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
                  | s:pointer n:dname
                    -> MemberScalar(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: []) .
static-declarator = s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix "=" i:init-top
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 0, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" "]" ")" f:fn-suffix "=" i:init-top
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 1, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix
                    -> StaticArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix "=" v:assignment
                    -> StaticInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)], value: $v)
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix
                    -> Static(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ] "=" i:init-top
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)], unsized: 0, init: $i)
                  | s:pointer n:dname "[" c:integer "]" d:[ brackets ] "=" i:init-top
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [], unsized: 0, init: $i)
                  | s:pointer n:dname "[" "]" d:[ brackets ] "=" i:init-top
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [], unsized: 1, init: $i)
                  | s:pointer n:dname "=" i:initializer
                    -> StaticAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [], unsized: 0, init: $i)
                  | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ]
                    -> StaticArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)])
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ] "=" v:assignment
                    -> StaticInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)], value: $v)
                  | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ]
                    -> Static(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)])
                  | s:pointer n:dname "[" c:integer "]" d:[ brackets ]
                    -> StaticArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
                  | s:pointer n:dname "=" v:assignment
                    -> StaticInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [], value: $v)
                  | s:pointer n:dname
                    -> Static(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: []) .
local-declarator = s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix "=" i:init-top
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 0, init: $i)
                 | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" "]" ")" f:fn-suffix "=" i:init-top
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], unsized: 1, init: $i)
                 | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" ")" f:fn-suffix
                   -> LocalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
                 | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix "=" v:assignment
                   -> LocalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)], value: $v)
                 | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } f:fn-suffix
                   -> Local(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [$f], extra: size($k) - size($o) - 1)])
                 | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ] "=" i:init-top
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)], unsized: 0, init: $i)
                 | s:pointer n:dname "[" c:integer "]" d:[ brackets ] "=" i:init-top
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [], unsized: 0, init: $i)
                 | s:pointer n:dname "[" "]" d:[ brackets ] "=" i:init-top
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [], unsized: 1, init: $i)
                 | s:pointer n:dname "=" i:initializer
                   -> LocalAgg(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [], unsized: 0, init: $i)
                 | s:pointer "(" "*" q:{ "const" } t:pointer n:dname "[" c:integer "]" e:[ brackets ] ")" d:[ brackets ]
                   -> LocalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [Paren(stars: 1 + size($t), dims: $e, fn: [], extra: 0)])
                 | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ] "=" v:assignment
                   -> LocalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)], value: $v)
                 | s:pointer "(" "*" q:{ "const" } t:pointer o:{ pstar } n:dname k:{ ")" } d:[ brackets ]
                   -> Local(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t) + size(flatten($o)), dims: [], fn: [], extra: size($k) - size($o) - 1)])
                 | s:pointer n:dname "[" c:integer "]" d:[ brackets ]
                   -> LocalArray(name: $n, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
                 | s:pointer n:dname "=" v:assignment
                   -> LocalInit(name: $n, stars: size($s), squals: join(each($s, "{}")), dims: [], paren: [], value: $v)
                 | s:pointer n:dname
                   -> Local(name: $n, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: []) .

(* **A declarator's brackets after the first**, since ROADMAP 6.12's fourth
 * part: a chain, each one's rest nested in it, and not a list, so that the
 * size of each level is an attribute of the one inside it, which is the
 * fold the notation has no function for. The first bracket of a
 * declarator is its own `count`, as it was when it was the only one. One
 * level of parentheses is read, `int (*p)[3]` and `int (*q[2])[3]`, with
 * its stars and its brackets a `Paren`: the name inside is still a factor
 * of the alternative, which `%names` needs. *)
brackets = "[" n:integer "]" r:[ brackets ] -> Dim(count: int($n), of: $r) .

(* **A name in parentheses is the name**, since 2026-10-04: `int (x) = 3;`
 * declares `x` as `int x = 3;` does, C11 6.7.6p6, and so does `int ((x))`,
 * and `int (*(p))` is `int (*p)`. The parentheses say nothing of the type
 * and are gone once parsed, so the declarator is the one it would be
 * without them, and its name is bound early in its own initialiser as any
 * is. The rule answers the name's text, which is what `%names` binds, so
 * the name is in force from the last `)`, where C11 6.2.1p7 puts it. *)
dname = name | "(" n:dname ")" -> $n .

(* **A `*` in parentheses inside another's**, since 2026-10-05: `int
 * (*(*p))` is `int (**p)`, as parentheses around stars and a name say
 * nothing of the type. Each `(*` after the first is a `pstar`, its stars
 * added to the `Paren`'s, and the `)`s after the name are read as many as
 * there are, the first's among them, since a repetition takes all it can
 * and would leave none for a `")"` written after it. That they balance is
 * the `Paren`'s `extra`, checked in the `locals` pass. One with brackets or
 * a function inside, `int (*(*p)[3])`, is still a syntax error. *)
pstar = "(" "*" q:{ "const" } t:pointer -> flatten([[0], $t]) .

(* **An initialiser in braces**, C11 6.7.9, since ROADMAP 6.13's first part:
 * a list of values and of lists, with a comma allowed after the last. A
 * declaration whose declarator is an array and has an initialiser, or whose
 * initialiser has braces, is an `*Agg` node, and its `init` is walked in
 * the `locals` pass beside the declarator's level text to find where each
 * value goes. An array's first count may be left out when there is one, and
 * is then what the initialiser reaches. Without braces an array takes only a
 * string, which fills an array of `char`. *)
init-top    = initializer
            | e:assignment -> InitExpr(value: $e) .
initializer = "{" "}" -> InitList(items: [])
            | "{" a:init-item r:{ "," b:init-item -> $b } [ "," ] "}" -> InitList(items: flatten([[$a], $r])) .
init-item   = d:designator r:{ designator } "=" v:init-value -> Desig(path: flatten([[$d], $r]), item: $v)
            | init-value .
init-value  = initializer
            | e:assignment -> InitExpr(value: $e) .

(* **A designator**, C11 6.7.9p6, since ROADMAP 6.13's third part: a
 * member's name after a `.`, or an index in brackets, which here is a
 * number written out, since where a value goes is worked out in the
 * `locals` pass and a constant expression in the `constants` pass after it.
 * Any other index is read so as to be refused by name. *)
designator  = "." n:name -> Step(kind: ".", n: 0, name: $n)
            | "[" i:integer "]" -> Step(kind: "[", n: int($i), name: "")
            | "[" conditional "]" -> Step(kind: "e", n: 0, name: "") .

(* **A function's parameters**, after a declarator in parentheses, which
 * is a pointer to a function, `int (*f)(int)`. Read and refused by name
 * from ROADMAP 6.12's fourth part, and a type since ROADMAP 6.14's first:
 * a `Sig` is a function's parameters and whether it ends in `...`, held in
 * the `Paren` whose stars point at it, see `Paren` and `Sig` in the
 * `locals` pass. *)
fn-suffix = "(" "void" ")" -> Sig(params: [], variadic: 0)
          | "(" ")" -> Sig(params: [], variadic: 2)
          | "(" p:params v:dots ")" -> Sig(params: $p, variadic: size($v)) .

(* **`(void)` is a list of no parameters**, C11 6.7.6.3p10, since
 * 2026-09-26. It is two alternatives of its own, tried first, because the
 * notation has no syntactic lookahead: a `params` that took `void` alone
 * would have taken the `void` of `(void *p)` and been unable to give it
 * back. Here the whole alternative fails at the `*`, and the next is tried
 * from the name.
 *
 * **`()` is no prototype**, C11 6.7.6.3p14, since 2026-10-04, as it was a
 * declaration's the same morning: in a pointer to a function, a typedef,
 * a cast and a parameter, `variadic` 2, which a call through it reads as a
 * call to a function declared with `()` is read. It was a list of no
 * parameters, which `params` still makes of it in a definition. *)
(* A function is a rule of its own because it is a **scope**: see `%names`
 * above. Its parameters hide a typedef of the same name from the `(` to the
 * end of the body, or to the `;` of a prototype, and no further.
 *
 * **What it returns is a `base` and some stars.** The base arrived on
 * 2026-09-23, and was the keyword `int` before: a struct returned whole is the
 * reason, and a base is the one node that already answers what a struct is.
 * The stars arrived on 2026-09-25, ROADMAP 6.2, and until then `int *f()` was
 * a syntax error and a typedef of a pointer was the only way to write one.
 * `char f()` parses too, and is returned narrowed, as a `short` is, since
 * 2026-10-03; the `locals` pass refused it by name until then.
 *
 * `item` tries this alternative first, and a struct's definition fails it at
 * the `{` after the tag, where a function's name was wanted, and moves on.
 *
 * **`static` says no other file can name it**, C11 6.2.2p3, since
 * 2026-09-29, ROADMAP 6.10, and the `functions` pass reads it from the
 * specifiers' words. A global takes it the same way, below. Until ROADMAP
 * 6.12's first part it was the first word or not there, and
 * `int static f(void)` was a syntax error; it may stand anywhere among the
 * specifiers now, as C11 6.7 has it. *)
function = r:specifiers t:pointer "(" "*" q:{ "const" } u:pointer n:name "(" "void" ")" ")" f:fn-suffix ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0, rparen: [Paren(stars: 1 + size($u), dims: [], fn: [$f], extra: 0)])
         | r:specifiers t:pointer "(" "*" q:{ "const" } u:pointer n:name "(" "void" ")" ")" f:fn-suffix "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0, rparen: [Paren(stars: 1 + size($u), dims: [], fn: [$f], extra: 0)],
                         body: $s, ids: [])
         | r:specifiers t:pointer "(" "*" q:{ "const" } u:pointer n:name "(" p:params v:dots ")" ")" f:fn-suffix ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p, variadic: size($v), rparen: [Paren(stars: 1 + size($u), dims: [], fn: [$f], extra: 0)])
         | r:specifiers t:pointer "(" "*" q:{ "const" } u:pointer n:name "(" p:params v:dots ")" ")" f:fn-suffix "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p, variadic: size($v), rparen: [Paren(stars: 1 + size($u), dims: [], fn: [$f], extra: 0)],
                         body: $s, ids: [])
         | r:specifiers t:pointer n:name "(" "void" ")" ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0, rparen: [])
         | r:specifiers t:pointer n:name "(" "void" ")" "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 0, rparen: [],
                         body: $s, ids: [])
         (* **`()` in a declaration says nothing of the parameters**, C11
          * 6.7.6.3p14, since 2026-10-04: an unprototyped function, whose
          * `variadic` is 2. Its calls are not counted and their arguments
          * go in registers with C's default promotions, 6.5.2.2p6; a later
          * prototype or definition says what it takes. In a definition
          * `()` is no parameters, as it was, and so is `(void)` anywhere. *)
         | r:specifiers t:pointer n:name "(" ")" ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: [], variadic: 2, rparen: [])
         | r:specifiers t:pointer n:name "(" p:params v:dots ")" ";"
             -> Prototype(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                          variadic: size($v), rparen: [])
         | r:specifiers t:pointer n:name "(" p:params v:dots ")" "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                         variadic: size($v), rparen: [], body: $s, ids: [])
         | r:specifiers t:pointer n:name "(" i:name j:{ "," x:name -> $x } ")" p:{ kr-declaration } "{" s:{ statement } "}"
             -> Function(name: $n, ret: $r, stars: size($t), squals: join(each($t, "{}")), params: $p,
                         variadic: 0, rparen: [], body: $s, ids: flatten([[$i], $j])) .

(* A member is declared the way a local is, and is two nodes for the reason a
 * local is: `int a[0];` and `int a;` must not be spelled the same. There is no
 * initialiser, because C has none for a member. *)
member = b:sqlist d:member-declarator r:{ "," e:member-declarator -> $e } ";"
           -> MDecls(spec: $b, items: flatten([[$d], $r])) .

(* A parameter is a node and not a name, because it takes a slot the way a
 * local does and the emit pass has to store a register into it. The
 * repetition's action is what makes this a list of parameters rather than a
 * list of parameters and commas, and the rule's own action is what makes it
 * a list at all: a rule with no action answers the one thing it matched, so
 * one parameter would arrive bare and two would arrive in a node called
 * `params`. `-> $1` says *the list, whatever its length*. *)
params = [ param { "," q:param -> $q } ] -> $1 .

(* **`...` after the parameters**, since 2026-09-26, ROADMAP 6.6: a list of
 * one when the function is variadic and of none when it is not, so that
 * `size` is the flag, as it is the count of a declaration's stars. It needs
 * the comma, so `int f(...)`, which C11 6.7.6.3 refuses for want of a named
 * parameter before it, is `(` then `...` here and a syntax error at the
 * `...`; so is `...` anywhere but last, where the `)` was wanted. A
 * repetition's iteration that fails gives back what it took, which is what
 * lets `params` stop at the `,` in front of the `...`. *)
dots   = [ "," e:"..." -> $e ] -> $1 .
(* **A parameter may have no name**, since ROADMAP 6.12's second part:
 * `int add(int, int);` is a prototype of two. One without a name is bound
 * as "", which nothing can look up, and is not "a parameter twice". A definition's parameters are named, C11 6.9.1p5, which the
 * `functions` pass asks. *)
(* **A parameter declared an array is a pointer to its element**, C11
 * 6.7.6.3p7, since ROADMAP 6.12's fourth part: `adj` says so, and the
 * first bracket's count, which may be left out, is dropped. *)
param  = b:specifiers s:pointer "(" "*" q:{ "const" } t:pointer n:name ")" f:fn-suffix
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
       | b:specifiers s:pointer "(" "*" q:{ "const" } t:pointer n:no-name ")" f:fn-suffix
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
       | b:specifiers s:pointer "(" "*" q:{ "const" } t:pointer n:name ")" d:[ brackets ]
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: $d, paren: [Paren(stars: 1 + size($t), dims: [], fn: [], extra: 0)])
       | b:specifiers s:pointer n:name "[" [ integer ] "]" d:[ brackets ]
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 1, dims: $d, paren: [])
       | b:specifiers s:pointer n:name
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: [], paren: [])
       | b:specifiers s:pointer n:no-name "[" [ integer ] "]" d:[ brackets ]
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 1, dims: $d, paren: [])
       | b:specifiers s:pointer n:no-name
           -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: [], paren: []) .

(* **The name of a parameter that has none**: nothing, answering "". It is
 * a factor so that `%names` has one to bind, and what it hides is a
 * typedef named "", which no program can write. The option inside it is
 * never taken, since two `...` in a row are no C; the notation has no rule
 * that matches nothing, and this is one that does. *)
no-name = [ "..." "..." ] -> "" .

(* **A definition with an identifier list**, C11 6.9.1p6, obsolescent and
 * still C: the names in the parentheses and a declaration for each before
 * the body. Each declaration is a parameter's, one name to one, and the
 * `functions` pass asks that they come in the list's order, which C does
 * not: this subset's limit, and a refusal by name. *)
kr-declaration = b:specifiers s:pointer "(" "*" q:{ "const" } t:pointer n:name ")" d:[ brackets ] ";"
                   -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: $d, paren: [Paren(stars: 1 + size($t), dims: [], fn: [], extra: 0)])
               | b:specifiers s:pointer n:name "[" [ integer ] "]" d:[ brackets ] ";"
                   -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 1, dims: $d, paren: [])
               | b:specifiers s:pointer n:name ";"
                   -> Param(name: $n, base: $b, stars: size($s), squals: join(each($s, "{}")), adj: 0, dims: [], paren: []) .

(* What is at the bottom of the stars. **A node since `struct`**, and a keyword
 * before it: `int` and `char` were two words the `locals` pass turned into a
 * width with a table written out at each of five declarations. A struct's
 * width is not in any table written here, because the program defines it, so
 * the question moved to the one node that can answer it for every
 * declaration at once.
 *
 * **A typedef's name builds a node of its own** rather than a `Base`,
 * because what it names is a base *and some stars*, and a `Base` has no
 * stars to give. The `locals` pass has each answer how many, and a
 * declaration adds its own.
 *
 * **A declaration's specifiers are what C11 6.7 says**, since ROADMAP 6.12's
 * first part: storage classes, qualifiers, function specifiers and the words
 * of a type, **in any order**. Until then they came in one order, with
 * `static` first or not there, and `long unsigned` was a syntax error. Every
 * word is kept, spelled, in `words`, each with a space on both sides, so
 * that how many times a word was written is the pieces `split` makes of it
 * less one, and the `functions` pass counts the words of the type against
 * the list in 6.7.2p2 to find which type they name: `int long` is `long`,
 * and `long char` is none. A `Base` keeps its tag in `name` when it is a
 * struct, and "" when it is words.
 *
 * **All 44 of C11's keywords are here**, 6.4.1, because a word the grammar
 * names is reserved and one it does not is a name: until this part 21 of
 * them were, and `int float = 1;` compiled. A keyword whose feature is not
 * in the subset is still read, where C puts it, so that the passes can
 * refuse it by name and not a parse at whatever came after it. *)
typedef-name = name .

(* **`__builtin_va_list` is a typedef's name no declaration wrote**, since
 * 2026-10-04: what <stdarg.h> calls `va_list`, here and in `cc`'s own
 * headers, which is a `char *` on Apple's arm64. It is a word of its own,
 * since `%names` knows only what a declaration declared, and the `locals`
 * pass gives it its meaning, see `Named`. *)
tname = typedef-name | "__builtin_va_list" .

(* **A struct as a specifier**, since ROADMAP 6.12's third part: its tag,
 * its tag and its definition, or a definition with no tag, which is where C
 * puts one, in any declaration's specifiers. The answer is the tag, "" for
 * none, and a list holding the definition or empty, which `Base` keeps as
 * its `def`. A struct with no members is **not** a syntax error, so that it
 * can be refused by name: see the `locals` pass. *)
(* **An enumeration as a specifier**, C11 6.7.2.2, since ROADMAP 6.15's
 * fourth part, written as a struct's is: its tag, its tag and its list, or
 * a list with no tag. Each enumerator is a name and, if one is written, the
 * value after its `=`, which the `locals` pass works out. *)
enum-core   = "enum" t:name "{" a:enumerator r:{ "," b:enumerator -> $b } [ "," ] "}" -> [$t, [EnumDef(name: $t, items: flatten([[$a], $r]))]]
            | "enum" "{" a:enumerator r:{ "," b:enumerator -> $b } [ "," ] "}"        -> ["", [EnumDef(name: "", items: flatten([[$a], $r]))]]
            | "enum" t:name                                                          -> [$t, []] .
enumerator  = n:name "=" v:conditional -> Enumerator(name: $n, value: [$v])
            | n:name                   -> Enumerator(name: $n, value: []) .

struct-core = "struct" t:name "{" m:{ member } "}" -> [$t, [StructDef(name: $t, members: $m)]]
            | "struct" "{" m:{ member } "}"        -> ["", [StructDef(name: "", members: $m)]]
            | "struct" t:name                      -> [$t, []] .

(* The words that are not the type's. A storage class, C11 6.7.1, is one of
 * six, `typedef` among them for syntax's sake; a function specifier one of
 * two, 6.7.4; a qualifier one of four, 6.7.3, and `_Alignas`, 6.7.5, reads
 * like one. `_Atomic` with parentheses is a type specifier, 6.7.2.4, and is
 * refused by the same name as the qualifier. *)
qualifier = "const" | "volatile" | "restrict"
          | "_Atomic" "(" typename ")" -> "_Atomic"
          | "_Atomic"
          | "_Alignas" "(" ( typename | conditional ) ")" -> "_Alignas" .
storage   = "static" | "typedef" | "extern" | "register" | "auto" | "_Thread_local" .
function-specifier = "inline" | "_Noreturn" .
type-word = "void" | "char" | "short" | "int" | "long" | "float" | "double"
          | "signed" | "unsigned" | "_Bool" | "_Complex" | "_Imaginary" .

(* **The specifiers of a declaration**, 6.7: any number of the words above,
 * and one of a struct, a union or an enum with its tag, a typedef's name,
 * or a run of the words of a type with the others among them. The name is
 * the one that must come alone, because C11 6.7.2p2 lets a typedef's name
 * be the only type specifier, and is what keeps `T x` from reading `x` as a
 * second type when it is a typedef's name too: it is taken once, and every
 * word after it is one of the others. A union and an enum are read to be
 * refused, and a struct's definition is an item of its own, below. *)
specifier = qualifier | storage | function-specifier .
specifiers = a:{ specifier } t:struct-core b:{ specifier }
               -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["struct"], $b]), "  ")), def: at($t, 2))
           | a:{ specifier } t:enum-core b:{ specifier }
               -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["enum"], $b]), "  ")), def: at($t, 2))
           | a:{ specifier } k:"union" t:name b:{ specifier }
               -> Base(name: "", words: (" {} " of join(flatten([$a, [$k], $b]), "  ")), def: [])
           | a:{ specifier } t:tname b:{ specifier }
               -> Named(name: $t, words: " {} " of join(flatten([$a, $b]), "  "))
           | a:{ specifier } w:type-word r:{ type-word | specifier }
               -> Base(name: "", words: (" {} " of join(flatten([$a, [$w], $r]), "  ")), def: []) .

(* **The same, with one `static` in it**, which is what makes a local a
 * `Static`, and **with one `typedef`**, which makes a declaration at file
 * scope a `Typedef`. Each is a rule of its own because the grammar is what
 * decides which node is built, and `%names` has to know a typedef while the
 * parse is going on. The word may stand before the type or among it; a
 * second one is left for `specifiers` to take, and a pass to refuse. *)
not-static  = qualifier | function-specifier | "typedef" | "extern" | "register" | "auto" | "_Thread_local" .
sspecifiers = a:{ not-static } "static" b:{ not-static } t:struct-core c:{ not-static }
                -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["static"], $b, ["struct"], $c]), "  ")), def: at($t, 2))
            | a:{ not-static } t:struct-core b:{ not-static } "static" c:{ not-static }
                -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["struct"], $b, ["static"], $c]), "  ")), def: at($t, 2))
            | a:{ not-static } "static" b:{ not-static } t:enum-core c:{ not-static }
                -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["static"], $b, ["enum"], $c]), "  ")), def: at($t, 2))
            | a:{ not-static } t:enum-core b:{ not-static } "static" c:{ not-static }
                -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["enum"], $b, ["static"], $c]), "  ")), def: at($t, 2))
            | a:{ not-static } "static" b:{ not-static } t:tname c:{ not-static }
                -> Named(name: $t, words: " {} " of join(flatten([$a, ["static"], $b, $c]), "  "))
            | a:{ not-static } t:tname b:{ not-static } "static" c:{ not-static }
                -> Named(name: $t, words: " {} " of join(flatten([$a, $b, ["static"], $c]), "  "))
            | a:{ not-static } "static" b:{ not-static } w:type-word r:{ type-word | not-static }
                -> Base(name: "", words: (" {} " of join(flatten([$a, ["static"], $b, [$w], $r]), "  ")), def: [])
            | a:{ not-static } w:type-word r:{ type-word | not-static } "static" c:{ type-word | not-static }
                -> Base(name: "", words: (" {} " of join(flatten([$a, [$w], $r, ["static"], $c]), "  ")), def: []) .

not-typedef  = qualifier | function-specifier | "static" | "extern" | "register" | "auto" | "_Thread_local" .
tdspecifiers = a:{ not-typedef } "typedef" b:{ not-typedef } t:struct-core c:{ not-typedef }
                 -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["typedef"], $b, ["struct"], $c]), "  ")), def: at($t, 2))
             | a:{ not-typedef } t:struct-core b:{ not-typedef } "typedef" c:{ not-typedef }
                 -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["struct"], $b, ["typedef"], $c]), "  ")), def: at($t, 2))
             | a:{ not-typedef } "typedef" b:{ not-typedef } t:enum-core c:{ not-typedef }
                 -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["typedef"], $b, ["enum"], $c]), "  ")), def: at($t, 2))
             | a:{ not-typedef } t:enum-core b:{ not-typedef } "typedef" c:{ not-typedef }
                 -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["enum"], $b, ["typedef"], $c]), "  ")), def: at($t, 2))
             | a:{ not-typedef } "typedef" b:{ not-typedef } t:tname c:{ not-typedef }
                 -> Named(name: $t, words: " {} " of join(flatten([$a, ["typedef"], $b, $c]), "  "))
             | a:{ not-typedef } t:tname b:{ not-typedef } "typedef" c:{ not-typedef }
                 -> Named(name: $t, words: " {} " of join(flatten([$a, $b, ["typedef"], $c]), "  "))
             | a:{ not-typedef } "typedef" b:{ not-typedef } w:type-word r:{ type-word | not-typedef }
                 -> Base(name: "", words: (" {} " of join(flatten([$a, ["typedef"], $b, [$w], $r]), "  ")), def: [])
             | a:{ not-typedef } w:type-word r:{ type-word | not-typedef } "typedef" c:{ type-word | not-typedef }
                 -> Base(name: "", words: (" {} " of join(flatten([$a, [$w], $r, ["typedef"], $c]), "  ")), def: []) .

(* **A member's, a cast's and `sizeof`'s**, C11 6.7.2.1 and 6.7.7: the
 * words of a type and its qualifiers, and no storage class, so `static` in
 * a member is a syntax error and not a refusal, as it was. *)
sqlist = a:{ qualifier } t:struct-core b:{ qualifier }
           -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["struct"], $b]), "  ")), def: at($t, 2))
       | a:{ qualifier } t:enum-core b:{ qualifier }
           -> Base(name: at($t, 1), words: (" {} " of join(flatten([$a, ["enum"], $b]), "  ")), def: at($t, 2))
       | a:{ qualifier } k:"union" t:name b:{ qualifier }
           -> Base(name: "", words: (" {} " of join(flatten([$a, [$k], $b]), "  ")), def: [])
       | a:{ qualifier } t:tname b:{ qualifier }
           -> Named(name: $t, words: " {} " of join(flatten([$a, $b]), "  "))
       | a:{ qualifier } w:type-word r:{ type-word | qualifier }
           -> Base(name: "", words: (" {} " of join(flatten([$a, [$w], $r]), "  ")), def: []) .

(* A type named where no declaration is, in `_Alignas`, `_Alignof`, `_Atomic`
 * and `_Generic`: read so that each can be refused by name. *)
typename = sqlist pointer .

(* **The stars of a declarator**, each with the `const`s after it. *)
pointer = { "*" cq:{ "const" } -> size($cq) } -> $1 .

block = "{" { statement } "}" -> Block(body: $2) .

(* **A `for` that declares**, C99 6.8.5p3, since ROADMAP 6.12's second part,
 * is a block holding the declaration and a `for` without one, which is the
 * scope C gives it: the names reach the end of the loop and no further. It
 * is a rule of its own so that `%names` ends a typedef's hiding there, as a
 * block's end does. What it may declare is refused in the `locals` pass. *)
for-declaration = "for" "(" b:specifiers d:local-declarator r:{ "," e:local-declarator -> $e } ";"
                    c:[ expression ] ";" t:[ expression ] ")" x:statement
                    -> Block(body: [Decls(spec: $b, items: flatten([[$d], $r]), kind: "for"),
                                    For(init: [], cond: $c, step: $t, body: $x)]) .

(* A declaration is two nodes rather than one with an optional initialiser,
 * because a node whose field is sometimes there is a node every pass has to
 * ask about. `int x = e;` is `int x; x = e;` and the emit pass says so.
 *
 * The stars are **counted** rather than kept: `int **p` declares a name with
 * two of them, and two is the whole of what any pass here asks. A type in this
 * subset is a base and a number of stars, so it fits in the keyword and the
 * number the node was going to carry anyway. This said until 2026-09-22 that
 * `char` would be the day a type needs a node of its own; `char` needed a
 * second number. `struct` was the day it was to need a node, and gave one
 * to the base instead: see `base` above and the `types` pass. *)
statement = "return" e:expression ";"              -> Return(value: $e)
          (* **`return;` returns nothing**, since 2026-09-26, ROADMAP 6.7,
           * and is refused by the `types` pass in a function that returns
           * something, as `cc` refuses it. *)
          | "return" ";"                             -> ReturnNothing
          (* **A label is a name and a `:` before a statement**, and a
           * `goto` names one, since 2026-09-25, ROADMAP 6.4. The label is
           * tried before an expression statement, which would read the name
           * and fail at the `:`, and before a declaration, whose base is a
           * reserved word or a typedef's name and so never a label's. *)
          (* **A `switch` is a statement with labels in it**, C11 6.8.4.2,
           * since 2026-09-25: its body is any statement, and a `case` or a
           * `default` is a label on one of the statements inside, however
           * deep, which is why a `case` can sit inside a loop inside the
           * `switch` and still be the `switch`'s. A `case` label is C's
           * *constant-expression*, which is a `conditional`: it may have a
           * `?:` in it, whose own `:` it keeps, and not a comma. *)
          | "switch" "(" c:expression ")" b:statement -> Switch(cond: $c, body: $b)
          | "case" v:conditional ":" b:statement     -> Case(value: $v, body: $b)
          | "default" ":" b:statement                -> Default(body: $b)
          | "goto" n:name ";"                        -> Goto(name: $n)
          | n:name ":" b:statement                   -> Labelled(name: $n, body: $b)
          (* An array first, because the three declaration forms are told
           * apart by the token after the name and this one's is `[`. The
           * count is a constant in the source and so is a field rather than a
           * subtree: C99's variable-length arrays are not in this subset, and
           * a count that a pass would have to evaluate is a different
           * mechanism from a count that is written down.
           *
           * It is a **node of its own** for the reason `Local` and
           * `LocalInit` are two nodes: a count that is sometimes there is a
           * count every pass has to ask about, and here the question has a
           * sharp edge. `int a[0]` is a count of zero and `int a;` is no
           * count at all, and one node would have to spell both the same. *)
          (* **A `static` local is a local in scope and a global in storage**,
           * C11 6.2.4p3, since 2026-09-29, ROADMAP 6.10: it is kept for the
           * whole run and initialised once, before the program starts. The
           * three forms are a local's, and three nodes of their own, since
           * nothing a pass says about a local's frame is true of one. The
           * word may stand anywhere among the specifiers since ROADMAP
           * 6.12's first part, `int static n;`, which is `sspecifiers`'
           * question; `auto` and `register` are a plain local's words. *)
          (* **A typedef in a block**, and a declaration of no names, since
           * ROADMAP 6.12's third part: each has the block's scope, which
           * `%names` gives the typedef and the `locals` pass gives its
           * meaning and a struct's tag. *)
          | b:tdspecifiers d:typedef-declarator r:{ "," e:typedef-declarator -> $e } ";"
                   -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "block")
          | b:specifiers ";"
                   -> Decls(spec: $b, items: [], kind: "block")
          | b:sspecifiers d:static-declarator r:{ "," e:static-declarator -> $e } ";"
                   -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "block")
          | b:specifiers d:local-list r:{ "," e:local-list -> $e } ";"
                   -> Decls(spec: $b, items: flatten([[$d], $r]), kind: "block")
          (* The `else` form first. Trying it first is also what settles the
           * dangling else: an inner `if` gets the chance to take the `else`
           * before the outer one does, which is what C11 6.8.4 says. *)
          | "if" "(" c:expression ")" t:statement "else" f:statement
                                                    -> IfElse(cond: $c, then: $t, else: $f)
          | "if" "(" c:expression ")" t:statement   -> If(cond: $c, then: $t)
          | "while" "(" c:expression ")" b:statement
                                                    -> While(cond: $c, body: $b)
          (* Each clause of a `for` may be missing, and an option is a list
           * that is empty when it did not match, so the node carries three
           * lists of at most one. That is the same shape as a block's body,
           * and the emit pass joins them the same way. *)
          | for-declaration
          | "for" "(" i:[ expression ] ";" c:[ expression ] ";" s:[ expression ] ")"
                b:statement                         -> For(init: $i, cond: $c, step: $s, body: $b)
          (* **A `do` runs its body before it tests**, C11 6.8.5.2, so once
           * even when the condition is false, and ends with a `;` of its own.
           * `break` and `continue` are statements with nothing in them, and
           * a `;` alone is the empty statement, the body of `for (...) ;`.
           * All four arrived on 2026-09-25, ROADMAP 6.4, and naming `do`,
           * `break` and `continue` here is what reserved them: before, `break;`
           * was an expression statement naming a variable. *)
          | "do" b:statement "while" "(" c:expression ")" ";"
                                                    -> DoWhile(body: $b, cond: $c)
          | "break" ";"                             -> Break
          | "continue" ";"                          -> Continue
          | ";"                                     -> Empty
          | block
          | "_Static_assert" "(" c:conditional "," m:string ms:{ string } ")" ";" -> StaticAssert(cond: $c, message: $m, more: $ms, file: false)
          | e:expression ";"                        -> Discard(value: $e) .

(* C's expression grammar, all fifteen of its levels. `lib/expression.phx`
 * is not imported: its table is calc's, with `and`, `or`, `not` and `<>` in
 * it, and C's is written here a level at a time as the constructs arrive.
 * The shape is the module's, though, and so is the fold: `$$` is what has
 * been built so far, and an action naming it replaces that, which is what
 * makes `100 - 50 - 25` group to the left without anybody saying so. *)
expression = assignment { "," a:assignment -> Comma(left: $$, right: $a) } .

(* **The comma operator is the loosest level**, since 2026-09-25, and so is
 * what `expression` means: C11 6.5.17 evaluates the left, throws it away and
 * is worth the right. That is also why an argument and an initialiser are
 * *not* an `expression`, and read an `assignment` instead: `f(a, b)` is two
 * arguments and `int x = 1, y;` would otherwise be a comma. A subscript, a
 * condition and a parenthesis take the whole thing, as C's do. *)

(* Assignment is an expression in C, worth the value assigned, and it groups
 * to the right: `a = b = 21` sets both. What is on the left is a **place**
 * and no longer a name, which is the whole of what `&` and `*` change about
 * this rule: `*p = 3` puts a value where a pointer says, and C11 6.5.16 asks
 * for an lvalue there rather than for an expression. The first alternative
 * fails at `=` on anything that is not an assignment and the choice moves on,
 * which is what ordered choice is for; `==` is a different token, so `x == 1`
 * never gets this far. *)
assignment = p:place "=" a:assignment -> Assign(place: $p, value: $a)
           | p:place o:compound a:assignment
               -> Update(place: $p, op: $o, value: $a, post: false)
           | conditional .

(* **A compound assignment changes a place in place**, since 2026-09-25, and
 * is not built as `a = a + b`: C11 6.5.16.2 says `a` is evaluated once, and
 * `x[k++] += 10` moves `k` once. So it is a node of its own, `Update`, which
 * `++` and `--` build too: C11 6.5.3.1 defines `++a` as `a += 1`, and `a++`
 * is the same step worth the value from before it, which is `post`. The
 * operator is kept as written, for the messages. *)
compound = "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=" .

(* **`?:` is one arm or the other, never both**, C11 6.5.15, and groups to
 * the right: `a ? b : c ? d : e` is `a ? b : (c ? d : e)`. The middle takes
 * a whole `expression`, since nothing can end it early but the `:`. *)
conditional = c:logical-or "?" t:expression ":" f:conditional
                -> Choose(cond: $c, then: $t, other: $f)
            | logical-or .

(* **`||` and `&&`**, since 2026-09-25, the loosest levels below assignment:
 * `a || b && c` is `a || (b && c)`, and both group to the left. They are one
 * node with an operator in it, as the arithmetic is, and not a `Binary`,
 * because they are not arithmetic: C11 6.5.13 and 6.5.14 evaluate the right
 * side only when the left has not decided, and the answer is 0 or 1, never
 * an operand's value. *)
logical-or  = logical-and { "||" logical-and
                              -> Logical(op: $1, left: $$, right: $2) } .
logical-and = bit-or      { "&&" bit-or
                              -> Logical(op: $1, left: $$, right: $2) } .

(* **The bitwise three sit between `&&` and the comparisons**, since
 * 2026-09-25, which is C's order and its famous trap: `a & b == c` is
 * `a & (b == c)`. They are arithmetic, and a `Binary` like `+`. *)
bit-or  = bit-xor { "|" bit-xor -> Binary(op: $1, left: $$, right: $2) } .
bit-xor = bit-and { "^" bit-and -> Binary(op: $1, left: $$, right: $2) } .
bit-and = equality { "&" equality -> Binary(op: $1, left: $$, right: $2) } .

(* A place is somewhere a value can be **put**, and it is the one thing `&`
 * can be asked for. There are two: a name, and a dereference of anything.
 * Saying that here rather than in a pass is what keeps `1 = 2` and `&1` out
 * without any pass having to ask what kind of node it was handed -- C11
 * 6.5.3.2 makes the operand of `&` an lvalue, and this rule is that
 * constraint written in the grammar, where it costs nothing to check.
 *
 * A place builds the same `Variable` and `Deref` nodes a *read* of one builds,
 * because they are the same nodes: what differs is which attribute the parent
 * asks them for. The emit pass gives both an address as well as a value, and
 * an assignment reads the address where a read reads the value.
 *
 * The third alternative is a **parenthesised** place, which C allows and this
 * rule refused until 2026-09-22: `(x) = 4` and `&(x)` are ordinary C and were
 * a syntax error here. Parentheses group without changing what a thing is,
 * and the action says exactly that by answering the place inside them rather
 * than building anything. It has to come before the name and after the `*`,
 * for the reason every ordered choice here does: `(` decides it.
 *
 * A subscripted place is the fourth, and `a[i]` is a place because it is a
 * `*`, which is all a subscript is. A member is a place too, `s.x` and
 * `p->x` alike, and arrives in the same alternative because it is written
 * in the same position, after a primary. The alternative is **first**,
 * before the parenthesised one, because ordered choice does not come back:
 * `(a)[1] = 2` would match `(a)` as a parenthesised place, fail at `[` where
 * the `=` was wanted, and never be tried as anything else. Tried first, a
 * place that has nothing after its primary fails at the token that follows
 * it and the choice moves on. *)
place = suffixed
      | "*" u:unary   -> Deref(value: $u)
      | literal
      | "(" p:place ")" -> $p
      | n:name        -> Variable(name: $n, lit: []) .

(* A comparison is an `int`, 0 or 1, and it chains: `3 > 2 > 1` is
 * `(3 > 2) > 1`, which is 0, and C means that. So these are repetitions
 * like the arithmetic below them, where `lib/expression.phx` has an option
 * because calc does not chain. Equality is looser than the relations, so
 * `0 == 1 < 2` is `0 == (1 < 2)`. *)
equality       = relational     { ( "==" | "!=" ) relational
                                    -> Compare(op: $1, left: $$, right: $2) } .
relational     = shift          { ( "<" | "<=" | ">" | ">=" ) shift
                                    -> Compare(op: $1, left: $$, right: $2) } .
shift          = additive       { ( "<<" | ">>" ) additive
                                    -> Binary(op: $1, left: $$, right: $2) } .

additive       = multiplicative { ( "+" | "-" ) multiplicative
                                    -> Binary(op: $1, left: $$, right: $2) } .
multiplicative = unary          { ( "*" | "/" | "%" ) unary
                                    -> Binary(op: $1, left: $$, right: $2) } .

(* `&` takes a place and `*` takes anything, which is C11 6.5.3.2 as written.
 * `&*p` is therefore `p` without anybody saying so: the address of a
 * dereference is the thing dereferenced, and the emit pass gets that from the
 * shape of the tree rather than from a rule about it.
 *
 * `sizeof` has two shapes and the **type** one goes first, because `sizeof
 * (x)` would otherwise be taken by the expression form's parenthesised
 * primary and `sizeof(int)` would fail there: `int` is a reserved word and
 * no expression begins with it. The two build different nodes rather than
 * one node with a field that is sometimes a type, for the reason the
 * declarations give above. *)
(* **A cast is a type in parentheses before a unary expression**, C11
 * 6.5.4, since 2026-09-26, ROADMAP 6.7. It is tried first, because a
 * parenthesised expression is a `primary` and would take the `(`; a base
 * is a keyword or a name `%names` has made a typedef, so `(x)` with `x` a
 * variable fails at once and falls through to the expression it is. It
 * binds tighter than every binary operator and looser than a suffix, so
 * `(char)x + 1` is `((char)x) + 1` and `(char)a[1]` is `(char)(a[1])`, as
 * in C. `sizeof (int) x` stays a syntax error, since the type form of
 * `sizeof` is tried before this and leaves the `x`. *)
unary   = "(" b:sqlist s:pointer "(" "*" q:{ "const" } t:pointer ")" f:fn-suffix ")" u:unary
            -> Cast(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)], value: $u)
        | "(" b:sqlist s:pointer "(" "*" q:{ "const" } t:pointer ")" d:[ brackets ] ")" u:unary
            -> Cast(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t), dims: [], fn: [], extra: 0)], value: $u)
        | "(" b:sqlist s:pointer "[" c:integer "]" d:[ brackets ] ")" u:unary
            -> Cast(base: $b, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [], value: $u)
        | "(" b:sqlist s:pointer ")" u:unary
            -> Cast(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [], value: $u)
        | "-" u:unary -> Negate(value: $u)
        | "!" u:unary -> Not(value: $u)
        | "~" u:unary -> Invert(value: $u)
        | "+" u:unary -> Plus(value: $u)
        | "++" p:place -> Update(place: $p, op: "++", value: Number(text: "1"), post: false)
        | "--" p:place -> Update(place: $p, op: "--", value: Number(text: "1"), post: false)
        | "&" p:place -> Addr(place: $p)
        | "*" u:unary -> Deref(value: $u)
        | "_Alignof" "(" typename ")" -> Unsupported(word: "_Alignof")
        | "sizeof" "(" b:sqlist s:pointer "(" "*" q:{ "const" } t:pointer ")" f:fn-suffix ")"
            -> SizeOfType(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [Paren(stars: 1 + size($t), dims: [], fn: [$f], extra: 0)])
        | "sizeof" "(" b:sqlist s:pointer "(" "*" q:{ "const" } t:pointer ")" d:[ brackets ] ")"
            -> SizeOfType(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t), dims: [], fn: [], extra: 0)])
        | "sizeof" "(" b:sqlist s:pointer "[" c:integer "]" d:[ brackets ] ")"
            -> SizeOfType(base: $b, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [])
        | "sizeof" "(" b:sqlist s:pointer ")"
            -> SizeOfType(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [])
        | "sizeof" u:unary                 -> SizeOfExpr(value: $u)
        | postfix .

(* **A subscript builds no node of its own.** C11 6.5.2.1 defines `E1[E2]` as
 * `(*((E1)+(E2)))`, and these actions build exactly that, so indexing is a
 * `Deref` of a `+` and every pass already knows what those are. What made
 * `a[i]` wait was never the brackets: it was the `+`, which has to count in
 * elements, and that is the `types` pass's business and the emit pass's.
 * `2[a]` is therefore `*(2 + a)`, which is C, and `x[0]` on an `int` is a
 * `*` on an `int` and refused as one.
 *
 * **Nor does `->`.** C11 6.5.2.3 defines `E->m` by what `(*E).m` would
 * be, and the action builds that, so a `Member` is always asked of a struct
 * and never of a pointer, and the `*` refuses a `->` on anything that is not
 * a pointer, in its own words. A member is a node, because unlike a
 * subscript it is not something else written differently: which member is
 * the struct's layout to say, and no other node carries a name to look up.
 *
 * `suffixed` has at least one suffix and `postfix` may have none. The place
 * rule wants the first, because a place without a suffix is one of its
 * other three; an expression wants the second. The fold is written twice
 * because a rule cannot both build its first suffix and fold the rest in
 * one list: `$$` needs its base in the list it folds, and `suffix` is that
 * base. The three suffixes are one repetition and not three, because C
 * mixes them freely: `a[i].next->v[2]` is four of them, in one fold.
 *
 * **A postfix `++` or `--` is a suffix too**, since 2026-09-25, for the same
 * reason: `q++->c` and `p++[0]` are C, and a `++` outside the fold would end
 * the chain. What it is a suffix *of* need not be a place, in the grammar: a
 * `++` on a call or on an assignment parses, and the `types` pass refuses it
 * as `cc` does, since `lvalue` is what knows. *)
postfix   = suffixed | primary .
suffixed  = suffix { "[" e:expression "]"
                          -> Deref(value: Binary(op: "+", left: $$, right: $e))
                      | "." n:name  -> Member(value: $$, name: $n)
                      | "->" n:name -> Member(value: Deref(value: $$), name: $n)
                      | "++" -> Update(place: $$, op: "++", value: Number(text: "1"), post: true)
                      | "--" -> Update(place: $$, op: "--", value: Number(text: "1"), post: true)
                      | "(" a:args ")" -> Call(fn: $$, args: $a) } .
suffix    = p:primary "[" e:expression "]"
              -> Deref(value: Binary(op: "+", left: $p, right: $e))
          | p:primary "." n:name  -> Member(value: $p, name: $n)
          | p:primary "->" n:name -> Member(value: Deref(value: $p), name: $n)
          | p:primary "++" -> Update(place: $p, op: "++", value: Number(text: "1"), post: true)
          | p:primary "--" -> Update(place: $p, op: "--", value: Number(text: "1"), post: true)
          | p:primary "(" a:args ")" -> Call(fn: $p, args: $a) .

(* **A call is a suffix**, since ROADMAP 6.14's second part, `(` and the
 * arguments after any postfix expression, C11 6.5.2.2, so `op(5, 3)`,
 * `(*op)(5, 3)`, `table[i](7, 2)` and `pick(1)(10, 4)` are one node,
 * `Call(fn, args)`, whose callee is an expression. Until then it was a
 * name and a `primary` of its own, `Call(name, args)`. *Settled with Hans
 * on 2026-10-01 after both ways were prototyped*: keeping that node and
 * adding a second for every other callee changed 143 lines and made the
 * oracle compile in 34 seconds, and this changed 97 and made it 9. A call
 * by name had been parsed once for each alternative of `suffix` that
 * started with it and failed after it, so a call nested in a call's
 * arguments was parsed a number of times that multiplied with each level:
 * `struct-return-as-argument.c`, four deep, took nine seconds of the
 * suite's twenty, and takes four hundredths now. Each argument is a node of its own for the same reason a parameter is:
 * the emit pass has to know which register it goes in, and that is a fact
 * about the argument's place in the list, which a node can be handed and an
 * expression cannot. *)
primary = integer -> Number(text: $1)
        | character -> Character(text: $1)
        | string { string } -> String(text: $1, more: $2)
        | name    -> Variable(name: $1, lit: [])
        | "_Generic" "(" assignment { "," ( typename | "default" ) ":" assignment } ")" -> Unsupported(word: "_Generic")
        (* **A variadic function's arguments**, since 2026-10-04, C11 7.16,
         * by the four builtins <stdarg.h>'s macros are in `cc`'s headers.
         * `va_list` is a `char *` that `va_start` points at the first
         * argument after the `...`, and `va_arg` reads one from and moves
         * past; `va_end` does nothing, and `va_copy` is an assignment. *)
        | "__builtin_va_start" "(" p:place "," n:name ")" -> VaStart(ap: $p, last: $n)
        | "__builtin_va_arg" "(" p:place "," b:sqlist s:pointer ")"
            -> VaArg(ap: $p, base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [])
        | "__builtin_va_end" "(" p:place ")" -> VaEnd(ap: $p)
        | "__builtin_va_copy" "(" d:place "," v:assignment ")" -> Assign(place: $d, value: $v)
        | literal
        | "(" expression ")" -> $2 .

(* **A compound literal**, C11 6.5.2.5, since ROADMAP 6.13's fourth part: a
 * type in parentheses and an initialiser in braces, which is an object with
 * no name. It is built as a `Variable` holding its object, a `Literal`, in
 * `lit`, so that everything a name is it is too, by the clauses a name
 * already has: a place, so `&` and an assignment take it, an array that
 * decays, a struct copied whole, its `sizeof`. Every other name has `lit`
 * empty. The object is a declaration's with an initialiser in braces, as a
 * `LocalAgg` in a function and a `StaticAgg` at file scope are, and the
 * `locals` pass binds it under a key no C name can spell, worked out from
 * where it is written, which the `Variable` looks up in place of its name.
 * A cast is tried first, in `unary`, and fails at the `{`, where its operand
 * was wanted. The type is a cast's, and an array's first count may be left
 * out, to be what the initialiser reaches. *)
literal = "(" b:sqlist s:pointer "(" "*" q:{ "const" } t:pointer ")" d:[ brackets ] ")" i:initializer
            -> Variable(name: "", lit: [Literal(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [Paren(stars: 1 + size($t), dims: [], fn: [], extra: 0)], unsized: 0, init: $i)])
        | "(" b:sqlist s:pointer "[" c:integer "]" d:[ brackets ] ")" i:initializer
            -> Variable(name: "", lit: [Literal(base: $b, stars: size($s), squals: join(each($s, "{}")), count: int($c), dims: $d, paren: [], unsized: 0, init: $i)])
        | "(" b:sqlist s:pointer "[" "]" d:[ brackets ] ")" i:initializer
            -> Variable(name: "", lit: [Literal(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: $d, paren: [], unsized: 1, init: $i)])
        | "(" b:sqlist s:pointer ")" i:initializer
            -> Variable(name: "", lit: [Literal(base: $b, stars: size($s), squals: join(each($s, "{}")), count: 0, dims: [], paren: [], unsized: 0, init: $i)]) .

args = [ arg { "," b:arg -> $b } ] -> $1 .   (* `-> $1` as for params *)
arg  = e:assignment -> Arg(value: $e) .

(* ------------------------------------------------------------------ *)
(* Pass one: the questions about functions that no order can answer.   *)
(*                                                                     *)
(* Whether a call names a declared function is a question about what   *)
(* came *above*, and the next pass asks it of a thread. Whether a       *)
(* function is defined twice, or declared with two different numbers of *)
(* parameters, is a question about the whole file, and this pass       *)
(* gathers what it needs on the way up and asks at the top. awk needed  *)
(* the gathered table for the call itself, because awk lets a call come *)
(* first; C does not, and the table here is only for the two checks.    *)

%pass functions

  (* **A declaration hands its specifiers down**, since ROADMAP 6.12's
   * second part: `base` in every pass is the `spec` of the `Decls` above,
   * so a declarator reads its words and its type as it did when they were
   * its own field. A struct's members do the same through `MDecls`. The
   * lists this pass gathers at the top are its items' lists joined, and
   * a node with none gives none. *)
  Decls  : down base = $spec
         : down dkind = $kind
         : shape  = flatten($items.shape)
         : dshape = flatten($items.dshape)
         : dname  = flatten($items.dname)
         : fdefs  = flatten($items.fdefs)
         : ginit  = flatten($items.ginit) .
  MDecls : down base = $spec .
  otherwise shape  = []
  otherwise dshape = []
  otherwise dname  = []
  otherwise fdefs  = []
  otherwise ginit  = []

  (* **Whether each function is its file's own**, since 2026-09-29, ROADMAP
   * 6.10, in document order, because C11 6.2.2p4 decides it by what came
   * first: a declaration without `static` takes the linkage of one above
   * it, so `static int f(void);` then `int f(void) { ... }` is internal,
   * and a `static` one after a declaration without it is refused, as `cc`
   * refuses it. The name's first declaration decides and the entry is never
   * changed, which is why `hidden` reads the same whether it is read before
   * the node's own binding or after. A global is declared once here, so
   * its own word is all it has. *)
  thread linkage = empty

  (* **What a declaration's words say**, since ROADMAP 6.12's first part,
   * worked out here so that the `locals` pass can check it: a check cannot
   * read what its own rule computes, and the next pass can. Each is a count
   * of one spelled word in `words`, see `specifiers`. `key` is how many
   * times each of the twelve words of a type was written, in 6.7.2p2's
   * order, and `tname` the type that list is, or "" for a list that is
   * none; a struct's is its tag. `unsup` is the first word whose feature is
   * not in the subset, the three that C11 lets an implementation leave out
   * first, and `pword` the first storage class a parameter may not have.
   * **`long long` is `long`**, since ROADMAP 6.15's first part: eight bytes
   * on this machine, as `long` is, and the same in every place a type is
   * asked about here; `signed char` was `char` already, which is signed on
   * this machine, and stays so. *)
  Base  : stat    = size(split($words, " static ")) > 1
        : tdef    = size(split($words, " typedef ")) > 1
        : sauto   = size(split($words, " auto ")) > 1
        : sreg    = size(split($words, " register ")) > 1
        : sext    = size(split($words, " extern ")) > 1
        : nstore  = (size(split($words, " static ")) - 1) + (size(split($words, " typedef ")) - 1) + (size(split($words, " extern ")) - 1) + (size(split($words, " register ")) - 1) + (size(split($words, " auto ")) - 1) + (size(split($words, " _Thread_local ")) - 1)
        : pword   = at(split(("{}{}{}" of lookup([[true, "static "]], size(split($words, " static ")) > 1, ""), lookup([[true, "typedef "]], size(split($words, " typedef ")) > 1, ""), lookup([[true, "auto "]], size(split($words, " auto ")) > 1, "")), " "), 1)
        : unsup   = at(split(("{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}" of
                                   lookup([[true, "_Complex "]], size(split($words, " _Complex ")) > 1, ""),
                                   lookup([[true, "_Imaginary "]], size(split($words, " _Imaginary ")) > 1, ""),
                                   lookup([[true, "_Atomic "]], size(split($words, " _Atomic ")) > 1, ""),
                                   "",
                                   lookup([[true, "float "]], size(split($words, " float ")) > 1, ""),
                                   lookup([[true, "double "]], size(split($words, " double ")) > 1, ""),
                                   "",
                                   "",
                                   lookup([[true, "union "]], size(split($words, " union ")) > 1, ""),
                                   lookup([[true, "volatile "]], size(split($words, " volatile ")) > 1, ""),
                                   lookup([[true, "restrict "]], size(split($words, " restrict ")) > 1, ""),
                                   lookup([[true, "_Thread_local "]], size(split($words, " _Thread_local ")) > 1, ""),
                                   lookup([[true, "inline "]], size(split($words, " inline ")) > 1, ""),
                                   lookup([[true, "_Noreturn "]], size(split($words, " _Noreturn ")) > 1, ""),
                                   lookup([[true, "_Alignas "]], size(split($words, " _Alignas ")) > 1, "")), " "), 1)
        : key     = "{}{}{}{}{}{}{}{}{}{}{}{}" of
                         size(split($words, " void ")) - 1,
                         size(split($words, " char ")) - 1,
                         size(split($words, " short ")) - 1,
                         size(split($words, " int ")) - 1,
                         size(split($words, " long ")) - 1,
                         size(split($words, " float ")) - 1,
                         size(split($words, " double ")) - 1,
                         size(split($words, " signed ")) - 1,
                         size(split($words, " unsigned ")) - 1,
                         size(split($words, " _Bool ")) - 1,
                         size(split($words, " _Complex ")) - 1,
                         size(split($words, " _Imaginary ")) - 1
        : tname   = lookup([[true, $name]], $name <> "", lookup([[true, "(anonymous)"]], size($def) > 0, lookup([
                                  ["100000000000", "void"],
                                  ["010000000000", "char"],
                                  ["010000010000", "char"],
                                  ["010000001000", "unsigned char"],
                                  ["000000000100", "_Bool"],
                                  ["001000000000", "short"],
                                  ["001100000000", "short"],
                                  ["001000010000", "short"],
                                  ["001100010000", "short"],
                                  ["001000001000", "unsigned short"],
                                  ["001100001000", "unsigned short"],
                                  ["000100000000", "int"],
                                  ["000000010000", "int"],
                                  ["000100010000", "int"],
                                  ["000000001000", "unsigned int"],
                                  ["000100001000", "unsigned int"],
                                  ["000010000000", "long"],
                                  ["000110000000", "long"],
                                  ["000010010000", "long"],
                                  ["000110010000", "long"],
                                  ["000010001000", "unsigned long"],
                                  ["000110001000", "unsigned long"],
                                  ["000020000000", "long"],
                                  ["000120000000", "long"],
                                  ["000020010000", "long"],
                                  ["000120010000", "long"],
                                  ["000020001000", "unsigned long"],
                                  ["000120001000", "unsigned long"]], $key, "")))
        : display = join(split(slice($words, 2, size($words) - 1), "  "), " ") .
  Named : stat    = size(split($words, " static ")) > 1
        : tdef    = size(split($words, " typedef ")) > 1
        : sauto   = size(split($words, " auto ")) > 1
        : sreg    = size(split($words, " register ")) > 1
        : sext    = size(split($words, " extern ")) > 1
        : nstore  = (size(split($words, " static ")) - 1) + (size(split($words, " typedef ")) - 1) + (size(split($words, " extern ")) - 1) + (size(split($words, " register ")) - 1) + (size(split($words, " auto ")) - 1) + (size(split($words, " _Thread_local ")) - 1)
        : pword   = at(split(("{}{}{}" of lookup([[true, "static "]], size(split($words, " static ")) > 1, ""), lookup([[true, "typedef "]], size(split($words, " typedef ")) > 1, ""), lookup([[true, "auto "]], size(split($words, " auto ")) > 1, "")), " "), 1)
        : unsup   = at(split(("{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}" of
                                   lookup([[true, "_Complex "]], size(split($words, " _Complex ")) > 1, ""),
                                   lookup([[true, "_Imaginary "]], size(split($words, " _Imaginary ")) > 1, ""),
                                   lookup([[true, "_Atomic "]], size(split($words, " _Atomic ")) > 1, ""),
                                   "",
                                   lookup([[true, "float "]], size(split($words, " float ")) > 1, ""),
                                   lookup([[true, "double "]], size(split($words, " double ")) > 1, ""),
                                   "",
                                   "",
                                   lookup([[true, "union "]], size(split($words, " union ")) > 1, ""),
                                   lookup([[true, "volatile "]], size(split($words, " volatile ")) > 1, ""),
                                   lookup([[true, "restrict "]], size(split($words, " restrict ")) > 1, ""),
                                   lookup([[true, "_Thread_local "]], size(split($words, " _Thread_local ")) > 1, ""),
                                   lookup([[true, "inline "]], size(split($words, " inline ")) > 1, ""),
                                   lookup([[true, "_Noreturn "]], size(split($words, " _Noreturn ")) > 1, ""),
                                   lookup([[true, "_Alignas "]], size(split($words, " _Alignas ")) > 1, "")), " "), 1) .

  (* **An unprototyped declaration counts nothing**, since 2026-10-04: no
   * shape, since it says no arity, and **no name** either, since a name
   * with no shape would make room for another name's second one in the
   * count below, and `int puts();` beside two arities of `f` would pass.
   *
   * A shape is a name and an arity as one text, so that `positions` can
   * count how many distinct ones there are: more shapes than names means a
   * name with two arities. **A `dshape` is the name and whether it ends in
   * `...`**, since 2026-09-26, counted the same way and kept apart so that
   * each refusal says which of the two differs. *)
  Prototype : internal = lookup([[true, 1]], $ret.stat, 0)
            : shape = lookup([[2, []]], $variadic, ["{}/{}" of $name, size($params)])
            : dshape = lookup([[2, []]], $variadic, ["{}/{}" of $name, $variadic])
            : dname = lookup([[2, []]], $variadic, [$name])
            : fdefs = []
            : hidden  = lookup($linkage, $name, $internal = 1)
            : linkage = bind($linkage, $name, lookup($linkage, $name, $internal = 1))
            ! $ret.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params)
            ! $ret.unsup = "" and $ret.nstore < 2 and ($ret.sauto or $ret.sreg)
                : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $ret.sauto, "register") .
  (* The same of a `FnDecl`, whose return type is `base`, since 2026-10-04. *)
  FnDecl    : internal = lookup([[true, 1]], $base.stat, 0)
            : shape = lookup([[2, []]], $variadic, ["{}/{}" of $name, size($params)])
            : dshape = lookup([[2, []]], $variadic, ["{}/{}" of $name, $variadic])
            : dname = lookup([[2, []]], $variadic, [$name])
            : fdefs = []
            : hidden  = lookup($linkage, $name, $internal = 1)
            : linkage = bind($linkage, $name, lookup($linkage, $name, $internal = 1))
            ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params)
            ! $dkind = "file" and $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg)
                : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $base.sauto, "register")
            (* In a block, since 2026-10-04, the one storage class a
             * function's declaration may have is `extern`. *)
            ! $dkind = "block" and $base.unsup = "" and $base.nstore < 2 and ($base.sauto or $base.sreg or $base.stat)
                : "'{}' is a function declared '{}' in a block, and C11 6.7.1p7 allows a function there no storage class but 'extern'"
                    of $name, lookup([[true, "auto"]], $base.sauto, lookup([[true, "register"]], $base.sreg, "static")) .
  Function  : internal = lookup([[true, 1]], $ret.stat, 0)
            : shape = ["{}/{}" of $name, size($params)]
            : dshape = ["{}/{}" of $name, $variadic]
            : dname = [$name]
            : fdefs = [$name]
            : hidden  = lookup($linkage, $name, $internal = 1)
            : linkage = bind($linkage, $name, lookup($linkage, $name, $internal = 1))
            ! $ret.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params)
            (* **A definition declared `typedef`** is no C, 6.9.1p2; a
             * typedef of a function's type is, and is read as a typedef
             * before a function is tried, since ROADMAP 6.14's fourth part. *)
            ! $ret.unsup = "" and $ret.nstore < 2 and $ret.tdef
                : "'{}' is a function's definition declared 'typedef', which C11 6.9.1p2 forbids" of $name
            ! $ret.unsup = "" and $ret.nstore < 2 and ($ret.sauto or $ret.sreg)
                : "'{}' is declared '{}' at file scope, which C11 6.9p2 forbids" of $name, lookup([[true, "auto"]], $ret.sauto, "register")
            ! size($params) > 0 and size(split((",{}," of join($params.name, ",")), ",,")) > 1
                : "a parameter of a function's definition has a name, C11 6.9.1p5"
            ! size(positions($ids)) < size($ids)
                : "'{}' has a name twice in its list of parameters, C11 6.9.1p6" of $name
            ! size(positions($ids)) = size($ids) and size($ids) > 0 and join($ids, ",") <> join($params.name, ",")
                : "'{}' does not declare one parameter for each name in its list, in the list's order: C11 6.9.1p6 asks for one each, and this subset for the order too" of $name .

  (* **A keyword read only to be refused**, since ROADMAP 6.12's first part:
   * `_Generic` and `_Alignof`, which are expressions; `_Static_assert` was
   * one too, until the second part. It is refused in the first pass so that
   * no later one has to say what such an expression is. *)
  Unsupported ! true : "'{}' is C11's, and not this subset's yet" of $word .

  (* A struct is an item and not a function, and adds nothing to either count. *)
  StructDef : shape = []
            : dshape = []
            : dname = []
            : fdefs = [] .
  Typedef   : shape = []
            : dshape = []
            : dname = []
            : fdefs = [] .
  Global      : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .
  GlobalInit  : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              : ginit  = [$name]
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .
  GlobalAgg   : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              : ginit  = [$name]
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .
  GlobalArray : hidden  = lookup([[true, lookup($linkage, $name, false)]], defined($linkage, $name) and not $base.stat, $base.stat)
              : linkage = bind($linkage, $name, lookup($linkage, $name, $base.stat))
              ! $base.stat and defined($linkage, $name) and not lookup($linkage, $name, false)
                  : "'{}' is declared 'static' after a declaration without it, C11 6.2.2p7" of $name
              ! not $base.stat and not $base.sext and defined($linkage, $name) and lookup($linkage, $name, false)
                  : "'{}' is declared without 'static' after a declaration with it, C11 6.2.2p7" of $name .

  (* Written out rather than named: a check runs before the attributes its
   * rule computes, so it cannot read them, and `phx` says so. *)
  (* **Which globals are initialised somewhere in the file**, since ROADMAP
   * 6.12's second part: C11 6.9.2 makes a declaration without an
   * initialiser a tentative definition, which is the definition only when
   * no other is, and the emit pass writes a global's storage once, at its
   * initialiser if it has one and at its first tentative definition if not.
   * A question about the whole file, so it is gathered here and asked there. *)
  Program : inits = flatten($items.ginit)
          ! size(positions(flatten($items.fdefs))) < size(flatten($items.fdefs))
              : "a function is defined twice"
          ! size(positions(flatten($items.shape))) > size(positions(flatten($items.dname)))
              : "a function is declared with two different numbers of parameters"
          ! size(positions(flatten($items.dshape))) > size(positions(flatten($items.dname)))
              : "a function is declared with '...' in one place and without it in another" .

(* ------------------------------------------------------------------ *)
(* Pass two: which local is which, where does it live, and what is it? *)
(*                                                                     *)
(* A local lives at a **byte offset** below its function's frame        *)
(* pointer, and the frame is how many bytes the function needs. It was  *)
(* a numbered slot until arrays arrived: `int a[10]` is forty bytes and *)
(* one slot cannot hold it, so a declaration's type reaches the frame   *)
(* here for the first time.                                             *)
(*                                                                     *)
(* Everything is given a multiple of eight and started on one. An       *)
(* `int` is four bytes and takes eight, which wastes half of every      *)
(* scalar and is what the frame did anyway when a slot was eight. The   *)
(* alternative, packing each thing at its own width, is not observable  *)
(* by any program: the distance between two **separate** objects is not *)
(* something C defines, and the distance between two elements of one    *)
(* array is the element's width either way. So the cheaper rule is the  *)
(* one that is kept. A struct's members are laid out by another rule,   *)
(* below, because the distance between two of them is measurable.       *)
(*                                                                     *)
(* A name means **five** things: where it lives, how many stars stood   *)
(* in front of it, how many elements it has, zero meaning it is not an  *)
(* array, how wide the thing at the bottom of the stars is, 4 for an    *)
(* `int`, 1 for a `char` and the struct's size for a struct, and which  *)
(* struct that is, or "" for none. All five go in one table rather than *)
(* in five side by side, because a second table would need the same     *)
(* `down` at a function and the same save-and-restore at a block, and   *)
(* two copies of a scope rule are two chances to disagree about what a  *)
(* scope is.                                                            *)
(*                                                                     *)
(* The width is `basew` here and `width` in the `types` pass, which     *)
(* reads it off a name and carries it through every expression, and the *)
(* struct is `tagname` here and `tag` there. Two names each because two *)
(* passes defining one attribute is a thing `phx` warns about, rightly. *)
(*                                                                     *)
(* **A struct's layout is worked out here too**, because a member is    *)
(* laid out by the same walk in document order that lays out a frame:   *)
(* each member starts at the first offset after the one before it that  *)
(* its own alignment allows, which is C11 6.7.2.1 and the ABI together, *)
(* and the struct is as long as that rounded up to its widest member's  *)
(* alignment. The frame rounds everything to eight and a struct cannot, *)
(* because the distance between two members of **one** object is a     *)
(* thing a program can measure, with `sizeof` and with `&`.             *)

%pass locals

  (* **Tags in scope**, since ROADMAP 6.12's third part, when a struct could
   * be defined in a block: a tag's name to its **key**, the name of its
   * layout in `layouts`. A struct defined at file scope is keyed by its tag,
   * as every struct was before; one defined in a function, or with no tag,
   * by the tag and a number counted across the file, `node.3` or
   * `(anonymous).4`, which no C tag can spell, so that a block's `struct s`
   * and the file's are two types, as C11 6.2.1 makes them. `tscope` is the
   * tags declared in the scope being walked, which is where a second
   * definition is refused. A block and a function keep and restore both,
   * and the typedefs, as they do the names. *)
  thread tags   = empty

  (* **Where an initialiser has got to**, since ROADMAP 6.13's first part:
   * `icur` is the offset in the object the next value goes to, and `iend`
   * the end of the last one written, so that the bytes between are zeros. *)
  thread icur = 0
  thread iend = 0
  (* Whether a value went back past one already written, which a global's
   * data cannot do, see `GlobalAgg` in the emit pass. *)
  thread iback = false

  (* **A struct's members in order**, since ROADMAP 6.13's second part, kept
   * in its layout as a fifth part, so that an initialiser can go member by
   * member; `fields` is keyed by name and has no order to give. *)
  thread mlist = []
  thread tscope = empty
  thread tagn   = 0

  (* **What a `for` may declare**, C11 6.8.5p3: objects that are `auto` or
   * `register`, and so no `static`, `extern` or `typedef`, which `cc`
   * refuses as C23's. `dkind` tells a declarator it is in one. *)
  (* **`struct s;` declares a struct in this scope**, C11 6.7.2.3p7,
   * since ROADMAP 6.12's third part: in a block it is a new type, which
   * hides one of the same tag outside until it is defined here or the block
   * ends. A declaration of no names whose specifiers are a struct's tag and
   * no definition is one; the words say it is a struct before `def` is
   * asked, since a typedef's name has none. *)
  Decls  : down base = $spec
         : down dkind = $kind
         : fwd    = size($items) = 0 and size(split($spec.words, " struct ")) > 1 and size($spec.def) = 0
         : fresh  = $fwd and not defined($tscope, $spec.name)
         : tags   = lookup([[true, bind($tags, $spec.name, lookup([[true, "{}.{}" of $spec.name, $tagn]], $infunc, $spec.name))]],
                           $fresh, $tags)
         : tscope = lookup([[true, bind($tscope, $spec.name, true)]], $fwd, $tscope)
         : tagn   = lookup([[true, $tagn + 1]], $fresh, $tagn)
         ! $kind = "for" and ($spec.stat or $spec.tdef or size(split($spec.words, " extern ")) > 1)
             : "a 'for' declares only objects that are 'auto' or 'register', C11 6.8.5p3" .

  (* **A static assertion's names** are the file's when it is an item, as a
   * global's initialiser's are, and the block's when it is a statement. *)
  StaticAssert : down env = lookup([[true, $globals]], $file, $env) .
  MDecls : down base = $spec
         : mconst = flatten($items.mconst)
         : mruns  = join($items.mrun) .

  (* **What a constant's text says**, since 2026-09-27: its suffix, its
   * base and its digits, read here and not in `types`, because a check
   * there reads them before the value they guard is worked out. A letter
   * `u` or `l` anywhere in it is a suffix, since no hex digit is one. *)
  Number : iszero  = $text = "0"
         : ihasu   = size(split($text, "u")) > 1 or size(split($text, "U")) > 1
         : ihasl   = size(split($text, "l")) > 1 or size(split($text, "L")) > 1
         : ibody   = slice($text, 1, size($text) - lookup([[true, 1]], $ihasu, 0) - (size(split($text, "l")) - 1) - (size(split($text, "L")) - 1))
         : ihex    = slice($ibody, 1, 2) = "0x" or slice($ibody, 1, 2) = "0X"
         : ioct    = not $ihex and slice($ibody, 1, 1) = "0" and size($ibody) > 1
         : idec    = not $ihex and not $ioct
         : idigits = lookup([[true, slice($ibody, 3, size($ibody))]], $ihex, $ibody)
         : ndigits = size($idigits)
         (* An octal constant with an 8 or a 9 is refused by the `types`
          * pass, and is not read here as one. *)
         : ebad    = $ioct and (size(split($idigits, "8")) > 1 or size(split($idigits, "9")) > 1)
         : eok     = $ndigits <= 15 and not $ebad
         : ev      = int(lookup([[true, "0"]], $ebad, slice($idigits, 1, 15)), lookup([[true, 16]], $ihex, lookup([[true, 8]], $ioct, 10)))
         (* Whether it is unsigned, for `eu` below: a `u`, or a hex or
          * octal constant past an `int`, C11 6.4.4.1p5. *)
         : eu      = $ihasu or (not $idec and $ev > 2147483647) .

  (* The table is a thread, because *what has been declared so far* is what
   * a walk in document order has. All three are set afresh at each function
   * by a `down` clause, which is what makes a thread nest.
   *
   * `env` is every name in sight and `scope` is only this block's, and they
   * answer different questions: a read asks the first, and a declaration
   * asks the second, because C11 6.2.1 lets an inner block declare a name
   * the outer one already has. One table cannot answer both -- the first
   * version of this pass had one, and refused `{ int x = 1; { int x = 2; } }`
   * as declared twice. *)
  thread env   = empty
  thread scope = empty
  thread bytes = 0
  (* The name a declaration is initialising, while its initialiser is
   * walked, where the declaration cannot bind it first, since the probe of
   * Proem's source on 2026-10-02: see `LocalInit`. *)
  thread ownname = ""
  (* What a declarator in parentheses binds early, see `LocalInit`: the
   * name and the entry's fields but the three its type text gives, for
   * the `Paren` to finish. A name of "" is none. *)
  thread pown = ["", false, 0, "", false, false, false, "", "", false]

  (* Which register a parameter arrives in is its **position**, which a byte
   * offset no longer says. It said it while every declaration was one slot
   * and parameter k was slot k; now it is counted on its own. *)
  thread pindex = 0

  (* The functions declared so far, name to its arity and whether it ends in
   * `...`, 1 or 0, since 2026-09-26. A definition binds itself
   * on the way *in*, with a `down` clause, so that its own body can call it;
   * the value flows on to the functions after it, which is what a `down` on
   * a thread does when nothing restores it. A prototype binds on the way
   * out, which for a node with no body is the same moment. *)
  thread funcs = empty
  (* **The functions known only from a declaration in a block**, since
   * 2026-10-05, name to `true`. Such a declaration is in force to its
   * block's end, C11 6.2.1p4, and while it is it has an entry in `env`
   * as a function's name, which the block puts back; its count and its
   * types still go in `funcs` and the tables beside it, which the passes
   * after this one read whole, and a name here is not looked up there.
   * A declaration at file scope makes it `false`, and every declaration
   * of a function binds it, so a name not here is in no file scope's. *)
  thread fblock = empty

  (* **The globals declared so far**, since 2026-09-26, ROADMAP 6.8, each
   * the entry a local's is, with `true` for the sixth field, which says
   * *global* to the emit pass, and a seventh, whether it was initialised.
   * The offset is 0 and unused: a global is reached by its name. The thread
   * is never reset, and **a function starts its `env` from it** instead of
   * from `empty`, so a local or a parameter hides a global exactly as a
   * block's local hides an outer one, and a function above a global does
   * not see it, which is C11 6.2.1's order. *)
  thread globals = empty

  (* Only a name can be a global; everything else a `&` can be asked of is
   * not one, which the `constants` pass reads to tell `&answer` from
   * `&table[1]`. *)
  otherwise global = false

  (* **Whether a name was declared `register`**, since ROADMAP 6.12's first
   * part, the eleventh part of an entry: C11 6.5.3.2p1 forbids its address,
   * and only a name can be one, so every other place a `&` is asked of is
   * not. A member of a `register` struct is not followed, and `&r.m` is a
   * refusal `cc` makes and this does not; never a false one. *)
  otherwise vreg = false
  Addr : known = $layouts
       ! $place.vreg
           : "'{}' is declared 'register', and C11 6.5.3.2p1 forbids taking its address" of $place.name .

  (* **What each function takes**, name to a list with one entry per
   * parameter: the tag of a struct passed whole, or "". Bound on the way out,
   * when the parameters have been worked out, which a `down` clause cannot
   * wait for; so this is not what a call checks its arity against, and the
   * `types` pass is handed the whole of it, at the root, to check a call's
   * arguments with. A call above its callee's declaration is refused anyway. *)
  thread sigs = empty

  (* **Every label in the program**, as the function's name and the label's
   * together, since 2026-09-25. A label belongs to its function, C11 6.2.1,
   * and to a name space of its own, 6.2.3, so it is never in `env` and
   * `x: x++;` names two different things. It is gathered on the way out and
   * handed to the `types` pass from the root, as `sigs` is, which is what
   * lets a `goto` name a label further down. *)
  thread labels = empty

  (* **What each function returns**, name to three things: the tag of the
   * struct at the bottom, or ""; its width, 4 for an `int`; and how many
   * stars are on top, since 2026-09-25. They are the three an expression's
   * type is, so a call reads its own off this without working anything
   * out. Bound on the way out, as `sigs` is and
   * for its reason: the return type is a child, worked out after a `down`
   * clause runs. So the `types` pass is handed the whole table at the root,
   * which is also what lets a function's own body call it. *)
  thread rets = empty

  (* **Which parameters are `long`s**, name to one boolean per parameter,
   * bound and handed on the way `sigs` is. A caller converts what it passes
   * to the parameter's type, C11 6.5.2.2p7, and an `int` put in a `long`
   * parameter has to be sign-extended into the whole register first: the
   * emit pass reads this at each call. *)
  thread pwidths = empty

  (* **Each parameter's type**, name to one level text per parameter, since
   * 2026-10-04, bound and handed on the way `sigs` is: the `constants`
   * pass gives an argument the initialiser's check of a pointer to a
   * function against it. *)
  thread plvs = empty

  (* **The struct layouts defined so far**, tag to size, alignment and a
   * table of members. It starts with `int`, `char` and `long` in it, as three
   * structs with no members, and that is what lets `Base` answer a width with one
   * lookup whatever it names: the keyword and the tag are asked the same
   * question of the same table. It is keyed by a struct's **key**, see
   * `tags` above, which no two definitions share, so it is never reset and
   * flows from each definition to everything after it; which definition a
   * tag means in a scope is `tags`' question, not this table's.
   *
   * **`void` is the fourth**, since 2026-09-26, ROADMAP 6.7, and unlike the
   * other three it keeps its name as its tag: see `Base`. So a `void` value
   * is a `record` to the `types` pass, no stars and a tag, and every place
   * that refuses a struct where C wants a number refuses it too, which is
   * C11 6.3.2.2's rule that a void expression's value is never used. It is
   * nought bytes wide, which is what makes `void *` arithmetic something to
   * refuse rather than to count in. No struct can take the tag, because
   * `void` is reserved the moment `base` names it.
   *
   * *The width has no witness, and cannot have one*: arithmetic, `*` and
   * `sizeof` are the three that would read it, and each refuses a `void`
   * by name. Made four, the oracle and every refusal stayed green. *)
  thread layouts = [["int", [4, 4, empty, false]], ["char", [1, 1, empty, false]],
                    ["long", [8, 8, empty, false]], ["void", [0, 1, empty, false]],
                    ["unsigned int", [4, 4, empty, false]], ["unsigned char", [1, 1, empty, false]],
                    ["unsigned long", [8, 8, empty, false]],
                    ["short", [2, 2, empty, false]], ["unsigned short", [2, 2, empty, false]],
                    ["_Bool", [1, 1, empty, false]]]

  (* **The typedefs so far**, name to the four things a declaration asks
   * of its base: a width, an alignment, a tag, and how many stars the typedef
   * already has. A block keeps and restores it, since a typedef may be
   * declared in one since ROADMAP 6.12's third part. The parse
   * has already decided which names are typedefs, with `%names`; this is what
   * each one *means*, which the parse has no way to hold. *)
  thread typedefs = empty

  (* The three a struct's members are laid out by, each set afresh by the
   * struct being defined: the members so far, the offset the next one may
   * start at, and the widest alignment seen. A member's entry is the same
   * five things a name's is, so that a member and a name are read alike. *)
  thread fields = empty
  thread moff   = 0
  thread malign = 1

  (* Which struct is being defined, so that it may point at itself. A struct
   * is not complete until its `}`, C11 6.7.2.1, so `struct node` inside its
   * own definition has no size and cannot be a member; a **pointer** to one
   * needs no size, and a linked list is made of exactly that. *)
  (* **A long run of dots**, since ROADMAP 6.13's third part: 32768 of them,
   * made by doubling, so that a run of any character n long is a slice of
   * it split at the dots and joined with that character. A struct's byte
   * map is made of such runs. *)
  Program : down defining = ""
          : down callpos  = false
          : down infunc   = false
          : down dd0 = "........"
          : down dd1 = "{}{}" of $dd0, $dd0
          : down dd2 = "{}{}" of $dd1, $dd1
          : down dd3 = "{}{}" of $dd2, $dd2
          : down dd4 = "{}{}" of $dd3, $dd3
          : down dd5 = "{}{}" of $dd4, $dd4
          : down dd6 = "{}{}" of $dd5, $dd5
          : down dd7 = "{}{}" of $dd6, $dd6
          : down dd8 = "{}{}" of $dd7, $dd7
          : down dd9 = "{}{}" of $dd8, $dd8
          : down dd10 = "{}{}" of $dd9, $dd9
          : down dd11 = "{}{}" of $dd10, $dd10
          : down dd12 = "{}{}" of $dd11, $dd11
          : down dots = $dd12
          : allsigs = $sigs
          : alllabels = $labels
          : allrets = $rets
          : allpwidths = $pwidths
          : allplvs = $plvs
          : allfuncs = $funcs .

  (* A struct's layout is bound on the way out, when every member has been
   * placed. The check for a second definition runs before that, and so sees
   * the table without this one in it. A struct with no members is refused
   * by name: C11 6.7.2.1 wants at least one, and this `cc` takes `{}` as an
   * extension with a `sizeof` of 0, so it is a program both would compile
   * and answer differently, the way `int a[0]` is. *)
  (* **Its key is worked out on the way in**, since ROADMAP 6.12's third
   * part, so that a member that points at the struct finds it: a tag this
   * scope has declared already keeps the key it was given, `struct s;` then
   * `struct s { ... }`; one defined in a function is numbered, and so is one
   * with no tag. A second definition in one scope is refused; one in an
   * inner scope is another type, and hides the first until the scope ends. *)
  StructDef : down skey     = lookup([[true, lookup($tags, $name, $name)]], $name <> "" and defined($tscope, $name),
                                     lookup([[true, "(anonymous).{}" of $tagn]], $name = "",
                                            lookup([[true, "{}.{}" of $name, $tagn]], $infunc, $name)))
            : down tagn     = $tagn + 1
            : down tags     = bind($tags, $name, $skey)
            : down defining = $skey
            : down fields   = empty
            : down moff     = 0
            : down malign   = 1
            : down mlist    = []
            : mykey   = $skey
            : tags    = bind($tags, $name, $skey)
            : tscope  = bind($tscope, $name, true)
            : ssize   = (($moff + $malign - 1) div $malign) * $malign
            : smap    = "{}{}" of join($members.mruns), join(split(slice($dots, 1, $ssize - $moff), "."), "~")
            : layouts = bind($layouts, $skey,
                             [$ssize, $malign, $fields, size(flatten($members.mconst)) > 0, $mlist,
                              $smap, $ssize < 32768 and size($mlist) < 86])
            ! $name <> "" and defined($tscope, $name)
                and at(lookup($layouts, lookup($tags, $name, ""), [0, 1, empty, false]), 1) > 0
                : "'struct {}' is defined twice" of $name
            ! size($members) = 0
                : "'struct {}' has no members, which C11 6.7.2.1 forbids and this cc allows as an extension"
                    of $name .

  (* What a declaration's base is worth: a width, an alignment, and the tag
   * or "". A struct's tag is its **key**, `tkey`, found in `tags`, or the
   * key its own definition was given when it has one; a tag nothing has
   * declared is taken to be the file's. One that is not complete where it
   * is named answers the default, a width of 0, which no complete type has
   * and which everything below reads as *not complete here*: a pointer to it
   * is C, and an object of it is refused where it is declared, since
   * ROADMAP 6.12's third part. Until then a tag nothing defined was refused
   * wherever it was named. A struct defined inside another leaves the outer
   * one's members as they were, which is what `hfields` keeps. *)
  (* A typedef is its base and its stars, worked out once here and read by
   * every declaration that names it. C11 6.7p3 lets a typedef be declared
   * again **to the same type**, so a second one is refused only when it
   * says something different. *)
  Typedef : down dbase   = $base
          : down dstars  = $stars
          : down inparen = false
          : down pP      = ""
          : down pouter  = $dims
          : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]], size($paren), join($paren.t))
          : lv     = lookup([[0, $lvin]], $count, "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin)
          : means    = [$base.basew, $base.align, $base.tagname, lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8), $base.buns,
                        ("{}{}" of $base.bquals, $squals), $lv]
          : typedefs = bind($typedefs, $name, $means)
          : scope    = lookup([[true, bind($scope, $name, true)]], $dkind = "block", $scope)
          (* **Not a typedef of `void` itself**, since 2026-09-26: C allows
           * one, and nothing here has needed it. `typedef void *vp;` is a
           * pointer and is allowed. *)
          ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
              : "'{}' is a typedef of 'void', which is C and is not here yet; a typedef of 'void *' is" of $name
          ! $dkind = "file" and defined($globals, $name)
              : "'{}' is a global already, and a typedef and a global share one name space, C11 6.2.3" of $name
          (* **A second typedef of one name** is refused when it names
           * another type in the same scope, and hides the first in an inner
           * one. A struct is compared by its key, since its width may have
           * been unknown at one of the two, see `Base`. *)
          ! $dkind = "block" and defined($scope, $name) and not defined($typedefs, $name)
              : "'{}' is declared twice" of $name
          ! ($dkind = "file" or defined($scope, $name)) and defined($typedefs, $name)
              and [at(lookup($typedefs, $name, empty), 3), at(lookup($typedefs, $name, empty), 4),
                   at(lookup($typedefs, $name, empty), 5), at(lookup($typedefs, $name, empty), 6)]
                  <> [$base.tagname, $stars + $base.ptrs, $base.buns, "{}{}" of $base.bquals, $squals]
              : "'{}' is a typedef twice, for two different types" of $name
          ! ($dkind = "file" or defined($scope, $name)) and defined($typedefs, $name)
              and (at(lookup($typedefs, $name, empty), 3) = "" or at(lookup($typedefs, $name, empty), 3) = "void")
              and at(lookup($typedefs, $name, empty), 1) <> $base.basew
              : "'{}' is a typedef twice, for two different types" of $name .

  (* **A declaration's stars are its own and its typedef's**: `intp *q` with
   * `typedef int *intp` is two. A base that is a keyword or a tag has none,
   * and `ptrs` is the sum every declaration below reads in place of its
   * `stars` field. *)
  Named : means   = lookup($typedefs, $name, lookup([["__builtin_va_list", [1, 1, "", 1, false, "00", "p:8:0:8|b:1:0:1"]]], $name, [4, 4, "", 0, false, "0", "b:4:0:4"]))
        : tq      = at($means, 6)
        : bquals  = "{}{}" of lookup([[true, slice($tq, 1, size($tq) - 1)]], size($tq) > 1, ""),
                              lookup([[true, "1"]], size(split($words, " const ")) > 1 or slice($tq, size($tq), size($tq)) = "1", "0")
        : hasconst = at(lookup($layouts, at($means, 3), [0, 1, empty, false]), 4)
        : buns    = at($means, 5)
        : sized   = at($means, 3) <> "" and at($means, 3) <> "void"
        : basew   = lookup([[true, at(lookup($layouts, at($means, 3), [0, 1, empty, false]), 1)]], $sized, at($means, 1))
        : align   = lookup([[true, at(lookup($layouts, at($means, 3), [0, 1, empty, false]), 2)]], $sized, at($means, 2))
        : tagname = at($means, 3)
        : ptrs    = at($means, 4)
        : mlv     = at($means, 7)
        : mlast   = at(split($mlv, "|"), size(split($mlv, "|")))
        : blv     = lookup([[true, "{}b:{}:0:{}:{}" of slice($mlv, 1, size($mlv) - size($mlast)), $basew, $align, at($means, 3)]],
                           $sized and int(at(split($mlast, ":"), 2)) = 0, $mlv)
        ! $unsup <> ""
            : lookup([["_Atomic", "'_Atomic' is optional in C11, and left out here, as __STDC_NO_ATOMICS__ says"]],
                     $unsup, "'{}' is C11's, and not this subset's yet" of $unsup)
        ! $unsup = "" and $nstore > 1
            : "this declaration has {} storage classes, and C11 6.7.1p2 allows one" of $nstore .

  (* **A level of a type is text**, since ROADMAP 6.12's fourth part,
   * settled on 2026-09-30 after this and a list were both prototyped: one
   * field a level, `kind:size:count:align`, joined by `|`, the base last.
   * `p:8:0:8` is a pointer, `a:24:2:4` an array of two things of twelve
   * bytes each, `b:4:0:4` an `int`. A declarator's text is its `lv`: the
   * base's `blv` with its stars in front, then its brackets and its
   * parentheses, inside out, as C11 6.7.6 builds a type. Each level is
   * made with its size in it, so no size is ever a product of a list.
   *
   * **The brackets after a declarator's first** are a chain of `Dim`s,
   * each the array of what the one inside it is; the innermost is the
   * array of the declarator's stars and base, or, inside parentheses, of
   * what the parentheses stand in for. A `Paren` is that: its own stars in
   * front of the brackets outside it, which are walked before it, since
   * a node's children are walked in the order its fields are written, and
   * a value handed down is worked out as the node is entered. *)
  Dim   : delem = lookup([[true, $pP]], $inparen, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $dstars, ""), $dbase.blv))
        : dinner = lookup([[0, $delem]], size($of), join($of.t))
        : t     = "a:{}:{}:{}|{}" of $count * int(at(split(at(split($dinner, "|"), 1), ":"), 2)), $count, int(at(split(at(split($dinner, "|"), 1), ":"), 4)), $dinner
        ! $count < 1
            : "an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension" .
  Paren : down inparen = true
        : down pheld   = $pown
        (* A `)` too many or too few after a `*` in parentheses inside
         * another's: see `pstar`. *)
        ! $extra > 0 : "a declarator has a ')' with no '(' before it"
        ! $extra < 0 : "a declarator has a '(' with no ')' after it"
        : down sigkey  = "fn.{}.{}" of $pos.line, $pos.column
        : down pP = "{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""),
                              lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $dstars, ""), $dbase.blv)]], size($pouter), join($pouter.t))]], size($fn), ("b:1:0:1::fn.{}.{}" of $pos.line, $pos.column))
        : t = lookup([[0, $pP]], size($dims), join($dims.t))
        (* **The early entry of a declarator in parentheses**, since
         * 2026-10-05: its type text is this, worked out here, before the
         * initialiser after it is walked, so the name is bound here, into
         * the thread the initialiser is walked with, and `pown` emptied,
         * since a cast or a `sizeof` in it may have a `Paren` of its own.
         * See `LocalInit`. *The star count in the entry has no witness*,
         * as the early entry's without parentheses has none: what reads a
         * name's type in its initialiser reads the text. One in a
         * parameter of this one's sees `pown` too, and what it binds a
         * `Sig` puts back. *)
        : pnone  = at($pheld, 1) = ""
        : ptakes = ((int(at(split(at(split($t, "|"), 1), ":"), 2)) + 7) div 8) * 8
        : pptrs  = lookup([[true, size(at(split($t, "a:"), 1)) div 8]], size(at(split($t, "a:"), 1)) < size(at(split($t, "b:"), 1)), size(at(split($t, "b:"), 1)) div 8)
        : env    = lookup([[true, $env]], $pnone, bind($env, at($pheld, 1), [lookup([[true, $bytes + $ptakes]], at($pheld, 2), 0), $pptrs, 0,
                          at($pheld, 3), at($pheld, 4), at($pheld, 5), at($pheld, 6), at($pheld, 7), at($pheld, 8), at($pheld, 9), at($pheld, 10), $t]))
        : bytes  = lookup([[true, $bytes + $ptakes]], not $pnone and at($pheld, 2), $bytes)
        : pown   = ["", false, 0, "", false, false, false, "", "", false] .

  (* **A pointer to a function**, since ROADMAP 6.14's first part: the
   * `Paren` it is written in points at a level of its own, the function,
   * which is a base, `b:1:0:1::KEY`, a sixth field holding a key and the
   * fifth, a struct's, empty. Being a base is what lets every clause that
   * counts a type's levels count this one's, and the key is what a call
   * through it will read: the function's parameters and what it returns,
   * bound under the key in the four tables a call by name reads under the
   * callee's name. A function declared by name is its own key, see
   * `Variable`; one a declarator writes is keyed by where it is written,
   * `fn.8.25`, which no C name can spell. What it returns is the
   * declarator's base and stars. Its parameters are walked as a
   * prototype's are, and take no slot and no name in the scope they are
   * written in, so what they change is put back. *The frame's byte count
   * has no witness*: not put back, it makes a frame larger and every offset
   * still right, and no program can tell. *)
  Sig : down hsenv    = $env
      : down hsscope  = $scope
      : down hsbytes  = $bytes
      : down hspindex = $pindex
      : down scope    = empty
      : down pindex   = 0
      : env     = $hsenv
      : scope   = $hsscope
      : bytes   = $hsbytes
      : pindex  = $hspindex
      : funcs   = bind($funcs, $sigkey, [size($params), $variadic])
      : sigs    = bind($sigs, $sigkey, $params.passes)
      : rets    = bind($rets, $sigkey, [$dbase.tagname, $dbase.basew, $dstars + $dbase.ptrs, $dbase.buns,
                                         ("{}{}" of $dbase.bquals, slice("000000000000", 1, $dstars)),
                                         ("{}{}" of slice("p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|", 1, 8 * $dstars), $dbase.blv)])
      : pwidths = bind($pwidths, $sigkey, $params.pwide)
      : plvs    = bind($plvs, $sigkey, $params.lv) .

  SizeOfType : down dbase   = $base
             : down dstars  = $stars
             : down inparen = false
             : down pP      = ""
             : down pouter  = $dims
             : lvin = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]], size($paren), join($paren.t))
             : lv   = lookup([[0, $lvin]], $count, "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin)
             : ptrs = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8) .
  (* **`va_start` names the last parameter of a function with a `...`**,
   * C11 7.16.1.4, since 2026-10-04; `cc` refuses one in a function without
   * a `...` and warns of another name, which is refused here. `va_arg`'s
   * type is worked out as a `sizeof`'s is. *)
  otherwise fvar  = 0
  otherwise flast = ""
  VaStart ! $fvar <> 1
              : "'va_start' is used in '{}', which has no '...', C11 7.16.1.4p1" of $fn
          ! $fvar = 1 and $last <> $flast
              : "'va_start' names '{}', and C11 7.16.1.4p4 wants the last parameter, '{}'" of $last, $flast .
  VaArg      : down dbase   = $base
             : down dstars  = $stars
             : down inparen = false
             : down pP      = ""
             : down pouter  = $dims
             : lvin = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]], size($paren), join($paren.t))
             : lv   = lookup([[0, $lvin]], $count, "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin)
             : known = $layouts
             : dquals = "{}{}" of $base.bquals, $squals
             : ptrs = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8) .
  Cast       : known = $layouts
             : down dbase   = $base
             : down dstars  = $stars
             : down inparen = false
             : down pP      = ""
             : down pouter  = $dims
             : lvin = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]], size($paren), join($paren.t))
             : lv   = lookup([[0, $lvin]], $count, "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin)
             : ptrs = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
