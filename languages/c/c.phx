                              size($paren), join($paren.t))
            : lv     = $lvin
            : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
            : basew  = $base.basew
            : dquals = "{}{}" of $base.bquals, $squals
            : takes  = lookup([[true, 0]], $base.sext or $lfnty, ((int(at(split(at(split($lv, "|"), 1), ":"), 2)) + 7) div 8) * 8)
            : offset = $bytes + $takes
            : env    = lookup([[true, bind($env, $name, [0, 0, 0, 1, "", true, false, false, $name, "0", false, "b:1:0:1::{}" of $name])]], $lfnty, bind($env, $name, lookup([[true, [0, $ptrs, 0, $basew, $base.tagname, true, false, $base.buns, $name, $dquals, false, $lv]]],
                                               $base.sext,
