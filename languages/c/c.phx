               : "{} is given a pointer to a function of another type, and a call through it would pass and return what the wrong type says" of ("'{}'" of $iname)
           ! (slice($leaf, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $leaf), "|"), 2)), ":"), 6) <> "") and not (at(split(("{}::::::" of at(split($value.xlv, "|"), 1)), ":"), 6) <> "" or (slice($value.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $value.xlv), "|"), 2)), ":"), 6) <> "")) and $value.type > 0 and not $value.npc
               : "{} is given a pointer to something that is not a function, where a pointer to a function goes" of ("'{}'" of $iname)
           ! slice($leaf, 1, 1) = "p" and not (slice($leaf, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $leaf), "|"), 2)), ":"), 6) <> "") and (at(split(("{}::::::" of at(split($value.xlv, "|"), 1)), ":"), 6) <> "" or (slice($value.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $value.xlv), "|"), 2)), ":"), 6) <> ""))
               : "{} is given a pointer to a function, where a pointer to something else goes, which C11 6.3.2.3 does not convert" of ("'{}'" of $iname)
           ! slice($leaf, 1, 1) = "b" and at(split(("{}::::::" of at(split($leaf, "|"), 1)), ":"), 6) = "" and not $value.record and (at(split(("{}::::::" of at(split($value.xlv, "|"), 1)), ":"), 6) <> "" or (slice($value.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $value.xlv), "|"), 2)), ":"), 6) <> ""))
               : "{} is given a pointer to a function, where a number goes" of ("'{}'" of $iname)
           ! $top and not $fillo
               : "'{}' is an array, initialised with a list in braces or, if it is of 'char', a string, C11 6.7.9p16" of $iname
           ! $fill and $iroom > 0 and $value.slen > $iroom
               : "'{}' is initialised with a string longer than it, C11 6.7.9p2" of $iname
           ! $tbad = "END"
               : "'{}' is given more initialisers than it has room for, C11 6.7.9p2" of $iname
           ! $tbad = "DEEP"
