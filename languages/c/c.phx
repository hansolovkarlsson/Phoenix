  (* **A function returns an `int`, a `long`, a struct or a pointer.** A
   * struct is returned whole, since 2026-09-23, and a pointer since
   * 2026-09-25: its stars are the function's own and its typedef's, summed
   * as a declaration's are, into `rptrs`. A `char` is refused by name,
   * because nothing narrows `x0` on the way out, and it is C that `cc`
   * compiles. **A pointer to a struct has a tag and is not a struct**, so
   * every question below and in the emit pass that asks whether a function
   * returns a struct asks for no stars as well. `main` returning a struct is refused as well, although C11
   * 5.1.2.2.1 leaves room for it and `cc` compiles it with a warning: what
   * the shell then sees is whatever the struct left in `w0`, which is an
   * exit status neither compiler means and the oracle could not compare.
   *
   * A second declaration has to say the same thing as the first, which is
   * C11 6.7p4. *)
  (* The functions a typedef of their type declares, and since
   * 2026-10-04 those declared in a block, each with its count, which the
   * `functions` pass cannot see: see `Global`, below. *)
  thread tdfns = empty
  Prototype : rlv   = lookup([[0, "{}{}" of slice("p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|", 1, 8 * $stars), $ret.blv]], size($rparen), join($rparen.t))
            : rptrs = lookup([[0, $stars + $ret.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1))
            : down dbase   = $ret
            : down dstars  = $stars
            : down inparen = false
            : down pP      = ""
            : down pouter  = []
          : down env    = empty
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : fblock = bind($fblock, $name, false)
            : funcs = lookup([[true, $funcs]], $variadic = 2 and defined($funcs, $name), bind($funcs, $name, [size($params), $variadic]))
            : sigs  = lookup([[true, $sigs]], $variadic = 2 and defined($sigs, $name), bind($sigs, $name, $params.passes))
            : rets  = bind($rets, $name, [lookup([[0, $ret.tagname]], size($rparen), ""), $ret.basew, $rptrs, $ret.buns, ("{}{}" of $ret.bquals, $squals), $rlv])
            : pwidths = lookup([[true, $pwidths]], $variadic = 2 and defined($pwidths, $name), bind($pwidths, $name, $params.pwide))
            : plvs    = lookup([[true, $plvs]], $variadic = 2 and defined($plvs, $name), bind($plvs, $name, $params.lv))
            ! defined($tdfns, $name) and lookup($tdfns, $name, [0, 0]) <> [size($params), $variadic]
              and $variadic <> 2 and at(lookup($tdfns, $name, [0, 0]), 2) <> 2
                : "'{}' is declared twice, with a different number of parameters or '...' each time" of $name
            ! defined($sigs, $name) and size(lookup($sigs, $name, empty)) = size($params) and lookup($sigs, $name, empty) <> $params.passes
                : "'{}' is declared twice, and a parameter that is a struct in one is not the same struct in the other"
                    of $name
            ! defined($globals, $name)
                : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
            ! defined($rets, $name)
                and [at(lookup($rets, $name, empty), 1), lookup([[true, 0]], at(lookup($rets, $name, empty), 1) <> "" and at(lookup($rets, $name, empty), 1) <> "void", at(lookup($rets, $name, empty), 2)),
                     at(lookup($rets, $name, empty), 3), at(lookup($rets, $name, empty), 4), at(lookup($rets, $name, empty), 5)]
                    <> [lookup([[0, $ret.tagname]], size($rparen), ""), lookup([[true, 0]], $ret.tagname <> "" and $ret.tagname <> "void" and size($rparen) = 0, $ret.basew),
                        lookup([[0, $stars + $ret.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1)), $ret.buns, "{}{}" of $ret.bquals, $squals]
                : "'{}' is declared twice, returning a different type each time" of $name
            ! defined($pwidths, $name) and size(lookup($pwidths, $name, empty)) = size($params) and lookup($pwidths, $name, empty) <> $params.pwide
                : "'{}' is declared twice, and a parameter that is a long in one is not in the other" of $name
            ! $name = "main" and $stars + $ret.ptrs = 0 and $ret.tagname <> ""
                : "'main' returns an int, C11 5.1.2.2.1, and this says '{}'"
                    of lookup([["void", "void"]], $ret.tagname, "struct {}" of at(split($ret.tagname, "."), 1)) .
  (* The same of a `FnDecl`, whose return type is `base`, since 2026-10-04. *)
  FnDecl    : rlv   = lookup([[0, "{}{}" of slice("p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|", 1, 8 * $stars), $base.blv]], size($rparen), join($rparen.t))
            : rptrs = lookup([[0, $stars + $base.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1))
            : down dbase   = $base
            : down dstars  = $stars
            : down inparen = false
            : down pP      = ""
            : down pouter  = []
            (* Its parameters are a scope of their own, as a prototype's
             * are, and what they change is put back, since 2026-10-04,
             * when one could be declared in a block, where the locals
             * before it are still in force after it. In a block it is a
             * name of the block's, so a local of its name there after it
             * is declared twice, and since 2026-10-05 it has an entry in
             * `env` as a function's name, the one `Variable` would make
             * from `funcs`, which hides a local of its name and which the
             * block puts back at its end; `fblock` says it is not known
             * after that. *Putting `pindex` back has no witness*: nothing
             * after a declaration in a block reads it. *)
            : down fdenv    = $env
            : down fdscope  = $scope
            : down fdbytes  = $bytes
            : down fdpindex = $pindex
            : down env    = empty
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : env    = lookup([[true, bind($fdenv, $name, [0, 0, 0, 1, "", true, false, false, $name, "0", false, "b:1:0:1::{}" of $name])]], $dkind = "block", $fdenv)
            : scope  = lookup([[true, bind($fdscope, $name, true)]], $dkind = "block", $fdscope)
            : bytes  = $fdbytes
            : pindex = $fdpindex
            : tdfns  = lookup([[true, bind($tdfns, $name, [size($params), $variadic])]], $dkind = "block" and $variadic <> 2, $tdfns)
            : fblock = bind($fblock, $name, lookup([[true, lookup($fblock, $name, true)]], $dkind = "block", false))
            ! $dkind = "block" and $variadic <> 2 and defined($funcs, $name) and at(lookup($funcs, $name, [0, 0]), 2) <> 2
              and lookup($funcs, $name, [0, 0]) <> [size($params), $variadic]
                : "'{}' is declared twice, with a different number of parameters or '...' each time" of $name
            : funcs = lookup([[true, $funcs]], $variadic = 2 and defined($funcs, $name), bind($funcs, $name, [size($params), $variadic]))
            : sigs  = lookup([[true, $sigs]], $variadic = 2 and defined($sigs, $name), bind($sigs, $name, $params.passes))
            : rets  = bind($rets, $name, [lookup([[0, $base.tagname]], size($rparen), ""), $base.basew, $rptrs, $base.buns, ("{}{}" of $base.bquals, $squals), $rlv])
            : pwidths = lookup([[true, $pwidths]], $variadic = 2 and defined($pwidths, $name), bind($pwidths, $name, $params.pwide))
            : plvs    = lookup([[true, $plvs]], $variadic = 2 and defined($plvs, $name), bind($plvs, $name, $params.lv))
            ! defined($tdfns, $name) and lookup($tdfns, $name, [0, 0]) <> [size($params), $variadic]
              and $variadic <> 2 and at(lookup($tdfns, $name, [0, 0]), 2) <> 2
                : "'{}' is declared twice, with a different number of parameters or '...' each time" of $name
            ! defined($sigs, $name) and size(lookup($sigs, $name, empty)) = size($params) and lookup($sigs, $name, empty) <> $params.passes
                : "'{}' is declared twice, and a parameter that is a struct in one is not the same struct in the other"
                    of $name
            ! defined($globals, $name)
                : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
            ! defined($rets, $name)
                and [at(lookup($rets, $name, empty), 1), lookup([[true, 0]], at(lookup($rets, $name, empty), 1) <> "" and at(lookup($rets, $name, empty), 1) <> "void", at(lookup($rets, $name, empty), 2)),
                     at(lookup($rets, $name, empty), 3), at(lookup($rets, $name, empty), 4), at(lookup($rets, $name, empty), 5)]
                    <> [lookup([[0, $base.tagname]], size($rparen), ""), lookup([[true, 0]], $base.tagname <> "" and $base.tagname <> "void" and size($rparen) = 0, $base.basew),
                        lookup([[0, $stars + $base.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1)), $base.buns, "{}{}" of $base.bquals, $squals]
                : "'{}' is declared twice, returning a different type each time" of $name
            ! defined($pwidths, $name) and size(lookup($pwidths, $name, empty)) = size($params) and lookup($pwidths, $name, empty) <> $params.pwide
                : "'{}' is declared twice, and a parameter that is a long in one is not in the other" of $name
            ! $name = "main" and $stars + $base.ptrs = 0 and $base.tagname <> ""
                : "'main' returns an int, C11 5.1.2.2.1, and this says '{}'"
                    of lookup([["void", "void"]], $base.tagname, "struct {}" of at(split($base.tagname, "."), 1)) .

  Function  : rlv   = lookup([[0, "{}{}" of slice("p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|", 1, 8 * $stars), $ret.blv]], size($rparen), join($rparen.t))
            : rptrs = lookup([[0, $stars + $ret.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1))
            : down dbase   = $ret
            : down dstars  = $stars
            : down inparen = false
            : down pP      = ""
            : down pouter  = []
            : down fn     = $name
            : down fvar   = $variadic
            : down flast  = at(flatten([[""], $params.name]), size($params) + 1)
            : down infunc = true
            : down fheldtags  = $tags
            : down fheldtypes = $typedefs
            : down fheldtscope = $tscope
            : down tscope = empty
            : tags     = $fheldtags
            : typedefs = $fheldtypes
            : tscope   = $fheldtscope
          : down env    = $globals
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : down funcs  = bind($funcs, $name, [size($params), $variadic])
            : down fblock = bind($fblock, $name, false)
            : sigs  = bind($sigs, $name, $params.passes)
            : rets  = bind($rets, $name, [lookup([[0, $ret.tagname]], size($rparen), ""), $ret.basew, $rptrs, $ret.buns, ("{}{}" of $ret.bquals, $squals), $rlv])
            : pwidths = bind($pwidths, $name, $params.pwide)
            : plvs    = bind($plvs, $name, $params.lv)
            : frame = $bytes
            ! defined($tdfns, $name) and lookup($tdfns, $name, [0, 0]) <> [size($params), $variadic]
              and $variadic <> 2 and at(lookup($tdfns, $name, [0, 0]), 2) <> 2
                : "'{}' is declared twice, with a different number of parameters or '...' each time" of $name
            ! defined($sigs, $name) and size(lookup($sigs, $name, empty)) = size($params) and lookup($sigs, $name, empty) <> $params.passes
                : "'{}' is declared twice, and a parameter that is a struct in one is not the same struct in the other"
                    of $name
            ! defined($globals, $name)
                : "'{}' is a global already, and a function and a global share one name space, C11 6.2.3" of $name
            ! defined($rets, $name)
                and [at(lookup($rets, $name, empty), 1), lookup([[true, 0]], at(lookup($rets, $name, empty), 1) <> "" and at(lookup($rets, $name, empty), 1) <> "void", at(lookup($rets, $name, empty), 2)),
                     at(lookup($rets, $name, empty), 3), at(lookup($rets, $name, empty), 4), at(lookup($rets, $name, empty), 5)]
                    <> [lookup([[0, $ret.tagname]], size($rparen), ""), lookup([[true, 0]], $ret.tagname <> "" and $ret.tagname <> "void" and size($rparen) = 0, $ret.basew),
                        lookup([[0, $stars + $ret.ptrs]], size($rparen), at(flatten([$rparen.stars, [0]]), 1)), $ret.buns, "{}{}" of $ret.bquals, $squals]
                : "'{}' is declared twice, returning a different type each time" of $name
            ! defined($pwidths, $name) and size(lookup($pwidths, $name, empty)) = size($params) and lookup($pwidths, $name, empty) <> $params.pwide
                : "'{}' is declared twice, and a parameter that is a long in one is not in the other" of $name
            ! $name = "main" and $stars + $ret.ptrs = 0 and $ret.tagname <> ""
                : "'main' returns an int, C11 5.1.2.2.1, and this says '{}'"
                    of lookup([["void", "void"]], $ret.tagname, "struct {}" of at(split($ret.tagname, "."), 1)) .

  Labelled : labels = bind($labels, ("{}/{}" of $fn, $name), true)
           ! defined($labels, "{}/{}" of $fn, $name)
               : "the label '{}' is in this function twice" of $name .

  (* A parameter is never an array, because the subset has no declarator for
   * one and C would have rewritten it to a pointer if it had. A scalar or a
   * pointer takes eight bytes and one register.
   *
   * **A struct takes its own size, rounded to eight, and one register or
   * two.** AAPCS64 passes a struct of up to sixteen bytes in registers, its
   * bytes packed, so one of nine to sixteen takes two; a larger one arrives
   * as the address of the caller's copy, in one, and the emit pass copies it
   * into the frame. So a register is counted here rather than a parameter,
   * and the ninth is refused as the ninth parameter is: it would be on the
   * stack, and nothing puts it there. *)
  Param : down dbase   = $base
        : down dstars  = $stars
        : down inparen = false
        : down pP      = ""
        : down pouter  = $dims
        : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                          size($paren), join($paren.t))
        (* **A parameter of a function's type is a pointer to one**, C11
         * 6.7.6.3p8, as one of an array's is a pointer to its element, since
         * 2026-10-04: `binop f`, with `binop` a typedef of a function's
         * type, is `binop *f`. It was refused by name until then. *)
        : fnparm = $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> ""
        : lv     = lookup([[true, "p:8:0:8|{}" of $lvin]], $adj = 1 or $fnparm, $lvin)
        : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
        : basew  = $base.basew
        : dquals = "{}{}" of $base.bquals, $squals
        : whole  = $ptrs = 0 and $base.tagname <> ""
        : passes = lookup([[true, $base.tagname]], $whole, "")
        (* What a caller converts an argument for: `l`, a `long`, which it
         * sign-extends, and since ROADMAP 6.15's third part `b`, a `_Bool`,
         * which it makes 0 or 1, as a callee `cc` compiled counts on. *)
        : pwide  = lookup([[true, "l"]], $ptrs = 0 and $base.tagname = "" and $basew = 8,
                          lookup([[true, "b"]], (at(split(("{}:::::::" of at(split($lv, "|"), 1)), ":"), 7) = "B"), ""))
        : regs   = lookup([[true, 2]], $whole and $basew > 8 and $basew <= 16, 1)
        : takes  = lookup([[true, (($basew + 7) div 8) * 8]], $whole, 8)
        : offset = $bytes + $takes
        : preg   = $pindex
        : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg, $lv])
        : scope  = bind($scope, $name, true)
        : bytes  = $bytes + $takes
        : pindex = $pindex + $regs
        ! $name <> "" and defined($scope, $name) : "'{}' is a parameter twice" of $name
        ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
            : "'{}' is a parameter of type 'void', and only '(void)' alone, for no parameters, is C" of $name
        ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0
            : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
        ! $pindex + lookup([[true, 2]], $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> ""
                                        and $base.basew > 8 and $base.basew <= 16, 1) > 8
            : "'{}' needs a ninth register, and only eight are compiled: the rest go on the stack, and nothing here puts them there"
                of $name
        ! $base.unsup = "" and $base.nstore < 2 and $base.pword <> ""
            : "'{}' is a parameter declared '{}', and the one storage class a parameter may have is 'register', C11 6.7.6.3p2"
                of $name, $base.pword .

  (* **A call's key**, since ROADMAP 6.14's second part, read from its
   * callee's type where this pass can: a name's, which is a function's own
   * name or the key a pointer's type holds. What it reads is what a call
   * that hands back a struct needs here; every other callee's key is the
   * `types` pass's, see `Call` there. **And whether a name is being
   * called**, `callpos`, so that a function used before it is declared is
   * refused in a call's own words: the callee is told, and what is inside
   * an argument, a subscript or a member is not. *)
  otherwise vlv   = ""
  otherwise vname = ""
  Call : known = $layouts
       : lkey  = lookup([[true, at(split(("{}::::::" of at(split($fn.vlv, "|"), 1)), ":"), 6)]], slice($fn.vlv, 1, 1) = "b", at(split(("{}::::::" of at(split(("{}||" of $fn.vlv), "|"), 2)), ":"), 6))
       : vrec  = at(lookup($rets, $lkey, ["", 4, 0, false, "0"]), 1) <> "" and at(lookup($rets, $lkey, ["", 4, 0, false, "0"]), 1) <> "void" and at(lookup($rets, $lkey, ["", 4, 0, false, "0"]), 3) = 0
       : down callpos = true .
  Arg    : down callpos = false .
  (* **An enumerator's value is worked out here**, since ROADMAP 6.15's
   * fourth part, settled with Hans on 2026-10-01: an `enum` is an
   * `unsigned int` in this `cc` when none of its constants is negative and
   * an `int` when one is, and the `types` pass, which runs before the
   * `constants` pass, has to know which. So this pass works out what an
   * enumerator's `=` says, from numbers, characters, earlier enumerators, `+`, `-`,
   * `~` and the arithmetic and bitwise operators, in exact integers: `ev`
   * the value and `eok` whether it could be, which is false for anything
   * else and refused by name at the enumerator. An operand past 2^31, a
   * division by zero and a shift past 31 are not worked out, so that no
   * product or shift passes 2^62 and nothing here traps: these are worked
   * out at every `Binary` in a program, and `unsigned-folds.c` multiplies
   * two numbers near 2^32. *)
  (*
   * **Unsigned arithmetic is not worked out where it differs**, since
   * 2026-10-04, when `-1 / 2u` was found compiled as 0 where `cc` makes it
   * 2147483647: `ev` is exact, and C converts an operand beside an
   * unsigned one to unsigned. `eu` says a value is an `unsigned int`, and
   * where one is, an operand or an answer that is negative, or 2^32 or
   * past it, is not worked out, `eun`, which the enumerator refuses in
   * its own words. Where neither happens, exact and unsigned agree, so
   * `1u << 4` and `A | B` are worked out as before. `-` and `~` of an
   * unsigned set `eun` and leave `eok` alone: what they make is never 0,
   * so no null pointer constant can tell, and every operator above them
   * asks `eun`. A shift's answer is its left side's type, which is
   * negative only when `eun` already says so, and too wide when it
   * passes 2^32, `(3u << 31) >> 31`.
   *
   * **And comparisons, `!`, `&&`, `||` and `?:`**, since 2026-10-04,
   * C11 6.6p6, each answering an `int`, but for `?:`, whose answer is
   * unsigned if either arm is. A comparison asks of its operands what any
   * operator does, since an unsigned operand converts the other. *)
  otherwise ev  = 0
  otherwise econst = false
  otherwise eok = false
  otherwise eu  = false
  otherwise eun = false
  Negate : ev = 0 - $value.ev : eu = $value.eu : eok = $value.eok
         : eun = $value.eun or ($value.eu and $value.ev <> 0) .
  Plus   : ev = $value.ev : eu = $value.eu : eun = $value.eun : eok = $value.eok .
  Invert : ev = -1 - $value.ev : eu = $value.eu : eok = $value.eok
         : eun = $value.eun or $value.eu .
  Not    : ev = lookup([[0, 1]], $value.ev, 0) : eun = $value.eun : eok = $value.eok .
  Logical : ev  = lookup([["&&", lookup([[true, 1]], $left.ev <> 0 and $right.ev <> 0, 0)]], $op,
                         lookup([[true, 1]], $left.ev <> 0 or $right.ev <> 0, 0))
          : eun = $left.eun or $right.eun
          : eok = $left.eok and $right.eok .
  Choose : ev    = lookup([[0, $other.ev]], $cond.ev, $then.ev)
         : eu    = $then.eu or $other.eu
         : eubad = ($then.eu or $other.eu) and lookup([[0, $other.ev]], $cond.ev, $then.ev) < 0
         : eun   = $cond.eun or $then.eun or $other.eun or $eubad
         : eok   = $cond.eok and $then.eok and $other.eok and not $eubad .
  Binary : down callpos = false
         : esmall = $left.ev >= 0 - 2147483648 and $left.ev <= 2147483648 and $right.ev >= 0 - 2147483648 and $right.ev <= 2147483648
         : el     = lookup([[true, $left.ev]], $esmall, 0)
         : er     = lookup([[true, $right.ev]], $esmall, 0)
         : enz    = lookup([[0, 1]], $er, $er)
         : epow   = at([1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648], lookup([[true, $er]], $er >= 0 and $er < 32, 0) + 1)
         : ev     = lookup([["+", $el + $er], ["-", $el - $er], ["*", $el * $er], ["/", quotient($el, $enz)], ["%", remainder($el, $enz)],
                            ["<<", $el * $epow], [">>", $el div $epow], ["&", bitand($el, $er)], ["|", bitor($el, $er)], ["^", bitxor($el, $er)]], $op, 0)
         : eshift = $op = "<<" or $op = ">>"
         : eu     = lookup([[true, $left.eu]], $eshift, $left.eu or $right.eu)
         : eubad  = lookup([[true, $left.eu and $ev >= 4294967296]], $eshift,
                           ($left.eu or $right.eu) and ($el < 0 or $er < 0 or $ev < 0 or $ev >= 4294967296))
         : eun    = $left.eun or $right.eun or $eubad
         : eok    = $left.eok and $right.eok and $esmall and not $eubad
                    and lookup([["+", true], ["-", true], ["*", true], ["/", $er <> 0], ["%", $er <> 0], ["<<", $er >= 0 and $er < 32],
                                [">>", $er >= 0 and $er < 32], ["&", true], ["|", true], ["^", true]], $op, false) .
  Compare : ev    = lookup([[true, 1]], lookup([["<", $left.ev < $right.ev], ["<=", $left.ev <= $right.ev], [">", $left.ev > $right.ev],
                                                [">=", $left.ev >= $right.ev], ["==", $left.ev = $right.ev]], $op, $left.ev <> $right.ev), 0)
          : eubad = ($left.eu or $right.eu) and ($left.ev < 0 or $right.ev < 0)
          : eun   = $left.eun or $right.eun or $eubad
          : eok   = $left.eok and $right.eok and not $eubad .

  (* **An enumeration**, C11 6.7.2.2, since ROADMAP 6.15's fourth part: its
   * constants counted on from 0, or from what an `=` says, `enext`, and
   * whether any is negative, `eneg`, which makes it an `int` and otherwise
   * an `unsigned int`, this `cc`'s choice, which C11 6.7.2.2p4 leaves to
   * the implementation. Its key is that type's, so an object of it is an
   * `int` or an `unsigned int` in every pass, and its tag names the key as
   * a struct's names its layout. *)
  thread enext = 0
  thread eneg  = false
  EnumDef : down env   = lookup([[true, $env]], $infunc, $globals)
          : down enext = 0
          : down eneg  = false
          : mykey  = lookup([[true, "int"]], $eneg, "unsigned int")
          : tags   = lookup([[true, bind($tags, $name, $mykey)]], $name <> "", $tags)
          : tscope = lookup([[true, bind($tscope, $name, true)]], $name <> "", $tscope)
          ! $name <> "" and defined($tscope, $name)
              : "'enum {}' is defined twice" of $name .
  (* Each constant is an `int` with a value, and a name in the scope it is
   * written in, at file scope a global's: its entry is a name's, with the
   * value as a thirteenth field, which `Variable` reads. *)
  Enumerator : val     = lookup([[0, $enext]], size($value), at(flatten([$value.ev, [0]]), 1))
             : enext   = $val + 1
             : eneg    = $eneg or $val < 0
             : env     = bind($env, $name, [0, 0, 0, 4, "", false, false, false, "", "0", false, "b:4:0:4", $val])
             : scope   = bind($scope, $name, true)
             : globals = lookup([[true, bind($globals, $name, [0, 0, 0, 4, "", false, false, false, "", "0", false, "b:4:0:4", $val])]], not $infunc, $globals)
             ! size($value) > 0 and at(flatten([$value.eun, [false]]), 1)
                 : "'{}' is given a value whose unsigned arithmetic this subset does not work out: C converts a negative operand or answer to an unsigned int, and this works in exact integers" of $name
             ! size($value) > 0 and not at(flatten([$value.eok, [false]]), 1) and not at(flatten([$value.eun, [false]]), 1)
                 : "'{}' is given a value this subset does not work out: C11 6.7.2.2p2 wants an integer constant expression, and this works one out only from numbers, characters, enumerators, parentheses, and the arithmetic, bitwise, comparison and logical operators and '?:'" of $name
             ! lookup([[0, $enext]], size($value), at(flatten([$value.ev, [0]]), 1)) > 2147483647
               or lookup([[0, $enext]], size($value), at(flatten([$value.ev, [0]]), 1)) < 0 - 2147483648
                 : "'{}' is {}, past an int's range, which C23 allows and C11 6.7.2.2p2 does not" of $name, lookup([[0, $enext]], size($value), at(flatten([$value.ev, [0]]), 1))
