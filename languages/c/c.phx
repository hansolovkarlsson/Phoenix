(* c.phx -- a C subset: what it looks like, and what it means.
 *
 * **The language, and nothing about any target.** The grammar, the tree it
 * builds and the symbol pass are here; `c-arm64.phx` imports this file and
 * adds one emit pass.
 * That is the split `languages/README.md` prescribes and the reason a second
 * target could arrive without touching this file.
 *
 *   phx languages/c/c-arm64.phx prog.c                       the tree
 *   phx --driver check languages/c/c-arm64.phx prog.c         the symbols
 *   phx --driver arm64 languages/c/c-arm64.phx prog.c > prog.s
 *   cc prog.s -o prog && ./prog
 *
 * ---------------------------------------------------------------------------
 * What this is for
 *
 * [ROADMAP 6](../../docs/ROADMAP.md#6-a-c-compiler) is the one entry on that
 * page that is a language rather than a mechanism: the compiler is the goal
 * and the mechanisms it turns out to need are the findings. The subset grows
 * in chibicc's order, one construct at a time with the suite green at each.
 * Step one stopped before `typedef` on purpose, because that was where the
 * tool was expected to need a change, and the change was to arrive with the
 * construct that wanted it. It did: `typedef` is here, and `%names`, below,
 * is the change.
 *
 * **What is here is every construct of step one**: `int main(){return 42;}`,
 * then `+ - * /` with parentheses, then unary minus and the six comparisons,
 * then a local `int`, then `if`, `while`, `for` and blocks as statements,
 * then functions with `int` parameters and calls, then `&` and `*` with the
 * pointer declarators that make them useful, then `sizeof`, then an array of
 * `int` or of pointers, which decays to a pointer to its first element, then
 * a subscript and the pointer arithmetic it is made of, then `char`,
 * character constants and string literals, then `struct` with `.` and `->`.
 * A function returning `int` with up to eight parameters, a body of declarations, assignments, expression
 * statements, control flow and `return`s, and expressions over constants,
 * locals, calls, pointers and members, prototypes so that a call can come
 * above the function it names, and structs defined at file scope. A name nothing declared, one declared twice in a
 * scope, one used outside its block, a call before a declaration or with the
 * wrong number of arguments, a function defined twice or declared with two
 * arities, a ninth parameter, a `*` on what is not a pointer, and arithmetic
 * on one, are refused, and so is a struct copied whole, by assignment, by
 * initialisation or as an argument.
 *
 * **Then `typedef`**, at file scope, of a base and any number of stars, a
 * struct included, and hidden by an ordinary name declared in a block or as
 * a parameter until that scope ends. A typedef declared twice for two types
 * is refused.
 *
 * ---------------------------------------------------------------------------
 * The lexical half is written here rather than imported. `lib/lexical.phx`
 * reads `#` as a line comment, which C does not, and every rule it carries
 * would become a token kind whether the subset has it or not. C's own
 * conventions -- hex and octal constants, suffixes, character literals,
 * strings with escapes -- arrive with the constructs that need them.
 *)

%fragment letter digit escape plain sescape splain .

letter  = "a" .. "z" | "A" .. "Z" | "_" .
digit   = "0" .. "9" .

name    = letter { letter | digit } .
integer = digit { digit } .

(* A character constant is one character between single quotes, or one
 * escape. **Printable ASCII only**, and the three ranges are that and nothing
 * else: a space to `~`, less the quote at 39 and the backslash at 92, which
 * are what an escape is for. A tab typed between the quotes is C and is
 * refused here, as are `'ab'`, which C leaves to the implementation, and the
 * octal and hex escapes, which arrive when a program wants one.
 *
 * The lexer saying exactly this is what lets the `types` pass work out a
 * code without asking whether it can: anything that reaches it is one of the
 * ninety-five characters in its table, or one of six escapes. *)
escape    = "\\" ( "n" | "t" | "\\" | "'" | "\"" | "0" ) .
plain     = " " .. "&" | "(" .. "[" | "]" .. "~" .
character = "'" ( escape | plain ) "'" .

(* A string literal is the same characters between double quotes, where the
 * double quote needs an escape and the single one does not, and with **five**
 * escapes rather than six. `\0` is left out because a string is where it
 * stops meaning what it seems to: C reads up to three octal digits after the
 * backslash, so `"\01"` is one byte and not a NUL and a `1`, and a lexer
 * that knew only `\0` would count two. It is refused rather than
 * miscounted, and arrives with the octal escapes. A character constant keeps
 * it, because the closing quote ends it there. Two literals side by side,
 * which C joins, are a syntax error here. *)
sescape = "\\" ( "n" | "t" | "\\" | "'" | "\"" ) .
splain  = " " .. "!" | "#" .. "[" | "]" .. "~" .
string  = "\"" { sescape | splain } "\"" .

space         = ( " " | "\t" | "\n" | "\r" ) { " " | "\t" | "\n" | "\r" } .
line-comment  = "//" { ! "\n" } .
block-comment = "/*" { ! "*/" } "*/" .

(* Two characters before one, every time: `<` first would leave the `=` of
 * `<=` behind, and the error would surface at the token after it. *)
symbol = "==" | "!=" | "<=" | ">=" | "->"
       | "(" | ")" | "{" | "}" | ";" | "," | "+" | "-" | "*" | "/" | "<" | ">" | "="
       | "&" | "[" | "]" | "." .

%skip space line-comment block-comment .

(* ------------------------------------------------------------------ *)
(* Tokens to a program.                                               *)
(*                                                                     *)
(* `int` and `return` are reserved by appearing below, which is what   *)
(* C's keyword list says about them too.                              *)

%syntax .
%start program .

program = { item } -> Program(items: $1) .

(* **What the parse keeps**, which is the one thing C asks of a parser that
 * no other language here has. `x * y;` declares `y` when `x` names a type and
 * multiplies when it does not, and `sizeof(x)` is the size of a type or of a
 * variable by the same test, so which rule a name belongs to is a question
 * about the declarations **above** it. ROADMAP 1.8 has the failure this
 * answers, measured before the notation had a way to say it.
 *
 * A `Typedef` declares its name a type. Every declaration of an ordinary
 * name hides one, because C11 6.2.1 lets `int T;` in a block make `T` a
 * variable until the block ends; a member does not, because members are a
 * name space of their own, 6.2.3. A block and a function each end what was
 * bound inside them, which is what makes the hiding end, and `function`
 * covers a prototype's parameters as much as a definition's, since C11 gives
 * a prototype a scope of its own. `typedef-name` is the one rule that asks. *)
%names typedef-names
    declare Typedef.name
    hide    Param.name Local.name LocalInit.name LocalArray.name
    scope   block function
    guard   typedef-name .

(* A prototype or a definition, and the prototype first because it is the
 * shorter: the header is the same and `;` fails on `{`. C99 6.5.2.2 wants a
 * declaration above every call, so a prototype is how a call reaches a
 * function defined below it, and how two functions call each other.
 *
 * One return type. The body is the statements themselves and not a `Block`,
 * because C11 6.2.1 puts the parameters in the same scope as the body's
 * outermost declarations: `int f(int a) { int a; }` is declared twice, and a
 * `Block` would open a scope the parameters are not in. *)
item = function
     (* A struct is defined at file scope and only there, and always with a
      * tag. C allows both a definition inside a block, with the block's scope,
      * and a struct with no tag at all; neither is here yet, and a program
      * that writes one gets a syntax error rather than a wrong answer. A
      * struct with no members is **not** a syntax error, so that it can be
      * refused by name: see the `locals` pass. *)
     | "struct" n:name "{" f:{ member } "}" ";"
         -> StructDef(name: $n, members: $f)
     (* **A typedef is a name for a declaration's type**, a base and some
      * stars, and like a struct it is at file scope only: C allows one in a
      * block, with the block's scope, and a program that writes one gets a
      * syntax error. No array, `typedef int v[3];`, because a declaration's
      * count is a field of the declaration and not of its type; that arrives
      * when a program wants it. *)
     | "typedef" b:base s:{ "*" } n:name ";"
         -> Typedef(name: $n, base: $b, stars: size($s)) .

(* A function is a rule of its own because it is a **scope**: see `%names`
 * above. Its parameters hide a typedef of the same name from the `(` to the
 * end of the body, or to the `;` of a prototype, and no further. *)
function = "int" n:name "(" p:params ")" ";"
             -> Prototype(name: $n, params: $p)
         | "int" n:name "(" p:params ")" "{" s:{ statement } "}"
             -> Function(name: $n, params: $p, body: $s) .

(* A member is declared the way a local is, and is two nodes for the reason a
 * local is: `int a[0];` and `int a;` must not be spelled the same. There is no
 * initialiser, because C has none for a member. *)
member = b:base s:{ "*" } n:name "[" c:integer "]" ";"
           -> MemberArray(name: $n, base: $b, stars: size($s), count: int($c))
       | b:base s:{ "*" } n:name ";"
           -> MemberScalar(name: $n, base: $b, stars: size($s), count: 0) .

(* A parameter is a node and not a name, because it takes a slot the way a
 * local does and the emit pass has to store a register into it. The
 * repetition's action is what makes this a list of parameters rather than a
 * list of parameters and commas, and the rule's own action is what makes it
 * a list at all: a rule with no action answers the one thing it matched, so
 * one parameter would arrive bare and two would arrive in a node called
 * `params`. `-> $1` says *the list, whatever its length*. *)
params = [ param { "," q:param -> $q } ] -> $1 .
param  = b:base s:{ "*" } n:name -> Param(name: $n, base: $b, stars: size($s)) .

(* What is at the bottom of the stars. **A node since `struct`**, and a keyword
 * before it: `int` and `char` were two words the `locals` pass turned into a
 * width with a table written out at each of five declarations. A struct's
 * width is not in any table written here, because the program defines it, so
 * the question moved to the one node that can answer it for every
 * declaration at once. The name is the keyword or the tag, and cannot be
 * both, because `int` and `char` are reserved and no tag can be spelled so.
 *
 * **A typedef's name is the fourth**, and builds a node of its own rather
 * than a `Base`, because what it names is a base *and some stars*, and a
 * `Base` has no stars to give. The `locals` pass has each answer how many,
 * and a declaration adds its own.
 *
 * A function still returns an `int` and nothing else: the item's header says
 * `int`, and a struct returned whole is a calling convention of its own. A
 * typedef of `int` is not taken there either, which C would. *)
base   = "int"             -> Base(name: "int")
       | "char"            -> Base(name: "char")
       | "struct" t:name   -> Base(name: $t)
       | t:typedef-name    -> Named(name: $t) .

(* A name that the declarations above have made a type, and not hidden
 * since. It is a `name` like any other to the scanner; what makes it a type
 * is `%names`, which is the only thing that can know. *)
typedef-name = name .

block = "{" { statement } "}" -> Block(body: $2) .

(* A declaration is two nodes rather than one with an optional initialiser,
 * because a node whose field is sometimes there is a node every pass has to
 * ask about. `int x = e;` is `int x; x = e;` and the emit pass says so.
 *
 * The stars are **counted** rather than kept: `int **p` declares a name with
 * two of them, and two is the whole of what any pass here asks. A type in this
 * subset is a base and a number of stars, so it fits in the keyword and the
 * number the node was going to carry anyway. This said until 2026-09-22 that
 * `char` would be the day a type needs a node of its own; `char` needed a
 * second number. `struct` was the day it was to need a node, and gave one
 * to the base instead: see `base` above and the `types` pass. *)
statement = "return" e:expression ";"              -> Return(value: $e)
          (* An array first, because the three declaration forms are told
           * apart by the token after the name and this one's is `[`. The
           * count is a constant in the source and so is a field rather than a
           * subtree: C99's variable-length arrays are not in this subset, and
           * a count that a pass would have to evaluate is a different
           * mechanism from a count that is written down.
           *
           * It is a **node of its own** for the reason `Local` and
           * `LocalInit` are two nodes: a count that is sometimes there is a
           * count every pass has to ask about, and here the question has a
           * sharp edge. `int a[0]` is a count of zero and `int a;` is no
           * count at all, and one node would have to spell both the same. *)
          | b:base s:{ "*" } n:name "[" c:integer "]" ";"
                   -> LocalArray(name: $n, base: $b, stars: size($s), count: int($c))
          | b:base s:{ "*" } n:name "=" e:expression ";"
                   -> LocalInit(name: $n, base: $b, stars: size($s), value: $e)
          | b:base s:{ "*" } n:name ";"
                   -> Local(name: $n, base: $b, stars: size($s), count: 0)
          (* The `else` form first. Trying it first is also what settles the
           * dangling else: an inner `if` gets the chance to take the `else`
           * before the outer one does, which is what C11 6.8.4 says. *)
          | "if" "(" c:expression ")" t:statement "else" f:statement
                                                    -> IfElse(cond: $c, then: $t, else: $f)
          | "if" "(" c:expression ")" t:statement   -> If(cond: $c, then: $t)
          | "while" "(" c:expression ")" b:statement
                                                    -> While(cond: $c, body: $b)
          (* Each clause of a `for` may be missing, and an option is a list
           * that is empty when it did not match, so the node carries three
           * lists of at most one. That is the same shape as a block's body,
           * and the emit pass joins them the same way. *)
          | "for" "(" i:[ expression ] ";" c:[ expression ] ";" s:[ expression ] ")"
                b:statement                         -> For(init: $i, cond: $c, step: $s, body: $b)
          | block
          | e:expression ";"                        -> Discard(value: $e) .

(* C's expression grammar, six of its fifteen levels. `lib/expression.phx`
 * is not imported: its table is calc's, with `and`, `or`, `not` and `<>` in
 * it, and C's is written here a level at a time as the constructs arrive.
 * The shape is the module's, though, and so is the fold: `$$` is what has
 * been built so far, and an action naming it replaces that, which is what
 * makes `100 - 50 - 25` group to the left without anybody saying so. *)
expression = assignment .

(* Assignment is an expression in C, worth the value assigned, and it groups
 * to the right: `a = b = 21` sets both. What is on the left is a **place**
 * and no longer a name, which is the whole of what `&` and `*` change about
 * this rule: `*p = 3` puts a value where a pointer says, and C11 6.5.16 asks
 * for an lvalue there rather than for an expression. The first alternative
 * fails at `=` on anything that is not an assignment and the choice moves on,
 * which is what ordered choice is for; `==` is a different token, so `x == 1`
 * never gets this far. *)
assignment = p:place "=" a:assignment -> Assign(place: $p, value: $a)
           | equality .

(* A place is somewhere a value can be **put**, and it is the one thing `&`
 * can be asked for. There are two: a name, and a dereference of anything.
 * Saying that here rather than in a pass is what keeps `1 = 2` and `&1` out
 * without any pass having to ask what kind of node it was handed -- C11
 * 6.5.3.2 makes the operand of `&` an lvalue, and this rule is that
 * constraint written in the grammar, where it costs nothing to check.
 *
 * A place builds the same `Variable` and `Deref` nodes a *read* of one builds,
 * because they are the same nodes: what differs is which attribute the parent
 * asks them for. The emit pass gives both an address as well as a value, and
 * an assignment reads the address where a read reads the value.
 *
 * The third alternative is a **parenthesised** place, which C allows and this
 * rule refused until 2026-09-22: `(x) = 4` and `&(x)` are ordinary C and were
 * a syntax error here. Parentheses group without changing what a thing is,
 * and the action says exactly that by answering the place inside them rather
 * than building anything. It has to come before the name and after the `*`,
 * for the reason every ordered choice here does: `(` decides it.
 *
 * A subscripted place is the fourth, and `a[i]` is a place because it is a
 * `*`, which is all a subscript is. A member is a place too, `s.x` and
 * `p->x` alike, and arrives in the same alternative because it is written
 * in the same position, after a primary. The alternative is **first**,
 * before the parenthesised one, because ordered choice does not come back:
 * `(a)[1] = 2` would match `(a)` as a parenthesised place, fail at `[` where
 * the `=` was wanted, and never be tried as anything else. Tried first, a
 * place that has nothing after its primary fails at the token that follows
 * it and the choice moves on. *)
place = suffixed
      | "*" u:unary   -> Deref(value: $u)
      | "(" p:place ")" -> $p
      | n:name        -> Variable(name: $n) .

(* A comparison is an `int`, 0 or 1, and it chains: `3 > 2 > 1` is
 * `(3 > 2) > 1`, which is 0, and C means that. So these are repetitions
 * like the arithmetic below them, where `lib/expression.phx` has an option
 * because calc does not chain. Equality is looser than the relations, so
 * `0 == 1 < 2` is `0 == (1 < 2)`. *)
equality       = relational     { ( "==" | "!=" ) relational
                                    -> Compare(op: $1, left: $$, right: $2) } .
relational     = additive       { ( "<" | "<=" | ">" | ">=" ) additive
                                    -> Compare(op: $1, left: $$, right: $2) } .

additive       = multiplicative { ( "+" | "-" ) multiplicative
                                    -> Binary(op: $1, left: $$, right: $2) } .
multiplicative = unary          { ( "*" | "/" ) unary
                                    -> Binary(op: $1, left: $$, right: $2) } .

(* `&` takes a place and `*` takes anything, which is C11 6.5.3.2 as written.
 * `&*p` is therefore `p` without anybody saying so: the address of a
 * dereference is the thing dereferenced, and the emit pass gets that from the
 * shape of the tree rather than from a rule about it.
 *
 * `sizeof` has two shapes and the **type** one goes first, because `sizeof
 * (x)` would otherwise be taken by the expression form's parenthesised
 * primary and `sizeof(int)` would fail there: `int` is a reserved word and
 * no expression begins with it. The two build different nodes rather than
 * one node with a field that is sometimes a type, for the reason the
 * declarations give above. *)
unary   = "-" u:unary -> Negate(value: $u)
        | "&" p:place -> Addr(place: $p)
        | "*" u:unary -> Deref(value: $u)
        | "sizeof" "(" b:base s:{ "*" } ")" -> SizeOfType(base: $b, stars: size($s))
        | "sizeof" u:unary                 -> SizeOfExpr(value: $u)
        | postfix .

(* **A subscript builds no node of its own.** C11 6.5.2.1 defines `E1[E2]` as
 * `(*((E1)+(E2)))`, and these actions build exactly that, so indexing is a
 * `Deref` of a `+` and every pass already knows what those are. What made
 * `a[i]` wait was never the brackets: it was the `+`, which has to count in
 * elements, and that is the `types` pass's business and the emit pass's.
 * `2[a]` is therefore `*(2 + a)`, which is C, and `x[0]` on an `int` is a
 * `*` on an `int` and refused as one.
 *
 * **Nor does `->`.** C11 6.5.2.3 defines `E->m` by what `(*E).m` would
 * be, and the action builds that, so a `Member` is always asked of a struct
 * and never of a pointer, and the `*` refuses a `->` on anything that is not
 * a pointer, in its own words. A member is a node, because unlike a
 * subscript it is not something else written differently: which member is
 * the struct's layout to say, and no other node carries a name to look up.
 *
 * `suffixed` has at least one suffix and `postfix` may have none. The place
 * rule wants the first, because a place without a suffix is one of its
 * other three; an expression wants the second. The fold is written twice
 * because a rule cannot both build its first suffix and fold the rest in
 * one list: `$$` needs its base in the list it folds, and `suffix` is that
 * base. The three suffixes are one repetition and not three, because C
 * mixes them freely: `a[i].next->v[2]` is four of them, in one fold. *)
postfix   = suffixed | primary .
suffixed  = suffix { "[" e:expression "]"
                          -> Deref(value: Binary(op: "+", left: $$, right: $e))
                      | "." n:name  -> Member(value: $$, name: $n)
                      | "->" n:name -> Member(value: Deref(value: $$), name: $n) } .
suffix    = p:primary "[" e:expression "]"
              -> Deref(value: Binary(op: "+", left: $p, right: $e))
          | p:primary "." n:name  -> Member(value: $p, name: $n)
          | p:primary "->" n:name -> Member(value: Deref(value: $p), name: $n) .

(* A call before a variable, because `f` fails at `(` and falls through.
 * Each argument is a node of its own for the same reason a parameter is:
 * the emit pass has to know which register it goes in, and that is a fact
 * about the argument's place in the list, which a node can be handed and an
 * expression cannot. *)
primary = n:name "(" a:args ")" -> Call(name: $n, args: $a)
        | integer -> Number(text: $1)
        | character -> Character(text: $1)
        | string    -> String(text: $1)
        | name    -> Variable(name: $1)
        | "(" expression ")" -> $2 .

args = [ arg { "," b:arg -> $b } ] -> $1 .   (* `-> $1` as for params *)
arg  = e:expression -> Arg(value: $e) .

(* ------------------------------------------------------------------ *)
(* Pass one: the questions about functions that no order can answer.   *)
(*                                                                     *)
(* Whether a call names a declared function is a question about what   *)
(* came *above*, and the next pass asks it of a thread. Whether a       *)
(* function is defined twice, or declared with two different numbers of *)
(* parameters, is a question about the whole file, and this pass       *)
(* gathers what it needs on the way up and asks at the top. awk needed  *)
(* the gathered table for the call itself, because awk lets a call come *)
(* first; C does not, and the table here is only for the two checks.    *)

%pass functions

  (* A shape is a name and an arity as one text, so that `positions` can
   * count how many distinct ones there are: more shapes than names means a
   * name with two arities. *)
  Prototype : shape = ["{}/{}" of $name, size($params)]
            : dname = [$name]
            : fname = []
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params) .
  Function  : shape = ["{}/{}" of $name, size($params)]
            : dname = [$name]
            : fname = [$name]
            ! size($params) > 8
                : "'{}' has {} parameters, and only eight are compiled: the ninth goes on the stack, and nothing here puts it there"
                    of $name, size($params) .

  (* A struct is an item and not a function, and adds nothing to either count. *)
  StructDef : shape = []
            : dname = []
            : fname = [] .
  Typedef   : shape = []
            : dname = []
            : fname = [] .

  (* Written out rather than named: a check runs before the attributes its
   * rule computes, so it cannot read them, and `phx` says so. *)
  Program ! size(positions(flatten($items.fname))) < size(flatten($items.fname))
              : "a function is defined twice"
          ! size(positions(flatten($items.shape))) > size(positions(flatten($items.dname)))
              : "a function is declared with two different numbers of parameters" .

(* ------------------------------------------------------------------ *)
(* Pass two: which local is which, where does it live, and what is it? *)
(*                                                                     *)
(* A local lives at a **byte offset** below its function's frame        *)
(* pointer, and the frame is how many bytes the function needs. It was  *)
(* a numbered slot until arrays arrived: `int a[10]` is forty bytes and *)
(* one slot cannot hold it, so a declaration's type reaches the frame   *)
(* here for the first time.                                             *)
(*                                                                     *)
(* Everything is given a multiple of eight and started on one. An       *)
(* `int` is four bytes and takes eight, which wastes half of every      *)
(* scalar and is what the frame did anyway when a slot was eight. The   *)
(* alternative, packing each thing at its own width, is not observable  *)
(* by any program: the distance between two **separate** objects is not *)
(* something C defines, and the distance between two elements of one    *)
(* array is the element's width either way. So the cheaper rule is the  *)
(* one that is kept. A struct's members are laid out by another rule,   *)
(* below, because the distance between two of them is measurable.       *)
(*                                                                     *)
(* A name means **five** things: where it lives, how many stars stood   *)
(* in front of it, how many elements it has, zero meaning it is not an  *)
(* array, how wide the thing at the bottom of the stars is, 4 for an    *)
(* `int`, 1 for a `char` and the struct's size for a struct, and which  *)
(* struct that is, or "" for none. All five go in one table rather than *)
(* in five side by side, because a second table would need the same     *)
(* `down` at a function and the same save-and-restore at a block, and   *)
(* two copies of a scope rule are two chances to disagree about what a  *)
(* scope is.                                                            *)
(*                                                                     *)
(* The width is `basew` here and `width` in the `types` pass, which     *)
(* reads it off a name and carries it through every expression, and the *)
(* struct is `tagname` here and `tag` there. Two names each because two *)
(* passes defining one attribute is a thing `phx` warns about, rightly. *)
(*                                                                     *)
(* **A struct's layout is worked out here too**, because a member is    *)
(* laid out by the same walk in document order that lays out a frame:   *)
(* each member starts at the first offset after the one before it that  *)
(* its own alignment allows, which is C11 6.7.2.1 and the ABI together, *)
(* and the struct is as long as that rounded up to its widest member's  *)
(* alignment. The frame rounds everything to eight and a struct cannot, *)
(* because the distance between two members of **one** object is a     *)
(* thing a program can measure, with `sizeof` and with `&`.             *)

%pass locals

  (* The table is a thread, because *what has been declared so far* is what
   * a walk in document order has. All three are set afresh at each function
   * by a `down` clause, which is what makes a thread nest.
   *
   * `env` is every name in sight and `scope` is only this block's, and they
   * answer different questions: a read asks the first, and a declaration
   * asks the second, because C11 6.2.1 lets an inner block declare a name
   * the outer one already has. One table cannot answer both -- the first
   * version of this pass had one, and refused `{ int x = 1; { int x = 2; } }`
   * as declared twice. *)
  thread env   = empty
  thread scope = empty
  thread bytes = 0

  (* Which register a parameter arrives in is its **position**, which a byte
   * offset no longer says. It said it while every declaration was one slot
   * and parameter k was slot k; now it is counted on its own. *)
  thread pindex = 0

  (* The functions declared so far, name to arity. A definition binds itself
   * on the way *in*, with a `down` clause, so that its own body can call it;
   * the value flows on to the functions after it, which is what a `down` on
   * a thread does when nothing restores it. A prototype binds on the way
   * out, which for a node with no body is the same moment. *)
  thread funcs = empty

  (* **The struct layouts defined so far**, tag to size, alignment and a
   * table of members. It starts with `int` and `char` in it, as two structs
   * with no members, and that is what lets `Base` answer a width with one
   * lookup whatever it names: the keyword and the tag are asked the same
   * question of the same table. A struct is defined at file scope only, so
   * this is never reset and flows from each definition to everything after
   * it, which is C11 6.2.1's scope for a tag declared outside any block. *)
  thread layouts = [["int", [4, 4, empty]], ["char", [1, 1, empty]]]

  (* **The typedefs so far**, name to the four things a declaration asks
   * of its base: a width, an alignment, a tag, and how many stars the typedef
   * already has. File scope only, like `layouts`, so never reset. The parse
   * has already decided which names are typedefs, with `%names`; this is what
   * each one *means*, which the parse has no way to hold. *)
  thread typedefs = empty

  (* The three a struct's members are laid out by, each set afresh by the
   * struct being defined: the members so far, the offset the next one may
   * start at, and the widest alignment seen. A member's entry is the same
   * five things a name's is, so that a member and a name are read alike. *)
  thread fields = empty
  thread moff   = 0
  thread malign = 1

  (* Which struct is being defined, so that it may point at itself. A struct
   * is not complete until its `}`, C11 6.7.2.1, so `struct node` inside its
   * own definition has no size and cannot be a member; a **pointer** to one
   * needs no size, and a linked list is made of exactly that. *)
  Program : down defining = "" .

  (* A struct's layout is bound on the way out, when every member has been
   * placed. The check for a second definition runs before that, and so sees
   * the table without this one in it. A struct with no members is refused
   * by name: C11 6.7.2.1 wants at least one, and this `cc` takes `{}` as an
   * extension with a `sizeof` of 0, so it is a program both would compile
   * and answer differently, the way `int a[0]` is. *)
  StructDef : down defining = $name
            : down fields   = empty
            : down moff     = 0
            : down malign   = 1
            : layouts = bind($layouts, $name,
                             [(($moff + $malign - 1) div $malign) * $malign, $malign, $fields])
            ! defined($layouts, $name) : "'struct {}' is defined twice" of $name
            ! size($members) = 0
                : "'struct {}' has no members, which C11 6.7.2.1 forbids and this cc allows as an extension"
                    of $name .

  (* What a declaration's base is worth: a width, an alignment, and the tag
   * or "". A tag nothing defined is refused, **except** the one being
   * defined, which answers the default: a width of 0, which no complete type
   * has and which the members below read as *not yet complete*. C allows a
   * pointer to a struct nobody ever defines; this subset does not, yet,
   * because the only program here that needs one is a list, and a list
   * names its own struct. *)
  (* A typedef is its base and its stars, worked out once here and read by
   * every declaration that names it. C11 6.7p3 lets a typedef be declared
   * again **to the same type**, so a second one is refused only when it
   * says something different. *)
  Typedef : means    = [$base.basew, $base.align, $base.tagname, $stars + $base.ptrs]
          : typedefs = bind($typedefs, $name, $means)
          ! defined($typedefs, $name)
              and lookup($typedefs, $name, empty)
                  <> [$base.basew, $base.align, $base.tagname, $stars + $base.ptrs]
              : "'{}' is a typedef twice, for two different types" of $name .

  (* **A declaration's stars are its own and its typedef's**: `intp *q` with
   * `typedef int *intp` is two. A base that is a keyword or a tag has none,
   * and `ptrs` is the sum every declaration below reads in place of its
   * `stars` field. *)
  Named : means   = lookup($typedefs, $name, [4, 4, "", 0])
        : basew   = at($means, 1)
        : align   = at($means, 2)
        : tagname = at($means, 3)
        : ptrs    = at($means, 4) .

  SizeOfType : ptrs = $stars + $base.ptrs .

  Base : ptrs    = 0
       : layout  = lookup($layouts, $name, [0, 1, empty])
       : basew   = at($layout, 1)
       : align   = at($layout, 2)
       : tagname = lookup([["int", ""], ["char", ""]], $name, $name)
       ! not defined($layouts, $name) and $name <> $defining
           : "'struct {}' is not defined" of $name .

  (* A member starts at the next offset its alignment allows. An element is
   * aligned as its base is, or to eight when it is a pointer, and an array as
   * its element is. *)
  MemberScalar : ptrs   = $stars + $base.ptrs
               : basew  = $base.basew
               : ebytes = lookup([[0, $basew]], $ptrs, 8)
               : ealign = lookup([[0, $base.align]], $ptrs, 8)
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, 0, $basew, $base.tagname])
               : moff   = $offset + $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
               ! defined($fields, $name) : "'{}' is a member twice" of $name
               ! $stars + $base.ptrs = 0 and $base.basew = 0
                   : "'struct {}' is not complete inside its own definition, so it cannot be a member of itself; a pointer to it can"
                       of $base.name .
  MemberArray  : ptrs   = $stars + $base.ptrs
               : basew  = $base.basew
               : ebytes = lookup([[0, $basew]], $ptrs, 8)
               : ealign = lookup([[0, $base.align]], $ptrs, 8)
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, $count, $basew, $base.tagname])
               : moff   = $offset + $count * $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
               ! $count < 1
                   : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                       of $name
               ! defined($fields, $name) : "'{}' is a member twice" of $name
               ! $stars + $base.ptrs = 0 and $base.basew = 0
                   : "'struct {}' is not complete inside its own definition, so it cannot be a member of itself; a pointer to it can"
                       of $base.name .

  Prototype : down env    = empty
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : funcs = bind($funcs, $name, size($params)) .

  Function  : down env    = empty
            : down scope  = empty
            : down bytes  = 0
            : down pindex = 0
            : down funcs  = bind($funcs, $name, size($params))
            : frame = $bytes .

  (* A parameter is a scalar or a pointer and never an array, because the
   * subset has no declarator for one and C would have rewritten it to a
   * pointer if it had. So it takes eight bytes like any scalar.
   *
   * **A struct passed whole is refused.** AAPCS64 passes one of up to
   * sixteen bytes in registers, packed, and a larger one by a hidden
   * pointer to a copy, and neither is a register holding a value, which is
   * all this subset's calls are. A pointer to a struct is a pointer. *)
  Param : ptrs   = $stars + $base.ptrs
        : basew  = $base.basew
        : offset = $bytes + 8
        : preg   = $pindex
        : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname])
        : scope  = bind($scope, $name, true)
        : bytes  = $bytes + 8
        : pindex = $pindex + 1
        ! defined($scope, $name) : "'{}' is a parameter twice" of $name
        ! $stars + $base.ptrs = 0 and $base.tagname <> ""
            : "'{}' is a struct passed whole, and only a pointer to one is compiled" of $name .

  Call ! not defined($funcs, $name)
           : "'{}' is called before it is declared" of $name
       ! defined($funcs, $name) and size($args) <> lookup($funcs, $name, 0)
           : "'{}' takes {} arguments, and this gives {}"
               of $name, lookup($funcs, $name, 0), size($args) .

  (* A block is a scope: its declarations are torn down on the way out and
   * the enclosing tables come back. The byte counter is *not* restored,
   * because frame space is taken whether or not the name for it is still in
   * sight, and two blocks side by side may as well not share any. *)
  Block : down held      = $env
        : down heldscope = $scope
        : down scope     = empty
        : env   = $held
        : scope = $heldscope .

  (* A scalar is eight bytes of frame whether it is a one-byte `char`, a
   * four-byte `int` or an eight-byte pointer, and binds a count of zero,
   * which is what *not an array* is spelled as everywhere below. A struct is
   * its size rounded up to eight, the way an array is. *)
  Local     : ptrs   = $stars + $base.ptrs
            : basew  = $base.basew
            : takes  = ((lookup([[0, $basew]], $ptrs, 8) + 7) div 8) * 8
            : offset = $bytes + $takes
            : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname])
            : scope  = bind($scope, $name, true)
            : bytes  = $bytes + $takes
            ! defined($scope, $name) : "'{}' is declared twice" of $name .
  (* **The name is bound on the way out**, after its initialiser has been
   * walked, so `int x = sizeof(x);` finds no `x` and is refused. C11 6.2.1p7
   * starts the scope at the end of the declarator, before the `=`, and `cc`
   * answers 4. A refusal and not a wrong answer, and so left; the parse gets
   * this right for a typedef hidden by its own local, see `%names`.
   *
   * A declaration with an initialiser is never an array: the subset has no
   * way to write the initialiser one would want. Nor is it a struct, which
   * would be a copy of one, and a struct is not copied whole here: see
   * `Assign` in the `types` pass. *)
  LocalInit : ptrs   = $stars + $base.ptrs
            : basew  = $base.basew
            : offset = $bytes + 8
            : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname])
            : scope  = bind($scope, $name, true)
            : bytes  = $bytes + 8
            ! defined($scope, $name) : "'{}' is declared twice" of $name
            ! $stars + $base.ptrs = 0 and $base.tagname <> ""
                : "'{}' is a struct initialised from another, which copies it whole, and that is not compiled" of $name .

  (* An element is one byte, four or eight, or a struct's size, the whole
   * thing is `count` of them, and what the frame gives it is that rounded up to eight.
   *
   * A count of zero is refused rather than bound, and that is what keeps
   * *count of zero* free to mean *not an array* in every table and test
   * below. C11 6.7.6.2 wants a size greater than zero; this `cc` takes
   * `int a[0]` as an extension and gives it a `sizeof` of 0, so without the
   * refusal it is a program both compile and answer differently. *)
  LocalArray : ptrs   = $stars + $base.ptrs
             : basew  = $base.basew
             : ebytes = lookup([[0, $basew]], $ptrs, 8)
             : whole  = $count * $ebytes
             : takes  = (($whole + 7) div 8) * 8
             : offset = $bytes + $takes
             : env    = bind($env, $name, [$offset, $ptrs, $count, $basew, $base.tagname])
             : scope  = bind($scope, $name, true)
             : bytes  = $bytes + $takes
             ! $count < 1
                 : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
                     of $name
             ! defined($scope, $name) : "'{}' is declared twice" of $name .

  (* The five once, and their parts named from them. `Assign` has no clause
   * here: what it assigns to is a place, and the question is asked where the
   * name is rather than twice. *)
  Variable : means   = lookup($env, $name, [0, 0, 0, 4, ""])
           : offset  = at($means, 1)
           : stars   = at($means, 2)
           : count   = at($means, 3)
           : basew   = at($means, 4)
           : tagname = at($means, 5)
           ! not defined($env, $name) : "'{}' is not declared" of $name .

  (* A member cannot be looked up here, because which struct it is in is the
   * `types` pass's to work out, and a thread is not something a later pass
   * can read. So the table is kept at the node, as it stood when the walk
   * reached it, for the pass that can use it. *)
  Member : known = $layouts .

(* ------------------------------------------------------------------ *)
(* Pass three: how many stars, and what that makes impossible.         *)
(*                                                                     *)
(* Every value travels in one sixty-four-bit register, an `int` in its  *)
(* low half, so almost nothing comes out wrong from a pointer being     *)
(* taken for an `int`: the emit pass picks the half from the star count *)
(* worked out here, and that is all it asks. The places where C says    *)
(* more than that are what this pass is for, and there were two before  *)
(* `struct`.                                                            *)
(*                                                                     *)
(* One is `p + 1`, which C11 6.5.6 says is the **next int** and not the *)
(* next byte, so the answer is a pointer and the emit pass has to know  *)
(* how wide a step is. It was refused by name until a size arrived with *)
(* arrays; it is now a type this pass works out. The other is `*x` on   *)
(* an `int`, which C11 6.5.3.2 forbids and which would compile here     *)
(* into a load from whatever the int happened to be.                   *)
(*                                                                     *)
(* **A struct is the third.** A member is found by which struct it is   *)
(* in, so an expression carries that as `tag`, and a struct is a thing  *)
(* in memory that no register holds, so the places that would copy one  *)
(* whole are refused rather than compiled into a copy of its address.   *)
(*                                                                     *)
(* What this pass deliberately does **not** do is check that what is    *)
(* assigned, or passed, has the type it is given. C11 6.5.16.1 has a    *)
(* table for that and `cc` warns from it, but nothing compiled here     *)
(* comes out wrong for getting it wrong, and a check that only          *)
(* reproduces somebody else's diagnostic is a second opinion rather     *)
(* than a compiler. This pass refuses what it would otherwise           *)
(* mis-compile, and nothing else.                                       *)
(*                                                                     *)
(* That was first argued against an eight-byte `int`, where a pointer   *)
(* put in an `int` and taken out again kept sixty-four bits here and    *)
(* thirty-two under `cc`. Since `int` narrowed the two agree, and the   *)
(* program is one this `cc` refuses to compile anyway. See journal      *)
(* 2026-09-22.                                                          *)

%pass types

  (* Zero is "not a pointer", which is what a statement is, what a program is,
   * and what every node that is not an expression is. Saying it once here is
   * what keeps the clauses below to the nodes that have something to say. *)
  otherwise type = 0

  (* **A type is two numbers since `char`**: how many stars, and how wide the
   * thing at the bottom of them is, 4 for an `int` and 1 for a `char`. The
   * second was always 4 and so was never written, until there was a second
   * answer. It is carried by the expressions that have a pointer's or a
   * place's type, a name, a `*`, a `&`, an assignment and pointer
   * arithmetic, and everything else is 4. That default is **C11 6.3.1.1's
   * integer promotion**: a `char` in an expression is an `int` before any
   * operator sees it, so `c + 1`, `-c` and `c < d` are all `int`s, and only
   * a thing that is still a place, or points at one, can be narrower.
   *
   * `struct` was expected to be where two numbers stop being enough, because
   * a member has a type of its own and a number cannot hold one. It needed a
   * **third** and not a node: the member's type is looked up by the struct's
   * tag, in the table the `locals` pass built, so what an expression has to
   * carry is only which struct it is. The node went to the base of a
   * declaration instead, in the grammar. *)
  otherwise width = 4

  (* The third number, which is text: the tag of the struct at the bottom of
   * the stars, or "" when it is an `int` or a `char`. A struct value is
   * `type` 0 with a tag, and a pointer to one has stars and the same tag. *)
  otherwise tag = ""

  (* **Whether the value is its own address.** An array and a struct are
   * both things in memory that no register holds: an array decays to the
   * address of its first element, and a struct is only ever reached through
   * its address, by a member or by `&`. The emit pass reads this to leave out
   * the load a scalar would have, and `Assign` to refuse both. *)
  otherwise aggregate = false

  (* And a size falls out of the type for everything except a name, because a
   * name is the only thing that can be an array: no operator here answers
   * one. `Variable` therefore says its own and this covers the rest. *)
  otherwise size = lookup([[0, $width]], $type, 8)

  (* **A name that is an array decays**, C11 6.3.2.1: in an expression it is a
   * pointer to its first element, so its `type` has one more star than it was
   * declared with. Its `size` does **not** decay, because `sizeof` is one of
   * the places C says the conversion does not happen, and the two attributes
   * being separate is what lets one of them answer a decayed question and the
   * other an undecayed one without either knowing about `sizeof`. *)
  Variable : width = $basew
           : tag   = $tagname
           : elem  = lookup([[0, $width]], $stars, 8)
           : type  = lookup([[0, $stars]], $count, $stars + 1)
           : size  = lookup([[0, $elem]], $count, $count * $elem)
           : aggregate = $count > 0 or ($stars = 0 and $tag <> "") .
  Addr     : type  = $place.type + 1
           : width = $place.width
           : tag   = $place.tag .
  (* An array is not an lvalue, C11 6.3.2.1 again: it decays before anything
   * can be assigned to it, so there is nothing to assign to. Without this the
   * emit pass would store through the array's address and write element
   * zero, which is a wrong answer rather than a refusal.
   *
   * **A struct is an lvalue and C assigns it whole**, 6.5.16.1, which is a
   * copy of its bytes. That is a loop, or a call to `memcpy`, and not a
   * store, so it is refused here rather than compiled into a store of the
   * source's address into the destination's first eight bytes. The two
   * cases are told apart by the decay: an array's `type` has a star its
   * declaration did not, and a struct's has none. *)
  Assign   : type  = $place.type
           : width = $place.width
           : tag   = $place.tag
           ! $place.aggregate and $place.type > 0
               : "an array is not something a value can be put in"
           ! $place.aggregate and $place.type = 0
               : "'struct {}' is assigned whole, which copies it, and that is not compiled"
                   of $place.tag .
  (* A struct as an argument is the parameter's refusal seen from the call:
   * AAPCS64 passes one in a way that is not a register holding a value. *)
  Arg      : type = $value.type
           ! $value.aggregate and $value.type = 0
               : "'struct {}' is passed whole, and only a pointer to one is compiled"
                   of $value.tag .
  Deref    : type  = $value.type - 1
           : width = $value.width
           : tag   = $value.tag
           : aggregate = $type = 0 and $tag <> ""
           ! $value.type < 1
               : "'*' wants a pointer, and this is {}"
                   of lookup([["", "an int"]], $value.tag, "a struct") .

  (* **A member is the struct's layout read at the member's name.** The
   * entry is the same five things a name's is, where it is, its stars, its
   * count, its width and its tag, and everything a `Variable` works out from
   * those it works out the same way: an array member decays and a struct
   * member is its own address. The offset is kept for the emit pass.
   *
   * `->` built `(*p).x` in the grammar, so there is one node and these two
   * checks between them cover both: a `->` on what is not a pointer was
   * already refused by the `*`, and what is left is a member asked of
   * something that is not a struct, or of a struct that has no such member.
   *
   * `$known` is the table the `locals` pass kept at this node, which is every
   * struct defined above the function. *)
  Member : entry = lookup(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name,
                          [0, 0, 0, 4, ""])
         : width = at($entry, 4)
         : tag   = at($entry, 5)
         : elem  = lookup([[0, $width]], at($entry, 2), 8)
         : type  = lookup([[0, at($entry, 2)]], at($entry, 3), at($entry, 2) + 1)
         : size  = lookup([[0, $elem]], at($entry, 3), at($entry, 3) * $elem)
         : aggregate = at($entry, 3) > 0 or (at($entry, 2) = 0 and $tag <> "")
         ! $value.type <> 0 or $value.tag = ""
             : "'{}' is asked for as a member of something that is not a struct" of $name
         ! $value.type = 0 and $value.tag <> ""
               and not defined(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name)
             : "'struct {}' has no member '{}'" of $value.tag, $name .

  Negate ! $value.type > 0 : "'-' wants a number, and this is a pointer" .

  (* `sizeof` is worth an `int` here and a `size_t` in C. `size_t` is a
   * **typedef**, which this subset stopped before on purpose, and was to be
   * revisited when `typedef` arrived. It has arrived and the answer stays an
   * `int`: what `size_t` names on this machine is an `unsigned long`, and
   * the subset has neither `unsigned` nor `long` to name, which is step four
   * of the arc and not step three. The cost is still one program: `sizeof(sizeof(int))` is 8 under `cc` and 4 here, and it is
   * written down in `tests/divergent/` with a check that it still diverges,
   * rather than compiled around. Everything else about `sizeof` agrees,
   * because the answers themselves, 4 and 8, are the ones `cc` gives. *)
  SizeOfType : type = 0 .
  SizeOfExpr : type = 0 .

  (* **A character constant is an `int`**, C11 6.4.4.4, which the defaults
   * above already say: no stars, four bytes, so `sizeof 'a'` is 4 as C has
   * it and not 1 as C++ does. What this adds is its **code**.
   *
   * The notation has no function from a character to its code, and does not
   * need one here. The ninety-five printable characters are written out in
   * order, and a character's code is how much of that text comes before it,
   * plus the 32 the table starts at: `split` at the character, and measure
   * the first piece. An escape is looked up first, because its text is two
   * characters and is not in the table. The lexer has already refused
   * anything that is neither, so the measurement never meets a character it
   * cannot find. `char-constant-every-one.c` walks the whole table. *)
  (* **A string literal is an array of `char`**, C11 6.4.5, one longer than
   * its characters for the NUL at the end, and it decays like any array: its
   * `type` is a pointer to `char` and its `size` is the whole array, so
   * `sizeof "abc"` is 4 and `"abc"[1]` is `'b'`.
   *
   * The length is counted rather than walked, because the notation has no
   * way to walk text. Every escape is two characters in the source and one
   * in the array, so the length is the text less one per escape. Counting
   * the escapes is counting backslashes, except that `\\` is two of them
   * and one escape. So the escaped backslashes are replaced first, by a
   * tab, which the lexer guarantees is not in the text; after that every
   * backslash left begins an escape of its own. Splitting at `\\` finds the
   * same pairs the escapes are made of, because both read left to right and
   * nothing else in an escape is a backslash.
   *
   * `string-length-agrees.c` holds this against the bytes the assembler
   * wrote, counted by walking them. *)
  String : body   = slice($text, 2, size($text) - 1)
         : single = join(split($body, "\\\\"), "\t")
         : length = size($single) - (size(split($single, "\\")) - 1)
         : type   = 1
         : width  = 1
         : size   = $length + 1 .

  Character : inner = slice($text, 2, size($text) - 1)
            : code  = lookup([["\\n", 10], ["\\t", 9], ["\\\\", 92], ["\\'", 39],
                              ["\\\"", 34], ["\\0", 0]], $inner,
                             size(at(split(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~",
                                           $inner), 1)) + 32) .

  (* C11 6.5.6 lets `+` take a pointer and an integer in either order, and `-`
   * a pointer and then an integer, and counts the integer in what the pointer
   * points at. The answer is a pointer of the same type, which is why the
   * type is a **sum** for `+`: exactly one side has stars, and the other adds
   * none. Counting in elements is the emit pass's, which reads the element's
   * width off this type.
   *
   * These were refusals until 2026-09-22, standing in for a size the subset
   * did not have. They are now the things C itself refuses.
   *
   * **The difference of two pointers is an `int`**, which is the count of
   * elements between them. C11 6.5.6 makes it a `ptrdiff_t`, and that is a
   * typedef, so this is `sizeof`'s decision taken a second time and for the
   * same reason, and an `int` is what the difference was in K&R's first
   * edition, before ANSI C named a type for it. `tests/divergent/` pins the
   * one program that shows it. Revisited with `typedef`, as `sizeof` was, and
   * kept for `sizeof`'s reason: a `ptrdiff_t` is a `long`, which waits for
   * `long`. The type is a difference of star
   * counts, which is 0 for two pointers of one type and the pointer's own for
   * a pointer less an int; two pointers of **different** types are refused,
   * as 6.5.6 requires, and that is also what keeps the difference from
   * coming out as a type no value has. *)
  (* The width of a sum is the pointer's, from whichever side it is on, and
   * 4 when there is no pointer, which is the promotion above. *)
  Binary(op: "+") : type  = $left.type + $right.type
                  : width = lookup([[0, 4]], $type,
                                   lookup([[0, $right.width]], $left.type, $left.width))
                  : tag   = lookup([[0, ""]], $type,
                                   lookup([[0, $right.tag]], $left.type, $left.tag))
      ! $left.type > 0 and $right.type > 0
          : "'+' does not add two pointers" .
  Binary(op: "-") : type  = $left.type - $right.type
                  : width = lookup([[0, 4]], $type, $left.width)
                  : tag   = lookup([[0, ""]], $type, $left.tag)
      ! $left.type = 0 and $right.type > 0
          : "'-' does not take a pointer from a number"
      ! $left.type > 0 and $right.type > 0
            and ($left.type <> $right.type or $left.width <> $right.width
                 or $left.tag <> $right.tag)
          : "'-' takes two pointers only when they point at the same type" .
  (* C11 6.5.5 wants arithmetic on both sides of `*` and `/`, so a pointer on
   * either is C's own refusal rather than this subset's. *)
  Binary ! $left.type > 0 or $right.type > 0
      : "'{}' does not take a pointer" of $op .
