  (* **A declaration with an initialiser in braces, or an array with one**,
   * since ROADMAP 6.13's first part. The declarator is worked out as an
   * array's or a scalar's is, and its initialiser is walked below, with the
   * declarator's parts handed down to it, since the type they make is not
   * worked out until they have been walked, after this node is entered. An
   * array of no stated size has as many elements as the walk reached. *)
  LocalAgg    : down abase    = $base
              : down early   = size($paren) = 0 and $count = 0 and $unsized = 0
              : down elv     = "{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv
              : down eptrs   = lookup([[true, size(at(split($elv, "a:"), 1)) div 8]], size(at(split($elv, "a:"), 1)) < size(at(split($elv, "b:"), 1)), size(at(split($elv, "b:"), 1)) div 8)
              : down etakes  = ((int(at(split(at(split($elv, "|"), 1), ":"), 2)) + 7) div 8) * 8
              : down obytes  = $bytes
              : down bytes   = lookup([[true, $bytes + $etakes]], $early, $bytes)
              : down env     = lookup([[true, bind($env, $name, [$obytes + $etakes, $eptrs, 0, $base.basew, $base.tagname, false, false, $base.buns, "", ("{}{}" of $base.bquals, $squals), $base.sreg, $elv])]],
                                      $early, $env)
              : down heldown = $ownname
              : down ownname = lookup([[true, $ownname]], $early, $name)
              : ownname = $heldown
              : down astars   = $stars
              : down adims    = $dims
              : down aparen   = $paren
              : down acount   = $count
              : down aunsized = $unsized
              : down aname    = $name
              : down atop     = true
              : down myobj    = ""
              : down lb       = 0
              : down dset     = false
              : down dobj     = ""
              : down iback    = false
              : down icur     = 0
              : down iend     = 0
              : down dbase   = $base
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                size($paren), join($paren.t))
              : isarr  = $count > 0 or $unsized = 1
              : maxend = lookup([[true, $iend]], $iend > $icur, $icur)
              : ecount = lookup([[1, ($maxend + lookup([[0, 1]], int(at(split(at(split($lvin, "|"), 1), ":"), 2)), int(at(split(at(split($lvin, "|"), 1), ":"), 2))) - 1) div lookup([[0, 1]], int(at(split(at(split($lvin, "|"), 1), ":"), 2)), int(at(split(at(split($lvin, "|"), 1), ":"), 2)))]], $unsized, $count)
              : lv     = lookup([[true, "a:{}:{}:{}|{}" of $ecount * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $ecount, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin]], $isarr, $lvin)
              : ptrs   = lookup([[true, size(at(split(lookup([[true, $lvin]], $isarr, $lv), "a:"), 1)) div 8]], size(at(split(lookup([[true, $lvin]], $isarr, $lv), "a:"), 1)) < size(at(split(lookup([[true, $lvin]], $isarr, $lv), "b:"), 1)), size(at(split(lookup([[true, $lvin]], $isarr, $lv), "b:"), 1)) div 8)
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : whole  = int(at(split(at(split($lv, "|"), 1), ":"), 2))
              : tail   = $whole - $iend
              : back   = $iback
              : takes  = (($whole + 7) div 8) * 8
              : offset = lookup([[true, $obytes + $takes]], $early, $bytes + $takes)
              : env    = bind($env, $name, [$offset, $ptrs, $ecount, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg, $lv])
              : scope  = bind($scope, $name, true)
              : bytes  = lookup([[true, $bytes]], $early, $bytes + $takes)
              ! $unsized = 1 and $icur < 1
                  : "'{}' is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension" of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
                  : "'{}' is declared 'void', and an object's type has to be complete, C11 6.7p7" of $name
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0
                  : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
              ! $base.unsup = "" and $base.nstore < 2 and $base.tdef
                  : "'{}' is a typedef, and only an object has an initialiser, C11 6.7.9" of $name
              ! $base.unsup = "" and $base.nstore < 2 and $base.sext
                  : "'{}' is declared 'extern' in a block, and C11 6.7.9p5 gives it no initialiser" of $name
              ! defined($scope, $name) : "'{}' is declared twice" of $name
              ! $base.unsup = "" and $base.nstore < 2 and $base.stat and $dkind <> "for"
                  : "'{}' is 'static' and was read as a local that is not: a fault in c.phx, and not in the program" of $name .
  (* **A compound literal's object**, since ROADMAP 6.13's fourth part, is
   * worked out as a declaration's with an initialiser in braces is, and its
   * initialiser walked the same way. In a function it is a `LocalAgg`'s, a
   * slot in the frame, C11 6.5.2.5p5's automatic storage; at file scope a
   * `StaticAgg`'s, data under a label, which is its key. The key is where
   * it is written, `lit.5.14`, which no C name can spell, and the `Variable`
   * around it looks it up. *)
  Literal     : down abase    = $base
              : down astars   = $stars
              : down adims    = $dims
              : down aparen   = $paren
              : down acount   = $count
              : down aunsized = $unsized
              : down aname    = "(compound literal)"
              : down atop     = true
              : down myobj    = ""
              : down lb       = 0
              : down dset     = false
              : down dobj     = ""
              : down iback    = false
              : down icur     = 0
              : down iend     = 0
              : down dbase   = $base
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                size($paren), join($paren.t))
              : isarr  = $count > 0 or $unsized = 1
              : maxend = lookup([[true, $iend]], $iend > $icur, $icur)
              : ecount = lookup([[1, ($maxend + lookup([[0, 1]], int(at(split(at(split($lvin, "|"), 1), ":"), 2)), int(at(split(at(split($lvin, "|"), 1), ":"), 2))) - 1) div lookup([[0, 1]], int(at(split(at(split($lvin, "|"), 1), ":"), 2)), int(at(split(at(split($lvin, "|"), 1), ":"), 2)))]], $unsized, $count)
              : lv     = lookup([[true, "a:{}:{}:{}|{}" of $ecount * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $ecount, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin]], $isarr, $lvin)
              : ptrs   = lookup([[true, size(at(split(lookup([[true, $lvin]], $isarr, $lv), "a:"), 1)) div 8]], size(at(split(lookup([[true, $lvin]], $isarr, $lv), "a:"), 1)) < size(at(split(lookup([[true, $lvin]], $isarr, $lv), "b:"), 1)), size(at(split(lookup([[true, $lvin]], $isarr, $lv), "b:"), 1)) div 8)
              : basew  = $base.basew
              : dquals = "{}{}" of $base.bquals, $squals
              : whole  = int(at(split(at(split($lv, "|"), 1), ":"), 2))
              : tail   = $whole - $iend
              : back   = $iback
              : takes  = lookup([[true, (($whole + 7) div 8) * 8]], $infunc, 0)
              : offset = $bytes + $takes
              : lfile  = not $infunc
              : lname  = "lit.{}.{}" of $pos.line, $pos.column
              : galign = int(at(split(at(split($lv, "|"), 1), ":"), 4))
              : env    = bind($env, $lname, lookup([[true, [$offset, $ptrs, $ecount, $basew, $base.tagname, false, false, $base.buns, "", $dquals, false, $lv]]], $infunc,
                                                   [0, $ptrs, $ecount, $basew, $base.tagname, true, true, $base.buns, $lname, $dquals, false, $lv]))
              : bytes  = $bytes + $takes
              ! $unsized = 1 and $icur < 1
                  : "a compound literal is an array of no elements, which C11 6.7.6.2 forbids and this cc allows as an extension"
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
                  : "a compound literal is of 'void', and an object's type has to be complete, C11 6.5.2.5p1"
              ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0
                  : "a compound literal is of 'struct {}', which is not complete here, C11 6.5.2.5p1" of at(split($base.tagname, "."), 1) .
  StaticAgg   : down abase    = $base
              : down early   = size($paren) = 0 and $count = 0 and $unsized = 0
              : down elv     = "{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv
              : down eptrs   = lookup([[true, size(at(split($elv, "a:"), 1)) div 8]], size(at(split($elv, "a:"), 1)) < size(at(split($elv, "b:"), 1)), size(at(split($elv, "b:"), 1)) div 8)
              : down env     = lookup([[true, bind($env, $name, [0, $eptrs, 0, $base.basew, $base.tagname, true, true, $base.buns, ("{}.{}.{}" of $fn, $name, $statics), ("{}{}" of $base.bquals, $squals), false, $elv])]],
                                      $early, $env)
              : down heldown = $ownname
              : down ownname = lookup([[true, $ownname]], $early, $name)
              : ownname = $heldown
              : down astars   = $stars
              : down adims    = $dims
              : down aparen   = $paren
              : down acount   = $count
              : down aunsized = $unsized
              : down aname    = $name
              : down atop     = true
              : down myobj    = ""
              : down lb       = 0
              : down dset     = false
              : down dobj     = ""
              : down iback    = false
              : down icur     = 0
              : down iend     = 0
              : down dbase   = $base
              : down dstars  = $stars
              : down inparen = false
              : down pP      = ""
              : down pouter  = $dims
              : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
