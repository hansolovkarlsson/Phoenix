            ! $base.sext and defined($globals, $name) and [at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 2), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 3), lookup([[true, 0]], at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "" and at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5) <> "void", at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 4)), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 5), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 8), at(lookup($globals, $name, [0, 0, 0, 0, "", true, false, false, "", "0", false, "b:4:0:4"]), 10)] <> [$stars + $base.ptrs, 0, lookup([[true, 0]], $base.tagname <> "" and $base.tagname <> "void", $base.basew), $base.tagname, $base.buns, "{}{}" of $base.bquals, $squals]
                : "'{}' is declared again with another type, C11 6.7p4" of $name .
  (* **The name is in scope in its own initialiser**, C11 6.2.1p7, which
   * starts the scope at the end of the declarator, before the `=`: `int x =
   * sizeof(x);` is 4, and `T *p = calloc(n, sizeof *p)` is how Proem writes
   * an allocation, thirteen times. Until the probe of Proem's source on
   * 2026-10-02 the name was bound on the way out only, after the
   * initialiser, and refused as undeclared.
   *
   * So it is bound **on the way in** too, which needs everything its entry
   * holds before the children are walked. Without parentheses in the
   * declarator the type text is the stars and the base, which the
   * specifiers, a sibling walked already, give; with them it is the
   * `Paren` child's, worked out on its way out. That form was refused by
   * name through `ownname`, which the initialiser's `Variable` reads, until
   * 2026-10-05, when the `Paren` was made to bind it: it is walked before
   * the initialiser, its sibling, so what it puts in the thread on its way
   * out is what the initialiser is walked with. This rule hands it the
   * entry's other fields as `pown`, and the `Paren` adds the three its type
   * text gives and claims the slot, so this rule's own byte count leaves
   * it alone, which has no witness for the reason `LocalAgg`'s below has
   * none; `StaticInit` and `GlobalInit` do the same. The slot is claimed on the way in as well, the frame thread set
   * past it for the initialiser, because an initialiser can take frame
   * bytes of its own, a compound literal, and the early and the late entry
   * have to name the same slot. `own-initialiser.c` takes the address of
   * its own name beside a compound literal. The parse gets the typedef
   * case right on its own, see `%names`.
   *
   * **The same early entry is made in braces, in a `static` and in a
   * global**, since 2026-10-04, `struct node x = { &x, sizeof x }`, by
   * `LocalAgg`, `StaticInit`, `StaticAgg`, `GlobalInit` and `GlobalAgg`.
   * A `static`'s label is its own on the way in, since only a `static`
   * declaration moves `statics`; a global's entry goes in the `env` its
   * initialiser is walked with, and not in `globals`, whose checks ask
   * what was declared before it. `LocalAgg` claims its slot first, as
   * this rule does; *the byte count it hands on has no witness*, since
   * counting the slot twice makes a frame larger and every offset still
   * right. **An array in braces is still refused by name**: its
   * size may be what its initialiser counts, which is not known on the way
   * in.
   *
   * A declaration with an initialiser is never an array: the subset has no
   * way to write the initialiser one would want. It may be a struct, since
   * 2026-09-23, which is copied into the frame, so it takes what a `Local`
   * takes; the `types` pass checks the two are the same kind. *)
  LocalInit : down dbase   = $base
            : down dstars  = $stars
            : down inparen = false
            : down pP      = ""
            : down pouter  = $dims
            : down early   = size($paren) = 0
            : down pearly  = size($paren) > 0
            : down pown    = lookup([[true, [$name, true, $base.basew, $base.tagname, false, false, $base.buns, "", ("{}{}" of $base.bquals, $squals), $base.sreg]]], $pearly, $pown)
            : down elv     = "{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv
            : down eptrs   = lookup([[true, size(at(split($elv, "a:"), 1)) div 8]], size(at(split($elv, "a:"), 1)) < size(at(split($elv, "b:"), 1)), size(at(split($elv, "b:"), 1)) div 8)
            : down etakes  = ((int(at(split(at(split($elv, "|"), 1), ":"), 2)) + 7) div 8) * 8
            : down obytes  = $bytes
            : down heldown = $ownname
            : down ownname = lookup([[true, $ownname]], $early, $name)
            : down bytes   = lookup([[true, $bytes + $etakes]], $early, $bytes)
            : down env     = lookup([[true, bind($env, $name, [$obytes + $etakes, $eptrs, 0, $base.basew, $base.tagname, false, false, $base.buns, "", ("{}{}" of $base.bquals, $squals), $base.sreg, $elv])]],
                                    $early, $env)
            : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                              size($paren), join($paren.t))
            : lv     = $lvin
            : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
            : basew  = $base.basew
            : dquals = "{}{}" of $base.bquals, $squals
            : takes  = ((int(at(split(at(split($lv, "|"), 1), ":"), 2)) + 7) div 8) * 8
            : offset = lookup([[true, $obytes + $takes]], $early or $pearly, $bytes + $takes)
            : env    = bind($env, $name, [$offset, $ptrs, 0, $basew, $base.tagname, false, false, $base.buns, "", $dquals, $base.sreg, $lv])
            : scope  = bind($scope, $name, true)
