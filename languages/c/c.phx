  Program : down callees = $allsigs
          : down arities = $allfuncs
          : down results = $allrets
          : down wides   = $allpwidths
          : down plvs    = $allplvs .
  Call : down sig    = lookup($callees, $ckey, [])
       : down plv    = lookup($plvs, $ckey, [])
       : down unproto = at(lookup($arities, $ckey, [0, 0]), 2) = 2
       : down callee = lookup([["", "a pointer to a function"]], $fn.vname, "'{}'" of $fn.vname)
       : down held   = $argi
       : down argi   = 0
       : argi        = $held
       ! at(lookup($arities, $ckey, [0, 0]), 2) = 0 and size($args) <> at(lookup($arities, $ckey, [0, 0]), 1)
           : "{} takes {} arguments, and this gives {}" of lookup([["", "a pointer to a function"]], $fn.vname, "'{}'" of $fn.vname), at(lookup($arities, $ckey, [0, 0]), 1), size($args)
       ! at(lookup($arities, $ckey, [0, 0]), 2) = 1 and size($args) < at(lookup($arities, $ckey, [0, 0]), 1)
           : "{} takes at least {} arguments, and this gives {}" of lookup([["", "a pointer to a function"]], $fn.vname, "'{}'" of $fn.vname), at(lookup($arities, $ckey, [0, 0]), 1), size($args) .
  Arg      : argi = $argi + 1
           ! $value.record and $value.tag = "void"
               : "{} is given the value of something 'void', which has none" of $callee
           ! $argi < size($sig) and $value.tag <> "void"
             and lookup([[true, $value.tag]], $value.record, "") <> at($sig, $argi + 1)
               : "{} is given a struct where its parameter is not that struct, or something else where its parameter is a struct"
                   of $callee
           ! $argi >= size($sig) and $value.record and $value.tag <> "void"
               : "{} is given a 'struct {}' {}, and a struct is not passed that way here"
                   of $callee, at(split($value.tag, "."), 1), lookup([[true, "where no prototype says what it takes"]], $unproto, "through '...'")
           (* **A pointer to a function is passed only as its own type**,
            * since 2026-10-04: the initialiser's four checks, against the
            * parameter's type from `plvs`. An argument through `...` has
            * none to be checked against. *)
