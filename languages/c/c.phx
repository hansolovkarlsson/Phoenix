  (* **The refusals a declaration's words make**, since ROADMAP 6.12's
   * first part, from what the `functions` pass worked out of them: a
   * keyword whose feature is not here, more than one storage class, and a
   * list of the words of a type that is no type, or `long long`. Each asks
   * that the one before it passed, so a declaration is refused once. *)
  Base : down hfields = $fields
       : down hmoff    = $moff
       : down hmalign  = $malign
       : down hmlist   = $mlist
       : fields  = $hfields
       : moff    = $hmoff
       : malign  = $hmalign
       : mlist   = $hmlist
       : tkey    = lookup([[true, $tname]], $name = "" and size($def) = 0,
                          lookup([[true, join($def.mykey)]], size($def) > 0, lookup($tags, $name, $name)))
       : ptrs    = 0
       : bquals  = lookup([[true, "1"]], size(split($words, " const ")) > 1, "0")
       : layout  = lookup($layouts, $tkey, [0, 1, empty, false])
       : hasconst = at($layout, 4)
       : basew   = at($layout, 1)
       : align   = at($layout, 2)
       : tagname = lookup([["int", ""], ["char", ""], ["long", ""], ["unsigned int", ""],
                           ["unsigned char", ""], ["unsigned long", ""], ["short", ""], ["unsigned short", ""], ["_Bool", ""]], $tkey, $tkey)
       : buns    = lookup([["unsigned int", true], ["unsigned char", true],
                           ["unsigned long", true], ["unsigned short", true], ["_Bool", true]], $tkey, false)
       (* **A `_Bool` is a byte with a mark**, since ROADMAP 6.15's third
        * part: `b:1:0:1:::B`, its seventh field `B`, which no other type's
        * text has, since every conversion into one is a test against zero
        * and not a narrowing, C11 6.3.1.2, and the places that convert ask
        * the text. The fifth and sixth fields, a struct's and a
        * function's, are empty. *)
       : blv     = lookup([[true, "b:1:0:1:::B"]], $tkey = "_Bool", lookup([[true, "b:{}:0:{}:{}" of $basew, $align, $tkey]], $tagname <> "" and $tagname <> "void",
                          "b:{}:0:{}" of $basew, $align))
       ! $unsup <> ""
           : lookup([["_Complex", "'_Complex' is optional in C11, and left out here, as __STDC_NO_COMPLEX__ says"],
                     ["_Imaginary", "'_Imaginary' is optional in C11, and left out here, as __STDC_NO_COMPLEX__ says"],
                     ["_Atomic", "'_Atomic' is optional in C11, and left out here, as __STDC_NO_ATOMICS__ says"]],
                    $unsup, "'{}' is C11's, and not this subset's yet" of $unsup)
       ! $unsup = "" and $nstore > 1
           : "this declaration has {} storage classes, and C11 6.7.1p2 allows one" of $nstore
       ! $unsup = "" and $nstore < 2 and $tname = ""
           : "'{}' is not one of the types C11 6.7.2p2 lists" of $display
       (* **An enumeration is named after its list**, C11 6.7.2.3p3, since
        * ROADMAP 6.15's fourth part: there is no `enum e;` before one, as
        * there is a `struct s;`. *)
       ! size(split($words, " enum ")) > 1 and size($def) = 0 and not defined($tags, $name)
           : "'enum {}' is named before its list, and C11 6.7.2.3p3 has no enumeration declared without one" of $name .

  (* A member starts at the next offset its alignment allows. An element is
   * aligned as its base is, or to eight when it is a pointer, and an array as
   * its element is. *)
  MemberScalar : down dbase   = $base
               ! $stars + size($paren) + size($dims) = 0 and at(split(("{}::::::" of at(split($base.blv, "|"), 1)), ":"), 6) <> ""
                   : "'{}' is a member of a function's type, which C11 6.7.2.1p3 does not allow; a pointer to one it does" of $name
               : down dstars  = $stars
               : down inparen = false
               : down pP      = ""
               : down pouter  = $dims
               : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                 size($paren), join($paren.t))
               : lv     = $lvin
               : ptrs   = lookup([[true, size(at(split($lv, "a:"), 1)) div 8]], size(at(split($lv, "a:"), 1)) < size(at(split($lv, "b:"), 1)), size(at(split($lv, "b:"), 1)) div 8)
               : basew  = $base.basew
               : dquals = "{}{}" of $base.bquals, $squals
               : mconst = lookup([[true, [1]]], slice($dquals, size($dquals), size($dquals)) = "1"
                                                or ($ptrs = 0 and $base.hasconst), [])
               : ebytes = int(at(split(at(split($lv, "|"), 1), ":"), 2))
               : ealign = int(at(split(at(split($lv, "|"), 1), ":"), 4))
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, 0, $basew, $base.tagname, $base.buns, $dquals, $lv])
               : mch    = slice("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&()*+,-./;<=>?@[]^_`", size($mlist) + 1, size($mlist) + 1)
               : mrun   = join(split(slice($dots, 1, $offset - $moff + lookup([[true, $ebytes]], $count = 0, $count * $ebytes)), "."), lookup([[true, $mch]], size($mlist) < 86, "?"))
               : mlist  = flatten([$mlist, [$name]])
               : moff   = $offset + $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
               ! defined($fields, $name) : "'{}' is a member twice" of $name
               ! $stars + $base.ptrs + size($paren) = 0 and $base.basew = 0 and $base.tagname = $defining
                   : "'struct {}' is not complete inside its own definition, so it cannot be a member of itself; a pointer to it can"
                       of $base.name
               ! $stars + $base.ptrs + size($paren) = 0 and $base.basew = 0 and $base.tagname <> "void" and $base.tagname <> ""
                 and $base.tagname <> $defining
                   : "'{}' is declared of 'struct {}', which is not complete here, C11 6.7p7" of $name, at(split($base.tagname, "."), 1)
               ! $stars + $base.ptrs + size($paren) = 0 and $base.tagname = "void"
                   : "'{}' is a member of type 'void', and a member's type has to be complete, C11 6.7.2.1p3" of $name .
  MemberArray  : down dbase   = $base
               : down dstars  = $stars
               : down inparen = false
               : down pP      = ""
               : down pouter  = $dims
               : lvin   = lookup([[0, lookup([[0, ("{}{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $stars, ""), $base.blv)]], size($dims), join($dims.t))]],
                                 size($paren), join($paren.t))
               : lv     = "a:{}:{}:{}|{}" of $count * int(at(split(at(split($lvin, "|"), 1), ":"), 2)), $count, int(at(split(at(split($lvin, "|"), 1), ":"), 4)), $lvin
               : ptrs   = lookup([[true, size(at(split($lvin, "a:"), 1)) div 8]], size(at(split($lvin, "a:"), 1)) < size(at(split($lvin, "b:"), 1)), size(at(split($lvin, "b:"), 1)) div 8)
               : basew  = $base.basew
               : dquals = "{}{}" of $base.bquals, $squals
               : mconst = lookup([[true, [1]]], slice($dquals, size($dquals), size($dquals)) = "1"
                                                or ($ptrs = 0 and $base.hasconst), [])
               : ebytes = int(at(split(at(split($lvin, "|"), 1), ":"), 2))
               : ealign = int(at(split(at(split($lvin, "|"), 1), ":"), 4))
               : offset = (($moff + $ealign - 1) div $ealign) * $ealign
               : fields = bind($fields, $name, [$offset, $ptrs, $count, $basew, $base.tagname, $base.buns, $dquals, $lv])
               : mch    = slice("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&()*+,-./;<=>?@[]^_`", size($mlist) + 1, size($mlist) + 1)
               : mrun   = join(split(slice($dots, 1, $offset - $moff + lookup([[true, $ebytes]], $count = 0, $count * $ebytes)), "."), lookup([[true, $mch]], size($mlist) < 86, "?"))
               : mlist  = flatten([$mlist, [$name]])
               : moff   = $offset + $count * $ebytes
               : malign = lookup([[true, $ealign]], $ealign > $malign, $malign)
