            : fblock  = lookup([[true, bind($fblock, $name, lookup($fblock, $name, true))]], $lfnty, $fblock)
            : funcs   = lookup([[true, bind($funcs, $name, lookup($funcs, $lfnkey, [0, 0]))]], $lfnty and not ($lfnun and defined($funcs, $name)), $funcs)
            : sigs    = lookup([[true, bind($sigs, $name, lookup($sigs, $lfnkey, []))]], $lfnty and not ($lfnun and defined($funcs, $name)), $sigs)
            : rets    = lookup([[true, bind($rets, $name, lookup($rets, $lfnkey, ["", 4, 0, false, "0"]))]], $lfnty and not ($lfnun and defined($funcs, $name)), $rets)
            : pwidths = lookup([[true, bind($pwidths, $name, lookup($pwidths, $lfnkey, []))]], $lfnty and not ($lfnun and defined($funcs, $name)), $pwidths)
            : plvs    = lookup([[true, bind($plvs, $name, lookup($plvs, $lfnkey, []))]], $lfnty and not ($lfnun and defined($funcs, $name)), $plvs)
            : tdfns   = lookup([[true, bind($tdfns, $name, lookup($funcs, $lfnkey, [0, 0]))]], $lfnty, $tdfns)
            ! $lfnty and defined($funcs, $name) and at(lookup($funcs, $name, [0, 0]), 2) <> 2 and not $lfnun
