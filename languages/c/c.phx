  (* **A designator's mistakes**, since ROADMAP 6.13's third part, as `cc`
   * refuses them, and the one this subset does: an index that is not a
   * number written out. *)
  Desig ! $dbad = "PAST"
            : "'{}' has a designator past the end of an array, C11 6.7.9p6" of $desname
        ! $dbad = "NOMEM"
            : "'{}' has a designator naming no member of the struct, C11 6.7.9p7" of $desname
        ! $dbad = "NOTS"
            : "'{}' has a '.' designator for something that is not a struct, C11 6.7.9p7" of $desname
        ! $dbad = "NOTA"
            : "'{}' has a '[ ]' designator for something that is not an array, C11 6.7.9p6" of $desname
        ! $dbad = "EXPR"
            : "'{}' has an array designator that is not a number written out, which this subset does not work out yet" of $desname .

  (* Zero is "not a pointer", which is what a statement is, what a program is,
   * and what every node that is not an expression is. Saying it once here is
   * what keeps the clauses below to the nodes that have something to say. *)
  otherwise type = 0

  (* **A type is two numbers since `char`**: how many stars, and how wide the
   * thing at the bottom of them is, 4 for an `int` and 1 for a `char`. The
   * second was always 4 and so was never written, until there was a second
   * answer. It is carried by the expressions that have a pointer's or a
   * place's type, a name, a `*`, a `&`, an assignment and pointer
   * arithmetic, and everything else is 4. That default is **C11 6.3.1.1's
   * integer promotion**: a `char` in an expression is an `int` before any
   * operator sees it, so `c + 1`, `-c` and `c < d` are all `int`s, and only
   * a thing that is still a place, or points at one, can be narrower.
   *
   * `struct` was expected to be where two numbers stop being enough, because
   * a member has a type of its own and a number cannot hold one. It needed a
   * **third** and not a node: the member's type is looked up by the struct's
   * tag, in the table the `locals` pass built, so what an expression has to
   * carry is only which struct it is. The node went to the base of a
   * declaration instead, in the grammar. *)
  otherwise width = 4

  (* The third number, which is text: the tag of the struct at the bottom of
   * the stars, or "" when it is an `int` or a `char`. A struct value is
   * `type` 0 with a tag, and a pointer to one has stars and the same tag. *)
  otherwise tag = ""

  (* **Whether the value is a `long`**, since 2026-09-23: no stars, no tag,
   * and eight bytes wide. A `long` is the one scalar here wider than the
   * `int` everything promotes to, so it is the one that changes what an
   * operator does: C11 6.3.1.8's usual arithmetic conversions make `int`
   * op `long` a `long`, the `int` side converted first. The emit pass reads
   * this to pick an `x` register and to sign-extend the `int` side. *)
  otherwise wide = $type = 0 and $width = 8 and $tag = ""

  (* **Whether it is unsigned**, since 2026-09-26, ROADMAP 6.9, the fourth
   * part of a type beside the stars, the width and the tag. Like the width
   * and the tag it describes the thing at the bottom of the stars, so a
   * pointer to an `unsigned char` carries it and a load through one knows
   * to use `ldrb`. `puns` is the same question **after promotion**, C11
   * 6.3.1.1: an `unsigned char` is an `int` before any operator sees it,
   * since an `int` holds every value it has, so only an `unsigned int` or
   * an `unsigned long` makes arithmetic unsigned.
   *
   * **C11 6.3.1.8's usual arithmetic conversions** are then one
   * expression, written out at each operator that needs it: when either
   * side is eight bytes wide the answer is unsigned only if an eight-byte
   * side is, because a `long` holds every `unsigned int`; otherwise it is
   * unsigned if either side is, because an `int` beside an `unsigned int`
   * becomes one. *)
  otherwise uns  = false
  otherwise puns = $uns and $type = 0 and $width >= 4

  (* **Whether the value is its own address.** An array and a struct are
   * both things in memory that no register holds: an array decays to the
   * address of its first element, and a struct is only ever reached through
   * its address, by a member or by `&`. The emit pass reads this to leave out
   * the load a scalar would have, and `Assign` to refuse both. *)
  otherwise aggregate = false

  (* **Whether the value is a struct**, as opposed to a pointer to one or a
   * number. C11 takes a struct in exactly five places: `.`, `&`, `sizeof`,
   * a copy into a struct of the same type, and a statement that throws it
   * away. Everywhere else, arithmetic, a comparison, a condition and a copy
   * into anything else, a `return` from an `int` function included, `cc`
   * refuses it, and this
   * subset compiled it until 2026-09-23 into the struct's **address** used
   * as a number. So each of those places asks this, and refuses. *)
  otherwise record = $type = 0 and $tag <> ""

  (* **Which levels of the type are `const`**, since 2026-09-29, ROADMAP
   * 6.10's third part: the fifth part of a type, beside the stars, the
   * width, the tag and whether it is unsigned. It is text, one `0` or `1`
   * a level, in the order a declaration writes them: the base first, then
   * each star's, so `const char *const p` is `11` and `char *q` is `00`,
   * and **the last is the value's own**. So a `*` drops the last, a `&`
   * puts a `0` after, and a pointer's arithmetic keeps its pointer's. It
   * was to be a number, a bit a level, and is text because a declaration's
   * stars reach a pass as a list, and the notation can make text of a list
   * with `each` and `join` and has no way to make a number of one.
   *
   * **What it changes is what is refused**, C11 6.3.2.1p1: a place whose own
   * level is `const` is not one a value can be put in, by `=`, by an update
   * or by `++`, and nor is a struct with a `const` member anywhere in it,
   * put whole. A value this pass knows nothing about is `0`, one level, so
   * a pointer's is too short and what it points at is not `const` when
   * asked: the gap loses a refusal and never makes one, and a conversion
   * that drops a `const` without a cast is not checked, by 6.7's rule. *)
  otherwise quals    = "0"
  otherwise readonly = slice($quals, size($quals), size($quals)) = "1"

  (* **What a `record` is called in a message**, since 2026-09-26: a
   * `void` value is one, see `layouts` in the `locals` pass, so every
   * refusal of a struct where C wants a number refuses it too, and says
   * `'void'` where it would have said `'struct void'`. *)
  otherwise kind = lookup([["void", "void"]], $tag, "struct {}" of at(split($tag, "."), 1))

  (* **Whether it is somewhere a value can be put**, C11 6.3.2.1's lvalue.
   * The `place` rule settled this in the grammar while the only places were
   * names and `*`s. A member is a place when what it is a member of is one,
   * and since structs are copied that need not be so: `(x = y).a` is a
   * member of a value, which C11 6.5.16 says an assignment is, and a program
   * that assigns to it or takes its address is refused by `cc` and was
   * compiled here into a write to `x`. *)
  otherwise lvalue = false

  (* **Whether it is a function**, since ROADMAP 6.14's first part, and
   * which: the key in the sixth field of its type's first level, see `Sig`
   * in the `locals` pass, or "". Only a name and a `*` can be one. A
   * function is its own address, C11 6.3.2.1p4, and decays to a pointer to
   * itself, as an array decays to a pointer to its first element. *)
  otherwise fnk = ""

  (* **Whether it is a null pointer constant**, since 2026-10-03, C11
   * 6.3.2.3p3: an integer constant expression worth 0, which `ev` and `eok`
   * of the `locals` pass already work out, or one cast to `void *`, which
   * `Cast` says. `0`, `1 - 1` and an enumerator worth 0 are; an `int`
   * variable holding 0 is not, nor a 0 cast to a `char` pointer. `?:`
   * asks, where C11 6.5.15p6 gives the answer the other arm's type, and
   * since 2026-10-04 so does every place a pointer to a function is given
   * a value, since a 0 cast to `void *` is a null pointer there too, a
   * global's and a `static`'s among them once the `constants` pass
   * settled a cast to a pointer, later the same day. *)
  otherwise npc = $type = 0 and $tag = "" and $eok and $ev = 0
  (* And a size falls out of the type for everything except a name, because a
   * name is the only thing that can be an array: no operator here answers
   * one. `Variable` therefore says its own and this covers the rest. *)
  otherwise size = lookup([[0, $width]], $type, 8)

  (* **The type as levels**, since ROADMAP 6.12's fourth part: `lv`, the
   * text the `locals` pass gives a declarator, see `Dim`. A name, a member,
   * a `*`, a `&` and a cast work their stars, width, size and whether they
   * are their own address out of it, since those are where an array of
   * arrays or a pointer to an array can be: `type` is the pointers in front
   * once an array has decayed, and `width` what they reach, so a pointer to
   * `int[3]` steps by twelve with nothing in the emit pass changed. Every
   * other expression has a type the old two numbers say, and its text is
   * made of them. *)
