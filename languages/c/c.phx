          : xlv    = lookup([[true, "p:8:0:8|{}" of $axlv]], lookup([[true, $other.fnk]], $useo, $then.fnk) <> "", lookup([[true, "p:8:0:8|{}" of slice($axlv, size(at(split($axlv, "|"), 1)) + 2, size($axlv))]], slice($axlv, 1, 1) = "a", $axlv))
          : type  = lookup([[true, $other.type]], $useo, $then.type)
          : quals = lookup([[true, "{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}" of lookup([["0", slice($then.quals, 1, 1)], ["", slice($then.quals, 1, 1)]], slice($other.quals, 1, 1), slice($other.quals, 1, 1)), lookup([["0", slice($then.quals, 2, 2)], ["", slice($then.quals, 2, 2)]], slice($other.quals, 2, 2), slice($other.quals, 2, 2)), lookup([["0", slice($then.quals, 3, 3)], ["", slice($then.quals, 3, 3)]], slice($other.quals, 3, 3), slice($other.quals, 3, 3)), lookup([["0", slice($then.quals, 4, 4)], ["", slice($then.quals, 4, 4)]], slice($other.quals, 4, 4), slice($other.quals, 4, 4)), lookup([["0", slice($then.quals, 5, 5)], ["", slice($then.quals, 5, 5)]], slice($other.quals, 5, 5), slice($other.quals, 5, 5)), lookup([["0", slice($then.quals, 6, 6)], ["", slice($then.quals, 6, 6)]], slice($other.quals, 6, 6), slice($other.quals, 6, 6)), lookup([["0", slice($then.quals, 7, 7)], ["", slice($then.quals, 7, 7)]], slice($other.quals, 7, 7), slice($other.quals, 7, 7)), lookup([["0", slice($then.quals, 8, 8)], ["", slice($then.quals, 8, 8)]], slice($other.quals, 8, 8), slice($other.quals, 8, 8)), lookup([["0", slice($then.quals, 9, 9)], ["", slice($then.quals, 9, 9)]], slice($other.quals, 9, 9), slice($other.quals, 9, 9)), lookup([["0", slice($then.quals, 10, 10)], ["", slice($then.quals, 10, 10)]], slice($other.quals, 10, 10), slice($other.quals, 10, 10)), lookup([["0", slice($then.quals, 11, 11)], ["", slice($then.quals, 11, 11)]], slice($other.quals, 11, 11), slice($other.quals, 11, 11)), lookup([["0", slice($then.quals, 12, 12)], ["", slice($then.quals, 12, 12)]], slice($other.quals, 12, 12), slice($other.quals, 12, 12)), lookup([["0", slice($then.quals, 13, 13)], ["", slice($then.quals, 13, 13)]], slice($other.quals, 13, 13), slice($other.quals, 13, 13)), lookup([["0", slice($then.quals, 14, 14)], ["", slice($then.quals, 14, 14)]], slice($other.quals, 14, 14), slice($other.quals, 14, 14)), lookup([["0", slice($then.quals, 15, 15)], ["", slice($then.quals, 15, 15)]], slice($other.quals, 15, 15), slice($other.quals, 15, 15)), lookup([["0", slice($then.quals, 16, 16)], ["", slice($then.quals, 16, 16)]], slice($other.quals, 16, 16), slice($other.quals, 16, 16))]],
                           $then.type > 0 and $other.type > 0,
                           lookup([[true, $other.quals]], $useo, $then.quals))
          : uns   = lookup([[0, lookup([[true, ($then.wide and $then.puns) or ($other.wide and $other.puns)]],
                                       $then.wide or $other.wide, $then.puns or $other.puns)]],
                           $type, lookup([[true, $other.uns]], $useo, $then.uns))
          : width = lookup([[0, lookup([[true, 8]], $then.wide or $other.wide, 4)]],
                           $type, lookup([[true, $other.width]], $useo, $then.width))
          : tag   = lookup([[true, $other.tag]], $useo, $then.tag)
          : aggregate = $then.record and $then.tag <> "void"
          ! $cond.record
              : "'{}' is a condition, and C tests only numbers and pointers" of $cond.kind
          ! $then.record <> $other.record
              : "'?:' has a struct on one side and not on the other"
          ! $then.record and $other.record and $then.tag <> $other.tag
              : "'?:' has '{}' on one side and '{}' on the other" of $then.kind, $other.kind
          ! ($then.type > 0) <> ($other.type > 0) and not lookup([[0, $then.npc]], $then.type, $other.npc)
              : "'?:' has a pointer on one side and a number on the other, and only a null pointer constant, C11 6.3.2.3p3, goes beside a pointer"
          ! $then.type > 0 and $other.type > 0 and not $then.npc and not $other.npc
              and not ($then.vptr and not $other.fptr) and not ($other.vptr and not $then.fptr)
              and ($then.type <> $other.type or $then.width <> $other.width or $then.tag <> $other.tag)
              : "'?:' has pointers to two different types" .

  Not     ! $value.record
              : "'!' tests a number or a pointer, and this is '{}'" of $value.kind .
  Logical ! $left.record or $right.record
              : "'{}' tests numbers and pointers, and this is '{}'"
                  of $op, lookup([[true, $left.kind]], $left.record, $right.kind) .
  Deref    : xlv    = lookup([[true, $value.xlv]], $value.fnk <> "", slice($value.xlv, size(at(split($value.xlv, "|"), 1)) + 2, size($value.xlv)))
           : tag   = $value.tag
           : fnk   = at(split(("{}::::::" of at(split($xlv, "|"), 1)), ":"), 6)
           : dec   = lookup([[true, "p:8:0:8|{}" of $xlv]], $fnk <> "",
                            lookup([[true, "p:8:0:8|{}" of slice($xlv, size(at(split($xlv, "|"), 1)) + 2, size($xlv))]], slice($xlv, 1, 1) = "a", $xlv))
           : type  = lookup([[true, size(at(split($dec, "a:"), 1)) div 8]], size(at(split($dec, "a:"), 1)) < size(at(split($dec, "b:"), 1)), size(at(split($dec, "b:"), 1)) div 8)
           : bot   = slice($dec, $type * 8 + 1, size($dec))
           : width = lookup([[true, at(lookup($known, $value.tag, [0, 1, empty, false]), 1)]],
                            $value.tag <> "" and $value.tag <> "void" and slice($bot, 1, 1) = "b", int(at(split(at(split($bot, "|"), 1), ":"), 2)))
           : size  = lookup([[true, $width]], $type = 0 and slice($xlv, 1, 1) = "b", int(at(split(at(split($xlv, "|"), 1), ":"), 2)))
           : aggregate = slice($xlv, 1, 1) = "a" or ($type = 0 and $tag <> "") or $fnk <> ""
           : q     = lookup([[true, slice($value.quals, 1, size($value.quals) - 1)]], size($value.quals) > 1, "")
           : quals = lookup([[true, "{}0" of $q]], slice($xlv, 1, 1) = "a", $q)
           : uns   = $value.uns
           : lvalue = true
           ! $value.type < 1
               : "'*' wants a pointer, and this is {}"
                   of lookup([["", "an int"], ["void", "'void'"]], $value.tag, "a struct")
           (* **`*` on a `void *` is refused**, since 2026-09-26. `cc`
            * refuses it wherever the value is read, and only warns at a
            * statement that throws it away; here it is refused at both,
            * since there is nothing of no width to load. *)
           ! $value.type = 1 and $value.tag = "void"
               : "'*' on a 'void *' has nothing to read: convert it to a pointer to something first"
           ! ($value.type = 1 and $value.tag <> "" and $value.tag <> "void" and $value.width = 0)
               : "'*' reads a 'struct {}', which is not complete here" of at(split($value.tag, "."), 1) .

  (* **A member is the struct's layout read at the member's name.** The
   * entry is the same five things a name's is, where it is, its stars, its
   * count, its width and its tag, and everything a `Variable` works out from
   * those it works out the same way: an array member decays and a struct
   * member is its own address. The offset is kept for the emit pass.
   *
   * `->` built `(*p).x` in the grammar, so there is one node and these two
   * checks between them cover both: a `->` on what is not a pointer was
   * already refused by the `*`, and what is left is a member asked of
   * something that is not a struct, or of a struct that has no such member.
   *
   * `$known` is the table the `locals` pass kept at this node, which is every
   * struct defined above the function. *)
  Member : entry = lookup(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name,
                          [0, 0, 0, 4, "", false, "0", "b:4:0:4"])
         (* A member of a `const` struct is `const`, as `cc` has it: its own
          * level is its declaration's or the struct's, and an array member
          * decays as a name does. *)
         : mq    = at($entry, 7)
         : mown  = "{}{}" of lookup([[true, slice($mq, 1, size($mq) - 1)]], size($mq) > 1, ""),
                              lookup([[true, "1"]], slice($mq, size($mq), size($mq)) = "1" or $value.readonly, "0")
         : uns   = at($entry, 6)
         : xlv    = at($entry, 8)
         : tag   = lookup([[true, ""]], at(split(("{}::::::" of at(split($xlv, "|"), size(split($xlv, "|")))), ":"), 6) <> "", at($entry, 5))
         : quals = lookup([[true, "{}0" of $mown]], slice($xlv, 1, 1) = "a", $mown)
         : dec   = lookup([[true, "p:8:0:8|{}" of slice($xlv, size(at(split($xlv, "|"), 1)) + 2, size($xlv))]], slice($xlv, 1, 1) = "a", $xlv)
         : type  = lookup([[true, size(at(split($dec, "a:"), 1)) div 8]], size(at(split($dec, "a:"), 1)) < size(at(split($dec, "b:"), 1)), size(at(split($dec, "b:"), 1)) div 8)
         : bot   = slice($dec, $type * 8 + 1, size($dec))
         : width = lookup([[true, at(lookup($known, at($entry, 5), [0, 1, empty, false]), 1)]],
                          at($entry, 5) <> "" and at($entry, 5) <> "void" and slice($bot, 1, 1) = "b", int(at(split(at(split($bot, "|"), 1), ":"), 2)))
         : size  = lookup([[true, $width]], $type = 0 and slice($xlv, 1, 1) = "b", int(at(split(at(split($xlv, "|"), 1), ":"), 2)))
         : aggregate = slice($xlv, 1, 1) = "a" or ($type = 0 and $tag <> "")
         : lvalue = $value.lvalue
         ! $value.type <> 0 or $value.tag = "" or $value.tag = "void"
             : "'{}' is asked for as a member of something that is not a struct" of $name
         ! $value.type = 0 and $value.tag <> "" and $value.tag <> "void"
               and not defined(at(lookup($known, $value.tag, [0, 1, empty]), 3), $name)
             : "'struct {}' has no member '{}'" of $value.tag, $name .

  Negate : width = lookup([[true, 8]], $value.wide, 4)
         : uns   = $value.puns
         ! $value.record : "'-' wants a number, and this is '{}'" of $value.kind
         ! $value.type > 0 : "'-' wants a number, and this is a pointer" .

  (* **`sizeof` is worth an `unsigned long`**, C11 6.5.3.4's `size_t` on
   * this machine. It was an `int` here from 2026-09-22, because the subset
   * had no `long`, and one program showed it: `sizeof(sizeof(int))`, 8
   * under `cc` and 4 here. It was a `long` from 2026-09-23, and a comment
   * here said nothing could see the difference, a size never being
   * negative. **A size less a larger number can**, and the arithmetic is
   * C's, not the reader's: `sizeof(int) - 5 < 0` is 0, and every answer of
   * `sizeof-is-unsigned.c` differed until 2026-09-27, ROADMAP 6.9's second
   * part, when it became unsigned. The difference of two pointers stays a
   * `long`, C's `ptrdiff_t`. *)
  (* **A cast is worth the type it names**, C11 6.5.4, and is a value and
   * not a place, so `lvalue` stays false. A cast to `void` is a `void`
   * value, a record with the tag `void`, which a statement may throw away
   * and nothing may read, as for a call to a `void` function.
   *
   * C casts only to a number, a pointer or `void`, and only from a number
   * or a pointer, or anything at all to `void`. `cc` refuses a struct cast
   * to a number, and a `void` value cast to anything but `void`; it
   * compiles a cast **to** a struct of the same kind, as GNU C does, which
   * is refused here by name. *)
  Cast : tag   = $base.tagname
       : xlv   = $lv
       : dec   = lookup([[true, "p:8:0:8|{}" of slice($xlv, size(at(split($xlv, "|"), 1)) + 2, size($xlv))]], slice($xlv, 1, 1) = "a", $xlv)
       : type  = lookup([[true, size(at(split($dec, "a:"), 1)) div 8]], size(at(split($dec, "a:"), 1)) < size(at(split($dec, "b:"), 1)), size(at(split($dec, "b:"), 1)) div 8)
       : bot   = slice($dec, $type * 8 + 1, size($dec))
       : width = lookup([[true, at(lookup($known, $base.tagname, [0, 1, empty, false]), 1)]],
                        $base.tagname <> "" and $base.tagname <> "void" and slice($bot, 1, 1) = "b", int(at(split(at(split($bot, "|"), 1), ":"), 2)))
       : size  = lookup([[true, $width]], $type = 0 and slice($xlv, 1, 1) = "b", int(at(split(at(split($xlv, "|"), 1), ":"), 2)))
       : aggregate = slice($xlv, 1, 1) = "a" or ($type = 0 and $tag <> "")
       : quals = $dquals
       : uns   = $base.buns
       : npc   = $type = 1 and $tag = "void" and size($paren) = 0 and size(split($quals, "1")) = 1
                 and $value.type = 0 and $value.tag = "" and $value.eok and $value.ev = 0
       ! slice($lv, 1, 1) = "a"
           : "a cast to an array is not C, C11 6.5.4"
       ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void"
           : "a cast to 'struct {}' is not C, C11 6.5.4; this cc allows one to the same struct, as GNU C does"
               of $base.tagname
       ! $value.record and not ($ptrs = 0 and $base.tagname <> "")
           : "'{}' is cast to something other than 'void', and only a number or a pointer can be"
               of $value.kind .

  (* **The builtins of <stdarg.h>**, since 2026-10-04. Each is given a
   * `va_list`, which is a `char *` here, and `va_start` and `va_end` are
   * worth nothing, as a call to a `void` function is. `va_arg` is worth
   * what its type says, worked out as a cast's is, and reads an argument
   * through `...`, which a caller promoted, so a type promotion changes is
   * never there, C11 7.16.1.1p2, and `cc` warns of it; a struct is not
   * passed through `...` here, and `void` is no value. *)
  VaStart : tag = "void"
          ! $ap.type <> 1 or $ap.width <> 1 or $ap.tag <> "" or $ap.uns
              : "'va_start' is given something that is not a 'va_list', which is a 'char *' here" .
  VaEnd   : tag = "void"
          ! $ap.type <> 1 or $ap.width <> 1 or $ap.tag <> "" or $ap.uns
              : "'va_end' is given something that is not a 'va_list', which is a 'char *' here" .
  VaArg : tag   = $base.tagname
        : xlv   = $lv
        : type  = $ptrs
        : bot   = slice($xlv, $type * 8 + 1, size($xlv))
        : width = lookup([[true, at(lookup($known, $base.tagname, [0, 1, empty, false]), 1)]],
                         $base.tagname <> "" and $base.tagname <> "void" and slice($bot, 1, 1) = "b", int(at(split(at(split($bot, "|"), 1), ":"), 2)))
        : quals = $dquals
        : uns   = $base.buns
        ! $ap.type <> 1 or $ap.width <> 1 or $ap.tag <> "" or $ap.uns
            : "'va_arg' is given something that is not a 'va_list', which is a 'char *' here"
        ! $ptrs = 0 and $base.tagname = "void"
            : "'va_arg' of 'void' reads nothing, and C11 7.16.1.1p2 wants an object's type"
        ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void"
            : "'va_arg' of 'struct {}': a struct is not passed through '...' here" of at(split($base.tagname, "."), 1)
        ! $ptrs = 0 and $base.tagname = "" and $base.basew < 4
            : "'va_arg' of a type of {} bytes, which an argument through '...' is promoted from to an 'int', so it is never there, C11 7.16.1.1p2" of $base.basew .

  SizeOfType : type = 0 : width = 8 : uns = true
             (* **`sizeof` of `void` is refused by name**, since 2026-09-26:
              * C11 6.5.3.4 wants a complete type, and `cc` answers 1, as GNU
              * C does. *)
             ! $ptrs = 0 and $base.tagname = "void"
                 : "'sizeof' of 'void' has no size, C11 6.5.3.4; this cc says 1, as GNU C does"
             ! $ptrs = 0 and $base.tagname <> "" and $base.tagname <> "void" and $base.basew = 0
                 : "'sizeof' of 'struct {}', which is not complete here, C11 6.5.3.4" of at(split($base.tagname, "."), 1) .
  SizeOfExpr : type = 0 : width = 8 : uns = true
             ! $value.record and $value.tag = "void"
                 : "'sizeof' of 'void' has no size, C11 6.5.3.4; this cc says 1, as GNU C does"
             ! $value.fnk <> ""
                 : "'sizeof' of a function has no size, C11 6.5.3.4; this cc says 1, as GNU C does" .

  (* **A constant's type is C11 6.4.4.1's table**, since 2026-09-27,
   * ROADMAP 6.9: the first of a list that can hold it, and the list
   * depends on the suffix and on whether it is decimal. Unsuffixed, a
   * decimal constant is an `int` or a `long`, and a hex or octal one may
   * also be an `unsigned int` between them, or an `unsigned long` after:
   * `4294967295` is a `long` and `0xffffffff` an `unsigned int`, which is
   * why `-1 < 0xffffffff` is 0. A `u` leaves only the unsigned ones, an
   * `l` only the eight-byte ones. `long long` is the width of `long` here,
   * so the table's last rows are not needed. **A decimal constant past the
   * largest `long` is an `unsigned long`**, which C11 leaves with no type
   * and `cc` and GNU C give that one, with a warning; until 2026-09-27 it
   * was refused by name.
   *
   * **The value is its sixty-four bits**, which are what `cc` writes and
   * what the notation's signed integers can hold: an `unsigned long` past
   * 2^63 is negative in `bits`. The library's `int` refuses text that does
   * not fit, so a constant is read in two halves, each small enough, and
   * put together in a way that cannot overflow. For hex, the low eight
   * digits and the rest, each thirty-two bits; for octal the low eleven,
   * thirty-three bits, and the rest; for decimal the low ten digits and
   * the rest, where 2^64 is 1844674407 and 3709551616 in those halves, and
   * one past the largest `long` is worked out from them as the value less
   * 2^64, by a route whose every step is in range. Each base's halves are
   * read from its own text or from nothing, because every entry of a
   * `lookup` is worked out and `int` of a hex digit in base 8 is an error.
   * Leading zeros above the sixty-four bits are allowed, as C allows them,
   * and anything else there is too big: a check is a guard, so the halves
   * are never worked out for a constant it refuses. *)
  Number : xhi    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 15, $ndigits - 8)]], $ihex and $ndigits > 8, "")), 16)
         : xlo    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 7, $ndigits)]], $ihex, "")), 16)
         : ohi    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 21, $ndigits - 11)]], $ioct and $ndigits > 11, "")), 8)
         : olo    = int(("0{}" of lookup([[true, slice($idigits, $ndigits - 10, $ndigits)]], $ioct, "")), 8)
         : dhi    = int("0{}" of lookup([[true, slice($idigits, $ndigits - 19, $ndigits - 10)]], $idec and $ndigits > 10, ""))
         : dlo    = int("0{}" of lookup([[true, slice($idigits, $ndigits - 9, $ndigits)]], $idec, ""))
         : dbig   = $idec and ($ndigits = 20 or ($ndigits = 19 and $idigits > "9223372036854775807"))
         : dsmall = lookup([[true, 0]], $dbig, $dhi) * 10000000000 + $dlo
         : dwrap  = (lookup([[true, $dhi]], $dbig, 1844674407) - 1844674407 + 1) * 10000000000
                    + ($dlo - 3709551616 - 10000000000)
         : bits   = lookup([[true, ($xhi - lookup([[true, 4294967296]], $xhi >= 2147483648, 0)) * 4294967296 + $xlo]],
                           $ihex,
                    lookup([[true, ($ohi - lookup([[true, 2147483648]], $ohi >= 1073741824, 0)) * 8589934592 + $olo]],
                           $ioct,
                    lookup([[true, $dwrap]], $dbig, $dsmall)))
         : fint   = $bits >= 0 and $bits <= 2147483647
         : fuint  = $bits >= 0 and $bits <= 4294967295
         : width  = lookup([[true, 4]], not $ihasl and ((not $ihasu and ($fint or (not $idec and $fuint)))
                                                      or ($ihasu and $fuint)), 8)
         : uns    = $ihasu or $bits < 0 or ($width = 4 and not $fint)
         ! $ioct and (size(split($idigits, "8")) > 1 or size(split($idigits, "9")) > 1)
             : "'{}' is an octal constant, and 8 and 9 are not octal digits" of $text
         ! ($ihex and $ndigits > 16 and join(split(slice($idigits, 1, $ndigits - 16), "0")) <> "")
           or ($ioct and (($ndigits > 22 and join(split(slice($idigits, 1, $ndigits - 22), "0")) <> "")
                          or ($ndigits >= 22 and slice($idigits, $ndigits - 21, $ndigits - 21) > "1")))
           or ($idec and ($ndigits > 20 or ($ndigits = 20 and $idigits > "18446744073709551615")))
             : "'{}' is too big for any integer type, C11 6.4.4.1" of $text .

  (* **A character constant is an `int`**, C11 6.4.4.4, which the defaults
   * above already say: no stars, four bytes, so `sizeof 'a'` is 4 as C has
   * it and not 1 as C++ does. What this adds is its **code**.
   *
   * The notation has no function from a character to its code, and does not
   * need one here. The ninety-five printable characters are written out in
   * order, and a character's code is how much of that text comes before it,
   * plus the 32 the table starts at: `split` at the character, and measure
   * the first piece. An escape is looked up first, because its text is two
   * characters and is not in the table. The lexer has already refused
   * anything that is neither, so the measurement never meets a character it
   * cannot find. `char-constant-every-one.c` walks the whole table. *)
  (* **A string literal is an array of `char`**, C11 6.4.5, one longer than
   * its characters for the NUL at the end, and it decays like any array: its
   * `type` is a pointer to `char` and its `size` is the whole array, so
   * `sizeof "abc"` is 4 and `"abc"[1]` is `'b'`.
   *
   * The length is counted rather than walked, because the notation has no
   * way to walk text. Every escape is two characters in the source and one
   * in the array, so the length is the text less one per escape. Counting
   * the escapes is counting backslashes, except that `\\` is two of them
   * and one escape. So the escaped backslashes are replaced first, by a
   * tab, which the lexer guarantees is not in the text; after that every
   * backslash left begins an escape of its own. Splitting at `\\` finds the
   * same pairs the escapes are made of, because both read left to right and
   * nothing else in an escape is a backslash.
   *
   * **Literals side by side are one**, C11 6.4.5p5, since ROADMAP 6.16's
   * second part: the node holds the first and the rest, and its text is
   * all of them written together, so that a join is `""` in the body, two
   * characters and no byte. A `"` inside a literal is always escaped, so
   * the only other quote a body has is the one in `\"`, which can stand
   * just before a join, `\"""`; counting `""` from the left finds one
   * pair in three quotes whichever two it takes, so it needs no setting
   * aside.
   *
   * `string-length-agrees.c` holds this against the bytes the assembler
   * wrote, counted by walking them. *)
  String : joined = join(flatten([[$text], $more]))
         : body   = slice($joined, 2, size($joined) - 1)
         : length = $slen
         (* Worked out in `locals`, numeric escapes and all; the two
          * substitutions that find what C refuses are read here. *)
         ! size(split($sone, "\x0c")) > 1
             : "a hex escape in this string has more than two digits, which this subset does not take; C11 6.4.4.4p9 allows more only as zeros before the two"
         ! size(split($sone, "\x0b")) > 1
             : "an octal escape in this string is past 255, the largest an unsigned char holds, C11 6.4.4.4p9"
         : type   = 1
         : width  = 1
         : size   = $length + 1 .

  (* A character's code is worked out in `locals`, beside a string's
   * escapes, so that an enumerator can be given one. *)

  (* C11 6.5.6 lets `+` take a pointer and an integer in either order, and `-`
   * a pointer and then an integer, and counts the integer in what the pointer
   * points at. The answer is a pointer of the same type, which is why the
   * type is a **sum** for `+`: exactly one side has stars, and the other adds
   * none. Counting in elements is the emit pass's, which reads the element's
   * width off this type.
   *
   * These were refusals until 2026-09-22, standing in for a size the subset
   * did not have. They are now the things C itself refuses.
   *
   * **The difference of two pointers is a `long`**, the count of elements
   * between them: C11 6.5.6's `ptrdiff_t`, which is a `long` on this
   * machine. It was an `int` from 2026-09-22 to the day `long` arrived, as
   * it was in K&R's first edition, and `sizeof(p - q)` was pinned as the
   * one program that showed it, beside `sizeof(sizeof(int))`, and moved
   * into the oracle with it. The type is a difference of star
   * counts, which is 0 for two pointers of one type and the pointer's own for
   * a pointer less an int; two pointers of **different** types are refused,
   * as 6.5.6 requires, and that is also what keeps the difference from
   * coming out as a type no value has. *)
  (* The width of a sum is the pointer's, from whichever side it is on, and
   * when there is no pointer it is 8 if either side is a `long` and 4
   * otherwise, which is C11 6.3.1.8's usual arithmetic conversions over the
   * promotion above. A difference of two pointers is 8, a `long`. *)
  Binary(op: "+") : type  = $left.type + $right.type
                  : quals = lookup([[0, "0"]], $type, lookup([[0, $right.quals]], $left.type, $left.quals))
                  : uns   = lookup([[0, lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)]],
                                   $type, lookup([[0, $right.uns]], $left.type, $left.uns))
                  : width = lookup([[0, lookup([[true, 8]], $left.wide or $right.wide, 4)]], $type,
                                   lookup([[0, $right.width]], $left.type, $left.width))
                  : tag   = lookup([[0, ""]], $type,
                                   lookup([[0, $right.tag]], $left.type, $left.tag))
                  : xlv   = lookup([[true, lookup([[true, "p:8:0:8|{}" of slice($left.xlv, size(at(split($left.xlv, "|"), 1)) + 2, size($left.xlv))]], slice($left.xlv, 1, 1) = "a", $left.xlv)]], $left.type > 0,
                                  lookup([[true, lookup([[true, "p:8:0:8|{}" of slice($right.xlv, size(at(split($right.xlv, "|"), 1)) + 2, size($right.xlv))]], slice($right.xlv, 1, 1) = "a", $right.xlv)]], $right.type > 0, "{}b:{}:0:{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $type, ""), $width, $width))
      ! $left.record or $right.record
          : "'{}' wants numbers or pointers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 and $right.type > 0
          : "'+' does not add two pointers"
      (* **Nor on a pointer to a function**, since ROADMAP 6.14's first
       * part: a function has no size either, C11 6.5.6. *)
      ! ((slice($left.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $left.xlv), "|"), 2)), ":"), 6) <> "") or at(split(("{}::::::" of at(split($left.xlv, "|"), 1)), ":"), 6) <> "") or ((slice($right.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $right.xlv), "|"), 2)), ":"), 6) <> "") or at(split(("{}::::::" of at(split($right.xlv, "|"), 1)), ":"), 6) <> "")
          : "'{}' on a pointer to a function counts in something of no size, C11 6.5.6; this cc counts in bytes, as GNU C does" of $op
      (* **Arithmetic on a `void *` is refused by name**, since
       * 2026-09-26: C11 6.5.6 counts in what the pointer points at, and a
       * `void` has no size. `cc` counts in bytes, as GNU C does. *)
      ! ($left.type = 1 and $left.tag = "void") or ($right.type = 1 and $right.tag = "void")
          : "'{}' on a 'void *' counts in something of no size; this cc counts in bytes, as GNU C does" of $op
      ! ($left.type = 1 and $left.tag <> "" and $left.tag <> "void" and $left.width = 0) or ($right.type = 1 and $right.tag <> "" and $right.tag <> "void" and $right.width = 0)
          : "'{}' counts in 'struct {}', which is not complete here, C11 6.5.6"
              of $op, at(split(lookup([[true, $left.tag]], ($left.type = 1 and $left.tag <> "" and $left.tag <> "void" and $left.width = 0), $right.tag), "."), 1) .
  Binary(op: "-") : type  = $left.type - $right.type
                  : quals = lookup([[0, "0"]], $type, $left.quals)
                  : uns   = lookup([[true, lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)]],
                                   $left.type = 0 and $right.type = 0,
                                   lookup([[0, false]], $type, $left.uns))
                  : width = lookup([[0, lookup([[true, 8]], $left.wide or $right.wide
                                                             or $left.type > 0, 4)]],
                                   $type, $left.width)
                  : tag   = lookup([[0, ""]], $type, $left.tag)
                  : xlv   = lookup([[true, lookup([[true, "p:8:0:8|{}" of slice($left.xlv, size(at(split($left.xlv, "|"), 1)) + 2, size($left.xlv))]], slice($left.xlv, 1, 1) = "a", $left.xlv)]], $left.type > 0 and $right.type = 0, "{}b:{}:0:{}" of lookup([[0, ""], [1, "p:8:0:8|"], [2, "p:8:0:8|p:8:0:8|"], [3, "p:8:0:8|p:8:0:8|p:8:0:8|"], [4, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [5, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [6, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [7, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [8, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [9, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [10, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [11, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"], [12, "p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|p:8:0:8|"]], $type, ""), $width, $width)
      ! $left.record or $right.record
          : "'{}' wants numbers or pointers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type = 0 and $right.type > 0
          : "'-' does not take a pointer from a number"
      ! $left.type > 0 and $right.type > 0
            and ($left.type <> $right.type or $left.width <> $right.width
                 or $left.tag <> $right.tag)
          : "'-' takes two pointers only when they point at the same type"
      ! ((slice($left.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $left.xlv), "|"), 2)), ":"), 6) <> "") or at(split(("{}::::::" of at(split($left.xlv, "|"), 1)), ":"), 6) <> "") or ((slice($right.xlv, 1, 1) = "p" and at(split(("{}::::::" of at(split(("{}||" of $right.xlv), "|"), 2)), ":"), 6) <> "") or at(split(("{}::::::" of at(split($right.xlv, "|"), 1)), ":"), 6) <> "")
          : "'{}' on a pointer to a function counts in something of no size, C11 6.5.6; this cc counts in bytes, as GNU C does" of $op
      (* **Arithmetic on a `void *` is refused by name**, since
       * 2026-09-26: C11 6.5.6 counts in what the pointer points at, and a
       * `void` has no size. `cc` counts in bytes, as GNU C does. *)
      ! ($left.type = 1 and $left.tag = "void") or ($right.type = 1 and $right.tag = "void")
          : "'{}' on a 'void *' counts in something of no size; this cc counts in bytes, as GNU C does" of $op
      ! ($left.type = 1 and $left.tag <> "" and $left.tag <> "void" and $left.width = 0) or ($right.type = 1 and $right.tag <> "" and $right.tag <> "void" and $right.width = 0)
          : "'{}' counts in 'struct {}', which is not complete here, C11 6.5.6"
              of $op, at(split(lookup([[true, $left.tag]], ($left.type = 1 and $left.tag <> "" and $left.tag <> "void" and $left.width = 0), $right.tag), "."), 1) .
  (* **A shift is the type of its left side**, C11 6.5.7, and not of the
   * wider of the two: `1 << (long)3` is an `int`, and `shifts.c` asks its
   * `sizeof`. Both sides are integers, so a pointer or a struct on either is
   * C's refusal. The emit pass shifts in the left side's register, and a
   * `long` count is read from its low half, which is all a shift reads. *)
  Binary(op: "<<") : width = lookup([[true, 8]], $left.wide, 4)
                   : uns   = $left.puns
      ! $left.record or $right.record
          : "'{}' wants numbers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 or $right.type > 0
          : "'{}' does not take a pointer" of $op .
  Binary(op: ">>") : width = lookup([[true, 8]], $left.wide, 4)
                   : uns   = $left.puns
      ! $left.record or $right.record
          : "'{}' wants numbers, and this is '{}'"
              of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
      ! $left.type > 0 or $right.type > 0
          : "'{}' does not take a pointer" of $op .
  (* C11 6.5.5 wants arithmetic on both sides of `*` and `/`, and integers on
   * both sides of `%`, which since 2026-09-25 is one of these too, and so are
   * `&`, `|` and `^`, C11 6.5.10 to 6.5.12. So a pointer on either is C's own
   * refusal rather than this subset's. *)
  Binary : width = lookup([[true, 8]], $left.wide or $right.wide, 4)
         : uns   = lookup([[true, ($left.wide and $left.puns) or ($right.wide and $right.puns)]],
                                   $left.wide or $right.wide, $left.puns or $right.puns)
         ! $left.record or $right.record
      : "'{}' wants numbers, and this is '{}'"
          of $op, lookup([[true, $left.kind]], $left.record, $right.kind)
         ! $left.type > 0 or $right.type > 0
      : "'{}' does not take a pointer" of $op .


(* ------------------------------------------------------------------- *)
(* **What is known before the program runs**, since 2026-09-25, ROADMAP *)
(* 6.5. C11 6.6 names the places an expression must be worked out at   *)
(* compile time, and a `case` label is the first here; array sizes,    *)
(* `enum`, a global's initialiser and the null pointer constant will   *)
(* read the same two attributes. `settled` says whether it can be, and   *)
(* `folded` what it is.                                                *)
(*                                                                     *)
(* **The arithmetic is C's, done in the notation's**, and the two      *)
(* differ in three ways this pass has to bridge. C's `int` wraps at     *)
(* thirty-two bits where the notation's integers trap at sixty-four,   *)
(* so an `int` result is cut to thirty-two with `bitand` and its sign  *)
(* put back. C's `/` truncates and `div` floors, so it is `quotient`.  *)
(* And the notation has no shift and no bits: `<<` and `>>` are a      *)
(* multiply and a `div` by a power of two, `div` flooring exactly as   *)
(* an arithmetic shift does, and `&`, `|` and `^` are the library's    *)
(* `bitand`, `bitor` and `bitxor`, which were added for this.          *)
(*                                                                     *)
(* **Nothing here may trap**, because a trap is the compiler stopping  *)
(* with an arithmetic error rather than a message. So an operator only *)
(* folds operands that fit in thirty-two bits, where no product passes *)
(* 2^62, and reads 0 for one that does not; a divisor of 0 is read as  *)
(* 1 and the answer is not known; a shift is folded only by 0 to 31.   *)
(* An operand that did not fold makes the answer not known, which a    *)
(* `case` then refuses.                                                *)
(*                                                                     *)
(* *The thirty-two bit wrap has no witness, and cannot have one.* An   *)
(* `int` result passes thirty-two bits only when C's arithmetic has    *)
(* overflowed, which is undefined, so no program the oracle may hold   *)
(* can tell. Taking it out changed no answer. It is kept because it is *)
(* what `cc` folds `1 << 31` to, and an `unsigned int`'s answer is the  *)
(* same cut without the sign put back, since 2026-09-27.               *)
(* ------------------------------------------------------------------- *)

%pass constants

  (* **What a call is given**, its count and each argument, since ROADMAP
   * 6.14's second part, when they moved here from the `types` pass: they
   * are checked against the callee's parameters, which are found by its
   * key, and the key of a pointer is its type's, which the `types` pass
   * works out after a call is entered, where these were handed down. A
   * callee that is not a name is called "a pointer to a function" in what
   * these say. *)
