(* solveig-sob.phx -- Solveig, compiled to `.sob` bytecode for SolVM.
 *
 *   phx --raw languages/solveig/solveig-sob.phx prog.sol > prog.sob
 *   solvm prog.sob
 *
 * The grammar, the tree and the `show` pass are in `solveig.phx` and are
 * imported. This file is the emit pass, and it emits **bytes**.
 *
 * ---------------------------------------------------------------------------
 * Why this is the interesting target
 *
 * Every emit pass before this one produced *text*, where the shape of the
 * output followed the shape of the tree and a parent wrapped its children.
 * A bytecode file does not work that way:
 *
 *   - **a table is length-prefixed**, so its size must be known before its
 *     first byte is written -- which falls out of `size` over what the
 *     children already emitted, and is why synthesised attributes suit it
 *   - **a name is an index into a table** that grows as the walk goes, so the
 *     table is a *threaded* attribute and the index is where the name landed
 *   - **a jump carries an offset** to code that has not been written yet,
 *     which is the size of what the branch will emit -- again a child's
 *     `size`, and again bottom-up
 *
 * The roadmap has claimed since stage 2 that a flat target is where threaded
 * state earns its keep, and has never tested it. This is the test.
 *
 * ---------------------------------------------------------------------------
 * The format
 *
 * From `docs/design.md` in the Solveig repository. Little-endian throughout,
 * so a `.sob` is portable.
 *
 *   header      "SOLB", u16 version, u16 script slot count
 *   names       u32 count, then each: u16 length + bytes
 *   constants   u32 count, then each: u8 tag + payload (0 nil, 1 i64, 2 f64,
 *                                                       3 bool)
 *   code        u32 length, then that many bytes
 *   lines       u32 run count, then each: u32 run length + u32 line
 *   files       u32 count, then each: u16 length + bytes
 *   fileruns    u32 run count, then each: u32 run length + u32 file index
 *   slotnames   u16 count, then each: u16 length + bytes
 *   methods     u32 count, then each: u16 name length + bytes, u16 arity,
 *                                     u16 slot count, u16 flags, then a body
 *)

%import "solveig.phx" .

(* ---- inlined control flow ----
 *
 * `ifTrue`, `ifFalse`, `ifElse`, `and`, `or`, `whileTrue` and `doUntil` are
 * ordinary messages and a program may still send them that way -- through
 * `perform`, or with a block held in a variable. Written **literally**,
 * which is how they are almost always written, `solas` emits jumps around
 * the bodies rather than allocating a block and entering a frame per branch
 * or per pass, and this is where that is said.
 *
 * It is a rewrite rather than a clause, and the reason is what makes the
 * whole thing eight lines instead of a rewritten `Block`. A clause answers
 * *about* a node, and the node in the way here is the `Block`: it opens a
 * chunk, starts fresh name and constant tables, and pushes a frame's worth
 * of slots. Conditioning all of that on who the parent is would be thirty
 * `lookup`s. **Taking the node out of the tree instead costs nothing**: what
 * is left is a list of statements sitting where the send was, and it
 * compiles in the enclosing frame because that is the frame it is in.
 * `OP_OUTER` depths come out right without anything adjusting them, for the
 * same reason.
 *
 * The restrictions are `solas`'s and they are in the patterns: **every block
 * has to be written right there, with no parameters and no temporaries.** A
 * block with parameters is an arity error when `ifElse` calls it with none,
 * and inlining would quietly make it work; a block's temporaries belong to
 * its own frame, and inlining would declare them in the enclosing one, where
 * they could collide with a name already there. Anything else falls through
 * to the ordinary `Send` clause, so the slow path stays correct rather than
 * merely unused.
 *
 * Bottom-up, so a block inside a block is inlined before the send around it
 * is looked at.
 *)
%rewrite inline bottomup

  Send(to: c, message: "ifTrue", args: [Block(params: [], temps: [], body: b)])
    => IfTrue(cond: $c, body: $b) .
  Send(to: c, message: "ifFalse", args: [Block(params: [], temps: [], body: b)])
    => IfFalse(cond: $c, body: $b) .
  Send(to: c, message: "ifElse",
       args: [Block(params: [], temps: [], body: y),
              Block(params: [], temps: [], body: n)])
    => IfElse(cond: $c, yes: $y, no: $n) .

  (* `and` and `or` short-circuit through a block exactly as `ifTrue` does,
   * which is why they take one. What differs is the answer: `ifTrue` answers
   * nil on the path it does not take, and these answer a boolean either way --
   * so the block's answer is the reply and has to be one, which is what
   * `OP_CHECK_BOOL` says. The shortcut's answer is a **constant** rather than
   * the global `true` or `false`, which a program can rebind: reading it would
   * make the two paths disagree about what `and` answers. *)
  Send(to: c, message: "and", args: [Block(params: [], temps: [], body: b)])
    => AndThen(cond: $c, body: $b) .
  Send(to: c, message: "or", args: [Block(params: [], temps: [], body: b)])
    => OrElse(cond: $c, body: $b) .

  (* The two loops, where the **receiver** is a block as well. `whileTrue`
   * tests before each pass and `doUntil` after, which is the whole of the
   * difference between them. *)
  Send(to: Block(params: [], temps: [], body: c), message: "whileTrue",
       args: [Block(params: [], temps: [], body: b)])
    => WhileTrue(cond: $c, body: $b) .
  Send(to: Block(params: [], temps: [], body: b), message: "doUntil",
       args: [Block(params: [], temps: [], body: c)])
    => DoUntil(body: $b, cond: $c) .

%pass sob

  (* ---- the tables, threaded ----
   *
   * `names` maps a name to the index it was given, and `nametext` is the same
   * table already encoded. Both are threaded and both are updated together,
   * because appending to one without the other would put an index in the code
   * that the file does not carry.
   *
   * A name is added **only if it is not already there**, which is a
   * conditional -- so it is a table, as every conditional here is:
   * `lookup([[true, unchanged]], defined(...), changed)`.
   *)
  (* The table is **seeded** with the three names the desugarings need.
   * `[a, b]` compiles to `array:of(a, b)` and `#[k = v]` to
   * `dictionary:of(k, v)`, so those three names are wanted by nodes that
   * never mention them -- and interning a name at the node that needs it
   * would mean writing the append-if-absent dance twice more per node. A
   * file that uses no collection carries three names it never reads, which
   * costs twenty-one bytes and buys a description half the size.
   *
   * `size($names)` is the next free index, so the seeding has to agree with
   * itself: three entries here, three encoded below, in the same order. *)
  thread names    = [["array", 0], ["of", 1], ["dictionary", 2]] .
  thread nametext = "\x05\x00array\x02\x00of\x0a\x00dictionary" .
  thread consts   = "" .
  thread nconsts  = 0 .

  (* A block compiles to a chunk in the enclosing chunk's method table, and
   * `OP_BLOCK` names it by index there -- so the table is threaded and the
   * index is where the method landed, exactly as a name is. *)
  thread methods  = "" .
  thread nmethods = 0 .

  (* How many slots the chunk being built needs. Slot 0 is the receiver, so a
   * chunk with no locals still has one. A group adds slots to the frame it is
   * written in and its siblings may reuse them, so what the chunk must
   * declare is the **largest** any point in it reached, not the last. *)
  thread nslots   = 1 .

  (* The files a chunk's code came from, and the same table encoded. A chunk
   * holds code from more than one file whenever an `@include` put some there,
   * and a line number naming a file nobody said is worse than no line at all.
   *
   * Interned per chunk exactly as a name is, and by an `otherwise` rather than
   * by a clause on each node type: **every** node is in a file, and which one
   * is a fact about the node rather than about what kind it is. *)
  thread files    = [] .
  thread filetext = "" .

  (* Whether the chunk being built reaches out of its own frame. A block that
   * does has to keep its home frame alive, which is the `CAPTURES` flag, and
   * `solas` decides it the same way: does this chunk's own code contain an
   * `OP_OUTER`. Per chunk, so it is saved and restored like the tables. *)
  thread reaches  = false .

  (* ---- what every node answers ----
   *
   * Two things a node knows by being a node rather than by being a kind of
   * one, and `otherwise` is the clause for exactly that: it runs when a node's
   * own rule works nothing out.
   *
   * **Where its bytes go in the line table** -- its own code at its own line,
   * which is right for every node except the seven an inlined block became,
   * and each of those says so itself.
   *
   * **Which file it is in**, interned into the chunk's file table. The index
   * has to be read before the table is appended to, which is the order these
   * are written in and the same order the name tables are updated in.
   *)
  otherwise runs = "{}{}" of bytes(size($code), 4), bytes($pos.line, 4)

  otherwise fileidx  = lookup($files, $pos.file, size($files))
  otherwise filetext = lookup([[true, $filetext]], defined($files, $pos.file),
                              "{}{}{}" of $filetext,
                                          bytes(size($pos.file), 2), $pos.file)
  otherwise files    = lookup([[true, $files]], defined($files, $pos.file),
                              [...$files, [$pos.file, size($files)]])

  (* ---- literals ---- *)

  (* `#45`, `$ff` and `%1010` are one node, and the marker says the base --
   * which is a lookup on the first character, as every choice here is. *)
  Integer : base   = lookup([["$", 16], ["%", 2]], slice($text, 1, 1), 10)
          : value  = int(slice($text, 2, size($text)), $base)
          : idx    = $nconsts
          : consts  = "{}{}{}" of $consts, bytes(1, 1), bytes($value, 8)
          : nconsts = $nconsts + 1
          : code    = "{}{}" of bytes(0, 1), bytes($idx, 2) .

  (* ---- a name ----
   *
   * A slot if the frame has one by that name, and a global otherwise. That is
   * the whole of scoping here: `$slotnames` is the frame's slots in slot
   * order, so a name's slot is simply *where it is in that list* -- which is
   * what `positions` answers, and the reason it exists.
   *
   * A name belonging to an *enclosing* frame would need `OP_OUTER` and a
   * count of frames to climb. That is not written yet, and a wrong answer
   * here would be a global with the same name -- silently the wrong variable.
   * So it is refused, and the check is what makes the omission safe. *)
  Name ! $name = "self" and $bdepth = 0
           : "'self' is only meaningful inside a block"
       : slot   = lookup(positions($slotnames), $name, -1)
       : oslot  = lookup($outerslot, $name, -1)
       : odepth = lookup($outerdepth, $name, -1)
       : reaches = lookup([[true, true]], $slot < 0 and $oslot > -1, $reaches)
       : idx = lookup($names, $name, size($names))
       : nametext = lookup([[true, $nametext]], defined($names, $name) or $slot > -1 or $oslot > -1,
                           "{}{}{}" of $nametext, bytes(size($name), 2), $name)
       : names = lookup([[true, $names]], defined($names, $name) or $slot > -1 or $oslot > -1,
                        [...$names, [$name, size($names)]])
         (* A slot of this frame, a slot of one further out, or a global --
          * and the depth is the difference between the two frames' distances
          * from the script, which is why each frame records its own. *)
       : code = lookup([[true, "{}{}" of bytes(4, 1), bytes($slot, 1)]], $slot > -1,
                lookup([[true, "{}{}{}" of bytes(6, 1),
                                          bytes($bdepth - $odepth, 1),
                                          bytes($oslot, 1)]], $oslot > -1,
                       "{}{}" of bytes(2, 1), bytes($idx, 2))) .

  (* ---- a send ----
   *
   * The receiver's code, then each argument's, then the send. The order the
   * bytes go in is the order the walk visited them, which is why a name's
   * index and the code that uses it agree without anything being arranged.
   *)
  Send : idx = lookup($names, $message, size($names))
       : nametext = lookup([[true, $nametext]], defined($names, $message),
                           "{}{}{}" of $nametext, bytes(size($message), 2), $message)
       : names = lookup([[true, $names]], defined($names, $message),
                        [...$names, [$message, size($names)]])
         (* A nested `of` is parenthesised: `of` does not chain, so without
          * them the second one would be reading the first one's arguments. *)
       : code = "{}{}{}{}{}" of $to.code, join($args.code, ""),
                                bytes(11, 1), bytes($idx, 2),
                                bytes(size($args), 1) .

  (* ---- text and symbols ----
   *
   * Both live in the **names** table rather than the constants: `OP_STRING`
   * and `OP_SYMBOL` take a name index and build the value at run time, which
   * is how two occurrences of the same literal come to share one entry.
   *
   * A literal arrives with its quotes on and its escapes raw, because `show`
   * has to be able to write it back out unchanged. Cooking it is four
   * replacements, and the order is the whole difficulty: doing `\\` first
   * would turn `\\n` into an escape it never was, and doing it last would
   * have already eaten the backslash. So `\\` goes to a byte no source file
   * can contain, the others are done, and the sentinel comes back. *)
  Text : raw    = slice($text, 2, size($text) - 1)
       : held   = join(split($raw, "\\\\"), "\x01")
       : cooked = join(split(join(split(join(split(join(split($held, "\\n"), "\n"),
                                               "\\t"), "\t"),
                                    "\\r"), "\r"),
                         "\\\""), "\"")
       : value  = join(split($cooked, "\x01"), "\\")
       : idx      = lookup($names, $value, size($names))
       : nametext = lookup([[true, $nametext]], defined($names, $value),
                           "{}{}{}" of $nametext, bytes(size($value), 2), $value)
       : names    = lookup([[true, $names]], defined($names, $value),
                           [...$names, [$value, size($names)]])
       : code = "{}{}" of bytes(9, 1), bytes($idx, 2) .

  Symbol : value    = slice($name, 2, size($name))
         : idx      = lookup($names, $value, size($names))
         : nametext = lookup([[true, $nametext]], defined($names, $value),
                             "{}{}{}" of $nametext, bytes(size($value), 2), $value)
         : names    = lookup([[true, $names]], defined($names, $value),
                             [...$names, [$value, size($names)]])
         : code = "{}{}" of bytes(10, 1), bytes($idx, 2) .

  (* ---- floats ----
   *
   * Tag 2, and the payload is the double's own bits -- which is what `bytes`
   * of a float means, and the reason it had to learn floats at all. *)
  Float : idx     = $nconsts
        : consts  = "{}{}{}" of $consts, bytes(2, 1), bytes(float($text), 8)
        : nconsts = $nconsts + 1
        : code    = "{}{}" of bytes(0, 1), bytes($idx, 2) .

  (* ---- collections ----
   *
   * Neither is an instruction. `[a, b]` is `array:of(a, b)` and `#[k = v]` is
   * `dictionary:of(k, v)`, so both are a global, the parts, and a send -- and
   * a dictionary sends twice as many arguments as it has pairs, since a pair
   * puts its key and its value on the stack as two.
   *)
  Array : code = "{}{}{}{}{}" of bytes(2, 1), bytes(0, 2),
                                 join($items.code, ""),
                                 ("{}{}" of bytes(11, 1), bytes(1, 2)),
                                 bytes(size($items), 1) .

  Pair : code = "{}{}" of $key.code, $value.code .

  Dictionary : code = "{}{}{}{}{}" of bytes(2, 1), bytes(2, 2),
                                      join($pairs.code, ""),
                                      ("{}{}" of bytes(11, 1), bytes(1, 2)),
                                      bytes(size($pairs) * 2, 1) .

  (* ---- binding ----
   *
   * `x := v` at the top level is a global. Inside a block it would be a slot,
   * which is what the scope work below is for; until a block has one, every
   * binding is a global, which is exactly what a script without blocks means.
   *)
  Bind : slot   = lookup(positions($slotnames), $name, -1)
       : oslot  = lookup($outerslot, $name, -1)
       : odepth = lookup($outerdepth, $name, -1)
       : reaches = lookup([[true, true]], $slot < 0 and $oslot > -1, $reaches)
       : idx      = lookup($names, $name, size($names))
       : nametext = lookup([[true, $nametext]], defined($names, $name) or $slot > -1 or $oslot > -1,
                           "{}{}{}" of $nametext, bytes(size($name), 2), $name)
       : names    = lookup([[true, $names]], defined($names, $name) or $slot > -1 or $oslot > -1,
                           [...$names, [$name, size($names)]])
       : store = lookup([[true, "{}{}" of bytes(5, 1), bytes($slot, 1)]], $slot > -1,
                 lookup([[true, "{}{}{}" of bytes(7, 1),
                                           bytes($bdepth - $odepth, 1),
                                           bytes($oslot, 1)]], $oslot > -1,
                        "{}{}" of bytes(3, 1), bytes($idx, 2)))
       : code = "{}{}" of $value.code, $store .

  (* `o:x := v` -- the object, the value, and the name to bind on it. *)
  SetSlot : idx      = lookup($names, $name, size($names))
          : nametext = lookup([[true, $nametext]], defined($names, $name),
                              "{}{}{}" of $nametext, bytes(size($name), 2), $name)
          : names    = lookup([[true, $names]], defined($names, $name),
                              [...$names, [$name, size($names)]])
          : code = "{}{}{}{}" of $to.code, $value.code,
                                 bytes(12, 1), bytes($idx, 2) .

  (* ---- what an inlined block became ----
   *
   * Seven nodes the grammar never builds: `%rewrite inline` above puts them
   * where a send used to be, and each is the jumps `solas` emits for that
   * send. The body is a **list of statements** rather than a block, so it
   * compiles into the chunk being built -- joined with `POP` and the last one
   * left, which is what a block body answers with.
   *
   * The offsets are the one arithmetic here, and every one of them is the
   * number of bytes between the end of the jump and where it lands. That is
   * `solas`'s rule and it is why an offset can be worked out at all: the code
   * being jumped over is a value this clause is holding, so its size is a
   * question rather than a fixup.
   *
   * An empty block answers nil, which is `OP_NIL` and not nothing -- the code
   * after a branch expects a value on the stack whichever way it went.
   *)
  IfTrue : idx      = lookup($names, "ifTrue", size($names))
         : nametext = lookup([[true, $nametext]], defined($names, "ifTrue"),
                             "{}{}{}" of $nametext, bytes(6, 2), "ifTrue")
         : names    = lookup([[true, $names]], defined($names, "ifTrue"),
                             [...$names, ["ifTrue", size($names)]])
         : joined   = join(each($body.code, "{}\x12"), "")
         : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                             slice($joined, 1, size($joined) - 1))
         : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                 "{}\x01\x00\x00\x00{}"), "")
         : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                               size($body),
                               slice($braw, 1, size($braw) - 8))
         : runs = join([$cond.runs,
                        bytes(5, 4), bytes($pos.line, 4),
                        $bruns,
                        bytes(4, 4), bytes($pos.line, 4)], "")
         : code = join([$cond.code,
                        bytes(14, 1), bytes(size($bodycode) + 3, 2), bytes($idx, 2),
                        $bodycode,
                        bytes(13, 1), bytes(1, 2),
                        bytes(1, 1)], "") .

  (* Inverted: the branch that *is* taken runs the body, so falling through is
   * the true case and answers nil. *)
  IfFalse : idx      = lookup($names, "ifFalse", size($names))
          : nametext = lookup([[true, $nametext]], defined($names, "ifFalse"),
                              "{}{}{}" of $nametext, bytes(7, 2), "ifFalse")
          : names    = lookup([[true, $names]], defined($names, "ifFalse"),
                              [...$names, ["ifFalse", size($names)]])
          : joined   = join(each($body.code, "{}\x12"), "")
          : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                              slice($joined, 1, size($joined) - 1))
          : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                  "{}\x01\x00\x00\x00{}"), "")
          : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                size($body),
                                slice($braw, 1, size($braw) - 8))
          : runs = join([$cond.runs,
                         bytes(9, 4), bytes($pos.line, 4),
                         $bruns], "")
          : code = join([$cond.code,
                         bytes(14, 1), bytes(4, 2), bytes($idx, 2),
                         bytes(1, 1),
                         bytes(13, 1), bytes(size($bodycode), 2),
                         $bodycode], "") .

  IfElse : idx      = lookup($names, "ifElse", size($names))
         : nametext = lookup([[true, $nametext]], defined($names, "ifElse"),
                             "{}{}{}" of $nametext, bytes(6, 2), "ifElse")
         : names    = lookup([[true, $names]], defined($names, "ifElse"),
                             [...$names, ["ifElse", size($names)]])
         : yjoined  = join(each($yes.code, "{}\x12"), "")
         : yescode  = lookup([[0, bytes(1, 1)]], size($yes),
                             slice($yjoined, 1, size($yjoined) - 1))
         : njoined  = join(each($no.code, "{}\x12"), "")
         : nocode   = lookup([[0, bytes(1, 1)]], size($no),
                             slice($njoined, 1, size($njoined) - 1))
         : yraw  = join(each($yes.runs, bytes($yes.pos.line, 4),
                                 "{}\x01\x00\x00\x00{}"), "")
         : yruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                               size($yes),
                               slice($yraw, 1, size($yraw) - 8))
         : nraw  = join(each($no.runs, bytes($no.pos.line, 4),
                                 "{}\x01\x00\x00\x00{}"), "")
         : nruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                               size($no),
                               slice($nraw, 1, size($nraw) - 8))
         : runs = join([$cond.runs,
                        bytes(5, 4), bytes($pos.line, 4),
                        $yruns,
                        bytes(3, 4), bytes($pos.line, 4),
                        $nruns], "")
         : code = join([$cond.code,
                        bytes(14, 1), bytes(size($yescode) + 3, 2), bytes($idx, 2),
                        $yescode,
                        bytes(13, 1), bytes(size($nocode), 2),
                        $nocode], "") .

  (* The shortcut answers a constant -- tag 3 and a byte -- so that rebinding
   * the global `false` cannot make the two paths disagree. *)
  AndThen : idx      = lookup($names, "and", size($names))
          : nametext = lookup([[true, $nametext]], defined($names, "and"),
                              "{}{}{}" of $nametext, bytes(3, 2), "and")
          : names    = lookup([[true, $names]], defined($names, "and"),
                              [...$names, ["and", size($names)]])
          : cidx     = $nconsts
          : consts   = "{}{}{}" of $consts, bytes(3, 1), bytes(0, 1)
          : nconsts  = $nconsts + 1
          : joined   = join(each($body.code, "{}\x12"), "")
          : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                              slice($joined, 1, size($joined) - 1))
          : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                  "{}\x01\x00\x00\x00{}"), "")
          : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                size($body),
                                slice($braw, 1, size($braw) - 8))
          : runs = join([$cond.runs,
                         bytes(5, 4), bytes($pos.line, 4),
                         $bruns,
                         bytes(9, 4), bytes($pos.line, 4)], "")
          : code = join([$cond.code,
                         bytes(14, 1), bytes(size($bodycode) + 6, 2), bytes($idx, 2),
                         $bodycode,
                         bytes(16, 1), bytes($idx, 2),
                         bytes(13, 1), bytes(3, 2),
                         bytes(0, 1), bytes($cidx, 2)], "") .

  OrElse : idx      = lookup($names, "or", size($names))
         : nametext = lookup([[true, $nametext]], defined($names, "or"),
                             "{}{}{}" of $nametext, bytes(2, 2), "or")
         : names    = lookup([[true, $names]], defined($names, "or"),
                             [...$names, ["or", size($names)]])
         : cidx     = $nconsts
         : consts   = "{}{}{}" of $consts, bytes(3, 1), bytes(1, 1)
         : nconsts  = $nconsts + 1
         : joined   = join(each($body.code, "{}\x12"), "")
         : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                             slice($joined, 1, size($joined) - 1))
         : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                 "{}\x01\x00\x00\x00{}"), "")
         : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                               size($body),
                               slice($braw, 1, size($braw) - 8))
         : runs = join([$cond.runs,
                        bytes(11, 4), bytes($pos.line, 4),
                        $bruns,
                        bytes(3, 4), bytes($pos.line, 4)], "")
         : code = join([$cond.code,
                        bytes(14, 1), bytes(6, 2), bytes($idx, 2),
                        bytes(0, 1), bytes($cidx, 2),
                        bytes(13, 1), bytes(size($bodycode) + 3, 2),
                        $bodycode,
                        bytes(16, 1), bytes($idx, 2)], "") .

  (* `OP_EXIT_IF_FALSE` is `OP_JUMP_IF_FALSE` without the name: it carries no
   * selector because a loop's condition failing is not a message anybody
   * sent. `OP_LOOP` is the only jump that goes backwards, and its offset is
   * measured the same way -- from the end of the instruction. *)
  WhileTrue : cjoined  = join(each($cond.code, "{}\x12"), "")
            : condcode = lookup([[0, bytes(1, 1)]], size($cond),
                                slice($cjoined, 1, size($cjoined) - 1))
            : bjoined  = join(each($body.code, "{}\x12"), "")
            : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                                slice($bjoined, 1, size($bjoined) - 1))
            : back = size($condcode) + 3 + size($bodycode) + 1 + 3
            : craw  = join(each($cond.runs, bytes($cond.pos.line, 4),
                                    "{}\x01\x00\x00\x00{}"), "")
            : cruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                  size($cond),
                                  slice($craw, 1, size($craw) - 8))
            : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                    "{}\x01\x00\x00\x00{}"), "")
            : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                  size($body),
                                  slice($braw, 1, size($braw) - 8))
            : runs = join([$cruns,
                           bytes(3, 4), bytes($pos.line, 4),
                           $bruns,
                           bytes(5, 4), bytes($pos.line, 4)], "")
            : code = join([$condcode,
                           bytes(15, 1), bytes(size($bodycode) + 4, 2),
                           $bodycode,
                           bytes(18, 1),
                           bytes(17, 1), bytes($back, 2),
                           bytes(1, 1)], "") .

  (* The body first and the test after it, so a `doUntil` always runs once.
   * The condition has to answer a boolean, and unlike `whileTrue` there is a
   * selector to say so with when it does not. *)
  DoUntil : idx      = lookup($names, "doUntil", size($names))
          : nametext = lookup([[true, $nametext]], defined($names, "doUntil"),
                              "{}{}{}" of $nametext, bytes(7, 2), "doUntil")
          : names    = lookup([[true, $names]], defined($names, "doUntil"),
                              [...$names, ["doUntil", size($names)]])
          : bjoined  = join(each($body.code, "{}\x12"), "")
          : bodycode = lookup([[0, bytes(1, 1)]], size($body),
                              slice($bjoined, 1, size($bjoined) - 1))
          : cjoined  = join(each($cond.code, "{}\x12"), "")
          : condcode = lookup([[0, bytes(1, 1)]], size($cond),
                              slice($cjoined, 1, size($cjoined) - 1))
          : back = size($bodycode) + 1 + size($condcode) + 3 + 3 + 3 + 3
          : braw  = join(each($body.runs, bytes($body.pos.line, 4),
                                  "{}\x01\x00\x00\x00{}"), "")
          : bruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                size($body),
                                slice($braw, 1, size($braw) - 8))
          : craw  = join(each($cond.runs, bytes($cond.pos.line, 4),
                                  "{}\x01\x00\x00\x00{}"), "")
          : cruns = lookup([[0, "{}{}" of bytes(1, 4), bytes($pos.line, 4)]],
                                size($cond),
                                slice($craw, 1, size($craw) - 8))
          : runs = join([$bruns,
                         bytes(1, 4), bytes($pos.line, 4),
                         $cruns,
                         bytes(13, 4), bytes($pos.line, 4)], "")
          : code = join([$bodycode,
                         bytes(18, 1),
                         $condcode,
                         bytes(16, 1), bytes($idx, 2),
                         bytes(15, 1), bytes(3, 2),
                         bytes(13, 1), bytes(3, 2),
                         bytes(17, 1), bytes($back, 2),
                         bytes(1, 1)], "") .

  (* ---- a block ----
   *
   * The one construct that opens a **chunk of its own**, and the reason
   * `down` had to learn to set a threaded attribute. A method carries its own
   * name and constant tables, so entering one starts them empty and leaving
   * one puts the enclosing tables back. The save is an ordinary `down`
   * attribute, the reset is a `down` on the thread, and the restore is a
   * leaving clause -- a stack, written out of the two things the notation
   * already had rather than added to it.
   *
   * Because it is a stack, it nests: a block inside a block saves the middle
   * chunk's tables and puts them back, and its method lands in the middle
   * chunk's table where its `OP_BLOCK` looks for it.
   *)
  Block : down outerslot  = [...positions($slotnames), ...$outerslot]
        : down outerdepth = bind($outerdepth, $slotnames, $bdepth)
        : down bdepth     = $bdepth + 1
          (* Slot 0 holds whatever the send put there: the receiver, which is
           * what `self` means -- in **every** block, not only the outermost.
           * A block installed on a class is a method and its slot 0 is the
           * receiver of the send, and a block written inside another is still
           * the one that gets sent. So `self` is slot 0 of the frame it is
           * written in, always, which is what naming it here says. *)
        : down slotnames = ["self", ...$params, ...$temps]
        : down heldnames = $names
        : down heldtext  = $nametext
        : down heldcs    = $consts
        : down heldnc    = $nconsts
        : down heldms    = $methods
        : down heldnm    = $nmethods
        : down heldsl    = $nslots
        : down heldre    = $reaches
        : down heldfl    = $files
        : down heldft    = $filetext
        : down names     = [["array", 0], ["of", 1], ["dictionary", 2]]
        : down nametext  = "\x05\x00array\x02\x00of\x0a\x00dictionary"
        : down consts    = ""
        : down nconsts   = 0
        : down methods   = ""
        : down nmethods  = 0
        : down nslots    = 1 + size($params) + size($temps)
        : down reaches   = false
        : down files     = []
        : down filetext  = ""

          (* Two slots of one name would be one slot: `positions` keeps a
           * repeat's first place, so the inner declaration would write over
           * the outer one. Refused rather than compiled. *)
        ! size(positions($slotnames)) < size($slotnames)
            : "a name is declared twice in one frame"

          (* Every statement but the last is discarded and the last is the
           * answer -- which is the whole body with `POP` after each, less
           * that final `POP`, since `POP` is one byte and it is the last one. *)
        : joined   = join(each($body.code, "{}\x12"), "")
        : bodycode = "{}{}" of slice($joined, 1, size($joined) - 1), bytes(19, 1)

          (* ---- where the code came from ----
           *
           * A run per statement: its bytes at its line, then the one byte
           * after it -- the `POP` -- at the same line. `$pos` is what makes
           * this sayable at all, and `bytes` over a list is what makes it one
           * line instead of a clause on every node type that can be a
           * statement.
           *
           * The table has to **cover the code exactly**: the loader adds the
           * runs up and refuses a file whose lines do not account for every
           * byte. That is why the count is measured off the table itself
           * rather than counted from the body.
           *)
        : bodyruns = join(each($body.runs, bytes($body.pos.line, 4),
                               "{}\x01\x00\x00\x00{}"), "")

          (* The last statement has no `POP`, so the run written for the byte
           * after it goes too -- eight bytes off the end of the table, the way
           * one byte comes off the end of the code just above. *)
        : lineruns = "{}\x01\x00\x00\x00{}"
                       of slice($bodyruns, 1, size($bodyruns) - 8),
                          bytes($pos.line, 4)

          (* The same shape again, saying which *file* rather than which line.
           * Coarser, because a statement is in one file however many lines it
           * covers -- so one run for its code and the `POP` after it. *)
        : innerfile = lookup($files, $pos.file, 0)
        : allfruns  = join(each(bytes(sizes($body.code), 4),
                                bytes($body.fileidx, 4),
                                "{}{}\x01\x00\x00\x00{}"), "")
        : fileruns  = lookup([[0, ""]], size($files),
                             "{}\x01\x00\x00\x00{}"
                               of slice($allfruns, 1, size($allfruns) - 8),
                                  bytes($innerfile, 4))

        : chunk  = join([bytes(size($names), 4), $nametext,
                         bytes($nconsts, 4), $consts,
                         bytes(size($bodycode), 4), $bodycode,
                         bytes(quotient(size($lineruns), 8), 4), $lineruns,
                         bytes(size($files), 4), $filetext,
                         bytes(quotient(size($fileruns), 8), 4), $fileruns,
                         bytes(0, 2),
                         bytes($nmethods, 4), $methods], "")

          (* name, arity, slots, flags, body. The flag is `IS_BLOCK`; the
           * `CAPTURES` flag is set only for a chunk containing `OP_OUTER`,
           * and this backend refuses those, so it is never on. *)
        : flags  = lookup([[true, 3]], $reaches, 1)
        : record = join([bytes(5, 2), "block", bytes(size($params), 2),
                         bytes($nslots, 2), bytes($flags, 2), $chunk], "")

        : idx      = $heldnm
        : code     = "{}{}" of bytes(8, 1), bytes($idx, 2)
        : names    = $heldnames
        : nametext = $heldtext
        : consts   = $heldcs
        : nconsts  = $heldnc
        : methods  = "{}{}" of $heldms, $record
        : nmethods = $heldnm + 1
        : nslots   = $heldsl
        : reaches  = $heldre

          (* The enclosing table back, **and this block's own file interned
           * into it**: a block is a statement of the chunk around it, and its
           * bytes there are an `OP_BLOCK` that has to name a file like any
           * other. The restore and the intern are one clause because the
           * table they both answer with is one value. *)
        : fileidx  = lookup($heldfl, $pos.file, size($heldfl))
        : filetext = lookup([[true, $heldft]], defined($heldfl, $pos.file),
                            "{}{}{}" of $heldft,
                                        bytes(size($pos.file), 2), $pos.file)
        : files    = lookup([[true, $heldfl]], defined($heldfl, $pos.file),
                            [...$heldfl, [$pos.file, size($heldfl)]]) .

  (* ---- a group ----
   *
   * `(|t| ...)` is not a chunk: it runs where it is written, and its
   * temporaries are slots of the frame it is written in. So it adds to the
   * slot names and to nothing else, and its code is its body inline.
   *)
  Group : down slotnames = [...$slotnames, ...$temps]
        ! size(positions($slotnames)) < size($slotnames)
            : "a name is declared twice in one frame"
        : joined = join(each($body.code, "{}\x12"), "")
        : code   = slice($joined, 1, size($joined) - 1)
          (* The frame needs room for the deepest group in it, not the last. *)
        : nslots = lookup([[true, $nslots]], $nslots > size($slotnames),
                          size($slotnames)) .

  (* ---- the file ----
   *
   * A statement leaves a value nobody wants, so each is followed by a `POP`,
   * and the script ends with a `HALT`.
   *)
  Program : down slotnames = [""]
          : down outerslot  = []
          : down outerdepth = []
          : down bdepth     = 0
          : bodycode = "{}{}" of join(each($body.code, "{}\x12"), ""), bytes(20, 1)
          (* The same table as a block's, and the same reason -- see `Block`
           * above, where it is written out. A `Program` keeps every `POP`, so
           * nothing comes off the end; what it adds is the `HALT`, one byte at
           * the line the file starts on, which nothing can fail at. *)
          : bodyruns = join(each($body.runs, bytes($body.pos.line, 4),
                                 "{}\x01\x00\x00\x00{}"), "")
          : allfruns = join(each(bytes(sizes($body.code), 4),
                                 bytes($body.fileidx, 4),
                                 "{}{}\x01\x00\x00\x00{}"), "")
          : ownfile  = lookup($files, $pos.file, 0)
          : fileruns = lookup([[0, ""]], size($files),
                              "{}\x01\x00\x00\x00{}"
                                of $allfruns, bytes($ownfile, 4))

            (* The root is not a statement of anything, so nothing ever reads a
             * run of its own -- but `otherwise runs` is about every node and
             * would want a `code` this one has not got. *)
          : runs = ""
          : lineruns = "{}\x01\x00\x00\x00{}" of $bodyruns, bytes($pos.line, 4)
          : out = join([
              "SOLB", bytes(14, 2), bytes($nslots, 2),
              bytes(size($names), 4), $nametext,
              bytes($nconsts, 4), $consts,
              bytes(size($bodycode), 4), $bodycode,
              bytes(quotient(size($lineruns), 8), 4), $lineruns,
              bytes(size($files), 4), $filetext,
              bytes(quotient(size($fileruns), 8), 4), $fileruns,
              bytes(0, 2),              (* slotnames *)
              bytes($nmethods, 4), $methods
            ], "") .

%driver sob = inline, sob -> out .
